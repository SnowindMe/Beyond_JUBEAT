/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

# 站点图标（2026-10-27 换品牌标识后从 svg 改为多尺寸 png）
# 注：CF 的 Browser Cache TTL 会覆盖下面这些图片扩展名的 max-age（实测回 3600），
#     所以换图标时真正生效的是 URL 上的 ?v=N（见 README「品牌资源版本」）。
/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/favicon-16.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# PWA 资源（2026-10-26 加「添加到屏幕」）。
# sw.js 与 manifest 都绝不能缓存：
#   · SW：浏览器更新 SW 时会对同一 URL 重新取，长缓存会让旧 SW 一直留着；
#   · manifest：它里面写着 icons 的 ?v=N，缓存住就会让「换图标」在最长 1 小时内不生效
#     （2026-10-27 实测：部署后 HTML 立刻是新链接，但边缘仍回旧的 manifest、Age 1090s）。
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/icon-maskable-512.png
  Cache-Control: public, max-age=604800
