{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beyond-jubeat",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // 可观测性：打开 Workers Logs（请求日志 + 持久化），供 Workers 控制台/Logpush 排查。
  // traces 与 issues 先关闭，避免额外采样开销；需要时把对应 enabled 改成 true。
  "observability": {
    // 顶层 enabled 是旧的整体开关，不写时线上会返回 false（虽不影响子项生效，
    // 但控制台会显示成关闭，容易误判）。显式打开，实际采样由下面的子项决定。
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    // 实时 Issues 检测：字段名是 issues（wrangler 4.151.x 不认识 issue_detection，
    // 写错会被静默丢弃并告警）。先关掉，需要时改 true。
    "issues": {
      "enabled": false
    }
  },
  // Worker 入口用适配器提供的统一入口（官方写法）。
  // 不能写 dist/server/entry.mjs：构建期的 vite 插件会校验「main 指向的文件必须已存在」，
  // 而它在构建末尾才产出，必然失败。写成包说明符则交给 vite/esbuild 解析，
  // 开发与部署共用同一份配置。
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 这些是运行时路由（SSR 页 + API 端点），dist/client 里没有对应静态文件。
    // 不写的话 not_found_handling 会在资源层直接用 404.html 截住它们，不进 Worker。
    // run_worker_first 让这些路径永远先交给 Worker；其余静态页不受影响。
    //   /songs*  = 曲目库与详情（查 D1）
    //   /songs/gen/* = 世代筛选页（2026-10-23 加）——不需要单独写一条：
    //                 它已被上面的 /songs/* 覆盖。实测写出来会被 @cloudflare/vite-plugin
    //                 判为 redundant 并直接 build 失败（Invalid routes in run_worker_first），
    //                 所以靠 /songs/* 兜住。以后若有人收窄 /songs/*，记得把这 15 个页补回。
    //   /login /register /account /admin = 需要读会话的用户页（2026-10-23 起）
    //     /admin/songs/* = 维护者曲目编辑面板（t4 加）——同样不需要单独写一条：
    //     它已被 /admin/* 覆盖。实测显式写 "/admin/songs", "/admin/songs/*" 会被
    //     @cloudflare/vite-plugin 判为 redundant 并直接 build 失败
    //     （Invalid routes in run_worker_first: rule '/admin/*' makes it redundant），
    //     所以这里只留说明，靠 /admin/* 兜住。以后若有人收窄 /admin/*，记得把编辑面板补回。
    //   /recent/* = 最近更改（t5 起改 SSR 读 D1 的 recent_changes）——
    //               这一条必须单独写：/recent 不在任何通配规则里，不写就会被
    //               资源层按 not_found_handling 直接截成 404.html，进不了 Worker。
    //   /api/*   = 注册/登录/退出/改密/自荐/审批/曲目编辑等表单提交端点
    "run_worker_first": [
      "/songs", "/songs/*",
      //   /jubility = Jubility 层级页（2026-10-26 加）。它和 /songs/ 一样要在运行时
      //   读 D1 现算理论值（曲库一加曲，理论值就要跟着变），所以必须走 Worker，
      //   否则会被资源层按 not_found_handling 直接截成 404.html。
      "/jubility", "/jubility/*",
      "/login", "/login/*",
      "/register", "/register/*",
      "/account", "/account/*",
      "/admin", "/admin/*",
      "/recent", "/recent/*",
      "/api/*"
    ]
  },
  // 适配器默认会给 Astro Sessions 挂一个名为 SESSION 的 KV 绑定（我们暂未用会话），
  // 不在这里写死 id 的话，构建产物里的 bindings 会缺 id，wrangler deploy 会失败。
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "65d684992b4041c6af8b34451a0393c1"
    }
  ],
  // Turnstile 人机验证（注册/登录）：
  //   TURNSTILE_SECRET 用 wrangler secret 注入，不写进本文件、不进仓库：
  //     npx wrangler secret put TURNSTILE_SECRET --name beyond-jubeat
  //   前端 site key 走构建期环境变量 PUBLIC_TURNSTILE_SITE_KEY（Cloudflare 构建设置里配，
  //   或本地 .env），未配置时不渲染 widget；服务端在缺 secret 时对生产环境 fail-closed。
  //
  // D1 绑定：/songs/ 在运行时从这里读曲目数据。
  // binding 用下划线形式（beyond_jubeat），Worker 里通过 env.beyond_jubeat 访问。
  "d1_databases": [
    {
      "binding": "beyond_jubeat",
      "database_name": "beyond-jubeat",
      "database_id": "91a48a18-62b2-4933-9214-788205926744"
    }
  ]
}
