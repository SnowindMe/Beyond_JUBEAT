---
// 全站外壳：<head> + 世代背景板 + 正文插槽
// data-g / data-font 是世代主题的初始值，客户端脚本接管后会改这两个属性
import '../styles/theme.css';
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import BootScreen from '../components/BootScreen.astro';
import BackTop from '../components/BackTop.astro';
import data from '../data/data.json';
import site from '../data/site.json';
import { pageTitle, SITE_NAME } from '../lib/title';
import { GEN_JP, GEN_CN } from '../lib/gens';
import { THEMES } from '../lib/themes';

interface Props {
  title?: string;
  description?: string;
  /** 首屏就带上的世代主题，默认 ave */
  gen?: string;
  font?: string;
  /** 规范链接：默认拼到 site 上，404 页传空串表示不输出 */
  canonicalPath?: string;
  ogImage?: string;
  /** 404 这类不该被索引的页面传 true */
  noindex?: boolean;
}

const SITE = 'https://wiki.byd-ub.top';

// 世代（曲库归属，lib/gens.ts 的 GEN_ORDER）与主题（视觉皮肤，lib/themes.ts 的 THEMES）是两套口径：
// clan 一个世代在主题表里拆成 4 套皮肤，两个数本来就不相等，所以都按各自的数组算，别写死。
const THEME_COUNT = THEMES.length;
/** 主题表里首帧要用的字段：整个表塞进 <head> 太重，只发 k/f/b/l 四个 */
const THEMES_JSON = JSON.stringify(THEMES.map((t) => [t.k, t.f, t.b, t.l]));

const {
  title = pageTitle('首页'),
  // 原来同一句里并列「15 个世代」和「14 套主题」，读者会以为自相矛盾（审计第 19 条）。
  description = `jubeat 音乐魔方中文资料站：日服 ${GEN_JP.length} 个世代、国服 ${GEN_CN.length} 个世代，共 ${data.stat.songs} 首曲目、${data.stat.charts} 张谱面，其中 ${THEME_COUNT} 套世代主题可切换。`,
  gen = 'ave',
  font = 'F',
  canonicalPath = '/',
  ogImage = SITE + '/assets/images/og/cover.png',
  noindex = false,
} = Astro.props;

const canonical = canonicalPath ? SITE + canonicalPath : null;

/* ---------- 明暗判据（审计第 10 条） ----------
   画面层（反相、压深、白雾、去光晕……）原先按六套浅色主题名逐条硬编码，
   散在 theme / jubility / fortune / songs / server-card 五个文件共 105 行。
   加一套浅色主题要回头改六处，漏一处就是「新主题下某块图反了或没反」。
   现在收成 <html> 上的 data-lum="light|dark"，CSS 侧一律只认它。

   判据取值只有一处：lib/themes.ts 每条主题的 l 字段。它必须与 theme.css 里该主题声明的
   color-scheme 一致——color-scheme 是权威（还能顺带让浏览器把原生控件、滚动条画对），
   l 是它给脚本和对比度自检用的副本。改主题明暗时两处同改，别只改一处。 */
const lum = THEMES.find((t) => t.k === gen)?.l ?? 'dark';

// 页脚「最后一次编辑」：读构建期写死的常量，**不再每次 new Date()**。
//
// 【2026-10-29 主人「怎么每个页面的最后编辑时间不一样啊」】
// 根因：原先在这里直接 new Date()。
//   · 静态页（首页等）在**构建期**就算定死，比如 09:47；
//   · SSR 页（/songs/、/jubility/、/recent/…prerender=false）每次请求**现算**，比如 12:36。
//   同一站点两套时间，用户看到的就是"每页都不一样"，而且 SSR 页还会随刷新跳动。
// 正确语义："最后一次编辑" = 最后一次上线的构建时刻，全站必须一致。
// 所以改由 scripts/gen-build-stamp.cjs 在 build 前写死时间戳，
// 静态页与 SSR 页都 import 同一份常量。
// import 而不是运行时读文件：SSR 产物跑在 Worker 里，没有 fs。
import buildStamp from '../data/build-stamp.json';
const BUILD_DATE = (buildStamp as { stamp: string }).stamp;
---

<!doctype html>
<html lang="zh-CN" data-g={gen} data-lum={lum} data-font={font}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {/* theme-color 的初值由下面的首屏预热脚本按世代改写；这里的 #0a1418 是 ave 的 --base，
      作为「脚本被禁用」时的兜底（原来的 #0b1a22 与 15 套主题全都不一致）。 */}
  <meta name="theme-color" content="#0a1418" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {/* 2026-10-27 换品牌标识：源图是位图（主人给的 PNG），所以 favicon 从 SVG 改成
      多尺寸 PNG。16/32 两档覆盖浏览器标签页与书签栏的实际取值，另给一个多尺寸
      favicon.ico 兜住仍会自动请求 /favicon.ico 的浏览器。
      【⚠ 品牌资源一律带 ?v=N】见 README「品牌资源版本」：CF 边缘会把 _headers 里的
      max-age 压成 1 小时且不随部署失效（实测源站已是新图、边缘仍回旧图标），
      所以「换图标」只能靠 URL 变化。改图标时三处版本号同改：
      这里、public/manifest.webmanifest、src/components/Header.astro 的 brand.webp。 */}
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" href="/favicon-32.png?v=2" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16.png?v=2" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <link rel="sitemap" href="/sitemap.xml" />
  {/* PWA：让手机浏览器可以把站点「添加到主屏幕」（2026-10-26 主人要求）。
      manifest 提供名称/图标/start_url；sw.js 只缓存静态资源，HTML 与 /api/ 一律直通
      ——本站多为 SSR 查 D1，缓存页面会让用户看到过期数据。 */}
  {/* ?v=2 是一次性的破缓存：部署前边缘已按旧的 max-age=3600 缓存了 manifest，换 URL 才能
      立刻读到新的 icons 列表。之后 _headers 已改成 must-revalidate，图标再换只需 bump
      manifest 内部三处 icons 的 ?v=N，不必再动这里的链接。 */}
  <link rel="manifest" href="/manifest.webmanifest?v=2" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="JUBEAT" />
  {/* 站点是单页 + 大量施工中的占位导航，canonical 固定到首页，避免 /foo/ 这类
      被 CF 兜到 404 页后仍被索引成重复内容。 */}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="zh_CN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {/* 【2026-10-30 曲目页服务器首帧预热】主人反馈「选国服后刷新，会先看到日服再跳到国服」。
      /songs/ 的两套 .sc-body 加起来 1.3MB，服务端永远按日服渲染，
      而存档里的 srv 要等页面末尾那段脚本才恢复——那时日服已经在 45KB 处被画出来了。
      实测脚本放在列表之后（1.34MB 处）也来不及：解析到日服 body 时就开始绘制了。

      所以挪到 <head> 来做，并且**不只改 hidden，还写一条 CSS**：
        html[data-srv-pref="cn"] .sc-body[data-srv="jp"] { display: none }
      这样样式表一到位就生效，不依赖任何 JS 执行时机，首帧直接是国服，中间没有可闪的窗口。
      末尾脚本仍会再设一次 hidden（两套机制一致，互相兜底）。 */}
  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem('jb-songs-filter-v1');
        if (!raw) return;
        var o = JSON.parse(raw);
        if (o && (o.srv === 'jp' || o.srv === 'cn')) {
          document.documentElement.setAttribute('data-srv-pref', o.srv);
        }
      } catch (e) {}
    })();
  </script>
  {/* 主题表里跟首帧有关的两个字段（字形组 f、底色 b）在这里也发给浏览器：
      下面那段预热脚本要用，而 is:inline 脚本不打包、import 不进来。
      ThemeScript.astro 里还有同一份 JSON，它负责撑起整个切换器——
      两份都来自 lib/themes.ts，加主题只改那一个文件。 */}
  <script is:inline id="jbThemes" type="application/json" set:html={THEMES_JSON}></script>
  <script is:inline>
    (function () {
      var FONT = {}, THEME_BG = {}, THEME_LUM = {};
      JSON.parse(document.getElementById('jbThemes').textContent).forEach(function (t) {
        FONT[t[0]] = t[1];
        THEME_BG[t[0]] = t[2];
        THEME_LUM[t[0]] = t[3];
      });
      var DEF = 'ave';
      var g = DEF;
      try { g = localStorage.getItem('jubeat-gen') || DEF; } catch (e) {}
      if (!FONT[g]) g = DEF;
      var el = document.documentElement;
      el.setAttribute('data-g', g);
      el.setAttribute('data-font', FONT[g]);
      /* 明暗跟着世代一起落：老用户刷新时先闪浅色底、再被深色主题盖住，就是这里缺一步。
         服务端只能按默认世代猜到初值，localStorage 里的真实世代要到这里才知道。
         data-lum 与 color-scheme 同源（见 lib/themes.ts 的 l 与 theme.css 的 color-scheme），
         下一行开始 theme-color / 主题切换都按这张表走，CSS 侧只认 data-lum。 */
      el.setAttribute('data-lum', THEME_LUM[g] || 'dark');
      /* theme-color 先给一个与世代相符的值：CSS 尚未应用时 getComputedStyle 读不到
         --base，所以这里用主题表里的底色调子兜住首帧；ThemeScript 的 commit() 之后会按
         解析后的 --base 再校一次（那里是唯一权威）。 */
      var mt = document.querySelector('meta[name="theme-color"]');
      if (mt && THEME_BG[g]) mt.setAttribute('content', THEME_BG[g]);
      /* 换过图的世代在这里登记版本号：背景 URL 会拼成 <k>.webp?v=N。
         /assets/images/* 是 immutable 一年缓存，不改文件名的话老访客永远看旧图；
         只有这里登记过的图才会带参数，其余 14 张照旧命中缓存。 */
      window.JB_BGVER = { festo: 3, jubeat: 2 };
      /* 字体自托管（2026-11-02，见 theme.css 顶部）：文件在 /assets/fonts/。

         【为什么按「世代」而不是按那个 A-G 字母映射】
         2026-10-27 改成「一世代一款字体」之后，旧映射（F/C/D/E/G 五个字母 →
         jost/rye/playfair/caveat/shrikhand）就已经失效了：那五款里只有 Caveat 还在用，
         其余四款没有任何 @font-face，预载等于白下（audit P1 的成因之一）。
         现在直接以世代 key 为键，与 theme.css 里 html[data-g=…] 的 --font-label 一一对应，
         换字体时两处同改即可。 */
      var FONTFILE = {
        jubeat: 'montserrat-700',
        ave: 'montserrat-500',
        ripples: 'quicksand-500',
        bta: 'quicksand-500',
        knit: 'playfair-display-400',
        qubell: 'lora-400',
        copious: 'raleway-300',
        saucer: 'raleway-300',
        saucerfulfill: 'raleway-300',
        prop: 'caveat-700',
        festo: 'pacifico-400',
        clan_red: 'oswald-700',
        clan_blue: 'oswald-700',
        clan_green: 'oswald-700',
        clan_purple: 'oswald-700',
        yymf: 'zcool-kuaile-400'
      };
      // 字体文件名仍按世代逐条列（theme.css 的 @font-face 一一对应，换字体两处同改）
      function pre(href, as, type) {
        var l = document.createElement('link');
        l.rel = 'preload';
        l.as = as;
        if (type) l.type = type;
        // as=font 的 preload 必须带 crossorigin（同源也一样），否则字体会被下载两次
        if (as === 'font') l.crossOrigin = 'anonymous';
        l.href = href;
        document.head.appendChild(l);
      }
      pre('/assets/images/bg/' + g + '.webp' + (window.JB_BGVER[g] ? '?v=' + window.JB_BGVER[g] : ''), 'image');
      var ff = FONTFILE[g] || FONTFILE.ave;
      /* preload 地址必须与 @font-face 的 src **完全一致**，否则浏览器当成两个 URL、
         字体会被下载两次。改字体时 theme.css 与这里要同改。 */
      if (ff) pre('/assets/fonts/' + ff + '.woff2', 'font', 'font/woff2');
    })();
  </script>
</head>
<body>
  {/* 跳过导航：键盘/读屏用户按 Tab 第一下就能直达正文，不用穿过整个顶栏。
      放在 body 首个元素，平时视觉隐藏，获得焦点才出现在左上角。 */}
  <a class="skip" href="#main">跳到主内容</a>
  <BootScreen />
  <div class="bgv" aria-hidden="true"><div class="bgv-l"></div><div class="bgv-l"></div></div>
  <div class="wrap">
    <Header />
    {/* main landmark：读屏可用 landmark 快捷键定位正文，也是 skip-link 的落点。
        tabindex="-1" 让点击 skip 后焦点真的落进 main（否则只滚动、焦点不动）。 */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot mono">
      <div class="foot-l">
        {/* 【2026-11-01 23:05 主人「下面的最后编辑时间和版本号换成徽章吧，把『最后一次编辑』去掉」】
            两个都是徽章，「最后一次编辑」这五个字不再显示，语义挪到 title / aria-label 上，
            这样读屏和悬停仍能知道这串数字是什么，视觉上只剩两个干净的数据徽章。 */}
        <span class="foot-badge foot-date" title="页面最后一次编辑的时间（最后一次构建时刻，全站一致）" aria-label={`最后一次编辑 ${BUILD_DATE}`}>
          <b>{BUILD_DATE}</b>
        </span>
        {/* title：页脚只显示 v1.15.0，读者不知道这是站点迭代版本还是 npm 包版本（审计第 21 条） */}
        <span class="foot-badge foot-ver" title="站点迭代版本，与 npm 包版本无关">v{site.version}</span>
      </div>
      <div class="foot-r">
        {/* 站点标识（logo + 品牌字 + Enjoy Yourself）已于 2026-10-27 按主人要求
            从页脚移到首页居中放大显示（首页 .brandblock），页脚只留版本信息与署名。 */}
        {/* 「powered by dsh」署名（主人 2026-10-25 要求加水印）。
            用官方 shields.io 徽章原样嵌入，尺寸按规范 121×20、不改配色与文案；
            走外链图片是为了长期拿到官方更新，同时不往仓库塞第三方 PNG。
            rel="noopener" + target=_blank：外链一律新开，不打断站内流程。 */}
        <a class="foot-dsh" href="https://github.com/deepseek-ai/deepseek-harness" target="_blank" rel="noopener" title="本项目在 DeepSeek Harness 中开发">
          <img src="https://img.shields.io/badge/powered_by-dsh-4D6BFE?style=flat-square&logo=deepseek&logoColor=white" alt="powered by dsh" width="121" height="20" loading="lazy" decoding="async" />
          {/* 兜底：shields.io 在某些网络下会被挡（本机就常走代理），破图比没有更难看。
              图加载失败时给 .foot-dsh 挂 is-err，CSS 把 img 藏起来、露出这行同款文字。 */}
          <span class="foot-dsh-txt" aria-hidden="true">powered by dsh</span>
        </a>
      </div>
    </footer>
  </div>
  <script is:inline>
    // 页脚「powered by dsh」徽章的文字兜底：shields.io 被挡/超时时，破图比不显示更难看。
    // 用 error 事件而不是 onload 池，是因为 img 可能在脚本执行前就已经失败（缓存/快速失败），
    // 所以先查一次 complete && naturalWidth === 0 的状态，再把后续失败也接上。
    (function () {
      var a = document.querySelector('.foot-dsh');
      if (!a) return;
      var img = a.querySelector('img');
      if (!img) return;
      function fail() { a.classList.add('is-err'); }
      if (img.complete && img.naturalWidth === 0) fail();
      img.addEventListener('error', fail);
      img.addEventListener('load', function () {
        if (img.naturalWidth === 0) fail();
      });
    })();
  </script>
  <script is:inline>
    // Service Worker 注册（PWA「添加到主屏幕」的必要条件之一，2026-10-26）。
    // 只在 https 或 localhost 下注册：http 的局域网调试地址（如 192.168.x.x）没有
    // Service Worker，硬注册会抛错并污染控制台。
    // load 后再注册，不跟首屏抢带宽。
    if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1')) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () { /* 注册失败不影响页面功能 */ });
      });
    }
  </script>
  <BackTop />
  <ThemeScript />
</body>
</html>