---
// 全站外壳：<head> + 世代背景板 + 正文插槽
// data-g / data-font 是世代主题的初始值，客户端脚本接管后会改这两个属性
import '../styles/theme.css';
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import BootScreen from '../components/BootScreen.astro';
import BackTop from '../components/BackTop.astro';
import data from '../data/data.json';
import site from '../data/site.json';
import { pageTitle, SITE_NAME } from '../lib/title';

interface Props {
  title?: string;
  description?: string;
  /** 首屏就带上的世代主题，默认 ave */
  gen?: string;
  font?: string;
  /** 规范链接：默认拼到 site 上，404 页传空串表示不输出 */
  canonicalPath?: string;
  ogImage?: string;
  /** 404 这类不该被索引的页面传 true */
  noindex?: boolean;
}

const SITE = 'https://wiki.byd-ub.top';

const {
  title = pageTitle('首页'),
  description = `jubeat 音乐魔方中文资料站：日服 ${data.stat.gensJp} 个世代、国服 ${data.stat.gensCn} 个世代，共 ${data.stat.songs} 首曲目、${data.stat.charts} 张谱面，支持 14 套世代主题切换。`,
  gen = 'ave',
  font = 'F',
  canonicalPath = '/',
  ogImage = SITE + '/assets/images/og/cover.png',
  noindex = false,
} = Astro.props;

const canonical = canonicalPath ? SITE + canonicalPath : null;

// 页脚「最后一次编辑」：取构建时刻（云端每次 push 自动构建，等价于最后上线时间）。
// 显式按北京时间算，避免 CI 跑在 UTC 时跨天。
// 主人 2026-10-22 要求加上【时:分】，格式 2026-10-22 14:25。
const BUILD_DATE = (() => {
  const d = new Date();
  try {
    const day = d.toLocaleDateString('en-CA', { timeZone: 'Asia/Shanghai' });
    const hm = d.toLocaleTimeString('en-GB', {
      timeZone: 'Asia/Shanghai',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    return `${day} ${hm}`;
  } catch {
    return d.toISOString().slice(0, 16).replace('T', ' ');
  }
})();
---

<!doctype html>
<html lang="zh-CN" data-g={gen} data-font={font}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b1a22" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap.xml" />
  {/* 站点是单页 + 大量施工中的占位导航，canonical 固定到首页，避免 /foo/ 这类
      被 CF 兜到 404 页后仍被索引成重复内容。 */}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="zh_CN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {/* 首屏主题预热：在 CSS 应用前就把世代写回 <html>，避免老用户刷新时先闪一下 ave；
      同时提前 preload 该世代背景图（背景由 JS 设 background-image，浏览器发现得晚）。 */}
  <script is:inline>
    (function () {
      var FONT = { ave: 'F', bta: 'F', clan_blue: 'C', clan_green: 'C', clan_purple: 'C', clan_red: 'C', copious: 'F', festo: 'G', knit: 'D', prop: 'E', qubell: 'D', saucer: 'F', saucerfulfill: 'F', ripples: 'F', yymf: 'F' };
      var g = 'ave';
      try { g = localStorage.getItem('jubeat-gen') || 'ave'; } catch (e) {}
      if (!FONT[g]) g = 'ave';
      var el = document.documentElement;
      el.setAttribute('data-g', g);
      el.setAttribute('data-font', FONT[g]);
      var FONTFILE = { F: 'jost-500.woff2', C: 'rye-400.woff2', D: 'playfair-700.woff2', E: 'caveat-700.woff2', G: 'shrikhand-400.woff2' };
      function pre(href, as, type) {
        var l = document.createElement('link');
        l.rel = 'preload';
        l.as = as;
        if (type) l.type = type;
        // as=font 的 preload 必须带 crossorigin（同源也一样），否则字体会被下载两次
        if (as === 'font') l.crossOrigin = 'anonymous';
        l.href = href;
        document.head.appendChild(l);
      }
      pre('/assets/images/bg/' + g + '.webp', 'image');
      var ff = FONTFILE[FONT[g]];
      if (ff) pre('/assets/fonts/' + ff, 'font', 'font/woff2');
    })();
  </script>
</head>
<body>
  <BootScreen />
  <div class="bgv" aria-hidden="true"><div class="bgv-l"></div><div class="bgv-l"></div></div>
  <div class="wrap">
    <Header />
    <slot />
    <footer class="foot mono">
      <div class="foot-l">
        <span class="foot-k">最后一次编辑 <b>{BUILD_DATE}</b></span>
        <span class="foot-ver">v{site.version}</span>
      </div>
      <div class="foot-r">
        <span class="mark mark-sm">
          <i></i>
          <span class="mark-x">
            <b>Beyond <span class="sym">↑</span> JUBEAT <span class="sym">♪</span><span class="til">~</span></b>
          </span>
        </span>
        <span class="foot-slogan">Enjoy Yourself</span>
      </div>
    </footer>
  </div>
  <BackTop />
  <ThemeScript />
</body>
</html>