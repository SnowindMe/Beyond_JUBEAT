---
// 全站外壳：<head> + 世代背景板 + 正文插槽
// data-g / data-font 是世代主题的初始值，客户端脚本接管后会改这两个属性
import '../styles/theme.css';
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import BootScreen from '../components/BootScreen.astro';
import BackTop from '../components/BackTop.astro';
import data from '../data/data.json';
import site from '../data/site.json';
import { pageTitle, SITE_NAME } from '../lib/title';

interface Props {
  title?: string;
  description?: string;
  /** 首屏就带上的世代主题，默认 ave */
  gen?: string;
  font?: string;
  /** 规范链接：默认拼到 site 上，404 页传空串表示不输出 */
  canonicalPath?: string;
  ogImage?: string;
  /** 404 这类不该被索引的页面传 true */
  noindex?: boolean;
}

const SITE = 'https://wiki.byd-ub.top';

const {
  title = pageTitle('首页'),
  // 「13 个世代 / 15 套主题」是两套口径：世代是曲库归属（lib/gens.ts），
  // 主题是视觉皮肤（ThemeScript 的 GEN 数组，clan 一个世代拆 4 套）。
  // 原来同一句里并列「15 个世代」和「14 套主题」，读者会以为自相矛盾（审计第 19 条）。
  description = `jubeat 音乐魔方中文资料站：日服 ${data.stat.gensJp} 个世代、国服 ${data.stat.gensCn} 个世代，共 ${data.stat.songs} 首曲目、${data.stat.charts} 张谱面，其中 15 套世代主题可切换。`,
  gen = 'ave',
  font = 'F',
  canonicalPath = '/',
  ogImage = SITE + '/assets/images/og/cover.png',
  noindex = false,
} = Astro.props;

const canonical = canonicalPath ? SITE + canonicalPath : null;

// 页脚「最后一次编辑」：取构建时刻（云端每次 push 自动构建，等价于最后上线时间）。
// 显式按北京时间算，避免 CI 跑在 UTC 时跨天。
// 主人 2026-10-22 要求加上【时:分】，格式 2026-10-22 14:25。
const BUILD_DATE = (() => {
  const d = new Date();
  try {
    // Intl.DateTimeFormat 显式构造，不再靠 toLocaleDateString('en-CA') 的隐式 locale 行为：
    // en-CA 的「YYYY-MM-DD」依赖运行时 ICU 数据，换环境可能变成 MM/DD/YYYY。
    const fmt = new Intl.DateTimeFormat('zh-CN', {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const p: Record<string, string> = {};
    for (const { type, value } of fmt.formatToParts(d)) p[type] = value;
    const hh = p.hour === '24' ? '00' : p.hour; // zh-CN 的 hourCycle 在 0 点可能给 24
    return `${p.year}-${p.month}-${p.day} ${hh}:${p.minute}`;
  } catch {
    return d.toISOString().slice(0, 16).replace('T', ' ');
  }
})();
---

<!doctype html>
<html lang="zh-CN" data-g={gen} data-font={font}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {/* theme-color 的初值由下面的首屏预热脚本按世代改写；这里的 #0a1418 是 ave 的 --base，
      作为「脚本被禁用」时的兜底（原来的 #0b1a22 与 15 套主题全都不一致）。 */}
  <meta name="theme-color" content="#0a1418" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {/* 2026-10-27 换品牌标识：源图是位图（主人给的 PNG），所以 favicon 从 SVG 改成
      多尺寸 PNG。16/32 两档覆盖浏览器标签页与书签栏的实际取值，另给一个多尺寸
      favicon.ico 兜住仍会自动请求 /favicon.ico 的浏览器。
      【⚠ 品牌资源一律带 ?v=N】见 README「品牌资源版本」：CF 边缘会把 _headers 里的
      max-age 压成 1 小时且不随部署失效（实测源站已是新图、边缘仍回旧图标），
      所以「换图标」只能靠 URL 变化。改图标时三处版本号同改：
      这里、public/manifest.webmanifest、src/components/Header.astro 的 brand.webp。 */}
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" href="/favicon-32.png?v=2" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16.png?v=2" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <link rel="sitemap" href="/sitemap.xml" />
  {/* PWA：让手机浏览器可以把站点「添加到主屏幕」（2026-10-26 主人要求）。
      manifest 提供名称/图标/start_url；sw.js 只缓存静态资源，HTML 与 /api/ 一律直通
      ——本站多为 SSR 查 D1，缓存页面会让用户看到过期数据。 */}
  {/* ?v=2 是一次性的破缓存：部署前边缘已按旧的 max-age=3600 缓存了 manifest，换 URL 才能
      立刻读到新的 icons 列表。之后 _headers 已改成 must-revalidate，图标再换只需 bump
      manifest 内部三处 icons 的 ?v=N，不必再动这里的链接。 */}
  <link rel="manifest" href="/manifest.webmanifest?v=2" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="JUBEAT" />
  {/* 站点是单页 + 大量施工中的占位导航，canonical 固定到首页，避免 /foo/ 这类
      被 CF 兜到 404 页后仍被索引成重复内容。 */}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="zh_CN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {/* 首屏主题预热：在 CSS 应用前就把世代写回 <html>，避免老用户刷新时先闪一下 ave；
      同时提前 preload 该世代背景图（背景由 JS 设 background-image，浏览器发现得晚）。 */}
  <script is:inline>
    (function () {
      var FONT = { ave: 'F', bta: 'F', clan_blue: 'C', clan_green: 'C', clan_purple: 'C', clan_red: 'C', copious: 'F', festo: 'G', jubeat: 'F', knit: 'D', prop: 'E', qubell: 'D', saucer: 'F', saucerfulfill: 'F', ripples: 'F', yymf: 'F' };
      var g = 'ave';
      try { g = localStorage.getItem('jubeat-gen') || 'ave'; } catch (e) {}
      if (!FONT[g]) g = 'ave';
      var el = document.documentElement;
      el.setAttribute('data-g', g);
      el.setAttribute('data-font', FONT[g]);
      /* theme-color 先给一个与世代相符的值：CSS 尚未应用时 getComputedStyle 读不到
         --base，所以这里用内联色表兜住首帧；ThemeScript 的 commit() 之后会按
         解析后的 --base 再校一次（那里是唯一权威）。 */
      var THEME_BG = { ave: '#0a1418', bta: '#190f08', clan_blue: '#0a1424', clan_green: '#08160f', clan_purple: '#120b1c', clan_red: '#1a0a0c', copious: '#080d22', festo: '#12100c', jubeat: '#050e22', knit: '#f2eee4', prop: '#f7f6f4', qubell: '#f4f1ea', saucer: '#eceff1', saucerfulfill: '#141414', ripples: '#dfeeea', yymf: '#e9eefb' };
      var mt = document.querySelector('meta[name="theme-color"]');
      if (mt && THEME_BG[g]) mt.setAttribute('content', THEME_BG[g]);
      /* 换过图的世代在这里登记版本号：背景 URL 会拼成 <k>.webp?v=N。
         /assets/images/* 是 immutable 一年缓存，不改文件名的话老访客永远看旧图；
         只有这里登记过的图才会带参数，其余 14 张照旧命中缓存。 */
      window.JB_BGVER = { festo: 3, jubeat: 2 };
      /* 字体走 fontsource + jsdmirror（2026-10-25，见 theme.css 顶部）：仓库不再存字体二进制，
         所以这里直接拼第三方 URL。键仍是「字体代号 → 完整 URL 路径」，与 @font-face 一一对应。 */
      var FONTCDN = 'https://cdn.jsdmirror.com/npm/@fontsource/';
      var FONTFILE = {
        F: 'jost/files/jost-latin-500-normal.woff2',
        C: 'rye/files/rye-latin-400-normal.woff2',
        D: 'playfair-display/files/playfair-display-latin-700-normal.woff2',
        E: 'caveat/files/caveat-latin-700-normal.woff2',
        G: 'shrikhand/files/shrikhand-latin-400-normal.woff2'
      };
      function pre(href, as, type) {
        var l = document.createElement('link');
        l.rel = 'preload';
        l.as = as;
        if (type) l.type = type;
        // as=font 的 preload 必须带 crossorigin（同源也一样），否则字体会被下载两次
        if (as === 'font') l.crossOrigin = 'anonymous';
        l.href = href;
        document.head.appendChild(l);
      }
      pre('/assets/images/bg/' + g + '.webp' + (window.JB_BGVER[g] ? '?v=' + window.JB_BGVER[g] : ''), 'image');
      var ff = FONTFILE[FONT[g]];
      /* preload 地址必须与 @font-face 的 src **完全一致**（含域名），否则浏览器当成
         两个 URL、字体会被下载两次。改字体时 theme.css 与这里要同改。 */
      if (ff) pre(FONTCDN + ff, 'font', 'font/woff2');
    })();
  </script>
</head>
<body>
  {/* 跳过导航：键盘/读屏用户按 Tab 第一下就能直达正文，不用穿过整个顶栏。
      放在 body 首个元素，平时视觉隐藏，获得焦点才出现在左上角。 */}
  <a class="skip" href="#main">跳到主内容</a>
  <BootScreen />
  <div class="bgv" aria-hidden="true"><div class="bgv-l"></div><div class="bgv-l"></div></div>
  <div class="wrap">
    <Header />
    {/* main landmark：读屏可用 landmark 快捷键定位正文，也是 skip-link 的落点。
        tabindex="-1" 让点击 skip 后焦点真的落进 main（否则只滚动、焦点不动）。 */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot mono">
      <div class="foot-l">
        <span class="foot-k">最后一次编辑 <b>{BUILD_DATE}</b></span>
        {/* title：页脚只显示 v1.15.0，读者不知道这是站点迭代版本还是 npm 包版本（审计第 21 条） */}
        <span class="foot-ver" title="站点迭代版本，与 npm 包版本无关">v{site.version}</span>
      </div>
      <div class="foot-r">
        {/* 站点标识（logo + 品牌字 + Enjoy Yourself）已于 2026-10-27 按主人要求
            从页脚移到首页居中放大显示（首页 .brandblock），页脚只留版本信息与署名。 */}
        {/* 「powered by dsh」署名（主人 2026-10-25 要求加水印）。
            用官方 shields.io 徽章原样嵌入，尺寸按规范 121×20、不改配色与文案；
            走外链图片是为了长期拿到官方更新，同时不往仓库塞第三方 PNG。
            rel="noopener" + target=_blank：外链一律新开，不打断站内流程。 */}
        <a class="foot-dsh" href="https://github.com/deepseek-ai/deepseek-harness" target="_blank" rel="noopener" title="本项目在 DeepSeek Harness 中开发">
          <img src="https://img.shields.io/badge/powered_by-dsh-4D6BFE?style=flat-square&logo=deepseek&logoColor=white" alt="powered by dsh" width="121" height="20" loading="lazy" decoding="async" />
          {/* 兜底：shields.io 在某些网络下会被挡（本机就常走代理），破图比没有更难看。
              图加载失败时给 .foot-dsh 挂 is-err，CSS 把 img 藏起来、露出这行同款文字。 */}
          <span class="foot-dsh-txt" aria-hidden="true">powered by dsh</span>
        </a>
      </div>
    </footer>
  </div>
  <script is:inline>
    // 页脚「powered by dsh」徽章的文字兜底：shields.io 被挡/超时时，破图比不显示更难看。
    // 用 error 事件而不是 onload 池，是因为 img 可能在脚本执行前就已经失败（缓存/快速失败），
    // 所以先查一次 complete && naturalWidth === 0 的状态，再把后续失败也接上。
    (function () {
      var a = document.querySelector('.foot-dsh');
      if (!a) return;
      var img = a.querySelector('img');
      if (!img) return;
      function fail() { a.classList.add('is-err'); }
      if (img.complete && img.naturalWidth === 0) fail();
      img.addEventListener('error', fail);
      img.addEventListener('load', function () {
        if (img.naturalWidth === 0) fail();
      });
    })();
  </script>
  <script is:inline>
    // Service Worker 注册（PWA「添加到主屏幕」的必要条件之一，2026-10-26）。
    // 只在 https 或 localhost 下注册：http 的局域网调试地址（如 192.168.x.x）没有
    // Service Worker，硬注册会抛错并污染控制台。
    // load 后再注册，不跟首屏抢带宽。
    if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1')) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () { /* 注册失败不影响页面功能 */ });
      });
    }
  </script>
  <BackTop />
  <ThemeScript />
</body>
</html>