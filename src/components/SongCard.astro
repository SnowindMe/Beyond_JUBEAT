---
// 曲目卡：/songs/ 与 /songs/gen/[gen]/ 共用的唯一一份卡片。
// 抽出来的原因：两页要长得完全一样，复制一份等于以后改样式要改两遍（必然漏一边）。
// 样式仍走 src/styles/songs.css 的 .sc-*（这里是纯结构，没有自己的 CSS）。
//
// data-* 承载匹配字段（2026-10-23，t9 搜索/筛选/排序）：
// 搜索与筛选一律读这些属性，**不在输入时去解析卡片里的文字**——
// 卡片文本里混着「双」徽章、被截断的省略号、破折号占位，解析出来必然是脏数据。
// 定数缺失写空串（不是 0）：前端据此区分「没有这一档」与「定数是 0」，
// 否则「7.0 以下」会把没有 EXT 的曲误判成 0。
// data-lv 是三档定数拼成的一串（"7 10.5 10.9"），只给搜索用：
// 用户常直接打「10.5」找歌，光靠曲名/曲师/songId 三个字段搜不到。
// data-lu（2026-10-28）：限时结束日 YYYY-MM-DD，空串 = 非限时。
// 「是否已结束」必须由浏览器按真实今天算——在这里按构建期日期焊死的话，
// 数据一生成就固定，第二天起就永远是错的。
import type { Song } from '../lib/db';
import { catOf, isPickUp } from '../lib/song-view';

interface Props {
  song: Song;
  /** 首屏图给 eager + high，其余 lazy + low（一次开 1200+ 请求会被浏览器排队拖慢） */
  eager?: boolean;
  /** 当前视图服务器：决定该卡属于哪个分区、算不算 PICK UP（口径都在 lib/song-view.ts） */
  srv?: 'jp' | 'cn';
  /** 是否画 PICK UP 标记。/songs/ 传 true；世代页不传——那页没有服务器上下文，
      整页同标或全不标都会误导。范围值本身仍写进 data-scope，筛选逻辑不受影响。 */
  markPick?: boolean;
}

const { song: s, eager = false, srv = 'jp', markPick = false } = Astro.props;
// 范围（PICK UP / COMMON）：与分区正交的第二个维度，判定在 lib/song-view.ts 的 isPickUp()，
// 这里只把它落成 data-scope 供前端筛选，顺带决定要不要画标记。
const pick = isPickUp(s, srv);
// 徽章颜色按难度固定（2026-10-22）：BSC 绿 / ADV 黄 / EXT 红；空值灰
const dash = (v: number | null) => (v == null ? '—' : String(v));
---
<article
  class="sc-card"
  data-t={s.t}
  data-a={s.a ?? ''}
  data-id={s.id}
  data-gen={s.gen}
  data-cat={catOf(s, srv)}
  data-bsc={s.lv.bsc ?? ''}
  data-adv={s.lv.adv ?? ''}
  data-ext={s.lv.ext ?? ''}
  data-lv={`${s.lv.bsc ?? ''} ${s.lv.adv ?? ''} ${s.lv.ext ?? ''}`}
  data-scope={pick ? 'pick' : 'common'}
  data-lu={s.lu ?? ''}
>
  <div class="sc-j">
    {s.cover ? (
      <img
        src={`/assets/images/jackets/${s.cover}`}
        alt=""
        width="144"
        height="144"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'low'}
        decoding="async"
      />
    ) : (
      <span class="sc-no">no jacket</span>
    )}
    {s.alt ? <span class="sc-alt">[2]</span> : null}
  </div>
  {/* PICK UP 标记（2026-10-25 主人要求）。放在曲绘下、曲名上：那里是视线从图上
      落到文字的必经点，一眼能扫到；也避开了曲绘右上角 [2] 与右下难度徽章这两处已占用位。
      只画在需要标记的页（markPick），世代页不画但 data-scope 照写。 */}
  {markPick && pick ? (
    <b class="sc-pick" title="PICK UP 曲目">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.6l2.6 5.6 6.1.7-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6L3.3 9.9l6.1-.7z"/></svg>
      <span>PICK UP</span>
    </b>
  ) : null}
  {/* 整卡可点（2026-10-22 主人指出只点标题进不去太难用）。
      做法是卡内嵌一个绝对定位铺满的 <a>，而不是把整张卡包成 <a>：
      包成 <a> 会把曲绘、双服徽章、三个难度徽章全卷进链接名里，
      读屏一次念一大串；铺满层让链接名只有曲名，点击却覆盖全卡。
      链接层放在最后以保证盖住其余内容，z-index 由 CSS 控制。 */}
  {/* 【双】徽章已移除（2026-10-24 主人：「【双】徽章可以不用」）。
      原先它标的是「日服/国服均有」，但国服视图现在收的都是已上线的日服曲（432 首旧框已有曲
      + 双服曲），几乎每张卡都带这个徽章 —— 满屏同一个标记等于没有信息量，还挤占曲名宽度。
      「两服都有」这个事实由分区（KONAMI）和详情页表达，卡片上不再重复。
      注意：s.jp && s.cn 仍参与国服视图的去重（songKey），只是不再画成徽章，也不再参与分区判定。 */}
  <b class="sc-t" title={s.t}>{s.t}</b>
  <span class="sc-a" title={s.a ?? ''}>{s.a ?? '—'}</span>
  <div class="sc-lv">
    <i class={`lv lv-bsc${s.lv.bsc == null ? ' lv-0' : ''}`}><u>BSC</u>{dash(s.lv.bsc)}</i>
    <i class={`lv lv-adv${s.lv.adv == null ? ' lv-0' : ''}`}><u>ADV</u>{dash(s.lv.adv)}</i>
    <i class={`lv lv-ext${s.lv.ext == null ? ' lv-0' : ''}`}><u>EXT</u>{dash(s.lv.ext)}</i>
  </div>
  <a class="sc-link" href={`/songs/${s.id}/`} aria-label={`${s.t}${s.a ? ' - ' + s.a : ''} 详情`}></a>
</article>
