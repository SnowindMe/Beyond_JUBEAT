---
// 首页「热门歌曲」榜（2026-11-03，原 FortuneHot 拆分而来）。
//
// 与运势块**不连接**（主人 2026-11-03 追加「中间不连着，独立成两个板块」）：
// 各自一个面板、各自一道顶部热力条、各自一个表头，中间留一个正常区块间距。
//
// 数据：读当天快照（00:05 由 cron 封好），请求里不现算名次。
// 2026-11-03 下午主人再删一层：「热门歌曲的歌不分日服和国服」——服务器这一维整个拿掉了，
// 不再过滤、不再重排，榜就是快照全局名次的前 25。
//
// 冷启动（快照未成型）时整段换成"新曲推荐"并标「热度统计中」（主人 2026-11-03 定 a）。
import '../styles/fortune.css';
import { env } from 'cloudflare:workers';
import { TOP } from '../lib/hot';
import { byIds, fallbackPool, todaySnapshot, type PoolSong } from '../lib/hotPage';

export const prerender = false;

const e = env as { beyond_jubeat?: D1Database; SESSION?: KVNamespace };
const db = e.beyond_jubeat as D1Database;

const snap = await todaySnapshot(e).catch(() => null);
const ready = !!snap && !snap.seeded;

type Row = PoolSong & { rank: number; delta: number; isNew: boolean; filled?: boolean };
const rows = snap?.entries.slice(0, TOP) ?? [];
const songs = rows.length ? await byIds(db, rows.map((r) => r.songId)).catch(() => []) : [];
const list: Row[] = rows
  .map((meta) => {
    const s = songs.find((x) => x.songId === meta.songId);
    return s ? { ...s, rank: meta.rank, delta: meta.delta, isNew: meta.isNew } : null;
  })
  .filter((r): r is Row => !!r);

/* 【补足 25 名】2026-11-03 20:10 主人「热门歌曲滚动25条」。
   以前榜多长取决于当天有多少曲被真听过（样本门槛只管「够不够 30 行」，
   过了门槛也可能只有 10 首不同的曲），于是滚动永远只有两屏、25 名白设。
   现在热度排完仍不足 TOP 时，用「最近上架」按原顺序补到 25：
   已上榜的不重复，名次接着往后排。
   真热度涨上来后这一段自然会被挤掉，不需要什么时候回头删。

   【补位行要看得出来（审计第 12 条）】2026-11-04。
   原先补位写死 delta:0 / isNew:false，界面上正好落在「名次不变」的三根暗柱上，
   读者分不出这几行是真上榜还是凑数的——「名次不变」和「还没数据」是两件事。
   现在补位另打 filled:true，槽位整格留白（不放柱也不放「新」），读屏写「新上架」。
   槽宽 22px 是固定的，留白不会让曲名左沿跳动。 */
if (ready && list.length && list.length < TOP) {
  const have = new Set(list.map((s) => s.songId));
  const extra = await fallbackPool(db, TOP).catch(() => []);
  const rest = extra.filter((id) => !have.has(id)).slice(0, TOP - list.length);
  const fill = await byIds(db, rest).catch(() => []);
  const byId = new Map(fill.map((s) => [s.songId, s]));
  for (const id of rest) {
    const s = byId.get(id);
    if (!s) continue;
    list.push({ ...s, delta: 0, isNew: false, filled: true });
  }
}

/* 【名次按行序重排】2026-11-04 主人「热门歌曲排位错乱」。
   原先直接显示快照里的 rank，而快照的 rank 是原窗口的绝对名次，
   中间一旦有曲目取不到（远端 D1 少了那几行），名次就跳号：实测线上出现过
   1…14 之后接 20、21 —— 15–19 那几首在库里查不到，被下面 filter 掉了。
   更糟的是补位行用 list.length + 1 起算，17 起头正好压到还没出场的那两个真名次上。
   名次在版面上就是行的位置，所以这里按最终行序重排 1..N：
   取不到的曲目让后面的行顶上来，补位行接着往下数，屏幕上的数字永远与位置一致。
   原快照名次只作排序依据，不再直接上台面。 */
list.forEach((r, i) => {
  r.rank = i + 1;
});

/** 一屏五行；不足六行时推到底会露空，所以那时不滚、也不补副本 */
const scrolls = list.length > 5;
/** 位移都是整屏（一屏 5 行），所以也不补副本：每一屏正好填满视窗，
 *  补了只会停在视窗之外，还让人误以为榜后面还有内容。
 *  总位移 = 最后一屏的起点，末屏（21–25 名）停止时视窗同样填满。
 *  【2026-11-04】这里只给行数，像素位移交给 CSS 的 --fh-end（按 --fh-row 算），
 *  行高不再在 JS 里写死一份。 */
const shown = list;
---

<section class="fh fh-hot" aria-labelledby="fh-hot">
  {/* 底部渐隐层：随主题在「暗角 / 白雾」之间切换，见 fortune.css 的 --fh-fade */}
  <div class="fh-fade" aria-hidden="true"></div>
  <div class="fh-hd">
    <h2 id="fh-hot">热门歌曲</h2>
    {ready && list.length ? <span class="fh-span">最近 7 天 · 前 25 名</span> : <span>{ready ? '暂无' : '待统计'}</span>}
  </div>

  {ready && list.length ? (
    <div class="fh-board">
      <div class={`fh-view ${scrolls ? 'is-rolling' : 'is-static'}`} style={`--fh-n:${list.length}`}>
        <ul class="fh-list">
          {shown.map((s, i) => (
              <li class={`fh-row${s.rank >= 4 ? ' is-low' : ''}`}>
                <span class="fh-rank">{s.rank}</span>
                <span class="fh-sr">
                  {s.isNew ? '新进榜' : s.filled ? '新上架' : s.delta > 0 ? `上升 ${s.delta} 位` : s.delta < 0 ? `下降 ${-s.delta} 位` : '名次不变'}
                </span>
                {/* 整块可点：链接层绝对定位铺满整行（只有它可聚焦、也只有一个读屏名），
                    曲名/曲绘都在层下面，不嵌套、不用给文字加下划线来暗示可点 */}
                <a class="fh-name" href={`/songs/${s.songId}/`} aria-label={`${s.title} - ${s.artist}`} />
                {/* 不用 loading="lazy"（2026-11-04 主人「未加载图片只有用户对页面有操作了才会加载」）：
                    视窗只有 260px 高、overflow hidden，25 行里 20 行落在遮挡区，
                    浏览器判定不可见就一张都不拉；等滚动把它们带进视窗已经是几秒后的事，
                    观感上就是「先空着，动一下鼠标才冒出来」。曲绘单张约 7KB、25 张不到 200KB，
                    这里省的不是带宽而是首屏正确性。 */}
                <img class="fh-cover" src={`/assets/images/jackets/${s.cover}`} alt="" width="38" height="38" decoding="async" />
                <span class="fh-txt">
                  <b>{s.title}</b>
                  <small>{s.artist}</small>
                </span>
                {/* 升降与「新」在行尾（2026-11-04 主人「要放在右边，上升下降显示出几名」）：
                    右对齐成一列，数字带正负号，上升红、下降绿（跟随中文习惯，与名次的橙分开）。 */}
                <span class="fh-tail" aria-hidden="true">
                  {s.isNew ? (
                    <span class="fh-new">新</span>
                  ) : s.filled ? null : s.delta === 0 ? (
                    <span class="fh-flat">—</span>
                  ) : (
                    <span class={`fh-delta ${s.delta > 0 ? 'fh-up' : 'fh-down'}`}>
                      {s.delta > 0 ? `↑${s.delta}` : `↓${-s.delta}`}
                    </span>
                  )}
                </span>
              </li>
          ))}
        </ul>
      </div>
    </div>
  ) : (
    <p class="fh-note">热度统计中，榜内是最近上架的曲目。</p>
  )}
</section>
