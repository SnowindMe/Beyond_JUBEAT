---
// 页内加载提示：视口最顶一条 3px 进度条（2026-10-27 主人要求「不想做成遮罩，想做成页内 loading」）。
// 改前的形态是全屏遮罩：铺满视口 + 圆孔动画 + overflow:hidden 锁滚动。问题有三个：
//   ① 每次点击导航都整页盖一层，视觉很重；② 锁滚动会让人以为页面卡住；
//   ③ 遮罩「点亮后必须有人收」——历史上出过三次「卡在 loading 页」。
// 现在改成一条不挡内容、不锁滚动的细条，三种触发共用：
//   1) 首访：从 0 走到 ~90% 的假进度，页面 load 后走满淡出
//   2) 点导航去下一页：延迟 160ms 才亮，新页来得快就完全不出现
//   3) 切世代主题：新背景/字标没命中缓存时才亮，命中就一点不闪
// 样式与脚本都 is:inline：必须首帧前生效，否则会先闪一下再出现。
---

<script is:inline>
  (function () {
    var d = document.documentElement;
    // 减少动效偏好：整条都不启动（进度条本身也属于装饰性动效）
    try {
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) {
        d.setAttribute('data-boot', 'off');
        return;
      }
    } catch (e) {}
    d.setAttribute('data-boot', 'on');
    // 首访才走「0→90%」那段假进度；同一会话里翻页不再重复。
    // 与旧版一致：这里只打标记，真正点亮交给主脚本，避免首帧就整条糊上来。
    try {
      if (sessionStorage.getItem('jb-boot') !== '1') {
        sessionStorage.setItem('jb-boot', '1');
        d.className += ' boot-first';
      }
    } catch (e) {
      d.className += ' boot-first';
    }
  })();
</script>

<style is:inline>
  /* 进度条容器：固定在最顶端，不占布局高度、不吃点击、不锁滚动。
     z-index 高于顶栏（顶栏是 50），因为它要盖在顶栏上沿那一条。 */
  .boot {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 9999;
    pointer-events: none;
    /* 常驻布局、默认全透明：display 不参与过渡，只有常驻元素才能淡出。
       visibility 延迟到淡出结束才隐藏，避免渐隐途中被提前摘掉。 */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.28s ease, visibility 0s linear 0.28s;
    /* 轨道底色跟主题走一点点，不跟也看得清；这里用半透明黑，
       深浅主题下都能衬出下面的彩色条 */
    background: rgba(0, 0, 0, 0.12);
  }
  /* 进场不写 animation/transition，改由 JS 直接设 inline style（见 show()）：
     ① 过渡在「首次显示」时会被浏览器跳过（没有已渲染的前一帧）；
     ② 动画时钟在窗口最小化/后台时冻结，实测 computed opacity 一直停在 0。
     两者都让「靠 CSS 表现进场」不可靠。进度条只有 3px，直接出现完全可接受，
     可靠性优先——和旧版看门狗那条设计取向一致。
     退场仍保留 CSS 的 opacity 过渡（那时元素已渲染过多帧、且是不是淡出并不关键），
     另有 JS 定时器兜底强制隐藏。 */
  html.boot-run .boot {
    opacity: 1;
    visibility: visible;
  }
  /* 真正的进度条：宽度由 JS 写 transform: scaleX()，走合成层、不触发布局。
     **故意不加 transition**：过渡依赖动画时钟，窗口最小化/标签页在后台时会被冻结，
     实测条宽会停在旧值不动（连 opacity 的进场过渡都推进不了）。
     条宽改由 JS 用定时器阶梯推进，任何环境下都能看到它在涨。 */
  .boot-bar {
    position: absolute;
    inset: 0;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--acc, #3ee6ff), var(--acc2, #7dfbe0));
    box-shadow: 0 0 10px color-mix(in srgb, var(--acc, #3ee6ff) 55%, transparent);
  }
  /* 顶端再叠一道更亮的细高光，让它看起来像「发光的一条」而不是色块 */
  .boot-bar::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35), transparent 70%);
  }
  /* 等待态的扫光：宽度不确定时在已填充段里来回扫，表示「还在动」。
     只在 is-wait 时出现，首访的假进度不用它。 */
  .boot.is-wait .boot-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    animation: bootSweep 1.05s ease-in-out infinite;
  }
  @keyframes bootSweep {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  /* 页面已经在走了（导航已发起）：让条子稍微亮一点，暗示「这就换页了」 */
  html.boot-out .boot {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .boot,
    html.boot-run .boot,
    html.boot-out .boot,
    .boot-bar { transition: none; }
    .boot.is-wait .boot-bar::before { animation: none; }
  }
</style>
<div class="boot" id="boot" role="status" aria-live="polite" aria-label="页面加载中">
  <div class="boot-bar" id="bootBar"></div>
</div>

<script is:inline>
(function () {
  var d = document.documentElement;
  var el = document.getElementById('boot');
  var bar = document.getElementById('bootBar');
  if (!el || !bar || d.getAttribute('data-boot') !== 'on') {
    // 关掉时给一套空实现，调用方不用判断存在性
    window.jbBoot = { show: function () {}, hide: function () {}, begin: function () { return function () {}; }, hold: function () { return function () {}; } };
    return;
  }

  var firstRun = d.classList.contains('boot-first');
  var shown = false;
  var fakeTimer = 0;   // 首访那段假进度的推进器
  var value = 0;       // 当前进度 0~1，仅用于算下一次该涨多少

  /* 看门狗：条一旦可见，最多挂 MAX_VISIBLE 毫秒，到点无条件收。
     旧版全屏遮罩靠它兜住「卡死」，现在虽然不挡内容，但一条永远在爬的进度条
     同样是错的信息（暗示还有东西没加载完），所以这道保险继续留着。 */
  var MAX_VISIBLE = 8000;
  var watchdog = 0;
  var pendingEnd = null;
  function armWatchdog() {
    clearTimeout(watchdog);
    watchdog = setTimeout(function () { hide(); }, MAX_VISIBLE);
  }

  function setBar(v) {
    value = Math.max(0, Math.min(1, v));
    bar.style.transform = 'scaleX(' + value + ')';
  }
  /* 假进度：越接近 1 涨得越慢，永远不到 100%。
     真实的加载完成时刻由 hide() 走满——这样「走满」这个动作只代表「真的好了」，
     不会出现进度条自己走满、页面却还在转的假象。 */
  function creep() {
    if (!shown) return;
    var next = value + (1 - value) * 0.16;
    if (next > 0.92) next = 0.92;
    setBar(next);
    fakeTimer = setTimeout(creep, 260 + Math.random() * 240);
  }

  var outT = 0;
  function show(waitMode) {
    if (shown) return;
    shown = true;
    armWatchdog();
    clearTimeout(outT);
    el.classList.toggle('is-wait', !!waitMode);
    d.classList.remove('boot-out');
    d.classList.add('boot-run');
    /* 直接写 inline style 点亮，不靠 CSS 动画/过渡：那两者的时钟在窗口最小化、
       标签页在后台时会被浏览器冻结，实测 computed opacity 一直停在 0。
       inline 优先级最高，CSS 里 .boot 的 opacity:0 被它覆盖。 */
    el.style.transition = 'none';
    el.style.opacity = '1';
    el.style.visibility = 'visible';
    if (waitMode) {
      // 等待态：先给一小段基础宽度，再靠扫光表达「还在动」。
      // 不爬假进度——不知道要等多久就不假装知道（和旧版进度条口径一致）。
      setBar(0.18);
    } else {
      setBar(0);
      // 下一帧再涨，让 scaleX(0) 先提交，否则首帧就是最终宽度、没有生长过程
      requestAnimationFrame(function () { creep(); });
    }
  }
  function hide() {
    if (!shown) return;
    shown = false;
    clearTimeout(watchdog);
    clearTimeout(fakeTimer);
    el.classList.remove('is-wait');
    // 收尾时走满，让「完成」有一个明确的视觉终点
    setBar(1);
    d.classList.add('boot-out');
    clearTimeout(outT);
    /* 交回 CSS 过渡做淡出（此时元素已渲染过多帧，起点是真实的、能看到渐隐）。
       随后那道 setTimeout 是**不依赖时钟的兜底**：无论过渡有没有推进，
       260ms 后一律强制隐藏，保证不会留下一条永远挂着的进度条。 */
    el.style.transition = '';
    el.style.opacity = '0';
    outT = setTimeout(function () {
      el.style.transition = 'none';
      el.style.visibility = 'hidden';
      d.classList.remove('boot-run', 'boot-out');
      setBar(0);
    }, 260);
  }
  /* 延迟显示：调用后 delay 毫秒内结束就完全不出现（缓存命中时就是这条路）。
     返回的 end() 既能「取消这次显示」也能「立刻收起」，两种调用都安全。 */
  function begin(delay) {
    var stopped = false;
    var t = setTimeout(function () { if (!stopped) show(true); }, delay == null ? 160 : delay);
    return function end() {
      stopped = true;
      clearTimeout(t);
      hide();
    };
  }
  /* 立刻亮起的等待（已经知道一定要等，比如切世代且图没缓存） */
  function hold() {
    show(true);
    var ended = false;
    return function end() { if (ended) return; ended = true; hide(); };
  }

  window.jbBoot = { show: show, hide: hide, begin: begin, hold: hold };

  /* ---- bfcache：进缓存前把条子复位，避免按 back 回来还挂着一条 ----
     旧版踩过「back 卡 loading」，根因是遮罩亮着被冻进快照。进度条虽然不挡操作，
     但一条永远在爬的条同样是坏状态，所以这条保险照留。 */
  window.addEventListener('pagehide', function (ev) {
    if (!ev.persisted) return;
    clearTimeout(outT);
    clearTimeout(watchdog);
    clearTimeout(fakeTimer);
    shown = false;
    pendingEnd = null;
    d.classList.remove('boot-run', 'boot-out', 'boot-first');
    el.classList.remove('is-wait');
    setBar(0);
  });
  window.addEventListener('pageshow', function (ev) {
    if (!ev.persisted) return;
    // 从缓存回来意味着这一页早就加载完了，条子没有任何继续存在的理由：
    // 无条件复位，并把 shown 归零，否则后续 show() 会因为 shown 仍为 true 而直接 return。
    clearTimeout(outT);
    clearTimeout(watchdog);
    clearTimeout(fakeTimer);
    shown = false;
    pendingEnd = null;
    d.classList.remove('boot-run', 'boot-out', 'boot-first');
    el.classList.remove('is-wait');
    setBar(0);
  });

  // ---- 首访：走假进度，load 后收（最短 700ms，避免一闪而过）----
  if (firstRun) {
    var t0 = (window.performance && performance.now) ? performance.now() : 0;
    var closed = false;
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { if (!closed) show(false); });
    });
    function closeBoot() {
      if (closed) return;
      closed = true;
      var left = Math.max(0, 700 - ((window.performance && performance.now ? performance.now() : 0) - t0));
      setTimeout(function () {
        d.classList.remove('boot-first');
        hide();
      }, left);
    }
    if (document.readyState === 'complete') closeBoot();
    else window.addEventListener('load', closeBoot, { once: true });
    // 兜底：3 秒还没 load 完也收（条子会自己停在 ~92%，不能永远挂着）
    setTimeout(closeBoot, 3000);
  }

  // ---- 点导航去下一页：160ms 内新页没来才亮 ----
  document.addEventListener('click', function (ev) {
    if (ev.defaultPrevented || ev.button !== 0) return;
    if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
    var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
    if (!a) return;
    if (a.target && a.target !== '_self') return;
    if (a.hasAttribute('download')) return;
    /* 被 JS 接管、点击后并不导航的链接：自己不跳，却会被这里当成「要走了」而亮条。
       实撞（v1.19.0）：顶栏账户菜单把 <a href="/account/"> 改成了开菜单的触发器，
       它 preventDefault，但本监听器挂在 document 的 capture 阶段、**比它先跑**。
       约定：这类触发器必须带 data-boot-skip（见 Header.astro 设置 aria-haspopup 那段）。 */
    if (a.hasAttribute('data-boot-skip')) return;
    var href = a.getAttribute('href');
    if (!href || href.charAt(0) === '#') return;
    if (/^(mailto:|tel:|javascript:)/i.test(href)) return;
    var url;
    try { url = new URL(a.href, location.href); } catch (e) { return; }
    if (url.origin !== location.origin) return;
    // 同页只改 hash 不算跳转
    if (url.pathname === location.pathname && url.search === location.search && url.hash) return;
    var endBoot = begin(160);
    pendingEnd = endBoot;
    // 导航本该在几十毫秒内卸载本页。若 3 秒后我们还活着，说明那次导航失败/被取消
    // （服务器 502、离线、用户按了 Esc、target 被 JS 拦下……），必须自己把条收掉。
    // 只在「本页仍然可见」时收：页面已经进后台说明导航确实在进行中。
    setTimeout(function () {
      if (document.visibilityState !== 'visible') return;
      pendingEnd = null;
      endBoot();
    }, 3000);
  }, true);
})();
</script>
