---
// 首页「今日运势」块（2026-11-03，原 FortuneHot 拆分而来）。
//
// 拆开的原因：主人 2026-11-03 追加「运势与排行榜中间不连着，独立成两个板块」。
// 两块原本共用一道竖分界、顶在同一个面板里，现在各成一个面板、各自有表头。
//
// 选项卡的最终形态（主人当日下午连续三句：先「1框可以去掉」（指难度）、
// 再「日服和国服运势保持一致」、随后「把今日运势的服务器选项卡加回来」）：
// **只留服务器一组，没有难度选项卡**。难度是每首自带属性（沉淀→BSC / 均衡→ADV /
// 挑战→EXT），徽章显示每首自己的难度与定数，不让用户再选。
//
// 【2026-11-05 改】原先三档固定各一首。现在手气是一份、三首共用，评价区间由手气压出来
// （主人：「日服和国服可以不同歌曲、不同评价，但今日手气要相同」「越高的运势评价所选择的
// 难度越高，相对应的评价区间也高」）。所以三首可能同档，档位不再与序号绑定。
//
// 做法：服务端把两服都算好并渲染成面板，客户端只切 hidden——
// 切换不走 HTTP 往返，也不丢滚动位置；同一/不同用户的两服结果各自独立抽样。
//
// 冷启动（快照未成型）时整段降级成"新曲推荐"（主人 2026-11-03 定 a）：
// 那时留着运势，会把没人听过的歌当"吉"推荐。
import '../styles/fortune.css';
import { env } from 'cloudflare:workers';
import { DIFF_LABEL, dayOf, fortuneOf, type Diff, type GradeKey, type Svr } from '../lib/hot';
import { fallbackByIds, pickFortune, todaySnapshot, fortunePool, type PoolSong } from '../lib/hotPage';
import data from '../data/data.json';

export const prerender = false;

const e = env as { beyond_jubeat?: D1Database; SESSION?: KVNamespace };
const db = e.beyond_jubeat as D1Database;

/** 当日种子。必须跟热榜同一个切日口径：两者都用 dayOf() 按 +08:00 切，
 *  否则北京时间 00:00–08:00 这八小时，运势还算"昨天"、热榜已经读"今天"。 */
const seed = dayOf();
const visitor = Astro.locals.user?.id ? 'u:' + Astro.locals.user.id : 'guest';

const snap = await todaySnapshot(e).catch(() => null);
const ready = !!snap && !snap.seeded;

/** 哪一服有曲：曲数为 0 的服不出选项卡（顺序按站点习惯，国服在前）。
 *
 *  【2026-11-04 改】两个数都是**构建期静态事实**，不再每请求查库：
 *  - stat.srv 由 scripts/build-data.cjs:137 按 server_jp / server_cn 逐条数出来，
 *    沉淀在 src/data/data.json；原先这里对 songs 表跑 SUM(CASE...) 全表扫，纯属白算。
 *  - 判空用 `> 0`：先兜 0 再判，字段缺失时按"这服没曲"处理，不会把空选项卡渲染出来。 */
const SRVS = (['cn', 'jp'] as const).filter((s) => (data.stat.srv?.[s] ?? 0) > 0);

type Pick = PoolSong & { need: GradeKey; needFloor: GradeKey; tier: string; diff: Diff; lv: number };
/** hand = 今日手气（三首共用的那一个评级），区间由每首自己的 need/needFloor 画 */
type Panel = { srv: Svr; hand: GradeKey; picks: Pick[] };

const panels: Panel[] = [];
if (ready) {
  // 运气值一份、两服共用（主人 2026-11-05：「日服和国服可以不同歌曲、不同评价，
  // 但今日手气要相同」）；难度与要求两服各自抽（同日下午「日服和国服的推荐歌曲，
  // [难度，等级，达成评价]都可以不一样」）。所以 fortuneOf 带上服名当 salt：
  // 运气值只吃 seed|visitor，两服一致；salt 只进难度与要求错位的抽样键。
  for (const srv of SRVS) {
    const lines = fortuneOf(seed, visitor, srv);
    const pool = await fortunePool(e, srv).catch(() => []);
    if (!pool.length) continue;
    const picks = pickFortune(pool, lines, seed + '|' + visitor + '|' + srv);
    // 手气取这一服的（两服的运气值相同，取哪一服都一样，但用自己这服的更好读）
    if (picks.length) panels.push({ srv, hand: lines[0].grade, picks });
  }
}

/** 冷启动的新曲推荐：最近上架 */
const freshPicks = ready ? [] : await (async () => {
  const ids = snap?.entries.slice(0, 3).map((r) => r.songId) ?? [];
  return ids.length ? fallbackByIds(db, ids) : [];
})();

/** 默认日服（站点主数据是日服，热榜选的代表也是日服那几首） */
const active = panels.find((p) => p.srv === 'jp') ?? panels[0];

const TIER_LABEL: Record<string, string> = { sediment: '沉淀', balance: '均衡', challenge: '挑战' };
/** 今日运气值 0–120（三首共用）。顶条与刻度尺都读它，所以只算一次 */
const luck = active ? active.picks[0].luck : 60;
---

<section class="fh" style={`--fh-heat:${(luck / 120) * 100}%;--fh-luck-pct:${(luck / 120) * 100}%`} aria-labelledby="fh-fortune">
  <div class="fh-fade" aria-hidden="true"></div>
  <div class="fh-hd">
    <h2 id="fh-fortune">今日运势</h2>
    {ready && panels.length > 1 ? (
      <div class="fh-ctl">
        <div class="fh-seg" role="group" aria-label="切换服务器">
          {panels.map((p) => (
            <button type="button" class={`fh-seg-b${p === active ? ' is-on' : ''}`} data-srv={p.srv} aria-pressed={p === active ? 'true' : 'false'}>
              {p.srv === 'jp' ? '日服' : '国服'}
            </button>
          ))}
        </div>
      </div>
    ) : (
      <span>{ready ? '运气一天一个' : '新曲推荐'}</span>
    )}
  </div>

  {ready && panels.length ? (
    <div class="fh-panes">
      {panels.map((p) => (
        <div class="fh-pane" data-pane={p.srv} hidden={p !== active}>
          <div class="fh-verdict">
            {/* 运气值：数字、/120 量纲、尺、两端的差/好刻字，四处是同一个数 */}
            {/* 运气值是这一块的唯一主体：读数、尺、评级印章都指同一个数。
                原来那句「今日手气 X」与印章重复，长说明也只在第一次看得懂，
                都去掉了（主人 2026-11-05 框掉）。印章贴在读数右边当色相刻度。 */}
            <span class="fh-luck">
              <span class="fh-luck-hd">
                <b>{p.picks[0].luck}</b><i>/120</i>
                <img class="fh-grado" src={`/assets/images/grade/${p.hand}.webp`} alt={`今日手气 ${p.hand.toUpperCase()}`} width="30" height="30" decoding="async" />
              </span>
              <span class="fh-luck-r" aria-hidden="true"></span>
              <span class="fh-luck-e" aria-hidden="true"><span>差</span><span>好</span></span>
            </span>
          </div>
          <ul class="fh-picks">
            {p.picks.map((s) => (
              <li class="fh-pick">
                {/* 整块可点：同热榜，链接层铺满整行，其余内容在层下面 */}
                <a class="fh-name" href={`/songs/${s.songId}/`} aria-label={`${s.title} - ${s.artist}`} />
                <img class="fh-cover" src={`/assets/images/jackets/${s.cover}`} alt="" width="38" height="38" decoding="async" />
                <span class="fh-txt">
                  <b>{s.title}</b>
                  <small>{s.artist}</small>
                </span>
                {/* 行尾簇：难度徽章 → 达成评价。徽章在评价左边（主人 2026-11-05
                    「放在评价前面」），读起来是「打这个难度、要打到这个评价」。 */}
                <span class="fh-tail">
                  <span class={`fh-lv fh-lv-${s.diff}`}>
                    <u>{DIFF_LABEL[s.diff]}</u>{s.lv}
                  </span>
                  {/* 达成评价：只留印章，不再跟「D…B」那串区间（主人 2026-11-05
                      「后面的 X…X 可以不要」）。印章是可读的评级图，所以不再另写字；
                      读屏用一句人话补全。 */}
                  <span class="fh-need" role="img" aria-label={`达成评价 ${s.need.toUpperCase()}`}>
                    <img class="fh-seal" src={`/assets/images/grade/${s.need}.webp`} alt="" aria-hidden="true" width="20" height="20" decoding="async" />
                  </span>
                </span>
                <span class="fh-sr">{TIER_LABEL[s.tier]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ) : freshPicks.length ? (
    <>
      <p class="fh-said">热度还在统计<br /><small>先看最近上架的三首。</small></p>
      <ul class="fh-picks">
        {freshPicks.map((s) => (
          <li class="fh-pick">
            <a class="fh-name" href={`/songs/${s.songId}/`} aria-label={`${s.title} - ${s.artist}`} />
            <span class="fh-tier">新曲</span>
            <img class="fh-cover" src={`/assets/images/jackets/${s.cover}`} alt="" width="38" height="38" decoding="async" />
            <span class="fh-txt">
              <b>{s.title}</b>
              <small>{s.artist}</small>
            </span>
          </li>
        ))}
      </ul>
    </>
  ) : null}
</section>

<script>
  // 只切显示，不发请求：面板全在文档里
  const seg = document.querySelector<HTMLElement>('.fh .fh-ctl');
  if (seg) {
    seg.addEventListener('click', (ev) => {
      const srv = (ev.target as HTMLElement).closest<HTMLElement>('.fh-seg-b')?.dataset.srv;
      if (!srv) return;
      document.querySelectorAll<HTMLElement>('.fh-pane').forEach((p) => {
        p.hidden = p.dataset.pane !== srv;
      });
      seg.querySelectorAll<HTMLElement>('.fh-seg-b').forEach((b) => {
        const isOn = b.dataset.srv === srv;
        b.classList.toggle('is-on', isOn);
        b.setAttribute('aria-pressed', isOn ? 'true' : 'false');
      });
    });
  }
</script>
