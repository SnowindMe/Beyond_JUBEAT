---
// 顶栏：品牌标 + 导航 + 世代主题切换（15 个世代）
// 导航只列真实存在的页面：没做的二级页不上导航，不做成指向 404 的死链。
// 加新页时 .nav-txt（宽屏）与 .nav-drawer（窄屏抽屉）两处必须同步加。
//
// 登录态（2026-10-23 加）：宽屏 .nav-txt 末尾显示「登录」或昵称，
// 抽屉里同一条；图标组 .nav-ico 加一个人形图标（窄屏入口）。
import { isStaff } from '../lib/auth';

const path = Astro.url.pathname;
const user = Astro.locals.user;
---

<header class="top">
  <a class="mark" href="/" aria-label="Beyond ↑ JUBEAT 首页"><i></i><div class="mark-x"><b>Beyond <span class="sym">↑</span> JUBEAT <span class="sym">♪</span><span class="til">~</span></b><span>Not Only Jubeat Wiki</span></div></a>
  <nav>
    {/* 窄屏导航入口：≤768px 时 .nav-txt 收起，只留这个汉堡按钮（主人 2026-10-22） */}
    <button type="button" class="nav-burger" id="navBurger" aria-expanded="false" aria-controls="navDrawer" aria-label="打开导航菜单" title="导航">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <div class="nav-txt">
      {/* 只列真的存在的页面：Jubility / Emblem / 伙伴 / 成就 等二级页还没做，
          先不上导航（主人 2026-10-22：先砍死链，以后计划做再加回来）。
          做出来一页就在 .nav-txt 和 .nav-drawer 两处同步加回一条。 */}
      <a href="/songs/" class:list={[{ on: path === '/songs/' || path.startsWith('/songs/') }]} aria-current={path.startsWith('/songs/') ? 'page' : undefined}>曲目</a><a href="/recent/" class:list={[{ on: path === '/recent/' }]} aria-current={path === '/recent/' ? 'page' : undefined}>最近更改</a>{user ? (
        <>{isStaff(user) && <a href="/admin/" class:list={[{ on: path === '/admin/' }]}>管理</a>}<a class:list={[{ on: path === '/account/' }]} href="/account/" aria-current={path === '/account/' ? 'page' : undefined}>{user.name}</a></>
      ) : (
        <a href="/login/" class:list={[{ on: path === '/login/' || path === '/register/' }]} aria-current={path === '/login/' ? 'page' : undefined}>登录</a>
      )}
    </div>
    <i class="nav-sep" aria-hidden="true"></i>
    <div class="nav-ico">
      <a class="nav-i" href="https://github.com/SnowindMe/Beyond_JUBEAT" target="_blank" rel="noopener" aria-label="GitHub 仓库" title="GitHub 仓库">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.2 20.6v-1.9c-2.7.5-3.5-1.1-3.5-1.1-.3-.9-.9-1.3-.9-1.3-.8-.5 0-.5 0-.5.9.1 1.3.9 1.3.9.7 1.3 1.9 1 2.4.8.1-.6.3-1 .5-1.2-2.2-.3-4.4-1.1-4.4-4.8 0-1.1.4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1 .8-.2 1.6-.3 2.5-.3s1.7.1 2.5.3c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.5 1 2.6 0 3.7-2.2 4.5-4.4 4.8.3.3.6.9.6 1.8v2.8"/></svg>
      </a>
      {/* 图标组同样只放真实页面。
          窄屏 .nav-txt 会整体隐藏，账户/登录必须留这个图标入口，否则手机上没法登录 */}
      <a class="nav-i nav-i-recent" href="/recent/" aria-label="最近更改" title="最近更改">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M12 7.4V12l3.1 2"/></svg>
      </a>
      <a class="nav-i nav-i-user" href={user ? '/account/' : '/login/'} aria-label={user ? `我的账户：${user.name}` : '登录'} title={user ? '我的账户' : '登录'}>
        {user ? (
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.6" r="3.6"/><path d="M4.8 20.2c0-3.6 3.2-6.4 7.2-6.4s7.2 2.8 7.2 6.4"/></svg>
        ) : (
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.6" r="3.6"/><path d="M4.8 20.2c0-3.6 3.2-6.4 7.2-6.4s7.2 2.8 7.2 6.4"/><path d="M17.4 3.4l3.2 3.2"/></svg>
        )}
      </a>
    </div>
    <div class="tsw">
      <button type="button" class="tsw-btn" id="tswBtn" aria-expanded="false" aria-haspopup="true" aria-controls="tswPop" aria-label="切换世代主题" title="切换世代主题">
        <svg class="tsw-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.6" y="3.6" width="7" height="7" rx="1.7"/><rect x="13.4" y="3.6" width="7" height="7" rx="3.5"/><rect x="3.6" y="13.4" width="7" height="7" rx="3.5"/><rect x="13.4" y="13.4" width="7" height="7" rx="1.7"/></svg>
        <svg class="tsw-car" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="tsw-pop" id="tswPop" data-open="0" role="group" aria-label="切换世代主题">
        <div class="tsw-g" id="genDock"></div>
      </div>
    </div>
  </nav>
  {/* 窄屏导航抽屉：与 .nav-txt 同一组链接，展开时覆盖在顶栏下方 */}
  <div class="nav-drawer" id="navDrawer" data-open="0" role="group" aria-label="站点导航">
    <a href="/songs/" class:list={[{ on: path.startsWith('/songs/') }]}>曲目</a>
    <a href="/recent/" class:list={[{ on: path === '/recent/' }]}>最近更改</a>
    {user ? (
      <>{isStaff(user) && <a href="/admin/" class:list={[{ on: path === '/admin/' }]}>管理</a>}<a class:list={[{ on: path === '/account/' }]} href="/account/">{user.name}</a></>
    ) : (
      <a href="/login/" class:list={[{ on: path === '/login/' || path === '/register/' }]}>登录</a>
    )}
  </div>
  <script is:inline>
    // 登录态同步：静态页在构建期生成，顶栏永远是「登录」。
    // 这里在客户端问一次 /api/auth/me，把顶栏换成「昵称 / 我的账户 / 管理」。
    // 失败静默——接口挂了不该影响页面其余部分。
    (function () {
      if (!window.fetch) return;
      fetch('/api/auth/me', { credentials: 'same-origin', headers: { accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          var u = d && d.user;
          if (!u) return; // 游客：保持「登录」不变
          // 宽屏文字链接：把「登录」换成 昵称，前面插「管理」（staff 才有）
          var navTxt = document.querySelector('.nav-txt');
          var drawer = document.getElementById('navDrawer');
          function fill(box, sep) {
            if (!box) return;
            var login = box.querySelector('a[href="/login/"]');
            if (!login) return;
            if (u.staff) {
              var man = document.createElement('a');
              man.href = '/admin/';
              man.textContent = '管理';
              login.parentNode.insertBefore(man, login);
            }
            login.href = '/account/';
            login.textContent = u.name;
            login.setAttribute('aria-current', location.pathname === '/account/' ? 'page' : 'false');
          }
          fill(navTxt);
          fill(drawer);
          // 图标入口：href 与 aria-label 换成账户
          var ico = document.querySelector('.nav-i-user');
          if (ico) {
            ico.href = '/account/';
            ico.setAttribute('aria-label', '我的账户：' + u.name);
            ico.title = '我的账户';
          }
        })
        .catch(function () {});
    })();
  </script>
  <script is:inline>
    // 汉堡菜单：只在窄屏出现。点按钮切 data-open，点链接/点外部/Esc 关闭。
    (function () {
      var btn = document.getElementById('navBurger');
      var drawer = document.getElementById('navDrawer');
      if (!btn || !drawer) return;
      function set(open) {
        drawer.setAttribute('data-open', open ? '1' : '0');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
      }
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        set(drawer.getAttribute('data-open') !== '1');
      });
      drawer.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('a')) set(false);
      });
      document.addEventListener('click', function (e) {
        if (drawer.getAttribute('data-open') !== '1') return;
        if (drawer.contains(e.target) || btn.contains(e.target)) return;
        set(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && drawer.getAttribute('data-open') === '1') {
          set(false);
          btn.focus();
        }
      });
    })();
  </script>
</header>