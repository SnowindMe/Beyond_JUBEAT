---
// 顶栏：品牌标 + 导航 + 世代主题切换（点击弹出 13 个世代）
// 只有真的存在的二级页才标当前项；施工中的条目指向真实路径、落进自定义 404。
const path = Astro.url.pathname;
---

<header class="top">
  <a class="mark" href="/" aria-label="Beyond ↑ JUBEAT 首页"><i></i><div class="mark-x"><b>Beyond <span class="sym">↑</span> JUBEAT <span class="sym">♪</span><span class="til">~</span></b><span>Not Only Jubeat Wiki</span></div></a>
  <nav>
    {/* 窄屏导航入口：≤768px 时 .nav-txt 收起，只留这个汉堡按钮（主人 2026-10-22） */}
    <button type="button" class="nav-burger" id="navBurger" aria-expanded="false" aria-controls="navDrawer" aria-label="打开导航菜单" title="导航">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <div class="nav-txt">
      {/* 二级页面都还没做：指向真实路径，落进自定义 404（施工中）而不是原地不动 */}
      <a href="/songs/" class:list={[{ on: path === '/songs/' }]} aria-current={path === '/songs/' ? 'page' : undefined}>曲目</a><a href="/jubility/">Jubility</a><a href="/emblem/">Emblem</a><a href="/partners/">伙伴</a><a href="/achievements/">成就</a><a href="/recent/" class:list={[{ on: path === '/recent/' }]} aria-current={path === '/recent/' ? 'page' : undefined}>最近更改</a>
    </div>
    <i class="nav-sep" aria-hidden="true"></i>
    <div class="nav-ico">
      <a class="nav-i" href="https://github.com/SnowindMe/Beyond_JUBEAT" target="_blank" rel="noopener" aria-label="GitHub 仓库" title="GitHub 仓库">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.2 20.6v-1.9c-2.7.5-3.5-1.1-3.5-1.1-.3-.9-.9-1.3-.9-1.3-.8-.5 0-.5 0-.5.9.1 1.3.9 1.3.9.7 1.3 1.9 1 2.4.8.1-.6.3-1 .5-1.2-2.2-.3-4.4-1.1-4.4-4.8 0-1.1.4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1 .8-.2 1.6-.3 2.5-.3s1.7.1 2.5.3c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.5 1 2.6 0 3.7-2.2 4.5-4.4 4.8.3.3.6.9.6 1.8v2.8"/></svg>
      </a>
      <a class="nav-i" href="/about/" aria-label="关于" title="关于">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M12 11v5.2"/><circle cx="12" cy="8.1" r=".9" fill="currentColor" stroke="none"/></svg>
      </a>
      <a class="nav-i" href="/login/" aria-label="登录" title="登录">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.2" r="3.6"/><path d="M4.8 20c.6-3.5 3.7-5.5 7.2-5.5s6.6 2 7.2 5.5"/></svg>
      </a>
      {/* 窄屏 .nav-txt 会整体隐藏，最近更改只留这个图标入口 */}
      <a class="nav-i nav-i-recent" href="/recent/" aria-label="最近更改" title="最近更改">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M12 7.4V12l3.1 2"/></svg>
      </a>
    </div>
    <div class="tsw">
      <button type="button" class="tsw-btn" id="tswBtn" aria-expanded="false" aria-haspopup="true" aria-controls="tswPop" aria-label="切换世代主题" title="切换世代主题">
        <svg class="tsw-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.6" y="3.6" width="7" height="7" rx="1.7"/><rect x="13.4" y="3.6" width="7" height="7" rx="3.5"/><rect x="3.6" y="13.4" width="7" height="7" rx="3.5"/><rect x="13.4" y="13.4" width="7" height="7" rx="1.7"/></svg>
        <svg class="tsw-car" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="tsw-pop" id="tswPop" data-open="0" role="group" aria-label="切换世代主题">
        <div class="tsw-g" id="genDock"></div>
      </div>
    </div>
  </nav>
  {/* 窄屏导航抽屉：与 .nav-txt 同一组链接，展开时覆盖在顶栏下方 */}
  <div class="nav-drawer" id="navDrawer" data-open="0" role="group" aria-label="站点导航">
    <a href="/songs/" class:list={[{ on: path === '/songs/' }]}>曲目</a>
    <a href="/jubility/">Jubility</a>
    <a href="/emblem/">Emblem</a>
    <a href="/partners/">伙伴</a>
    <a href="/achievements/">成就</a>
    <a href="/recent/" class:list={[{ on: path === '/recent/' }]}>最近更改</a>
  </div>
  <script is:inline>
    // 汉堡菜单：只在窄屏出现。点按钮切 data-open，点链接/点外部/Esc 关闭。
    (function () {
      var btn = document.getElementById('navBurger');
      var drawer = document.getElementById('navDrawer');
      if (!btn || !drawer) return;
      function set(open) {
        drawer.setAttribute('data-open', open ? '1' : '0');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
      }
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        set(drawer.getAttribute('data-open') !== '1');
      });
      drawer.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('a')) set(false);
      });
      document.addEventListener('click', function (e) {
        if (drawer.getAttribute('data-open') !== '1') return;
        if (drawer.contains(e.target) || btn.contains(e.target)) return;
        set(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && drawer.getAttribute('data-open') === '1') {
          set(false);
          btn.focus();
        }
      });
    })();
  </script>
</header>