---
// 顶栏：品牌标 + 导航 + 世代主题切换（13 个世代 / 15 套主题：
//   世代是曲库口径（src/lib/gens.ts 的 GEN_ORDER 13 条，含国服音乐魔方）；
//   主题是视觉皮肤（ThemeScript 的 GEN 数组 15 条，clan 一个世代拆成 4 套）。两个数别混用）
// 导航只列真实存在的页面：没做的二级页不上导航，不做成指向 404 的死链。
// 加新页时 .nav-txt（宽屏）与 .nav-drawer（窄屏抽屉）两处必须同步加。
//
// 登录态（2026-10-23 加）：宽屏 .nav-txt 末尾显示「登录」或昵称，
// 抽屉里同一条；图标组 .nav-ico 加一个人形图标（窄屏入口）。
import { isStaff } from '../lib/auth';

const path = Astro.url.pathname;
const user = Astro.locals.user;
---

<header class="top">
  {/* translate="no"：品牌名不能被浏览器自动翻译拆坏（Beyond ↑ JUBEAT ♪~ 拆开就失去标识性） */}
  <a class="mark" href="/" aria-label="Beyond ↑ JUBEAT 首页" translate="no"><i></i><div class="mark-x"><b>Beyond <span class="sym">↑</span> JUBEAT <span class="sym">♪</span><span class="til">~</span></b><span translate="no">Not Only Jubeat Wiki</span></div></a>
  <nav>
    {/* 窄屏导航入口：≤768px 时 .nav-txt 收起，只留这个汉堡按钮（主人 2026-10-22） */}
    <button type="button" class="nav-burger" id="navBurger" aria-expanded="false" aria-controls="navDrawer" aria-label="打开导航菜单" title="导航">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <div class="nav-txt">
      {/* 只列真的存在的页面：Emblem / 伙伴 / 成就 等二级页还没做，先不上导航
          （主人 2026-10-22：先砍死链，以后计划做再加回来）。
          做出来一页就在 .nav-txt 和 .nav-drawer 两处同步加回一条。
          导航文字链：曲目 / Jubility / 最近更改（2026-10-26 加 Jubility，放在曲目后面）。
          账户相关（登录 / 管理 / 昵称）全部收进右侧人形图标的
          账户菜单——主人 2026-10-25 的两次要求：「标记一可以不要，全部整合进标记二里」
          「标记1的【登录】也不要」。所以这里是白的，游客也只走图标进 /login/。
          窄屏抽屉里仍保留一条文字入口（抽屉是手机上的主入口，图标在 ≤414px 那一档
          会被收窄，留一条文字更稳）。 */}
      <a href="/songs/" class:list={[{ on: path === '/songs/' || path.startsWith('/songs/') }]} aria-current={path.startsWith('/songs/') ? 'page' : undefined}>曲目</a><a href="/jubility/" class:list={[{ on: path === '/jubility/' || path.startsWith('/jubility/') }]} aria-current={path.startsWith('/jubility/') ? 'page' : undefined}>Jubility</a><a href="/recent/" class:list={[{ on: path === '/recent/' }]} aria-current={path === '/recent/' ? 'page' : undefined}>最近更改</a>
    </div>
    <i class="nav-sep" aria-hidden="true"></i>
    <div class="nav-ico">
      <a class="nav-i nav-i-github" href="https://github.com/SnowindMe/Beyond_JUBEAT" target="_blank" rel="noopener" aria-label="GitHub 仓库" title="GitHub 仓库">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.2 20.6v-1.9c-2.7.5-3.5-1.1-3.5-1.1-.3-.9-.9-1.3-.9-1.3-.8-.5 0-.5 0-.5.9.1 1.3.9 1.3.9.7 1.3 1.9 1 2.4.8.1-.6.3-1 .5-1.2-2.2-.3-4.4-1.1-4.4-4.8 0-1.1.4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1 .8-.2 1.6-.3 2.5-.3s1.7.1 2.5.3c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.5 1 2.6 0 3.7-2.2 4.5-4.4 4.8.3.3.6.9.6 1.8v2.8"/></svg>
      </a>
      {/* 图标组同样只放真实页面。
          窄屏 .nav-txt 会整体隐藏，账户/登录必须留这个图标入口，否则手机上没法登录 */}
      <a class="nav-i nav-i-recent" href="/recent/" aria-label="最近更改" title="最近更改">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M12 7.4V12l3.1 2"/></svg>
      </a>
      {/* 账户入口（2026-10-25 主人：「标记一可以不要，全部整合进标记二里」）：
          登录后不再在导航里摊开「管理 / 昵称」，全部收进这个人形图标的菜单，
          样式对齐图二那种下拉（顶部账号信息 → 菜单项 → 分隔线 → 红色退出登录）。
          游客仍是一个直达 /login/ 的普通链接，不需要 JS 也能用。 */}
      <div class="acm" id="acm">
        <a class="nav-i nav-i-user" id="acmBtn" href={user ? '/account/' : '/login/'} aria-label={user ? `账户：${user.name}` : '登录'} title={user ? '账户' : '登录'}>
          {user ? (
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.6" r="3.6"/><path d="M4.8 20.2c0-3.6 3.2-6.4 7.2-6.4s7.2 2.8 7.2 6.4"/></svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.6" r="3.6"/><path d="M4.8 20.2c0-3.6 3.2-6.4 7.2-6.4s7.2 2.8 7.2 6.4"/><path d="M17.4 3.4l3.2 3.2"/></svg>
          )}
        </a>
        <div class="acm-pop" id="acmPop" data-open="0" role="menu" aria-label="账户菜单"></div>
      </div>
    </div>
    <div class="tsw">
      <button type="button" class="tsw-btn" id="tswBtn" aria-expanded="false" aria-haspopup="true" aria-controls="tswPop" aria-label="切换世代主题" title="切换世代主题">
        <svg class="tsw-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.6" y="3.6" width="7" height="7" rx="1.7"/><rect x="13.4" y="3.6" width="7" height="7" rx="3.5"/><rect x="3.6" y="13.4" width="7" height="7" rx="3.5"/><rect x="13.4" y="13.4" width="7" height="7" rx="1.7"/></svg>
        <svg class="tsw-car" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="tsw-pop" id="tswPop" data-open="0" role="group" aria-label="切换世代主题">
        <div class="tsw-g" id="genDock"></div>
      </div>
    </div>
  </nav>
  {/* 窄屏导航抽屉：与 .nav-txt 同一组链接，展开时覆盖在顶栏下方 */}
  <div class="nav-drawer" id="navDrawer" data-open="0" role="group" aria-label="站点导航">
    <a href="/songs/" class:list={[{ on: path.startsWith('/songs/') }]}>曲目</a>
    <a href="/jubility/" class:list={[{ on: path.startsWith('/jubility/') }]}>Jubility</a>
    <a href="/recent/" class:list={[{ on: path === '/recent/' }]}>最近更改</a>
    {user ? (
      <>{isStaff(user) && <a href="/admin/" class:list={[{ on: path === '/admin/' }]}>管理</a>}<a class:list={[{ on: path === '/account/' }]} href="/account/">{user.name}</a></>
    ) : (
      <a href="/login/" class:list={[{ on: path === '/login/' || path === '/register/' }]}>登录</a>
    )}
    {/* 窄屏把顶栏的 GitHub 图标收进抽屉：44×44 的图标组在 390px 宽里挤不下，
        但要保留入口，所以抽屉里补一条文字链接（桌面抽屉永不显示，不影响宽屏）。 */}
    <a href="https://github.com/SnowindMe/Beyond_JUBEAT" target="_blank" rel="noopener">GitHub 仓库</a>
  </div>
  <script is:inline>
    // 登录态同步 + 账户菜单（2026-10-25 主人要求：导航里的「管理 / 昵称」不要了，
    // 全部收进右侧人形图标的下拉菜单，样式对齐图二：顶部账号信息 → 菜单项 → 分隔线 → 红色退出）。
    //
    // 为什么菜单是 JS 建的而不是服务端渲染：本站绝大多数页是构建期预渲染的静态 HTML，
    // 生成时没有会话，顶栏永远是游客态（见 /api/auth/me 里同一段说明）。
    // 所以按钮在 HTML 里就是一个普通链接（游客直达 /login/，无 JS 也能用），
    // 登录后脚本再把它升级成「点开菜单」。
    (function () {
      if (!window.fetch) return;
      var pop = document.getElementById('acmPop');
      var btn = document.getElementById('acmBtn');
      var box = document.getElementById('acm');
      if (!pop || !btn || !box) return;

      var ROLE = { player: '玩家', maintainer: '维护者', owner: '站长' };

      /* 菜单结构：header(id) + 项目组 + footer(退出登录)。
         只放真实存在的页面——本站没有「配置/账单/外观/语言/时区」这些项，
         照图二硬塞进去就是死链或空壳，宁可少放。 */
      function build(u) {
        pop.innerHTML = '';

        var head = document.createElement('div');
        head.className = 'acm-id';
        var nm = document.createElement('b');
        nm.textContent = u.name;
        var rl = document.createElement('span');
        rl.textContent = ROLE[u.role] || '玩家';
        head.appendChild(nm);
        head.appendChild(rl);
        pop.appendChild(head);

        var list = document.createElement('div');
        list.className = 'acm-list';
        function item(href, text, on) {
          var a = document.createElement('a');
          a.href = href;
          a.setAttribute('role', 'menuitem');
          a.textContent = text;
          if (on) a.className = 'on';
          list.appendChild(a);
          return a;
        }
        var here = location.pathname;
        item('/account/', '我的账户', here === '/account/');
        if (u.staff) item('/admin/', '管理后台', here === '/admin/' || here.indexOf('/admin/') === 0);
        pop.appendChild(list);

        var sep = document.createElement('div');
        sep.className = 'acm-sep';
        pop.appendChild(sep);

        var foot = document.createElement('div');
        foot.className = 'acm-list acm-foot';
        // 退出必须是 POST：/api/auth/logout 只接受 POST（防 CSRF 的 GET 预取，
        // 浏览器/爬虫随手 GET 一次就会被踢下线）。所以这里用一个真表单提交。
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '/api/auth/logout';
        var b = document.createElement('button');
        b.type = 'submit';
        b.className = 'acm-out';
        b.setAttribute('role', 'menuitem');
        b.textContent = '退出登录';
        form.appendChild(b);
        foot.appendChild(form);
        pop.appendChild(foot);
      }

      /* 开合：与主题切换器同一套行为——点按钮切、点外部关、Esc 关并把焦点还回按钮。
         关闭态靠 CSS 的 visibility（延后到淡出走完），不额外加 hidden 属性：
         两套机制叠加会让「重开」那一帧丢掉过渡（display 从 none 回来不跑 transition）。 */
      function setOpen(v, opts) {
        pop.setAttribute('data-open', v ? '1' : '0');
        btn.setAttribute('aria-expanded', v ? 'true' : 'false');
        if (v) {
          var first = pop.querySelector('a,button');
          if (first) first.focus();
        } else if (!opts || opts.returnFocus !== false) {
          var act = document.activeElement;
          if (!act || act === document.body || pop.contains(act)) btn.focus();
        }
      }

      var isOpen = function () { return pop.getAttribute('data-open') === '1'; };

      fetch('/api/auth/me', { credentials: 'same-origin', headers: { accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          var u = d && d.user;
          if (!u) return; // 游客：保持直达 /login/ 的普通链接
          build(u);
          btn.href = '/account/';
          btn.setAttribute('aria-label', '账户菜单：' + u.name);
          btn.setAttribute('aria-haspopup', 'true');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-controls', 'acmPop');
          btn.title = '账户菜单';
          /* 这个 <a> 已经不是链接了，是开菜单的按钮。必须打标记，否则
             BootScreen 的 document-capture 点击监听器会先于我们的 preventDefault 看到
             href，误判成「要跳走」并点亮 LOADING 遮罩（实撞：点账户菜单闪 loading）。 */
          btn.setAttribute('data-boot-skip', '');

          // 点按钮 = 开菜单，不再是跳转（但 href 留着，中键/新标签仍可直达账户页）
          btn.addEventListener('click', function (ev) {
            ev.preventDefault();
            ev.stopPropagation();
            setOpen(!isOpen());
          });
          document.addEventListener('click', function (ev) {
            if (!isOpen()) return;
            if (box.contains(ev.target)) return;
            setOpen(false, { returnFocus: false });
          });
          document.addEventListener('keydown', function (ev) {
            if (ev.key === 'Escape' && isOpen()) {
              setOpen(false);
              btn.focus();
            }
          });
          // 窄屏抽屉里的「昵称」也直接指向账户页（抽屉不放大菜单，省一次点击）
          var drawer = document.getElementById('navDrawer');
          if (drawer) {
            var login = drawer.querySelector('a[href="/login/"]');
            if (login) {
              if (u.staff) {
                var man = document.createElement('a');
                man.href = '/admin/';
                man.textContent = '管理后台';
                login.parentNode.insertBefore(man, login);
              }
              login.href = '/account/';
              login.textContent = u.name;
            }
          }
        })
        .catch(function () {});
    })();
  </script>
  <script is:inline>
    // 汉堡菜单：只在窄屏出现。点按钮切 data-open，点链接/点外部/Esc 关闭。
    (function () {
      var btn = document.getElementById('navBurger');
      var drawer = document.getElementById('navDrawer');
      if (!btn || !drawer) return;
      function set(open) {
        drawer.setAttribute('data-open', open ? '1' : '0');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
      }
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        set(drawer.getAttribute('data-open') !== '1');
      });
      drawer.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('a')) set(false);
      });
      document.addEventListener('click', function (e) {
        if (drawer.getAttribute('data-open') !== '1') return;
        if (drawer.contains(e.target) || btn.contains(e.target)) return;
        set(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && drawer.getAttribute('data-open') === '1') {
          set(false);
          btn.focus();
        }
      });
    })();
  </script>
</header>