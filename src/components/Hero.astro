---
// 首屏：标语 + 字标 + 数据统计 + 世代曲绘立方体
import data from '../data/data.json';
const LOGOS = ['ave','bta','knit','copious','saucer','saucerfulfill','prop','qubell','clan','festo','ripples'];
const jacket = (c) => '/assets/images/jackets/' + String(c || '').split('/').pop();
// 首屏曲绘墙：16 张按 8 + 8 分成上下两条轨道（2026-10-27 主人要求窄屏双行滑动）。
// 宽屏仍是 4×4 方阵（.cube-r 用 display:contents 摊平），窄屏才变成两条反向滚动的行。
const hero16 = data.gen.find((g) => g.k === 'Ave.')?.top16 ?? [];
const heroRows = [hero16.slice(0, 8), hero16.slice(8, 16)];
---

<script is:inline define:vars={{ cubeData: data.gen.reduce((m, g) => {
  if (g.top16?.length) m[g.k] = g.top16.map((s) => ({ c: s.cover, t: s.t, e: s.lv?.ext ?? null }));
  return m;
}, {}) }}>
  // 首屏立方体：主题世代 → 该世代定数最高的 16 首。
  // 为什么用 define:vars 而不是 <script type="application/json">：
  // 后者要再 JSON.parse 一次、且 Astro 对 set:html 的 JSON 里尖括号转义有坑；
  // define:vars 直接把对象序列化进脚本，最省事。
  //
  // 【为什么放在<head>前的同步脚本里】主题是在 HTML 解析早期由 ThemeScript 设的
  // data-g；若这里等到 DOMContentLoaded 才换，会先闪一下 ave 那 16 张再跳成目标世代。
  // 但此时 #cubeGrid 还不存在，所以这里只做「记录」，真正替换由 cube-apply 调用。
  window.__cubeData = cubeData;
</script>

<section class="hero">
  <div>
    {/* h1 里唯一有文字的是 .word-t，但 15 套世代主题都用 display:none 把它藏掉，
        字标图又是 aria-hidden + alt=""，结果 h1 的可访问名是空字符串（实测 AX name: ""）。
        aria-label 补一个稳定可读名，别指望视觉字标能读出来。 */}
    {/* 字标 img 补上 width/height：不带尺寸时图片没解码完高度是 0（实测 box 285×0），
        整块首屏会在图到货的瞬间往下跳。世代字标宽高比各不相同（ave 284×210、
        ripples 570×171、yymf 1180×593），所以真正的占位比例由 CSS 按 data-g
        写在 .word-l 的 aspect-ratio 上；这组属性只是给「还没应用主题」的那一帧兜底。 */}
    {/* 首屏标题行（2026-10-26 主人点子的落地）：
        原来「字标」和「WELCOME TO jubeat ~」是上下两块，各说一遍 jubeat。
        现在拼成同一行：WELCOME TO 作前缀大字，世代字标图直接充当 jubeat 这个词，
        （末尾的 ~ 已于 2026-10-27 按主人要求去掉）。字标图里含各代装饰（圆弧、菱形、色条、副标题），所以用
        --bh/--bc 两个按世代量出来的比例，只把「jubeat 字身带」对齐到文字基线上，
        装饰自然溢出到行外——这就是「联动」的手感。
        h1 仍保留完整可访问名（字标图是 aria-hidden + alt=""）。 */}
    <h1 class="word" id="wordMark" aria-label="欢迎来到 jubeat 音乐魔方"><span class="word-t" aria-hidden="true">jubeat</span><span class="word-line"><span class="wl-pre" aria-hidden="true">WELCOME TO</span><span class="word-l" aria-hidden="true"><img id="wordLogo" alt="" width="285" height="210" decoding="async" fetchpriority="high" /></span></span></h1>
    {/* 字标图紧跟 img 就地设 src：HTML 里不写 src 就不会先下 ave，再由主题脚本换成保存的世代。
        这段必须紧贴 img（is:inline 同步执行），否则浏览器已按空 src 判定过一次。 */}
    <script is:inline>
      (function () {
        var g = document.documentElement.getAttribute('data-g') || 'ave';
        var el = document.getElementById('wordLogo');
        if (el) el.src = '/assets/images/logo/' + (g.indexOf('clan_') === 0 ? 'clan' : g) + '.webp';
      })();
    </script>
    {/* 原 .welcome（WELCOME TO jubeat ~ 独立一行）已并入上面的 h1 标题行，此处不再重复。 */}
    <div class="sub"><i></i>音乐魔方</div>
    {/* 统计卡四连（曲目/谱面/世代/EXT≥10）已于 2026-10-27 按主人要求删除：
        这一排和右侧曲绘墙的信息重复（曲目数在 .cube-sum 里也有一份），
        首屏留白反而更干净。theme.css 里 .stats/.st 的规则一并清掉。 */}
  </div>
  {/*
    曲绘立方体（2026-10-25 改）：
    原来是「每个世代一张代表曲」共 13 格、且切主题不变化。
    主人要求：显示**当前主题世代的 16 首**（clan 主题就显示 16 首 clan 的曲），按定数大到小。
    所以服务端把 13 个世代各备一份 top16，这里先渲染默认世代那一份，
    其余由 ThemeScript 在切换时整体替换（数据塞进 JSON 一次性带过去，切换时不发请求）。
  */}
  <div class="cubewrap" data-cube>
    <div class="cube" id="cubeGrid" data-cube-grid>
      {heroRows.map((row, ri) => (
        <div class:list={['cube-r', ri === 0 ? 'cube-r-a' : 'cube-r-b']}>
          {row.map((s, i) => (
            <i>
              <img src={jacket(s.cover)} alt={s.t} width="144" height="144"
                   loading="eager" decoding="async" fetchpriority={ri === 0 && i < 4 ? 'high' : 'auto'} />
            </i>
          ))}
          {/* 复制一份当接缝：窄屏横滑到 -50% 时首尾正好接上（宽屏 display:none）。
              用 aria-hidden + 空 alt，读屏不会把曲名念两遍。 */}
          {row.map((s) => (
            <i data-dup aria-hidden="true">
              <img src={jacket(s.cover)} alt="" width="144" height="144" loading="eager" decoding="async" />
            </i>
          ))}
        </div>
      ))}
    </div>
    {/* 总数格移出 4×4 网格（2026-10-25）：16 张曲绘正好排满 4 行 4 列，
        原来的总数格是第 17 格，会孤零零占第 5 行第一列，看着像个坏格。
        改成网格下方独立一条横条，信息更清楚、也不破坏方阵。 */}
    <div class="cube-sum"><b>{data.stat.songs}</b><span>曲</span></div>
  </div>

  <script is:inline>
    // 按当前主题世代重绘 16 张曲绘。
    // 由 ThemeScript 的 commit() 在设置完 data-g 之后调用（见那边的注释），
    // 也在首屏执行一次，覆盖「主题是上次保存的、和 SSR 默认世代不一致」的情况。
    //
    // 【为什么只换 innerHTML 而不改 DOM 结构】16 张图 + 1 个总数格是固定布局，
    // 曲绘张数恒为 16（每个世代都够 16 首，已由 build-data 保证），
    // 所以整块重写最省事，也不用维护 diff 逻辑。
    //
    // 【切代主题（clan Red/Blue/Green/Purple）都映射到 clan 这一批曲】
    // 主题 key 是 15 套，世代 slug 是 13 个，clan 的四个主题共用 clan 世代。
    (function () {
      // 【关键：主题 key ≠ 世代名，必须整张表映射】
      // ThemeScript 的 key 是「主题皮肤」层（bta / qubell / yymf / clan_red… 共 15 套），
      // 而 data.json 的 gen.k 是「世代」层（beyond the Ave. / Qubell / 音乐魔方 / clan… 共 13 个）。
      // 两层名字几乎都不同，只写 clan 的别名会取不到数据 → 网格被清空（本轮实测 cells:0）。
      // 15 条映射一一对应，已用脚本核对全部命中。
      var THEME2GEN = {
        jubeat: 'jubeat', ripples: 'ripples', knit: 'knit', copious: 'copious', saucer: 'saucer',
        saucerfulfill: 'saucer fulfill', prop: 'prop', qubell: 'Qubell',
        clan_red: 'clan', clan_blue: 'clan', clan_green: 'clan', clan_purple: 'clan',
        festo: 'festo', ave: 'Ave.', bta: 'beyond the Ave.', yymf: '音乐魔方'
      };
      function applyCube(themeKey) {
        var grid = document.getElementById('cubeGrid');
        var data = window.__cubeData;
        if (!grid || !data) return;
        var key = THEME2GEN[themeKey] || themeKey;
        var list = data[key] || data['Ave.'];
        // 取不到就保持现状，**绝不清空**：清空会出现"一格都没有"的空方阵，
        // 比显示旧内容糟糕得多（本轮第一版就是这么踩的，cells:0）。
        if (!list || !list.length) return;
        // 总数格已移出网格（见下方 .cube-sum），这里只重写曲绘格。
        // 结构必须和 SSR 那份完全一致：8 + 8 两条轨道，每条再复制一段做接缝
        // （窄屏横向滚动的 -50% 落点）。宽屏 .cube-r 是 display:contents，
        // 复制段 display:none，所以 4×4 方阵照样成立。
        var half = Math.ceil(list.length / 2);
        var rows = [list.slice(0, half), list.slice(half)];
        var html = '';
        for (var r = 0; r < rows.length; r++) {
          var one = '', dup = '';
          for (var i = 0; i < rows[r].length; i++) {
            var s = rows[r][i];
            if (!s.c) continue; // 没有曲绘的跳过（宁可少一格也不出裂图）
            one += '<i><img src="/assets/images/jackets/' + s.c + '" alt="' + String(s.t).replace(/"/g, '&quot;') +
                   '" width="144" height="144" loading="eager" decoding="async"></i>';
            dup += '<i data-dup aria-hidden="true"><img src="/assets/images/jackets/' + s.c +
                   '" alt="" width="144" height="144" loading="eager" decoding="async"></i>';
          }
          html += '<div class="cube-r ' + (r === 0 ? 'cube-r-a' : 'cube-r-b') + '">' + one + dup + '</div>';
        }
        grid.innerHTML = html;
      }
      window.jbCube = applyCube;
      // 首屏立即执行一次：SSR 渲染的是 ave 那 16 张，但用户上次可能停在别的主题。
      // 本脚本在 #cubeGrid 之后，且 ThemeScript 早已设好 data-g，所以直接读它重绘，
      // 避免「先看到 ave 再跳成目标世代」。
      applyCube(document.documentElement.getAttribute('data-g') || 'ave');
    })();
  </script>

</section>