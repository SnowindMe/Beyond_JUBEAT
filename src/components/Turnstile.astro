---
// Cloudflare Turnstile 人机验证组件。
// 用法：<Turnstile />（放在 <form> 里即可，脚本会自动往最近的 form 注入隐藏字段 cf-turnstile-response）
//
// 为什么要自己包一层而不是直接在页面里贴 script：
//   ① site key 要走环境变量/构建常量，不能散落在页面里；
//   ② widget 是异步加载的，需要占住高度防止表单跳动（.au-turn 的 min-height）；
//   ③ 提交时 token 是一次性的，出错重试必须 reset，否则会被判「已使用」。
//
// 模式：Managed（主人 2026-10-23 选）——CF 自动判断是否出挑战，多数用户无感。
// site key 来自 src/lib/turnstile-config.ts（公开值，写死进仓库少一个配置出错点）。
import { TURNSTILE_SITE_KEY, TURNSTILE_ENABLED } from '../lib/turnstile-config';

const siteKey = TURNSTILE_ENABLED ? TURNSTILE_SITE_KEY : '';
---

{siteKey ? (
  <div class="au-turn cf-turnstile" data-sitekey={siteKey} data-theme="auto" data-size="flexible"></div>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
) : null}

<script is:inline>
  // 表单提交时如果 token 还没生成，拦一下并提示（Turnstile 加载失败/未完成挑战）。
  // 注意：只在有 widget 的页面挂，避免影响其它表单。
  (function () {
    var form = document.currentScript && document.currentScript.closest('form');
    if (!form || !form.querySelector('.cf-turnstile')) return;
    form.addEventListener('submit', function (e) {
      var input = form.querySelector('[name="cf-turnstile-response"]');
      if (input && !input.value) {
        e.preventDefault();
        var alert = form.querySelector('.au-alert');
        if (!alert) {
          alert = document.createElement('p');
          alert.className = 'au-alert';
          form.insertBefore(alert, form.firstChild);
        }
        alert.textContent = '人机验证还没完成，请稍等一下再提交。';
      }
    });
  })();
</script>
