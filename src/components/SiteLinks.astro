---
// 首页 · 相关站点：友链 / 数据来源 / 设计参考（2026-11-01 主人要求，2026-11-02 改为胶囊容器）
// 主人原话：「在黄线处添加一个div，用来存放友链，数据来源，设计参考的网址」
//        → 「小字解释不用了」「做美观一些」「可以加图标」
//        → 「相关站点这样设计太占地方了，能否将站点设计成一个个小胶囊放进一个容器里展示（友链胶囊就设置成金色）」
//
// 【设计取向】这是索引性质的区块，读者只想快点找到「去哪查资料」：
//   · 一个容器收三组，每组一行：标签 + 胶囊流（原先是三栏竖清单，11 条各占 30px 行）；
//   · 胶囊 = 图标 + 名字，横向 wrap，整块高度从约 250px 降到约 150px；
//   · 友链是全块唯一的彩色强调（金色）——它是最主要的出口，其余两组让位给它；
//   · 没有网址的条目用虚线胶囊（.links-nolink），不做点不动的死链。
//
// 【图标规范】与站内既有 SVG 一致：viewBox 24×24、stroke 描边、fill:none、
// aria-hidden（名字已在旁边，图标不重复朗读）。不引入图标库。
type Link = { name: string; url: string; icon: IconKey };

/** 图标 key → 路径数据。按站点性质分：谱面站用网格、wiki 用书本、视频站用播放、官方站用徽章。 */
const ICONS = {
  chart: 'M4 6h16M4 12h10M4 18h13', // 谱面/谱面确认
  grid: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z', // 表格/评级表
  play: 'M5 4.5l13 7.5-13 7.5z', // 视频站
  book: 'M4 5.5c2.5-1.5 6-1.5 8 0v13c-2-1.5-5.5-1.5-8 0zM20 5.5c-2.5-1.5-6-1.5-8 0v13c2-1.5 5.5-1.5 8 0z', // wiki
  badge: 'M12 3.5l7 3v6c0 4-3 6.8-7 8-4-1.2-7-4-7-8v-6z', // 官方
  pen: 'M15.5 4.5l4 4L9 19H5v-4z', // 设计
  code: 'M9 6l-5 6 5 6M15 6l5 6-5 6', // 代码
  link: 'M9.5 14.5l5-5M10 6.5l1.8-1.8a4 4 0 015.6 5.6L15.6 12M8.4 12l-2 1.8a4 4 0 005.6 5.6L13.8 17.6', // 通用外链
} as const;
type IconKey = keyof typeof ICONS;

/** gold: 这组的胶囊用金色强调（目前只有友链）。 */
const GROUPS: { key: string; title: string; gold?: boolean; links: Link[] }[] = [
  {
    key: 'friends',
    title: '友链',
    gold: true,
    // 【2026-11-01 主人给定，原样照抄】· JUBEAT VIEWER · Jubeat2Malody · Jubeat LV.10 SSS难易度表
    links: [
      { name: 'JUBEAT VIEWER', url: 'https://ub.thregren.world/', icon: 'chart' },
      { name: 'Jubeat2Malody', url: 'https://swan416.top/jubeat', icon: 'grid' },
      { name: 'Jubeat LV.10 SSS难易度表', url: 'https://sss-jubeat.pages.dev/', icon: 'badge' },
    ],
  },
  {
    key: 'data',
    title: '数据来源',
    // 【2026-11-01 主人给定，原样照抄六条】
    links: [
      { name: 'Jubeat音乐魔方', url: 'https://space.bilibili.com/3546949219256767', icon: 'play' },
      { name: 'jubeat beyond the Ave.', url: 'https://p.eagate.573.jp/game/jubeat/beyond/', icon: 'badge' },
      { name: 'Remywiki', url: 'https://remywiki.com', icon: 'book' },
      { name: 'BEMANIWiki 2nd', url: 'https://bemaniwiki.com', icon: 'book' },
      { name: 'jubeat@Wiki', url: 'https://w.atwiki.jp/jubeat', icon: 'book' },
      { name: 'BaseForJubeaters', url: 'https://b4j-beyond.mono-logic.com/', icon: 'chart' },
      { name: 'arcade-songs', url: 'https://arcade-songs.zetaraku.dev', icon: 'grid' },
    ],
  },
  {
    key: 'design',
    title: '设计参考',
    // 【2026-11-01 主人给定，原样照抄】
    //   · jubeat（ユビート）https://p.eagate.573.jp/game/jubeat/mobile/
    //   · DXRating https://dxrating.net/
    //   · 落雪咖啡屋 https://maimai.lxns.net/
    //   · Union https://union.godserver.cn/
    //   · 音游街小程序（小程序，无 URL）
    links: [
      { name: 'jubeat（ユビート）', url: 'https://p.eagate.573.jp/game/jubeat/mobile/', icon: 'badge' },
      { name: 'DXRating', url: 'https://dxrating.net/', icon: 'chart' },
      { name: '落雪咖啡屋', url: 'https://maimai.lxns.net/', icon: 'grid' },
      { name: 'Union', url: 'https://union.godserver.cn/', icon: 'link' },
      { name: 'jubeat_staff', url: 'https://x.com/jubeat_staff', icon: 'badge' },
      { name: '音游街小程序', url: '', icon: 'play' },
    ],
  },
];
---

<section class="links" aria-labelledby="linksTitle">
  <h2 class="links-title" id="linksTitle">相关站点</h2>
  <div class="links-box">
    {GROUPS.map((g) => (
      <div class="links-row">
        <p class="links-row-t">{g.title}</p>
        <ul class="links-pills">
          {g.links.map((l) => {
            const ico = (
              <svg class="links-ico" viewBox="0 0 24 24" aria-hidden="true"
                   fill={l.icon === 'play' ? 'currentColor' : 'none'}
                   stroke={l.icon === 'play' ? 'none' : 'currentColor'}
                   stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={ICONS[l.icon]} />
              </svg>
            );
            const cls = 'links-pill' + (g.gold ? ' is-gold' : '');
            // 【空 url = 不是网页，只有名字】「音游街」是小程序，没有网址。
            // 渲染成 <a> 会得到一个点不动的死链，比没有更让人恼火；
            // 用虚线胶囊 + 淡字色，读者一看就知道「这个不是链接」。
            return (
              <li>
                {l.url ? (
                  <a class={cls} href={l.url} target="_blank" rel="noopener">{ico}<span>{l.name}</span></a>
                ) : (
                  <span class={cls + ' links-nolink'}>{ico}<span>{l.name}</span></span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</section>
