---
// 首页 · 相关站点：友链 / Officials / 数据来源 / 设计参考 / 谱面确认 / 大白饭中转站
// 2026-11-01 主人要求建立本区块，2026-11-02 改胶囊容器，同日再要求分组与图标规范化。
// 主人原话：「在【友链】和【数据来源】中间加入【Officials】，把 jubeat_staff，Jubeat音乐魔方，
//   jubeat beyond the Ave. 和 jubeat（ユビート）移过去」「在【设计参考】后面加入【大白饭中转站】」
//   「jubeat_staff，Jubeat音乐魔方 的图标换为用户小图标（人形），其他站点用网站小图标（地球），
//    wiki 用 wiki 小图标（书本），整理好不要乱」。
//
// 【设计取向】
//   · 一个容器收五组，每组一行：组标签 + 胶囊流；
//   · 友链是全块唯一的彩色强调（金色），其余组用中性描边；
//   · 没有网址的条目用虚线胶囊（.links-nolink），不做点不动的死链。
//
// 【图标规范】不再由每条链接自己挑图标，改由「站点性质」推导，全块只有三种：
//   · user = 人（个人/账号类：B 站 UP 主、X 账号）——按名字显式指定；
//   · book = 书本（wiki 类）——按名字显式指定；
//   · globe = 地球（其余一切站点，默认）。
// 以前每条自己选 chart/grid/badge/play，同类站点会拿到不同图标；现在同类必然同图标。
type Link = { name: string; url: string };

const ICONS = {
  user: 'M12 4.2a3.6 3.6 0 110 7.2 3.6 3.6 0 010-7.2M4.8 20.2c0-3.7 3.2-5.6 7.2-5.6s7.2 1.9 7.2 5.6',
  globe: 'M12 3.4a8.6 8.6 0 100 17.2 8.6 8.6 0 000-17.2M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.3 3.6 8.6s-1.2 6.2-3.6 8.6c-2.4-2.4-3.6-5.3-3.6-8.6S9.6 5.8 12 3.4',
  book: 'M4 5.5c2.5-1.5 6-1.5 8 0v13c-2-1.5-5.5-1.5-8 0zM20 5.5c-2.5-1.5-6-1.5-8 0v13c2-1.5 5.5-1.5 8 0z',
} as const;
type IconKey = keyof typeof ICONS;
/** 显式指定的人形图标（个人/账号类） */
// 【2026-11-13 主人给了「谱面确认」一组，条目前缀（人）/（网）就是图标要求：
//   （人）= 个人/账号类 → user；其余按默认 globe，所以（网）的两个 wiki 也没有进 WIKIS。】
const USERS = new Set([
  'Jubeat音乐魔方',
  'jubeat_staff',
  '发福魔方',
  'Jack大本',
  'Thregren',
  'ibakenya',
  'お',
]);
/** 显式指定的书本图标（wiki 类） */
const WIKIS = new Set(['Remywiki', 'BEMANIWiki 2nd', 'jubeat@Wiki']);
const iconOf = (name: string): IconKey => (USERS.has(name) ? 'user' : WIKIS.has(name) ? 'book' : 'globe');

/** gold: 这组的胶囊用金色强调（目前只有友链）。 */
const GROUPS: { key: string; title: string; gold?: boolean; links: Link[] }[] = [
  {
    key: 'friends',
    title: '友链',
    gold: true,
    // 【2026-11-01 主人给定，原样照抄】· JUBEAT VIEWER · Jubeat2Malody · Jubeat LV.10 SSS难易度表
    links: [
      { name: 'JUBEAT VIEWER', url: 'https://ub.thregren.world/' },
      { name: 'Jubeat2Malody', url: 'https://swan416.top/jubeat' },
      { name: 'Jubeat LV.10 SSS难易度表', url: 'https://sss-jubeat.pages.dev/' },
    ],
  },
  {
    key: 'officials',
    title: 'Officials',
    // 【2026-11-02 主人要求新建本组】把原来分散在「数据来源」「设计参考」里的官方账号/官网挪进来
    links: [
      { name: 'jubeat_staff', url: 'https://x.com/jubeat_staff' },
      { name: 'Jubeat音乐魔方', url: 'https://space.bilibili.com/3546949219256767' },
      // 【2026-11-13 主人要求放在【Jubeat音乐魔方】后】名字照他给的写法（U 后面是弯引号 ‘）
      { name: 'jubeat U‘nit', url: 'https://p.eagate.573.jp/game/jubeat/unit/' },
      { name: 'jubeat beyond the Ave.', url: 'https://p.eagate.573.jp/game/jubeat/beyond/' },
      { name: 'jubeat（ユビート）', url: 'https://p.eagate.573.jp/game/jubeat/mobile/' },
    ],
  },
  {
    key: 'data',
    title: '数据来源',
    // 【2026-11-01 主人给定，原样照抄】官方两条已移入 Officials
    links: [
      { name: 'Remywiki', url: 'https://remywiki.com' },
      { name: 'BEMANIWiki 2nd', url: 'https://bemaniwiki.com' },
      { name: 'jubeat@Wiki', url: 'https://w.atwiki.jp/jubeat' },
      { name: 'BaseForJubeaters', url: 'https://b4j-beyond.mono-logic.com/' },
      { name: 'arcade-songs', url: 'https://arcade-songs.zetaraku.dev' },
    ],
  },
  {
    key: 'design',
    title: '设计参考',
    // 【2026-11-01 主人给定，原样照抄】官方一条已移入 Officials
    //   · DXRating https://dxrating.net/
    //   · 落雪咖啡屋 https://maimai.lxns.net/
    //   · Union https://union.godserver.cn/
    //   · 音游街小程序（小程序，无 URL）
    links: [
      { name: 'DXRating', url: 'https://dxrating.net/' },
      { name: '落雪咖啡屋', url: 'https://maimai.lxns.net/' },
      { name: 'Union', url: 'https://union.godserver.cn/' },
      // 【2026-11-13 主人要求放在【Union】后】
      { name: 'Majdata.Net', url: 'https://cn.majdata.net/' },
      { name: '音游街小程序', url: '' },
    ],
  },
  {
    key: 'confirm',
    title: '谱面确认',
    // 【2026-11-13 主人给定，原样照抄】放在【设计参考】后面：
    //   · （人）发福魔方 https://space.bilibili.com/3706964538297029
    //   · （人）Jack大本 https://space.bilibili.com/446748
    //   · （人）Thregren https://space.bilibili.com/3369422
    //   · （人）ibakenya https://www.youtube.com/@ibakenya
    //   · （人）お https://www.youtube.com/@o_jb
    //   · （网）Cosmos_Memo https://w.atwiki.jp/cosmos_memo/
    //   · （网）Sonicy_Memo https://w.atwiki.jp/sonicy_memo/
    links: [
      { name: '发福魔方', url: 'https://space.bilibili.com/3706964538297029' },
      { name: 'Jack大本', url: 'https://space.bilibili.com/446748' },
      { name: 'Thregren', url: 'https://space.bilibili.com/3369422' },
      { name: 'ibakenya', url: 'https://www.youtube.com/@ibakenya' },
      { name: 'お', url: 'https://www.youtube.com/@o_jb' },
      { name: 'Cosmos_Memo', url: 'https://w.atwiki.jp/cosmos_memo/' },
      { name: 'Sonicy_Memo', url: 'https://w.atwiki.jp/sonicy_memo/' },
    ],
  },
  {
    key: 'rice',
    title: '大白饭中转站',
    // 【2026-11-02 主人给定，原样照抄】两个中转站点
    links: [
      { name: 'GINKA', url: 'https://api.ginka.cloud/' },
      { name: 'ChooseC', url: 'https://api.choosec.cn/' },
    ],
  },
];
---

<section class="links" aria-labelledby="linksTitle">
  <h2 class="links-title" id="linksTitle">相关站点</h2>
  <div class="links-box">
    {GROUPS.map((g) => (
      <div class="links-row">
        <p class="links-row-t">{g.title}</p>
        <ul class="links-pills">
          {g.links.map((l) => {
            const k = iconOf(l.name);
            const ico = (
              <svg class="links-ico" viewBox="0 0 24 24" aria-hidden="true"
                   fill="none" stroke="currentColor"
                   stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={ICONS[k]} />
              </svg>
            );
            const cls = 'links-pill' + (g.gold ? ' is-gold' : '');
            // 【空 url = 不是网页，只有名字】「音游街」是小程序，没有网址。
            // 渲染成 <a> 会得到一个点不动的死链，比没有更让人恼火；
            // 用虚线胶囊 + 淡字色，读者一看就知道「这个不是链接」。
            return (
              <li>
                {l.url ? (
                  <a class={cls} href={l.url} target="_blank" rel="noopener">{ico}<span>{l.name}</span></a>
                ) : (
                  <span class={cls + ' links-nolink'}>{ico}<span>{l.name}</span></span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</section>
