---
// 曲目详情页的 BGM 试听条（2026-10-29）。
//
// 音源来自 ub.thregren.world，但**不直连**：统一走本站 /api/audio/<songId>
// 反代，音频落在 CF 边缘缓存里（见 src/pages/api/audio/[songId].ts 的说明）。
// 【2026-11-19 主人「无论有无音源都显示播放条」】没有音源的曲目现在也渲染本组件，
// 但整条走禁用态（虚线轨道、播放键置灰、时间位改「暂无音源」），位置与有音源时一致，
// 不做「有就多一块、没有就少一块」的版面跳动。
//
// 为什么不用原生 <audio controls>：
//   原生控件三件套（播放键 / 进度条 / 音量）是浏览器各自的皮肤，
//   在深色世代主题里会突兀成一块灰白色块；而且它的高度、内边距不可控，
//   塞进唱片内页式的版面里会破坏基线。所以只借它的媒体能力，外观自己做。
interface Props {
  /** 本站 songId，用于拼 /api/audio/<id> */
  songId: string;
  /** 曲库里的 BPM 字串（可能是区间或带括注的旧脏值），画成播放条左上角的徽章 */
  bpm?: string | null;
  /** 有没有音源；false 时整条走禁用态，位置照旧（见文件头 2026-11-19 注释） */
  hasAudio?: boolean;
  /** 音源来自哪里：r2=Jack大本 的投稿、ub=上游 thregren；null 表示没有音源 */
  source?: 'r2' | 'ub' | null;
}
const { songId, bpm, hasAudio = true, source = null } = Astro.props;

// 【2026-10-31 主人第 4 条】BPM 徽章只显示数字或区间：
// 库里的值仍可能带括注（如「170 (beatmania IIDX …)」），括注留给详情页信息块，
// 播放条上只留数字主体。
// 【2026-11-19 主人「当没有 bpm 数据时，bpm 徽章默认数值显示 --」】不再整块省略：
// 缺席也是一条信息，省略会让人以为这个位置本来就没有东西；给一个「--」占位，
// 徽章的宽度与其它曲目一致，跨曲目扫视时不会跳。
const bpmText = (String(bpm ?? '').replace(/\([^)]*\)/g, ' ').trim().slice(0, 16)) || '--';
// 来源徽章的文案：两种来源各自对应一个给谱面的人（主人 2026-11-19 指定写法）
const SRC_LABEL = { r2: 'Jack大本', ub: 'Thregren' } as const;
const srcLabel = source ? SRC_LABEL[source] : '';
---

<div
  class:list={['sda', hasAudio ? '' : 'is-empty']}
  data-audio={hasAudio ? '/api/audio/' + songId : undefined}
  data-song={songId}
>
  <button
    class="sda-play"
    type="button"
    aria-label={hasAudio ? '试听 BGM' : '暂无音源'}
    title={hasAudio ? '试听 BGM' : '暂无音源'}
    disabled={!hasAudio}
  >
    <svg class="sda-ico sda-ico-play" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5.5v13l11-6.5z" />
    </svg>
    <svg class="sda-ico sda-ico-pause" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5.5v13M15 5.5v13" />
    </svg>
    <span class="sda-spin" aria-hidden="true"></span>
  </button>

  <div class="sda-main">
    <div class="sda-meta">
      <span class="sda-bpm" title={"BPM " + bpmText} data-empty={bpmText === '--' ? '' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M10 5.6h4l4 13.9H6z" />
          <path d="M13.6 3.4 9.1 16.4" />
        </svg>
        <b>{bpmText}</b>
      </span>
      {/* 【2026-11-19 主人「在 bpm 徽章右边新增一个来源徽章，文案『来源：XXX』」】
          R2 音源是 Jack大本 的投稿，上游走 thregren——两者都是"谁给的这份音源"，
          所以跟 BPM 一样做成徽章并排；没有音源时不摆来源徽章。 */}
      {
        srcLabel ? (
          <span class="sda-src" title={'音源来源：' + srcLabel}>
            <i>来源：</i>
            <b>{srcLabel}</b>
          </span>
        ) : null
      }
      {
        hasAudio ? (
          <span class="sda-time"><b class="sda-cur">0:00</b><i>/</i><span class="sda-dur">--:--</span></span>
        ) : (
          <span class="sda-time sda-none">暂无音源</span>
        )
      }
    </div>

    <div
      class="sda-track"
    role="slider"
    tabindex="0"
    aria-label="播放进度"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-valuetext="未播放"
  >
      <span class="sda-fill"></span>
      <span class="sda-knob"></span>
    </div>
  </div>
</div>

<style>
  /* 【2026-10-31 主人画框：① 去掉 BGM 标签 ② 进度条下移并延长
     ③ 时间移到进度条右上 ④ 进度条左上放 BPM 徽章】
     原来是「按钮 / BGM 标签 / 进度 / 时间」一条横排：标签与时间各占掉一段，
     进度条被夹在中间、长度有限。现在按钮左侧不动，右侧改成两行——
     上行是元信息（左 BPM 徽章、右 时间），下行才是进度条本身。
     整块高度固定（min-height 40），加载态与失败态都不改高度，避免按下播放版面抖一下。 */
  .sda {
    display: flex;
    align-items: center;
    gap: 12px;
    /* 【2026-10-29 播放条上移到定数条之前】现在紧跟艺人，
       间距比原来略大（18-24 → 22-30），让"作品信息 → 播放"有明确气口；
       下方与定数条的距离由 .sd-gauge 的 margin-top 控制。 */
    margin-top: clamp(22px, 3vw, 30px);
    min-height: 40px;
  }

  /* 播放键：与站内圆形按钮同口径（细边 + 主题色悬停），不用实心色块压过曲名 */
  .sda-play {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    border: 1px solid var(--edge);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .sda-play:hover {
    color: var(--acc);
    border-color: color-mix(in srgb, var(--acc) 55%, transparent);
    background: color-mix(in srgb, var(--acc) 10%, transparent);
  }
  .sda-play:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 3px;
  }

  .sda-ico {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 【2026-11-02 移动端触控修复】40×40 → 44×44。
     审计移动端清单里详情页剩的那 1 个 <40px 目标就是这颗播放键
     （2026-11-02 审计第三节 P2，该文档已删）。图标同步放大 1px 保持视觉比例。 */
  @media (max-width: 768px) {
    .sda-play {
      width: 44px;
      height: 44px;
    }
    .sda-play .sda-ico {
      width: 18px;
      height: 18px;
    }
  }
  /* 播放三角用填充而不是描边，视觉上更「实」 */
  .sda-ico-play {
    fill: currentColor;
    stroke: none;
    width: 18px;
    height: 18px;
    margin-left: 2px;
  }
  .sda-ico-pause {
    display: none;
  }
  .sda.is-playing .sda-ico-play {
    display: none;
  }
  .sda.is-playing .sda-ico-pause {
    display: block;
  }

  /* 加载转圈：只在首次拉音频时出现，替换掉播放图标 */
  .sda-spin {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.6px solid color-mix(in srgb, currentColor 25%, transparent);
    border-top-color: currentColor;
  }
  .sda.is-loading .sda-spin {
    display: block;
    animation: sdaSpin 0.8s linear infinite;
  }
  .sda.is-loading .sda-ico {
    display: none;
  }
  @keyframes sdaSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 右栏两行：上行元信息、下行进度条 */
  .sda-main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .sda-meta {
    /* z-index 压在进度条加高的命中区之上：否则条上方的 -10px 命中区会吃掉
       点向徽章/时间的点击（条本身不需要，但命中区不该盖住别的元素）。 */
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 18px;
  }

  /* BPM 徽章：节拍器图标 + 数字，贴在进度条左上角 */
  .sda-bpm {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    padding: 3px 9px 3px 7px;
    border: 1px solid var(--edge);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    font-family: var(--font-data);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink3);
  }
  .sda-bpm svg {
    width: 14px;
    height: 14px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sda-bpm b {
    font-weight: 700;
    color: var(--ink2);
    font-variant-numeric: tabular-nums;
  }
  /* 没有 BPM 的占位「--」：降一档权重，别让占位符比真数据还显眼 */
  .sda-bpm[data-empty] b {
    color: var(--ink3);
    font-weight: 400;
  }

  /* 进度轨道：可点可拖。上下留出更多命中区域（伪元素撑高），
     不然 4px 高的细条在手机上根本按不准。 */
  .sda-track {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    height: 4px;
    border-radius: var(--r-hair);
    background: color-mix(in srgb, var(--ink) 12%, transparent);
    cursor: pointer;
    touch-action: none;
  }
  .sda-track::before {
    content: "";
    position: absolute;
    /* 命中区比原来矮一点：条上方 10px 处现在是元信息行，别再往上压 */
    inset: -10px 0;
  }
  .sda-track:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 6px;
  }
  .sda-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--acc);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .sda-knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--acc);
    /* 未播放时隐藏圆点（轨道上只有一个点会像加载失败） */
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  .sda.is-ready .sda-knob,
  .sda.is-playing .sda-knob {
    opacity: 1;
  }

  /* 时间：等宽数据字体，当前时间用主色，总时长压暗 */
  .sda-time {
    flex: none;
    /* 只有时间时也要靠右（徽章缺席的曲目不摆占位元素） */
    margin-left: auto;
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    font-family: var(--font-data);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--ink3);
  }
  .sda-time b {
    font-weight: 700;
    color: var(--ink2);
  }
  .sda-time i {
    font-style: normal;
    opacity: 0.5;
  }

  /* 【2026-11-19 来源徽章】跟 BPM 同一档的细徽章，字号与内距都略收，
     它是附注不是读数。 */
  .sda-src {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    flex: none;
    padding: 3px 9px;
    border: 1px solid var(--edge);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    font-size: 11px;
    color: var(--ink3);
    white-space: nowrap;
  }
  .sda-src b {
    font-weight: 700;
    color: var(--ink2);
  }

  /* 【2026-11-19 无音源】轨道改灰色虚线、按钮与读数降权。
     虚线用的是 border 而不是背景条纹：轨道本身只有 4px，条纹会糊成实心。 */
  .sda.is-empty .sda-play {
    opacity: 0.45;
    cursor: default;
  }
  .sda.is-empty .sda-track {
    background: none;
    border-top: 2px dashed color-mix(in srgb, var(--ink) 20%, transparent);
    height: 0;
    cursor: default;
  }
  .sda.is-empty .sda-fill,
  .sda.is-empty .sda-knob {
    display: none;
  }
  .sda.is-empty .sda-none {
    color: var(--ink3);
    font-family: inherit;
    font-size: 11.5px;
  }
  .sda.is-empty .sda-cur,
  .sda.is-empty .sda-dur,
  .sda.is-empty .sda-time i {
    display: none;
  }

  /* 失败态：整条降权 + 一句说明，不弹窗、不 Toast */
  .sda.is-error .sda-track {
    cursor: default;
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--ink) 12%, transparent) 0 6px,
      transparent 6px 12px
    );
  }
  .sda.is-error .sda-time {
    color: var(--ink3);
  }

  @media (prefers-reduced-motion: reduce) {
    .sda.is-loading .sda-spin {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    /* 【2026-10-29 主人画黄框：移动端播放条要横跨全宽】
       桌面端播放条留在曲绘右侧（见 songs.css 的说明），但**窄屏**不同：
       窄屏是「左图 108 + 右栏」两列，播放条若只在右栏 197px 里，
       进度条被压得很短、按钮也挤在曲绘旁边（主人连续两次反馈"挨着曲绘"）。
       黄框给的目标形态是：从页面左缘一直铺到右缘，与下方定数条左右对齐。
       实现：负 margin 抵消右栏偏移（--sd-main-offset 由 .sd-body 下发，
       窄屏 = 108 封面 + 22 栏间距 = 130），宽度按同值补回。
       写在组件 scoped 的 @media 里——全局 .sda 规则特异性低于 scoped，外面写不生效。 */
    .sda {
      gap: 10px;
      /* 【2026-10-29 主人「这个 div 紧挨着曲绘底边」】
         横跨后播放条左端正好落在曲绘正下方，所以"离曲绘多远"由这条 margin-top 决定。
         实测：艺人底边 245、曲绘底边 261。
         margin-top 28 时播放条顶 273 —— 离艺人 28px 但离曲绘只有 12px，看着仍贴图。
         要让它离曲绘底边约 24px，需 margin-top = 24 + (261-245) = 40。
         （差值 16 = 曲绘比艺人段多出来的高度，随字号/行数变化，改文案时要重测。） */
      margin-top: 40px;
      /* 【2026-11-19 主人「移动端视图下，当曲名有两行时，应减少 div.sda 的 margin-top」】
         40px 是按「曲名一行」量出来的气口（见上）。曲名折成两行时，艺人段整体
         已被推下一行高度，再加上 40 就成了双份留白。这里按行数回落：
         曲名脚本在折成两行时给 <html> 挂 is-title-2l，这里据此收到 22px
         （40 - 一行高度 ≈ 18，剩下的气口与一行时相当）。 */
      margin-top: 40px;
      margin-left: calc(-1 * var(--sd-main-offset));
      width: calc(100% + var(--sd-main-offset));
    }
    /* 曲名两行时收紧上间距（见上面 margin-top 的说明） */
    :global(html.is-title-2l) .sda {
      margin-top: 22px;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.sda');
    if (!root) return;

    var btn = root.querySelector('.sda-play');
    var track = root.querySelector('.sda-track');
    var fill = root.querySelector('.sda-fill');
    var knob = root.querySelector('.sda-knob');
    var curEl = root.querySelector('.sda-cur');
    var durEl = root.querySelector('.sda-dur');
    var src = root.getAttribute('data-audio');

    // 【2026-11-19】没有音源时整条是禁用态：按钮已 disabled，事件挂上去也无从触发，
    // 直接不初始化播放器（省掉没用的 Audio 创建与预热请求）。
    // 预热那发 Range 尤其要跳——它会让 API 404 一次。
    if (!src) return;

    var audio = null;
    var dragging = false;

    function fmt(t) {
      if (!isFinite(t) || t < 0) return '--:--';
      var m = Math.floor(t / 60);
      var s = Math.floor(t % 60);
      return m + ':' + (s < 10 ? '0' + s : s);
    }

    // 【2026-10-29 主人第 1 条】曲绘下方的唱片要在 BGM 播放时旋转。
    // 播放状态本来只有 SongAudio 内部知道，而唱片壳在 aside（另一个组件层级）。
    // 用 documentElement 上的 data-bgm 标记做唯一的跨组件通道：
    //   · 不用 window 事件——那要额外一套 add/removeEventListener，还得管清理；
    //   · 不用 CSS 兄弟选择器——aside 与 .sda 不是兄弟，隔了两层。
    // 写 <html data-bgm="playing">，唱片只认这一条。
    function setBgm(state) {
      var el = document.documentElement;
      if (state) el.setAttribute('data-bgm', state);
      else el.removeAttribute('data-bgm');
    }

    function paint() {
      var d = audio ? audio.duration : 0;
      var c = audio ? audio.currentTime : 0;
      var p = d > 0 ? Math.min(1, c / d) : 0;
      fill.style.transform = 'scaleX(' + p + ')';
      knob.style.left = p * 100 + '%';
      curEl.textContent = fmt(c);
      if (d > 0) durEl.textContent = fmt(d);
      track.setAttribute('aria-valuenow', String(Math.round(p * 100)));
      track.setAttribute('aria-valuetext', fmt(c) + ' / ' + (d > 0 ? fmt(d) : '未知'));
    }

    /* 【2026-11-03 热门榜埋点】真正出声 8 秒才记一次。
       为什么不是一点播放就记：详情页上"随手试听一下"很多，3 秒就走人的不该算热度，
       所以用定时器验满。播到一半暂停再播不重复计时（hitTimer 还在就不重开）。
       接口 /api/hot/hit 自己还有同曲 30 秒节流与 IP 闸门，这里只负责"真听到"这一件事。
       失败一律静默：埋点挂掉不能影响播放。 */
    var hitTimer = null;
    function countHit() {
      if (hitTimer || countHit.done) return;
      hitTimer = setTimeout(function () {
        countHit.done = true;
        try {
          fetch('/api/hot/hit', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ songId: root.getAttribute('data-song') || '' }),
            keepalive: true,
          }).catch(function () {});
        } catch (e) { /* 老浏览器没 keepalive 也一样走 */ }
      }, 8000);
    }

    /* 【2026-11-18 主人「优化一下音源加载速度」】
       两件都不影响首屏：①手指/鼠标一碰按钮就先建 Audio（preload 只取文件头），
       省掉点击那一刻的创建与连接建立；②页面空闲时发一个 1 字节的 Range 请求把音源
       推进本站边缘缓存——Worker 拿到 R2 对象后是整份 tee 进缓存的，所以这一发等于
       把后面的分段请求都变成 HIT，而浏览器只花 1 字节。失败一律静默。 */
    function warm() { try { ensure(); } catch (e) { /* 预热失败不影响正常播放 */ } }
    btn.addEventListener('pointerenter', warm);
    btn.addEventListener('pointerdown', warm);
    btn.addEventListener('focus', warm);
    function prewarm() {
      fetch(src, { headers: { Range: 'bytes=0-0' }, credentials: 'same-origin' }).catch(function () {});
    }
    if ('requestIdleCallback' in window) requestIdleCallback(prewarm, { timeout: 4000 });
    else setTimeout(prewarm, 2500);

    function ensure() {
      if (audio) return audio;
      // 首次点击才创建并拉流：1241 首的详情页若都预载，流量与首屏都不划算
      audio = new Audio(src);
      // 【2026-10-30 首播慢的最后一环：preload='auto' 会先拉整份】
      // 实测（浏览器，全新曲目）：点播放后第一个请求 TTFB 15414ms、解码 0KB、
      // 却占着连接 2.8 秒；第二个请求才拿到 66KB 出声。第一个就是 preload='auto'
      // 发起的「整份预取」，它和首播要的 Range 抢同一条出口，首播因此被拖到 11 秒。
      //
      // 改成 'metadata'：只让浏览器取文件头（几十 KB 就能拿到时长/编码），
      // 真正要播时它自己按 Range 分段拉——这正是主人说的「流式分片」。
      // 代价：拖动进度条时可能多一次 Range 请求，但服务端已支持 206 且命中边缘缓存
      // 时只要 4–7ms，可以忽略。
      audio.preload = 'metadata';
      // 【2026-10-29 主人「有些浏览器没加载完 bgm 资源，loading 就提前消失了」】
      // 根因：'playing' 在某些浏览器里会**早于缓冲完成**触发（尤其 Safari / 弱网），
      // 此时只是"开始尝试出声"，data 可能还不够，之后还会卡顿重缓冲。
      // 判据改为看 readyState：HAVE_FUTURE_DATA(3) 以上才算真的能连续播放。
      // 我们不在 playing 里清 loading，而是统一走 canplay/canplaythrough +
      // 一个 readyState 复查，两个条件都满足才撤掉转圈。
      function clearLoadingIfReady() {
        if (!audio) return;
        // 【2026-11-19 主人「有时点击后要等加载动画结束几秒才开始自动播放」】
        // 原判据只看 readyState>=3 就撤转圈，但「数据够」到「真的出声」之间还有一段
        // （解码 + 打开输出设备，慢网/慢机上肉眼可见数秒）。那段里转圈已经没了、
        // 图标也还不是暂停，看起来就是"加载完了却干等"。
        // 现在要求两件事同时成立：readyState 达标 **且** 已经 'playing'。
        // 3 = HAVE_FUTURE_DATA（有当前帧 + 后续数据），比 2（HAVE_CURRENT_DATA）更稳
        if (audio.readyState >= 3 && root.classList.contains('is-playing')) {
          root.classList.remove('is-loading');
        }
      }
      audio.addEventListener('canplay', clearLoadingIfReady);
      audio.addEventListener('canplaythrough', clearLoadingIfReady);
      // 兜底轮询：canplay/canplaythrough 在个别浏览器里可能提前或延迟触发，
      // 每 200ms 复查 readyState，达标就撤转圈。
      var readyTimer = setInterval(clearLoadingIfReady, 200);
      // 【防卡死】readyState 一直到不了 3（网络卡住/上游慢）时，转圈不能无限转下去——
      // 那会让用户以为"还在加载"，实际上什么都没发生。
      // 15s 后无论 readyState 如何都撤掉转圈；若仍未就绪，按钮保持可点（再点会重新拉流）。
      var loadGuard = setTimeout(function () {
        root.classList.remove('is-loading');
      }, 15000);
      audio.addEventListener('error', function () {
        clearInterval(readyTimer);
        clearTimeout(loadGuard);
      });
      audio.addEventListener('loadedmetadata', function () {
        root.classList.add('is-ready');
        paint();
      });
      audio.addEventListener('timeupdate', function () {
        if (!dragging) paint();
      });
      // 【2026-10-29 主人第 6 条】点下播放后要**先显示转圈，等资源真的能放再切暂停键**。
      // 关键在于听 'playing'（已有足够数据、真正开始输出声音）而不是 'play'
      // （只是"被要求播放"，此时可能还在缓冲）。原实现听 'play' 并顺手去掉 is-loading，
      // 导致慢网下转圈一闪而过、图标立刻变成暂停，像是在播而实际没声音。
      audio.addEventListener('playing', function () {
        root.classList.add('is-playing');
        // 【不再在这里清 is-loading】'playing' 可能早于缓冲完成触发，
        // 由 canplay / canplaythrough / 轮询按 readyState>=3 来撤转圈，见上面。
        clearLoadingIfReady();
        setBgm('playing');
        countHit();
      });
      audio.addEventListener('pause', function () {
        root.classList.remove('is-playing');
        setBgm('');
        // 暂停即作废这轮计时：播了 7 秒就停在 8 秒门前不该算，重新播要从头数
        if (hitTimer && !countHit.done) { clearTimeout(hitTimer); hitTimer = null; }
      });
      audio.addEventListener('ended', function () {
        root.classList.remove('is-playing');
        setBgm('');
        paint();
      });
      audio.addEventListener('error', function () {
        root.classList.add('is-error');
        root.classList.remove('is-playing', 'is-loading', 'is-ready');
        durEl.textContent = '不可用';
        btn.setAttribute('aria-label', '音源不可用');
        btn.disabled = true;
        btn.style.cursor = 'default';
      });
      return audio;
    }

    btn.addEventListener('click', function () {
      var a = ensure();
      // 【2026-11-19 主人「第一次点加载不出、第二次没反应、第三次才播」】
      // 根因：play() 一发出 a.paused 就变 false（此时还在缓冲），第二次点击于是走了
      // "正在播 → 暂停"那条分支，把还在加载的流掐掉，看起来就是点了没反应；
      // 第三次点击 a.paused 才又为 true 才播成。判据改为「还没真正出声」时再点继续播。
      // 只有 is-playing（'playing' 事件置上的类）才算在播、才允许暂停。
      var idle = a.paused;
      if (idle || !root.classList.contains('is-playing')) {
        // 先上转圈，再发起播放：顺序反了会出现"资源秒到、转圈来不及显示"的闪烁。
        // 只有 'playing' 事件（真正能出声）才会清掉它，见 ensure() 里的监听。
        root.classList.add('is-loading');
        // 上一发还在缓冲时再点＝重试：load() 会中止旧请求重新拉，否则再点只是又喊一次
        // play()，卡住的那条连接仍占着，看起来就是"点了没反应"。
        var retry = !idle && a.readyState < 3;
        if (retry) { try { a.load(); } catch (e) {} }
        // 走 play() 的 promise：被浏览器策略拦下时把转圈收回，不留假加载状态
        var p = a.play();
        if (p && p.catch) {
          p.catch(function (err) {
            // load() 打断了上一次 play()，它会以 AbortError 拒绝——这一发仍在拉流，
            // 转圈不能撤，撤了就成了"点了变回原样"的假失败（2026-11-19 实测）。
            if (err && err.name === 'AbortError' && retry) return;
            root.classList.remove('is-loading', 'is-playing');
          });
        }
      } else {
        a.pause();
        root.classList.remove('is-loading');
      }
      btn.blur();
    });

    function seekFromEvent(e) {
      var a = ensure();
      var r = track.getBoundingClientRect();
      var p = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      var d = a.duration;
      if (!isFinite(d) || d <= 0) return;
      a.currentTime = p * d;
      paint();
    }

    track.addEventListener('pointerdown', function (e) {
      dragging = true;
      if (track.setPointerCapture) track.setPointerCapture(e.pointerId);
      seekFromEvent(e);
    });
    track.addEventListener('pointermove', function (e) {
      if (dragging) seekFromEvent(e);
    });
    track.addEventListener('pointerup', function (e) {
      dragging = false;
      if (track.releasePointerCapture) {
        try { track.releasePointerCapture(e.pointerId); } catch {}
      }
    });
    // 拖出轨道后松手也要结束拖拽状态，否则进度条会一直跟着鼠标
    track.addEventListener('pointercancel', function () {
      dragging = false;
    });

    // 键盘：左右 ±5 秒，Home/End 跳到首尾。空格交给按钮本身（不在这里抢）。
    track.addEventListener('keydown', function (e) {
      var a = ensure();
      if (!isFinite(a.duration) || a.duration <= 0) return;
      var step = 5;
      if (e.key === 'ArrowLeft') a.currentTime = Math.max(0, a.currentTime - step);
      else if (e.key === 'ArrowRight') a.currentTime = Math.min(a.duration, a.currentTime + step);
      else if (e.key === 'Home') a.currentTime = 0;
      else if (e.key === 'End') a.currentTime = a.duration;
      else return;
      e.preventDefault();
      paint();
    });

    /* 【2026-10-29 主人「移动端播放 bgm 时用手势从详情页退回曲目页，音乐不会停」】
       根因：Audio 对象是 JS 持有的，浏览器**不会**因为"页面被导航走"就自动暂停它——
       尤其在 iOS Safari / 微信里用手势返回时，页面进 bfcache，DOM 还在、Audio 还在播。
       所以必须自己监听页面生命周期：
         · pagehide：页面离开（含进 bfcache、被卸载）→ 立即暂停并复位；
         · visibilitychange：切到后台/切标签 → 也暂停（移动端音频在后台继续放很扰人）；
         · bfcache 恢复（pageshow 的 persisted=true）→ 保持暂停状态，不自动续播，
           用户回来看到的是暂停中的播放器，需要再点一次。
       另外必须清掉 html[data-bgm]，否则唱片在用户返回后仍显示旋转。 */
    function stopAndReset() {
      if (audio && !audio.paused) {
        try { audio.pause(); } catch (e) { /* 已卸载时个别浏览器会抛，忽略 */ }
      }
      root.classList.remove('is-playing', 'is-loading');
      setBgm('');
    }
    window.addEventListener('pagehide', stopAndReset);
    // bfcache 命中（Chromium / Firefox / Safari 都会）——页面没真正销毁时也要复位
    window.addEventListener('beforeunload', stopAndReset);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') stopAndReset();
    });
    // 从 bfcache 返回：确保 UI 与状态都是"暂停"，而不是停在播放态
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) {
        root.classList.remove('is-playing', 'is-loading');
        setBgm('');
        paint();
      }
    });

    paint();
  })();
</script>
