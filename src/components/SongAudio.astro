---
// 曲目详情页的 BGM 试听条（2026-10-29）。
//
// 音源来自 ub.thregren.world，但**不直连**：统一走本站 /api/audio/<songId>
// 反代，音频落在 CF 边缘缓存里（见 src/pages/api/audio/[songId].ts 的说明）。
// 没有映射到音源的曲目不渲染本组件——详情页宁可少一个控件，也不摆一个点了没反应的按钮。
//
// 为什么不用原生 <audio controls>：
//   原生控件三件套（播放键 / 进度条 / 音量）是浏览器各自的皮肤，
//   在深色世代主题里会突兀成一块灰白色块；而且它的高度、内边距不可控，
//   塞进唱片内页式的版面里会破坏基线。所以只借它的媒体能力，外观自己做。
interface Props {
  /** 本站 songId，用于拼 /api/audio/<id> */
  songId: string;
  /** 曲库里的 BPM 字串（可能是区间或带括注的旧脏值），画成播放条左上角的徽章 */
  bpm?: string | null;
}
const { songId, bpm } = Astro.props;

// 【2026-10-31 主人第 4 条】BPM 徽章只显示数字或区间：
// 库里的值仍可能带括注（如「170 (beatmania IIDX …)」），括注留给详情页信息块，
// 播放条上只留数字主体；取不到值就整块不渲染。
const bpmText = String(bpm ?? '')
  .replace(/\([^)]*\)/g, ' ')
  .trim()
  .slice(0, 16);
---

<div class="sda" data-audio={"/api/audio/" + songId}>
  <button class="sda-play" type="button" aria-label="试听 BGM" title="试听 BGM">
    <svg class="sda-ico sda-ico-play" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5.5v13l11-6.5z" />
    </svg>
    <svg class="sda-ico sda-ico-pause" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5.5v13M15 5.5v13" />
    </svg>
    <span class="sda-spin" aria-hidden="true"></span>
  </button>

  <div class="sda-main">
    <div class="sda-meta">
      {
        bpmText ? (
          <span class="sda-bpm" title={"BPM " + bpmText}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9.9 4.6h4.2l4.7 14.9H5.2z" />
              <path d="M12 4.7 8.7 15.6" />
              <path d="M4.5 19.5h15" />
            </svg>
            <b>{bpmText}</b>
          </span>
        ) : null
      }
      <span class="sda-time"><b class="sda-cur">0:00</b><i>/</i><span class="sda-dur">--:--</span></span>
    </div>

    <div
      class="sda-track"
    role="slider"
    tabindex="0"
    aria-label="播放进度"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-valuetext="未播放"
  >
      <span class="sda-fill"></span>
      <span class="sda-knob"></span>
    </div>
  </div>
</div>

<style>
  /* 【2026-10-31 主人画框：① 去掉 BGM 标签 ② 进度条下移并延长
     ③ 时间移到进度条右上 ④ 进度条左上放 BPM 徽章】
     原来是「按钮 / BGM 标签 / 进度 / 时间」一条横排：标签与时间各占掉一段，
     进度条被夹在中间、长度有限。现在按钮左侧不动，右侧改成两行——
     上行是元信息（左 BPM 徽章、右 时间），下行才是进度条本身。
     整块高度固定（min-height 40），加载态与失败态都不改高度，避免按下播放版面抖一下。 */
  .sda {
    display: flex;
    align-items: center;
    gap: 12px;
    /* 【2026-10-29 播放条上移到定数条之前】现在紧跟艺人，
       间距比原来略大（18-24 → 22-30），让"作品信息 → 播放"有明确气口；
       下方与定数条的距离由 .sd-gauge 的 margin-top 控制。 */
    margin-top: clamp(22px, 3vw, 30px);
    min-height: 40px;
  }

  /* 播放键：与站内圆形按钮同口径（细边 + 主题色悬停），不用实心色块压过曲名 */
  .sda-play {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    border: 1px solid var(--edge);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .sda-play:hover {
    color: var(--acc);
    border-color: color-mix(in srgb, var(--acc) 55%, transparent);
    background: color-mix(in srgb, var(--acc) 10%, transparent);
  }
  .sda-play:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 3px;
  }

  .sda-ico {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* 播放三角用填充而不是描边，视觉上更「实」 */
  .sda-ico-play {
    fill: currentColor;
    stroke: none;
    width: 18px;
    height: 18px;
    margin-left: 2px;
  }
  .sda-ico-pause {
    display: none;
  }
  .sda.is-playing .sda-ico-play {
    display: none;
  }
  .sda.is-playing .sda-ico-pause {
    display: block;
  }

  /* 加载转圈：只在首次拉音频时出现，替换掉播放图标 */
  .sda-spin {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.6px solid color-mix(in srgb, currentColor 25%, transparent);
    border-top-color: currentColor;
  }
  .sda.is-loading .sda-spin {
    display: block;
    animation: sdaSpin 0.8s linear infinite;
  }
  .sda.is-loading .sda-ico {
    display: none;
  }
  @keyframes sdaSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 右栏两行：上行元信息、下行进度条 */
  .sda-main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .sda-meta {
    /* z-index 压在进度条加高的命中区之上：否则条上方的 -10px 命中区会吃掉
       点向徽章/时间的点击（条本身不需要，但命中区不该盖住别的元素）。 */
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 18px;
  }

  /* BPM 徽章：节拍器图标 + 数字，贴在进度条左上角 */
  .sda-bpm {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    padding: 2px 8px 2px 6px;
    border: 1px solid var(--edge);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    font-family: var(--font-data);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink3);
  }
  .sda-bpm svg {
    width: 13px;
    height: 13px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sda-bpm b {
    font-weight: 700;
    color: var(--ink2);
    font-variant-numeric: tabular-nums;
  }

  /* 进度轨道：可点可拖。上下留出更多命中区域（伪元素撑高），
     不然 4px 高的细条在手机上根本按不准。 */
  .sda-track {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    height: 4px;
    border-radius: var(--r-hair);
    background: color-mix(in srgb, var(--ink) 12%, transparent);
    cursor: pointer;
    touch-action: none;
  }
  .sda-track::before {
    content: "";
    position: absolute;
    /* 命中区比原来矮一点：条上方 10px 处现在是元信息行，别再往上压 */
    inset: -10px 0;
  }
  .sda-track:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 6px;
  }
  .sda-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--acc);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .sda-knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--acc);
    /* 未播放时隐藏圆点（轨道上只有一个点会像加载失败） */
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  .sda.is-ready .sda-knob,
  .sda.is-playing .sda-knob {
    opacity: 1;
  }

  /* 时间：等宽数据字体，当前时间用主色，总时长压暗 */
  .sda-time {
    flex: none;
    /* 只有时间时也要靠右（徽章缺席的曲目不摆占位元素） */
    margin-left: auto;
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    font-family: var(--font-data);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--ink3);
  }
  .sda-time b {
    font-weight: 700;
    color: var(--ink2);
  }
  .sda-time i {
    font-style: normal;
    opacity: 0.5;
  }

  /* 失败态：整条降权 + 一句说明，不弹窗、不 Toast */
  .sda.is-error .sda-track {
    cursor: default;
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--ink) 12%, transparent) 0 6px,
      transparent 6px 12px
    );
  }
  .sda.is-error .sda-time {
    color: var(--ink3);
  }

  @media (prefers-reduced-motion: reduce) {
    .sda.is-loading .sda-spin {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    /* 【2026-10-29 主人画黄框：移动端播放条要横跨全宽】
       桌面端播放条留在曲绘右侧（见 songs.css 的说明），但**窄屏**不同：
       窄屏是「左图 108 + 右栏」两列，播放条若只在右栏 197px 里，
       进度条被压得很短、按钮也挤在曲绘旁边（主人连续两次反馈"挨着曲绘"）。
       黄框给的目标形态是：从页面左缘一直铺到右缘，与下方定数条左右对齐。
       实现：负 margin 抵消右栏偏移（--sd-main-offset 由 .sd-body 下发，
       窄屏 = 108 封面 + 22 栏间距 = 130），宽度按同值补回。
       写在组件 scoped 的 @media 里——全局 .sda 规则特异性低于 scoped，外面写不生效。 */
    .sda {
      gap: 10px;
      /* 【2026-10-29 主人「这个 div 紧挨着曲绘底边」】
         横跨后播放条左端正好落在曲绘正下方，所以"离曲绘多远"由这条 margin-top 决定。
         实测：艺人底边 245、曲绘底边 261。
         margin-top 28 时播放条顶 273 —— 离艺人 28px 但离曲绘只有 12px，看着仍贴图。
         要让它离曲绘底边约 24px，需 margin-top = 24 + (261-245) = 40。
         （差值 16 = 曲绘比艺人段多出来的高度，随字号/行数变化，改文案时要重测。） */
      margin-top: 40px;
      margin-left: calc(-1 * var(--sd-main-offset));
      width: calc(100% + var(--sd-main-offset));
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.sda');
    if (!root) return;

    var btn = root.querySelector('.sda-play');
    var track = root.querySelector('.sda-track');
    var fill = root.querySelector('.sda-fill');
    var knob = root.querySelector('.sda-knob');
    var curEl = root.querySelector('.sda-cur');
    var durEl = root.querySelector('.sda-dur');
    var src = root.getAttribute('data-audio');

    var audio = null;
    var dragging = false;

    function fmt(t) {
      if (!isFinite(t) || t < 0) return '--:--';
      var m = Math.floor(t / 60);
      var s = Math.floor(t % 60);
      return m + ':' + (s < 10 ? '0' + s : s);
    }

    // 【2026-10-29 主人第 1 条】曲绘下方的唱片要在 BGM 播放时旋转。
    // 播放状态本来只有 SongAudio 内部知道，而唱片壳在 aside（另一个组件层级）。
    // 用 documentElement 上的 data-bgm 标记做唯一的跨组件通道：
    //   · 不用 window 事件——那要额外一套 add/removeEventListener，还得管清理；
    //   · 不用 CSS 兄弟选择器——aside 与 .sda 不是兄弟，隔了两层。
    // 写 <html data-bgm="playing">，唱片只认这一条。
    function setBgm(state) {
      var el = document.documentElement;
      if (state) el.setAttribute('data-bgm', state);
      else el.removeAttribute('data-bgm');
    }

    function paint() {
      var d = audio ? audio.duration : 0;
      var c = audio ? audio.currentTime : 0;
      var p = d > 0 ? Math.min(1, c / d) : 0;
      fill.style.transform = 'scaleX(' + p + ')';
      knob.style.left = p * 100 + '%';
      curEl.textContent = fmt(c);
      if (d > 0) durEl.textContent = fmt(d);
      track.setAttribute('aria-valuenow', String(Math.round(p * 100)));
      track.setAttribute('aria-valuetext', fmt(c) + ' / ' + (d > 0 ? fmt(d) : '未知'));
    }

    function ensure() {
      if (audio) return audio;
      // 首次点击才创建并拉流：1241 首的详情页若都预载，流量与首屏都不划算
      audio = new Audio(src);
      // 【2026-10-30 首播慢的最后一环：preload='auto' 会先拉整份】
      // 实测（浏览器，全新曲目）：点播放后第一个请求 TTFB 15414ms、解码 0KB、
      // 却占着连接 2.8 秒；第二个请求才拿到 66KB 出声。第一个就是 preload='auto'
      // 发起的「整份预取」，它和首播要的 Range 抢同一条出口，首播因此被拖到 11 秒。
      //
      // 改成 'metadata'：只让浏览器取文件头（几十 KB 就能拿到时长/编码），
      // 真正要播时它自己按 Range 分段拉——这正是主人说的「流式分片」。
      // 代价：拖动进度条时可能多一次 Range 请求，但服务端已支持 206 且命中边缘缓存
      // 时只要 4–7ms，可以忽略。
      audio.preload = 'metadata';
      // 【2026-10-29 主人「有些浏览器没加载完 bgm 资源，loading 就提前消失了」】
      // 根因：'playing' 在某些浏览器里会**早于缓冲完成**触发（尤其 Safari / 弱网），
      // 此时只是"开始尝试出声"，data 可能还不够，之后还会卡顿重缓冲。
      // 判据改为看 readyState：HAVE_FUTURE_DATA(3) 以上才算真的能连续播放。
      // 我们不在 playing 里清 loading，而是统一走 canplay/canplaythrough +
      // 一个 readyState 复查，两个条件都满足才撤掉转圈。
      function clearLoadingIfReady() {
        if (!audio) return;
        // 3 = HAVE_FUTURE_DATA（有当前帧 + 后续数据），比 2（HAVE_CURRENT_DATA）更稳
        if (audio.readyState >= 3) {
          root.classList.remove('is-loading');
        }
      }
      audio.addEventListener('canplay', clearLoadingIfReady);
      audio.addEventListener('canplaythrough', clearLoadingIfReady);
      // 兜底轮询：canplay/canplaythrough 在个别浏览器里可能提前或延迟触发，
      // 每 200ms 复查 readyState，达标就撤转圈。
      var readyTimer = setInterval(clearLoadingIfReady, 200);
      // 【防卡死】readyState 一直到不了 3（网络卡住/上游慢）时，转圈不能无限转下去——
      // 那会让用户以为"还在加载"，实际上什么都没发生。
      // 15s 后无论 readyState 如何都撤掉转圈；若仍未就绪，按钮保持可点（再点会重新拉流）。
      var loadGuard = setTimeout(function () {
        root.classList.remove('is-loading');
      }, 15000);
      audio.addEventListener('error', function () {
        clearInterval(readyTimer);
        clearTimeout(loadGuard);
      });
      audio.addEventListener('loadedmetadata', function () {
        root.classList.add('is-ready');
        paint();
      });
      audio.addEventListener('timeupdate', function () {
        if (!dragging) paint();
      });
      // 【2026-10-29 主人第 6 条】点下播放后要**先显示转圈，等资源真的能放再切暂停键**。
      // 关键在于听 'playing'（已有足够数据、真正开始输出声音）而不是 'play'
      // （只是"被要求播放"，此时可能还在缓冲）。原实现听 'play' 并顺手去掉 is-loading，
      // 导致慢网下转圈一闪而过、图标立刻变成暂停，像是在播而实际没声音。
      audio.addEventListener('playing', function () {
        root.classList.add('is-playing');
        // 【不再在这里清 is-loading】'playing' 可能早于缓冲完成触发，
        // 由 canplay / canplaythrough / 轮询按 readyState>=3 来撤转圈，见上面。
        clearLoadingIfReady();
        setBgm('playing');
      });
      audio.addEventListener('pause', function () {
        root.classList.remove('is-playing');
        setBgm('');
      });
      audio.addEventListener('ended', function () {
        root.classList.remove('is-playing');
        setBgm('');
        paint();
      });
      audio.addEventListener('error', function () {
        root.classList.add('is-error');
        root.classList.remove('is-playing', 'is-loading', 'is-ready');
        durEl.textContent = '不可用';
        btn.setAttribute('aria-label', '音源不可用');
        btn.disabled = true;
        btn.style.cursor = 'default';
      });
      return audio;
    }

    btn.addEventListener('click', function () {
      var a = ensure();
      if (a.paused) {
        // 先上转圈，再发起播放：顺序反了会出现"资源秒到、转圈来不及显示"的闪烁。
        // 只有 'playing' 事件（真正能出声）才会清掉它，见 ensure() 里的监听。
        root.classList.add('is-loading');
        // 走 play() 的 promise：被浏览器策略拦下时把转圈收回，不留假加载状态
        var p = a.play();
        if (p && p.catch) {
          p.catch(function () {
            root.classList.remove('is-loading', 'is-playing');
          });
        }
      } else {
        a.pause();
        root.classList.remove('is-loading');
      }
      btn.blur();
    });

    function seekFromEvent(e) {
      var a = ensure();
      var r = track.getBoundingClientRect();
      var p = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      var d = a.duration;
      if (!isFinite(d) || d <= 0) return;
      a.currentTime = p * d;
      paint();
    }

    track.addEventListener('pointerdown', function (e) {
      dragging = true;
      if (track.setPointerCapture) track.setPointerCapture(e.pointerId);
      seekFromEvent(e);
    });
    track.addEventListener('pointermove', function (e) {
      if (dragging) seekFromEvent(e);
    });
    track.addEventListener('pointerup', function (e) {
      dragging = false;
      if (track.releasePointerCapture) {
        try { track.releasePointerCapture(e.pointerId); } catch {}
      }
    });
    // 拖出轨道后松手也要结束拖拽状态，否则进度条会一直跟着鼠标
    track.addEventListener('pointercancel', function () {
      dragging = false;
    });

    // 键盘：左右 ±5 秒，Home/End 跳到首尾。空格交给按钮本身（不在这里抢）。
    track.addEventListener('keydown', function (e) {
      var a = ensure();
      if (!isFinite(a.duration) || a.duration <= 0) return;
      var step = 5;
      if (e.key === 'ArrowLeft') a.currentTime = Math.max(0, a.currentTime - step);
      else if (e.key === 'ArrowRight') a.currentTime = Math.min(a.duration, a.currentTime + step);
      else if (e.key === 'Home') a.currentTime = 0;
      else if (e.key === 'End') a.currentTime = a.duration;
      else return;
      e.preventDefault();
      paint();
    });

    /* 【2026-10-29 主人「移动端播放 bgm 时用手势从详情页退回曲目页，音乐不会停」】
       根因：Audio 对象是 JS 持有的，浏览器**不会**因为"页面被导航走"就自动暂停它——
       尤其在 iOS Safari / 微信里用手势返回时，页面进 bfcache，DOM 还在、Audio 还在播。
       所以必须自己监听页面生命周期：
         · pagehide：页面离开（含进 bfcache、被卸载）→ 立即暂停并复位；
         · visibilitychange：切到后台/切标签 → 也暂停（移动端音频在后台继续放很扰人）；
         · bfcache 恢复（pageshow 的 persisted=true）→ 保持暂停状态，不自动续播，
           用户回来看到的是暂停中的播放器，需要再点一次。
       另外必须清掉 html[data-bgm]，否则唱片在用户返回后仍显示旋转。 */
    function stopAndReset() {
      if (audio && !audio.paused) {
        try { audio.pause(); } catch (e) { /* 已卸载时个别浏览器会抛，忽略 */ }
      }
      root.classList.remove('is-playing', 'is-loading');
      setBgm('');
    }
    window.addEventListener('pagehide', stopAndReset);
    // bfcache 命中（Chromium / Firefox / Safari 都会）——页面没真正销毁时也要复位
    window.addEventListener('beforeunload', stopAndReset);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') stopAndReset();
    });
    // 从 bfcache 返回：确保 UI 与状态都是"暂停"，而不是停在播放态
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) {
        root.classList.remove('is-playing', 'is-loading');
        setBgm('');
        paint();
      }
    });

    paint();
  })();
</script>
