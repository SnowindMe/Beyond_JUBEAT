---
// 世代主题切换：15 套配色（clan 一个世代拆 4 套）+ 背景交叉淡入，选择记在 localStorage
// 换图需要现下时才亮 LOADING（由 BootScreen.astro 暴露的 window.jbBoot 控制）
// 用 is:inline 保持原样（不打包、在解析到此处时立即执行）
---
<script is:inline>
(function(){
  // 顺序 = 游戏世代新→旧（主人 2026-10-20 指定）。n 是切换器里显示的正式写法，
  // k 是内部 key，同时决定 /assets/images/bg/<k>.webp 与 logo/<k>.webp 的文件名。
  var GEN=[
    {k:'ripples',n:'ripples',f:'F',c:'#70c5b7'},
    {k:'knit',n:'knit',f:'D',c:'#e0a92e'},
    {k:'copious',n:'copious',f:'F',c:'#8fa6ff'},
    {k:'saucer',n:'saucer',f:'F',c:'#3aa8c8'},
    {k:'saucerfulfill',n:'saucer fulfill',f:'F',c:'#c9d2d6'},
    {k:'prop',n:'prop',f:'E',c:'#e0338f'},
    {k:'qubell',n:'Qubell',f:'D',c:'#c98a3c'},
    {k:'clan_red',n:'clan Red',f:'C',c:'#ff6b6b'},
    {k:'clan_blue',n:'clan Blue',f:'C',c:'#5c8dff'},
    {k:'clan_green',n:'clan Green',f:'C',c:'#57d98a'},
    {k:'clan_purple',n:'clan Purple',f:'C',c:'#b07dff'},
    {k:'festo',n:'festo',f:'G',c:'#ffd166'},
    {k:'ave',n:'Ave.',f:'F',c:'#2ee8e8'},
    {k:'bta',n:'Beyond the Ave.',f:'F',c:'#ffa23c'},
    {k:'yymf',n:'音乐魔方',f:'F',c:'#8fd0ff'}
  ];
  var BG='/assets/images/bg/';
  // 字标：首屏只加载当前世代那一张，切主题时才换 src（原先 10 张一起下载，浪费 ~150KB）
  var LOGO='/assets/images/logo/';
  var root=document.documentElement, dock=document.getElementById('genDock');
  var wordLogo=document.getElementById('wordLogo');
  var btns={}, cur=null;
  GEN.forEach(function(g){
    var b=document.createElement('button');
    b.type='button'; b.title=g.n;
    b.style.setProperty('--sw',g.c);
    b.innerHTML='<i></i><span>'+g.n+'</span>';
    b.addEventListener('click',function(){apply(g);});
    dock.appendChild(b); btns[g.k]=b;
  });

  /* 主题切换动画：背景交叉淡入。
     body::after 的 background-image 本身不可过渡（浏览器把它当离散值，切图即硬跳），
     所以另起 .bgv 两层背景板：旧图留在 A/B 中当前那张，新图铺到另一张再淡入，
     opacity 走 GPU 合成，切主题时图是「渐变过去」而不是「闪一下」。 */
  var bgv=document.querySelectorAll('.bgv-l'), vf=0;
  function paint(g){
    var url='url("'+BG+g.k+'.webp")';
    var nx=bgv[(vf+1)%bgv.length];
    nx.style.backgroundImage=url;
    nx.style.opacity='1';
    bgv[vf].style.opacity='0';
    vf=(vf+1)%bgv.length;
  }
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* 切世代要不要「等」，不靠猜：一律走 bootApi.begin(160)。
     160ms 内新背景与新字标就位（缓存命中时就是这样），遮罩根本不会出现；
     真要从网上拉图，160ms 后自动亮起 LOADING，等图铺好再收。 */
  var bootApi = window.jbBoot;

  /* 本页已经真正拿到过的图。有了这张表，「缓存命中」就不用靠 160ms 猜，
     可以直接完全跳过遮罩——本地切换世代零闪烁靠的就是它。 */
  var loaded = {};
  function logoUrl(g){ return LOGO + (g.k.indexOf('clan_')===0 ? 'clan' : g.k) + '.webp'; }
  function bgUrl(g){ return BG + g.k + '.webp'; }
  function sync(g){ loaded[bgUrl(g)] = 1; loaded[logoUrl(g)] = 1; }

  /* 换世代要下载两样东西：背景大图 + 字标。两样都到齐了才撤遮罩，
     否则会出现「遮罩收了但背景还是空白」的那一下。 */
  function waitImages(g, done) {
    var lu = logoUrl(g), bu = bgUrl(g);
    var left = 2, closed = false;
    function tick(url) {
      if (closed) return;
      loaded[url] = 1;
      left--;
      if (left > 0) return;
      closed = true;
      // 不包 rAF：图已在内存里，commit 时写进 .bgv 的 backgroundImage 与遮罩收起
      // 是同一次样式更新，浏览器同一帧提交，不会露出空白。而 rAF 在窗口失焦/后台
      // 会被节流到 1s 一次，那样遮罩就会多挂一秒——实测踩过这个坑。
      done();
    }
    [bu, lu].forEach(function (url) {
      var img = new Image();
      img.onload = function () { tick(url); };
      img.onerror = function () { tick(url); };
      img.src = url;
    });
    // 兜底：2.6s 还没齐也别把人锁住
    setTimeout(function () {
      if (closed) return;
      closed = true;
      done();
    }, 2600);
  }

  /* theme-color：手机浏览器地址栏/状态栏的颜色。原来写死 #0b1a22，15 套主题里 0 套对。
     现在跟着当前世代的 --base 走：读的是 <html> 上解析后的 --base，
     所以换世代只要在 commit() 里同步一次，不用在 JS 里再维护一份色表。 */
  var metaTheme=document.querySelector('meta[name="theme-color"]');
  function syncThemeColor(){
    if(!metaTheme) return;
    var base=getComputedStyle(root).getPropertyValue('--base').trim();
    if(base) metaTheme.setAttribute('content',base);
  }
  function commit(g,instant){
    var prev=cur; cur=g;
    root.setAttribute('data-g',g.k);
    root.setAttribute('data-font',g.f);
    syncThemeColor();
    if(wordLogo){
      // 四个 clan_* 世代共用同一张 clan 字标
      var next=logoUrl(g);
      if(wordLogo.getAttribute('src')!==next) wordLogo.setAttribute('src',next);
    }
    root.style.removeProperty('--bgimg');
    root.style.removeProperty('--bgop');
    for(var k in btns){btns[k].setAttribute('aria-pressed',k===g.k?'true':'false');}
    if(instant||reduce||!prev){
      // 首屏直接落图，不要从空白淡进来
      for(var i=0;i<bgv.length;i++){bgv[i].style.transition='none';}
      bgv[0].style.backgroundImage=bgv[1].style.backgroundImage='url("'+BG+g.k+'.webp")';
      bgv[0].style.opacity='1'; bgv[1].style.opacity='0';
      vf=0;
      // 关键：必须把 transition 还回去，否则首屏这一下会把「永不过渡」写死在元素上，
      // 之后每次切主题都是硬跳（这正是要修的那个闪一下）。
      void bgv[0].offsetWidth;
      for(var j=0;j<bgv.length;j++){bgv[j].style.transition='';}
    }else{
      paint(g);
    }
    try{localStorage.setItem('jubeat-gen',g.k);}catch(e){}
  }

  function apply(g,instant){
    var prev=cur;
    if(instant||reduce||!prev){ commit(g,true); sync(g); return; }
    // 这两张图本页已经拿到过：直接换，一点遮罩都不挂（本地切世代就是这条路）
    if(loaded[bgUrl(g)]===1 && loaded[logoUrl(g)]===1){ commit(g,false); return; }
    // 真要现下：先挂一个「160ms 后才亮」的遮罩，够快就自动作废
    var endBoot = bootApi ? bootApi.begin(160) : null;
    commit(g,false);
    var closed=false;
    function stop(){
      if(closed) return; closed=true;
      if(endBoot) endBoot();
    }
    waitImages(g, stop);
    setTimeout(stop, 3000);
  }

  var saved='ave';
  try{saved=localStorage.getItem('jubeat-gen')||'ave';}catch(e){}
  var hit=GEN.filter(function(g){return g.k===saved;})[0]||GEN[0];
  apply(hit,true);

  var tswBtn=document.getElementById('tswBtn'), tswPop=document.getElementById('tswPop'), tsw=tswBtn.parentNode;
  /* 焦点管理（2026-10-23 无障碍收口）：
     打开：把焦点送进弹层第一个（或当前选中的）世代按钮——键盘用户不必再 Tab 一次才进得去；
     关闭：把焦点还给 #tswBtn——否则焦点会留在已被 visibility:hidden 摘掉的按钮上，
     读屏与键盘的下一次 Tab 就从「不存在的位置」算起。
     opts.returnFocus=false 用于点击弹层外关闭：那种情况焦点本来就在别处，抢回来反而烦人。 */
  function setOpen(v, opts){
    tswPop.setAttribute('data-open',v?'1':'0');
    tswBtn.setAttribute('aria-expanded',v?'true':'false');
    if(v){
      var target = tswPop.querySelector('button[aria-pressed="true"]') || tswPop.querySelector('button');
      if(target) target.focus();
    } else if(!opts || opts.returnFocus!==false){
      // 只有焦点还在弹层里（或已掉到 body）时才还，避免和用户刚点的目标抢焦点
      var act=document.activeElement;
      if(!act || act===document.body || tswPop.contains(act)) tswBtn.focus();
    }
  }
  tswBtn.addEventListener('click',function(ev){
    ev.stopPropagation();
    setOpen(tswPop.getAttribute('data-open')!=='1');
  });
  document.addEventListener('click',function(ev){
    if(tsw.contains(ev.target)) return;
    if(tswPop.getAttribute('data-open')==='1') setOpen(false,{returnFocus:false});
  });
  document.addEventListener('keydown',function(ev){
    if(ev.key!=='Escape') return;
    if(tswPop.getAttribute('data-open')!=='1') return;
    setOpen(false);
  });
})();
</script>