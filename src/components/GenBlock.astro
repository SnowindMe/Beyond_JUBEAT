---
// 世代块：一个世代标题（吸顶）+ 该世代下的曲目网格。
//
// 为什么抽成组件（2026-10-24）：「全部分区」视图与「单分区」视图都要渲染世代块，
// 两份拷贝会漂——改一处忘另一处是今晚反复踩的坑（sc-skip 挪位只加没删）。
// 组件化后两种视图只有「传哪些曲目进来」的区别。
import SongCard from './SongCard.astro';
import type { Song } from '../lib/db';

type Props = {
  gen: string;
  list: Song[];
  year: string;
  eager: Set<string>;
  srv?: 'jp' | 'cn';
  /** 是否在卡片上画 PICK UP 标记（只有 /songs/ 传 true，世代页不画），见 SongCard 的说明 */
  markPick?: boolean;
};

const { gen, list, year, eager, srv = 'jp', markPick = false } = Astro.props;

// 说明：content-visibility 的占位高度（contain-intrinsic-size）不在这里算。
// 列数由 .sc-grid 的 auto-fill 随容器宽度连续变化，服务端拿不到，只能由页面脚本
// 实测后写到 .sc-gen 的行内样式上 —— 逻辑与公式见 src/pages/songs.astro 的 refreshIntrinsic()。
---
<div class="sc-gen" data-y={year || '0'} data-gen={gen}>
  <div class="sc-gen-h">
    {/* 【2026-10-28】原先世代名是链接，点进单独的世代筛选页 /songs/gen/<slug>/。
        主人要求删掉那页，于是退回纯文字。
        【2026-10-30 主人新要求「点击世代名可以跳转到下一世代」】改回可点击，
        但**不再是链接**（不跳页、不改 URL），而是页面内按钮：
        点一下滚到下一个有内容的世代块，到最后一个则回到第一个，循环。
        为什么不写成 <a>：目标块是同页锚点，用 a 会改 URL、进历史栈，
        返回键会莫名其妙回到同一页；用 button + scrollIntoView 更干净。
        具体跳转逻辑在 src/pages/songs.astro 的 genJump() —— 那里能拿到
        「当前哪些世代块是可见的」（筛选后会有块被藏起来，只该跳到可见的下一个）。 */}
    <button type="button" class="sc-gen-b" data-gen-jump aria-label={`跳到下一世代（当前：${gen}）`} title="点击跳到下一世代">
      <b>{gen}</b>
    </button>
    {year && <span>{year}</span>}
    <i>{list.length}</i>
  </div>
  <div class="sc-grid">
    {list.map((s) => (
      <SongCard song={s} eager={eager.has(s.id)} srv={srv} markPick={markPick} />
    ))}
  </div>
</div>
