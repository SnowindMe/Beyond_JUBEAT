---
import Layout from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SiteLinks from '../components/SiteLinks.astro';
// 【2026-11-12】Fortune / HotBoard 两块先下线（见下方注释），import 一并注释掉，
// 否则 Astro 会把两个组件打进产物。将来恢复时取消注释即可。
// import Fortune from '../components/Fortune.astro';
// import HotBoard from '../components/HotBoard.astro';
import data from '../data/data.json';
import { pageTitle } from '../lib/title';
import { GEN_JP, GEN_CN } from '../lib/gens';
import { THEMES } from '../lib/themes';
// 主题套数（theme.css 里 html[data-g] 的皮肤套数）与世代数不是一回事：
// 主题表在 lib/themes.ts，clan 一个世代在那里拆成 4 套皮肤，所以主题数不等于世代数。
// 两个数都读各自的数组长度，别在页面里另写死——这两个数都写死过，然后就与表打架了。
const THEME_COUNT = THEMES.length;

// 【2026-11-03 起首页是 SSR】「今日运势 / 热门歌曲」要读 D1 的每日快照，
// 构建期没有那一天的数据，静态页会永远停在发版那天。
// 代价是首页每次请求都过 Worker：快照读的是 KV（毫秒级），
// 而且中间件那层边缘缓存对它同样生效，不会真的每次打 D1。
export const prerender = false;
---

<Layout
  title={pageTitle('首页')}
  canonicalPath="/"
  description={`jubeat 音乐魔方中文资料站：日服 ${GEN_JP.length} 个世代、国服 ${GEN_CN.length} 个世代，共 ${data.stat.songs} 首曲目、${data.stat.charts} 张谱面，其中 ${THEME_COUNT} 套世代主题可切换。`}
>
  <Hero />

  {/* 【2026-11-12 主人「【今日运势】和【热门歌曲】先隐藏了，以后可能换个实现」】
      两块先下线，组件文件留在 components/Fortune.astro、HotBoard.astro 不动
      （样式在 styles/fortune.css、hot.css 里也一并保留），将来换实现时直接接着改。
      注意：首页 export const prerender = false 一开始是为了这两块读 D1/KV 快照，
      它们下线后首页其实可以回到预渲染——但那是另一次改动的收益与风险（路由/WorKer
      首处理配置要一起看），这次不顺手改。 */}

  {/* 友链 / 数据来源 / 设计参考（2026-11-01 主人要求，放在首页那条横向分隔线处）。
      位置在 Hero 与站点标识区之间：读者看完首屏、还没到落款时，
      先看到「这些数据从哪来」——比塞进页脚更容易被读到。 */}
  <SiteLinks />

  {/* 站点标识区（2026-10-27 主人要求）：原来在页脚右下角的小号 logo + 品牌字
      挪到这里，在首页用一个居中的 div 放大显示。品牌字沿用顶栏 .mark 的世代字体
      与符号（↑ ♪ ~）处理，标识图用 .mark-logo 的同款写法但尺寸放大。 */}
  <div class="brandblock" translate="no">
    <span class="mark mark-bk">
      <img class="mark-logo" src="/assets/images/logo/brand.webp?v=2" alt="" aria-hidden="true" width="126" height="96" decoding="async" />
      <span class="mark-x">
        <b>Beyond <span class="sym">↑</span> JUBEAT <span class="sym">♪</span><span class="til">~</span></b>
        {/* 品牌字下方的副标（主人 2026-10-27 定稿文案；
            顶栏标识下的副标是 Jubeat further, explore MORE，两处不同，不要抄串） */}
        <span>Enjoy JUBEAT, Enjoy Life, Enjoy Friend, And Enjoy Yourself</span>
      </span>
    </span>
  </div>
</Layout>