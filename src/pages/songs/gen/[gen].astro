---
// 世代筛选页：/songs/gen/<slug>/ 一个世代一页（共 13 个世代 → 13 个 url）。
//
// 为什么是 SSR（prerender = false）：曲目数据在 D1，构建期既不知道新增曲目，
// 也不该为了一个世代页预渲染上千张卡；和 /songs/、详情页保持同一条数据路径。
// 世代本身是静态口径（lib/gens.ts），所以「页存在与否」在构建期就定了，
// 未知 slug 直接回 404 + noindex——不是 500，也不是跳转。
//
// 卡片复用 components/SongCard.astro（和 /songs/ 同一份），排序沿用桶内的
// 「EXT 定数降序 → 曲名升序」，两页看到同一个世代时顺序一致。
import Layout from '../../../layouts/Base.astro';
import '../../../styles/songs.css';
import SongCard from '../../../components/SongCard.astro';
import NotFound from '../../../components/NotFound.astro';
import { pageTitle } from '../../../lib/title';
import { GEN_ORDER, SRV_LABEL, genBySlug } from '../../../lib/gens';
import { getAllSongs, type Song } from '../../../lib/db';
import { env } from 'cloudflare:workers';

export const prerender = false;

// 这里不写 getStaticPaths：本页是 SSR（prerender = false），Astro 会忽略它并报警告。
// 13 个合法 slug 由 lib/gens.ts 的 GEN_ORDER 决定，URL 合法与否在运行时判（未知 → 404）。
const { gen } = Astro.params;
const meta = genBySlug(gen);

// 未知 slug：原地回 404（不 302 到 /404，URL 不变，符合 HTTP 语义），并且 noindex。
// 注意下面的派生值全部要判空——否则 meta 为 undefined 时读 meta.k 会抛 TypeError，
// 线上表现就是 500 而不是 404（详情页踩过同一个坑）。
if (!meta) {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=0');
}

const ALL: Song[] = meta
  ? await getAllSongs((env as { beyond_jubeat?: D1Database })?.beyond_jubeat)
  : [];

// 该世代的曲目：gen_name 就是精确归属（一个世代只属于一个服务器），
// 不再过 inView 的服务器标志——双服都有的那一行也得出现在所属世代里。
const LIST: Song[] = meta ? ALL.filter((s) => s.gen === meta.k) : [];

const extOf = (s: Song) => s.lv.ext ?? -1;
LIST.sort((a, b) => extOf(b) - extOf(a) || a.t.localeCompare(b.t));

if (meta) {
  Astro.response.headers.set(
    'cache-control',
    'public, max-age=30, s-maxage=300, stale-while-revalidate=60'
  );
}

// 分区构成：这个世代的曲目在各分区下各有几首（日服世代只有 版权/原创，
// 音乐魔方 世代有三个分区）。只列非零，避免摆一排 0。
const catTally = new Map<string, number>();
for (const s of LIST) catTally.set(s.cat, (catTally.get(s.cat) ?? 0) + 1);
const CATS_OF_GEN = [...catTally.entries()].sort((a, b) => b[1] - a[1]);

// 同服务器下的其他世代（页脚内链：13 个世代页互相通，别让任何一页成为孤岛）
const SIBLINGS = meta ? GEN_ORDER.filter((g) => g.s === meta.s && g.k !== meta.k) : [];

const lvRange = (key: 'bsc' | 'adv' | 'ext') => {
  const vals = LIST.map((s) => s.lv[key]).filter((v): v is number => v != null);
  return vals.length ? `${Math.min(...vals)}–${Math.max(...vals)}` : '—';
};

// 卡片入场只给可见的前十几张错开（一个世代最多 225 张，全做动画没有意义）。
const STAGGER = 12;
---

{!meta ? (
  <Layout title={pageTitle('页面不存在')} canonicalPath="" noindex>
    <NotFound />
  </Layout>
) : (
  <Layout
    title={pageTitle(`${meta.k} 世代曲目`)}
    canonicalPath={`/songs/gen/${meta.slug}/`}
    description={`jubeat ${meta.k}（${SRV_LABEL[meta.s]}，${meta.y}）世代共 ${LIST.length} 首曲目，按 EXT 定数降序排列：${CATS_OF_GEN.map(([c, n]) => `${c} ${n} 首`).join('、')}。BSC/ADV/EXT 定数范围 ${lvRange('bsc')} / ${lvRange('adv')} / ${lvRange('ext')}。`}
  >
    <section class="band sg" id="genRoot">
      <nav class="sg-crumb" aria-label="面包屑">
        <a href="/songs/">曲目库</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{meta.k}</span>
      </nav>

      <header class="sg-head">
        <p class="sg-kicker">{SRV_LABEL[meta.s]} · {meta.y}</p>
        <h1 class="sg-title">{meta.k}</h1>
        <p class="sg-sub">
          <b>{LIST.length}</b> 首曲目
          {CATS_OF_GEN.length ? <span class="sg-cats">{CATS_OF_GEN.map(([c, n]) => `${c} ${n}`).join(' · ')}</span> : null}
        </p>
      </header>

      {/* 直接铺 SongCard，不套额外容器：套一层会让 .sc-card 不再是网格项，
          间距规则要重写一遍（而那正是"复制第二份卡片"开始的地方）。
          入场动画只给前 STAGGER 张，靠 CSS 的 nth-child 限定，见 songs.css 的 .sg-grid。 */}
      <div class="sc-grid sg-grid">
        {LIST.map((s, i) => (
          <SongCard song={s} eager={i < STAGGER} />
        ))}
      </div>

      {SIBLINGS.length ? (
        <nav class="sg-more" aria-label="同服务器的其他世代">
          <h2 class="sg-more-h">{SRV_LABEL[meta.s]}的其他世代</h2>
          <div class="sg-more-l">
            {SIBLINGS.map((g) => (
              <a href={`/songs/gen/${g.slug}/`}>{g.k}</a>
            ))}
          </div>
        </nav>
      ) : null}
    </section>
  </Layout>
)}
