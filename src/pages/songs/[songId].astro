---
// 曲目详情页：按 song_id 查 D1 单行。
// 和 /songs/ 一样是 SSR（prerender = false）：曲库在 D1，构建期不知道有哪些 id，
// 也不能给上千首曲目逐个预渲染静态页——新增曲目会漏、改一次数据要全量重建。
import Layout from '../../layouts/Base.astro';
import '../../styles/songs.css';
import { pageTitle } from '../../lib/title';
import { GEN_ORDER } from '../../lib/gens';
import NotFound from '../../components/NotFound.astro';
import SongAudio from '../../components/SongAudio.astro';
import HoldMarker from '../../components/HoldMarker.astro';
import { getSongById, type Song } from '../../lib/song-data';
import { LEVELS, gauge, dash as dashLv, HOLD_PCT_MAX } from '../../lib/difficulty';
// 曲目标签（2026-11-19）：每档下面一栏「配置 / 难度 / 评价」，登录玩家可增删。
// 词表在 lib 里、渲染在这里、校验在 /api/song-tags，三处只有一份词表。
// 种子来自 data/song-tags.json（构建期内联），库里存的（玩家提交）优先并覆盖人数。
import { TAG_KIND_LABEL, TAG_WORDS, KINDS_BY_DIFF, type TagKind } from '../../lib/song-tags';
import tagSeed from '../../../data/song-tags.json';
import { jacketUrl } from '../../lib/covers';
// 键数分位 / 长押率基准：**构建期预计算**的静态数据，运行时只读。
// 【2026-11-01 线上事故，别改回现算】最初写成每次请求调 buildDifficultyStats()，
// 要对 1248 首 × 3 档做分桶 + 60 万次内层循环（实测 77 ms），
// CF Worker 的 CPU 预算撑不住，详情页直接 500。
// 这组统计只随曲库变、与请求无关，构建期算一次落盘才是对的。
import diffStatsJson from '../../data/difficulty-stats.json';
import { env } from 'cloudflare:workers';
// BGM 试听映射（本站 songId → 上游相对路径），由 scripts/ub/build-ub-audio.cjs 生成。
// 打包期内联进 Worker，运行时不读文件；未命中的曲目说明上游没有音源，不渲染播放器。
import audioMap from '../../data/ub-audio.json';
// 已搬进 R2 的音源（id → key）。2026-11-18 起国服音乐魔方代 63 首走 R2，
// 优先于上游；这里只用来判「有没有音源」，取用顺序在 /api/audio 里。
import r2AudioMap from '../../data/audio-map.json';
// 具体上传者登记（2026-11-22）：R2 里的音频不全是同一个人给的，来源徽章按曲目显示真名。
import audioSources from '../../data/audio-sources.json';
// 谱面密度数据**不再 import 进 Worker 包**。
// 【2026-11-01 主人「能不能不需要全量获得谱面，进入到歌曲详情页才加载」】
// 原先把整张表（1.07MB）import 进来，实测详情页 chunk 3.3MB，
// 而每次请求只用到其中一首（中位 961 字节），1200 首被批量访问时纯属浪费。
//
// 三种做法的实测对比：
//   ① 打进 Worker 包：用户 0 下载、无延迟，但 Worker 每次载入整表（原方案）。
//   ② 进页面再找 ub 拉：用户 +3KB、+3 次跨站（各 ~300ms），且 ub 挂了图就没了。
//   ③ **每首一个同源静态 JSON**（现方案）：用户 0 下载（同源、边缘缓存）、
//      单次约 20ms，Worker 只读这 1KB。取不到就整块不渲染。
// 产物：public/assets/diff/<songId>.json，由 scripts/ub/split-ub-charts.cjs 生成。

export const prerender = false;

const { songId } = Astro.params;
const db = (env as { beyond_jubeat?: D1Database })?.beyond_jubeat;
const song: Song | null = songId
  ? await getSongById((env as { ASSETS: Fetcher }).ASSETS, Astro.url.origin, songId, db, Astro.locals.cfContext)
  : null;

// 【2026-11-19 曲目标签】先铺词表当骨架（三档 × 三类，全空），再把种子与库里的并进来。
// 库里的覆盖种子：同名词取库里那条，种子里没有的也照样列出来——所以玩家新打的
// 一条能在刷新后立刻出现，不必等谁去改 data/song-tags.json。
// SSR 里直接查 D1 而不是像别名那样留给前端拉：标签是一屏 15 个格子，
// 分两段跳太晃；量也不大（单曲最多几十条），且详情页本来就 SSR。
const tagSeedOf = (tagSeed as { tags: Record<string, Record<string, Record<string, string[]>>> }).tags;
const tagRows =
  song && db
    ? (
        await db
          .prepare('SELECT diff, kind, name, count FROM song_tags WHERE song_id = ? ORDER BY count DESC, name ASC')
          .bind(String(song.id))
          .all<{ diff: string; kind: string; name: string; count: number }>()
      ).results ?? []
    : [];
const myTags = song && Astro.locals.user
  ? new Set(
      (
        await db!
          .prepare('SELECT diff, kind, name FROM song_tags WHERE song_id = ? AND by_user = ?')
          .bind(String(song.id), Astro.locals.user.id)
          .all<{ diff: string; kind: string; name: string }>()
      ).results?.map((r) => r.diff + '|' + r.kind + '|' + r.name) ?? [],
    )
  : new Set<string>();

/* 【2026-11-20 别名】主人「别名复用标签的设计」——所以同样在服务端先取一份
   给首屏用（列表很小），再由脚本用 /api/song-alias 校正（HTML 会过边缘缓存）。 */
const aliasRows = song && db
  ? (await db.prepare('SELECT name, by_user FROM song_alias WHERE song_id = ? ORDER BY created_at ASC')
      .bind(String(song.id))
      .all<{ name: string; by_user: string }>()).results ?? []
  : [];
const myAliases = new Set(
  aliasRows.filter((r) => Astro.locals.user && r.by_user === Astro.locals.user.id).map((r) => r.name),
);

/** 某档某类的最终列表：[{ name, count, mine, seeded }]，库里优先、种子补齐 */
function tagsOf(diff: string, kind: TagKind): { name: string; count: number; mine: boolean; seeded: boolean }[] {
  const out = new Map<string, { name: string; count: number; mine: boolean; seeded: boolean }>();
  for (const w of TAG_WORDS[kind] ?? []) out.set(w, { name: w, count: 0, mine: false, seeded: true });
  for (const w of tagSeedOf?.[String(song?.id)]?.[diff]?.[kind] ?? []) {
    out.set(w, { name: w, count: 0, mine: myTags.has(diff + '|' + kind + '|' + w), seeded: true });
  }
  for (const r of tagRows) {
    if (r.diff !== diff || r.kind !== kind) continue;
    out.set(r.name, {
      name: r.name,
      count: r.count,
      mine: myTags.has(diff + '|' + kind + '|' + r.name),
      seeded: out.get(r.name)?.seeded ?? false,
    });
  }
  // 已打的排前面（人数多的在前），未打的维持词表顺序
  return [...out.values()].sort((a, b) => b.count - a.count);
}

// 【2026-11-01 键数 / 长押的参照系】分位拿**全站同档谱面**当分母，
// 由 scripts/build-difficulty-stats.cjs 在构建期算好，这里只做查表。
// 存储形状是 [分位|null, 长押率|null] 的数组（压体积用），这里还原成具名对象。
const DIFF_BASELINE = (diffStatsJson as { baseline: { medianPct: number; sample: number } | null }).baseline;
const DIFF_RAW = (diffStatsJson as { stats: Record<string, [number | null, number | null]> }).stats;
const diffStats = {
  get: (k: string) => {
    const v = DIFF_RAW[k];
    if (!v) return null;
    return { notesPctl: v[0], holdPct: v[1], holdBaseline: DIFF_BASELINE };
  },
};

// 找不到就渲染 404 内容并回 404 状态码：原 URL 不变，符合 HTTP 语义，
// 也不会被搜索引擎当成「内容存在但跳走了」。不用 Astro.redirect——那会 302 到 /404，
// URL 变了之后浏览器地址栏显示的是 /404，用户复制出来的链接就丢了 songId。
if (!song) {
  Astro.response.status = 404;
}
// 404 结果不缓存（避免把「这首不存在」缓存到边缘，之后补数据也还能查到）
Astro.response.headers.set(
  'cache-control',
  song
    ? 'public, max-age=30, s-maxage=300, stale-while-revalidate=60'
    : 'public, max-age=0, s-maxage=0'
);

// 注意：以下派生值只在 song 存在时计算。之前漏了这层保护——song 为 null 时
// 直接读 song.gen 会抛 TypeError，线上表现为 500 而不是 404（真实踩坑）。
const genMeta = song ? GEN_ORDER.find((g) => g.k === song.gen) : undefined;

// 【2026-10-29 主人「唱片换成对应世代的颜色 + 加世代 logo」，
//   并明确「即使正在看 jubeat 的歌，只要切到 ripples 主题，也应当显示 jubeat 的颜色」】
//
// 所以这里**不能用 var(--acc)**——那是"当前主题色"，会随顶栏切主题而变。
// 要的是「这首歌所属世代」的固定色：曲子属于 jubeat，就永远是 jubeat 的蓝，
// 无论用户此刻套着哪套皮肤。所以把这些色值抄成本表常量。
//
// 色值来源：src/styles/theme.css 每个 html[data-g="x"] 块的 --acc
// （scripts/ci 里若有主题色改动，这里是唯一需要同步的手抄点；改色请两边一起改）。
// clan 在数据层只有一个世代，但主题层拆成 4 套；clan 系列的曲子改用 EXT 等级分段取色，
// 见下面的 clanColor()。
const GEN_COLOR: Record<string, string> = {
  jubeat: '#2f86e6',
  ripples: '#4fae9e',
  knit: '#e0a92e',
  copious: '#8fa6ff',
  saucer: '#37474F',
  'saucer fulfill': '#c9d2d6',
  prop: '#e0338f',
  Qubell: '#3E8FBF',
  festo: '#ffd166',
  'Ave.': '#2ee8e8',
  'beyond the Ave.': '#ffa23c',
  // 【2026-11-22 主人「U'nit 世代徽章底色会跟随主题变换而变色」】漏登记就落到 var(--acc)，
  // 跟着当前主题跑。补上 theme.css 里 unit 的 --acc（#e0a800），徽章与唱片才钉在本代色上。
  "U'nit": '#e0a800',
  音乐魔方: '#3f6fd8',
};

// 【2026-10-29 主人「clan 代的唱片和世代徽章颜色根据 EXT 等级来定：
//   7 级及以下绿、8 级蓝、9 级红、10 级紫」】
// clan 恰好自带四套主题色，这里按 EXT 分段取对应的那套，观感上是同一套视觉语言。
// 色值取自 theme.css：clan_green #57d98a / clan_blue #5c8dff /
// clan_red #ff6b6b / clan_purple #b07dff。
// 边界：EXT 为空（无谱面）时退回 7 级及以下的绿色——不留空色。
// 分段用「>= 10 → 紫，>= 9 → 红，>= 8 → 蓝，其余 → 绿」，
// 这样 10.5 这类超 10 的定数也落在紫段，不会漏进红段。
const CLAN_BY_EXT = [
  { min: 10, color: '#b07dff' }, // 紫
  { min: 9, color: '#ff6b6b' },  // 红
  { min: 8, color: '#5c8dff' },  // 蓝
  { min: -Infinity, color: '#57d98a' }, // 绿（7 级及以下）
];
const clanColor = (ext: number | null) => {
  const v = ext == null ? 0 : ext;
  for (const seg of CLAN_BY_EXT) if (v >= seg.min) return seg.color;
  return CLAN_BY_EXT[CLAN_BY_EXT.length - 1].color;
};

// 世代名（数据层）与 logo 文件名（主题层）是两套标识，不能直接拼：
//   Qubell→qubell、Ave.→ave、beyond the Ave.→bta、音乐魔方→yymf、saucer fulfill→saucerfulfill。
const GEN_LOGO: Record<string, string> = {
  jubeat: 'jubeat',
  ripples: 'ripples',
  knit: 'knit',
  copious: 'copious',
  saucer: 'saucer',
  'saucer fulfill': 'saucerfulfill',
  prop: 'prop',
  Qubell: 'qubell',
  clan: 'clan',
  festo: 'festo',
  'Ave.': 'ave',
  'beyond the Ave.': 'bta',
  "U'nit": 'unit',
  音乐魔方: 'yymf',
};
/* gen ink: saucer #37474F is 1.99:1 against #0b0f14 */
const inkOn = (hex) => {
  if (!hex) return '#0b0f14';
  const c = hex.replace('#', '');
  const lin = (v) => (v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4));
  const l =
    0.2126 * lin(parseInt(c.slice(0, 2), 16) / 255) +
    0.7152 * lin(parseInt(c.slice(2, 4), 16) / 255) +
    0.0722 * lin(parseInt(c.slice(4, 6), 16) / 255);
  return l < 0.3 ? '#ffffff' : '#0b0f14';
};
const genLogo = song ? GEN_LOGO[song.gen] : undefined;
// clan 走 EXT 分段取色，其余世代用固定色（见上面两处注释）
const genColor = song
  ? song.gen === 'clan'
    ? clanColor(song.lv.ext)
    : GEN_COLOR[song.gen]
  : undefined;

const dash = dashLv;
// 键数四位数（最高 1606）在窄卡里要读得快，加千分位
const fmtInt = (v: number) => v.toLocaleString('en-US');
const servers = song ? [song.jp ? '日服' : null, song.cn ? '国服' : null].filter(Boolean).join(' / ') : '';
const coverSrc = song?.cover ? jacketUrl(song.id, song.cover) : null;

// 定数刻度、难度顺序与空值显示已统一抽到 src/lib/difficulty.ts——
// 加一档难度或改上限只需改那一处，模板与样式不再各持一份。
// 【2026-11-01 难度卡片】主人要求「拓展难度条样式，希望能看到某个难度的一些基本信息」。
// 现在每个难度是一张卡：等级 + 定数 + 填充条 + 键数 / 每键均时 / 长押。
// 这三项全部来自库里已有字段（notecounts / holds / bpm），1248 首 100% 有键数，
// 不再新增任何数据列，也就不存在"线上 D1 忘灌导致静默失效"的风险。

// 音源来源：R2 优先（Jack大本 的投稿），否则上游 thregren；都没有则 null。
// 播放条上的「来源：XXX」徽章与 hasAudio 都取自这里，两处口径不能各算一份。
const audioSource: 'r2' | 'ub' | null = song
  ? (r2AudioMap as Record<string, string>)[String(song.id)]
    ? 'r2'
    : (audioMap as Record<string, string>)[String(song.id)]
      ? 'ub'
      : null
  : null;

// 具体上传者：登记过就显示登记的名字（Fruity / Album …），没登记才回落到「Jack大本」。
const audioUploader = song
  ? ((audioSources as Record<string, string>)[String(song.id)] ?? null)
  : null;

// 有没有音源：映射表命中才算。1222 首有（上游是日服谱面站，
// 国服原创曲、拿不到官方 id 的 BTA- 占位曲、以及 2026-10-29 刚上架那 7 首——
// 上游还没收录——本就没有），未命中的不摆空控件。
const hasAudio = !!(
  song &&
  ((r2AudioMap as Record<string, string>)[String(song.id)] ||
    (audioMap as Record<string, string>)[String(song.id)])
);

// ---------------------------------------------------------------------------
// 谱面密度数据（2026-11-01 主人「要不去 ub 拉取谱面文件吧，做个如图所示的 bar 条」）
//
// 每档给：逐小节键数 bars[]、时长 dur、bpm、上游 level。
// 【为什么先校验 level】ub 上有个别曲目还挂着旧版谱面（实测 paranoia 的 EXT 是 Lv8 老谱，
// 库里已是 Lv9.5，键数 563 vs 965 差 40%）。拿旧谱的节奏形态当当前谱面展示是错的，
// 所以上游 level 与库里定数不符时**整档不画密度条**，只留数字。
// 宁可少一张图，也不能给一张谎图。
// ---------------------------------------------------------------------------
/** 官方口径的谱面密度数据（见 scripts/ub/build-ub-charts.cjs 头注释）。 */
type ChartCols = {
  cols: number[];   // 115 列，每列的颗数
  dur: number;      // 时间轴秒数 = 最后一颗判定时刻 + 1s
  keys: number;     // 物量 = 单点×1 + 长押×2
  notes: number;    // 单点数
  holds: number;    // 长押数
  bpm: number;
  level?: string | null;
};
/** 柱高封顶层数（官方 8 层）。超过 8 颗的列按 8 层画，不压峰归一化。 */
const MAX_LAYERS = 8;



/**
 * 按 songId 取这一首的谱面密度（三档一起，约 1KB）。
 *
 * 【为什么用 ASSETS 绑定而不是 fetch】
 * 直觉写法是 fetch 自己的同源 URL，但那是**一次真实的 HTTP 请求**：
 * 在 Worker 里对同 zone 的 URL 发 fetch，可能走成外网回环、
 * 也可能因 zone 的缓存规则命中或不命中，行为不确定，还会额外算一次子请求。
 * ASSETS 绑定（wrangler.jsonc 里 assets.binding 已配）直接读静态资源层，
 * 不发网络、不占子请求配额，天然就是「边缘最近的副本」。
 *
 * 关于流量分摊（主人要求）：/assets/* **不在 run_worker_first 里**，
 * 所以浏览器直接请求这些文件时由 CF 静态资源层返回，根本不进 Worker；
 * 加上 public/_headers 里 /assets/diff/* 配了 1 年 immutable，
 * 边缘与浏览器都长缓存。而这份数据是**构建期快照**，
 * 运行时完全不碰 ub.thregren.world —— 上游不承担本站的读取流量。
 *
 * 拿不到就返回 null，与版本校验共用同一个兜底：整块不画，不摆假图。
 */
const loadCharts = async (id: string): Promise<Record<string, ChartCols> | null> => {
  try {
    const assets = (env as { ASSETS?: { fetch: (r: Request) => Promise<Response> } })?.ASSETS;
    const url = new URL(`/assets/diff/${id}.json`, Astro.url);
    // 开发期没有 ASSETS 绑定（astro dev 不起 workerd），退回直接读文件系统
    const res = assets
      ? await assets.fetch(new Request(url))
      : await fetch(url, { headers: { accept: 'application/json' } });
    if (!res.ok) return null;
    return (await res.json()) as Record<string, ChartCols>;
  } catch {
    return null;
  }
};
const charts = song ? await loadCharts(String(song.id)) : null;

/**
 * 取某一档的谱面密度；**版本对不上就返回 null**（整档不画）。
 *
 * 两道校验，缺一不可（实测数据：只靠 level 会漏 89/93 个）：
 *   ① level 不符：上游还挂着旧版谱面。实测 paranoia 的 EXT 在 ub 是 Lv8 老谱，
 *      库里已是 Lv9.5，键数 563 vs 965。
 *   ② **键数不符**：这一条更要紧——页面上「键数」显示的是库里的值，
 *      如果谱面文件算出来的键数与之不符，那么密度条画的就不是这一份谱面。
 *      实测 3493 个谱面里有 93 个键数对不上、但其中只有 4 个 level 也不符，
 *      所以光查 level 挡不住 89 个「定了同一定数但谱面被改过」的情况。
 *
 * 判据很简单：密度条必须和它旁边那个「N 键」说的是同一份谱面，否则宁可不画。
 */
const chartOf = (key: 'bsc' | 'adv' | 'ext') => {
  const c = charts?.[key];
  if (!c || !c.cols?.length) return null;
  const libNotes = song?.notecounts?.[key];
  // 【判据只有一条：键数必须一致】算出来的 ub 键数要等于库里那个官方物量。
  // 键数一致就说明「这确实是同一张谱面」，图形有效。
  //
  // 【2026-11-01 22:55 为什么去掉定数比对】主人原话「等级差异不按 ub 的来（等级都是官方的）」。
  // 库里的定数是官方值，ub 页上那一栏的 level 标签会滞后（实测 4 例：50000228 EXT 库 9.3 / ub 9，
  // 990000003 EXT 9.8/9.6，991000003 EXT 9.5/9.3，991000001 ADV 6/7——这四例的**键数全部相等**，
  // 谱面本身没问题）。用定数当判据会把「谱面对、只是标签旧」的四档误判成不可画。
  // 反过来，定数比对原先要防的「取错页」（如 paranoia 把 Lv8 老谱当现行谱）也由键数这一条
  // 完整抓住：老谱 563 键≠965 键，照样不画。所以定数判据是多余且有害的。
  if (libNotes != null && c.keys !== libNotes) return null;
  return c;
};

// 【2026-10-28 重设计·第三版】主人「这歌曲详情太小了」。
// 上一版（10-22）是「左栏 = 封面 + 4 项硬数据，右栏 = 曲名 + 定数条，底部条 = 其余」。
// 实测问题：左栏 4 项把 aside 撑到 ~450px，而右栏只有 ~250px，靠 align-self:center
// 硬居中 → 定数条下方空出一大块（140px+），面板显得又高又空。
// 这一版改成**唱片内页**的标准结构：
//   左栏只有封面（208px，视觉锤）；
//   右栏艺术主体：艺人 → 曲名 → 定数条（信息重心）；
//   全部元数据（songId / 世代 / 分区 / 服务器 / 上线 / 解禁 / 备注；BPM 在播放条徽章上）
//   统一收进底部横条——它本来就该是「唱片背签」式的密集小字区，铺满宽度。
// 好处：两栏高度接近，版面不用硬居中；元数据集中成一区比散落两处更好扫读。
// 仍然只渲染有值的项，不摆「—」占位。
// 【2026-10-29】songId / 世代 / 分区 三项已挪到曲名上方的徽章行，
// 这里不再重复——同一份信息出现两处，读起来像两个不同字段。
type Meta = { k: string; v: string; mono?: boolean };
const metaFoot: Meta[] = song
  ? [
      { k: '服务器', v: servers },
      // 【2026-10-31 主人「把如图的 BPM 给去掉」】BPM 已由播放条左上角的徽章承担，
      // 底部背签不再重复同一个字段（他此前也有「同一份信息别出现两处」的口径）。
      // 【2026-11-16 拆列】两服日期分开显示：有哪服的日期就显示哪条，不合并成一个「上线」。
      // 双服曲的两条日期常常不同（国服是上架、日服是首登），合成一格会读成同一个时间点。
      ...(song.dJp ? [{ k: '日服上线', v: song.dJp, mono: true }] : []),
      ...(song.dCn ? [{ k: '国服上线', v: song.dCn, mono: true }] : []),
      ...(song.unlock ? [{ k: '解禁', v: song.unlock }] : []),
      ...(song.kind === 'synthetic' ? [{ k: '备注', v: '官方 songId 暂缺，此处为占位 id' }] : []),
    ].filter((m) => m.v)
  : [];
---

<Layout
  title={pageTitle(song ? song.t : '页面不存在')}
  canonicalPath={song ? `/songs/${song.id}/` : ''}
  noindex={!song}
  description={song ? `${song.t}${song.a ? ' - ' + song.a : ''}｜jubeat ${song.gen} 世代，BSC ${dash(song.lv.bsc)} / ADV ${dash(song.lv.adv)} / EXT ${dash(song.lv.ext)}。` : undefined}
>
  {!song ? <NotFound /> : (
  // --gen-c = 本曲所属世代的固定色（与当前主题无关），由父级下发一次，
  // 后代 .sd-disc / .sd-badge-gen 都读它——"唱片颜色 = 世代徽章颜色"天然一致。
  <section
  class="band sd"
  id="songRoot"
  style={genColor ? '--gen-c: ' + genColor + '; --gen-ink: ' + inkOn(genColor) : undefined}
>
    {/* 顶部不再是「大圆角玻璃面板里塞一堆小方盒」，而是两栏唱片页式布局：
        左窄栏放曲绘与硬数据（像唱片封套背签），右栏让曲名与定数占据版面。
        曲绘原图只有 144px，放大必糊——所以不追求大图，做成贴合尺寸的实物感封面。 */}
    {/* 【2026-11-03 主人「给标记一套上一层容器限制」】面板外面再套一层容器 .sd-shell：
        唱片是以 left:-100px 挂在 .sd-cover 上的，cover 又坐在面板内边距里，
        所以唱片必然探出面板左缘 40+px；面板原本 overflow:visible，探出的部分直接跑到板外。
        交外层容器掌住：左侧预留 --sd-gutter 把悬出量吃进来，再 overflow:clip 兜底。
        head 与 body 一起放进来，返回/面包屑才对得上面板左缘。 */}
    <div class="sd-shell">
    <div class="sd-head">
      <a class="sd-back" href="/songs/">曲目库</a>
      <span class="sd-sep" aria-hidden="true"></span>
      <span class="sd-crumb">{song.gen}</span>
    </div>

    <div class="sd-body">
      <aside class="sd-aside">
        {/* 【2026-10-29 主人第 1 条】曲绘下面垫一张唱片，向左露出小半个；
            BGM 播放时唱片旋转（状态由 SongAudio 写在 html[data-bgm] 上）。
            唱片必须在曲绘之下（z-index 更低），露出的那一弯才像"从封套里抽出来"。
            结构：.sd-disc 是唱片本体（黑胶同心圆环），.sd-disc-spin 只是承载旋转的层，
            两者拆开是因为旋转要独立于居中定位，混在一起会让 transform 互相覆盖。 */}
        <div class="sd-cover" aria-hidden={coverSrc ? undefined : 'true'}>
          {/* 唱片（主人 2026-10-29 两次修正）：
              ① 盘面颜色 = 当前世代主题色（与世代徽章同源，都取 --acc）；
              ② 世代 logo **印在盘面上、随唱片一起转**，不是钉在圆心。
                 所以 logo 放进 .sd-disc-spin 里——那个层才是承载旋转的。
                 圆心只留一个装轴孔。 */}
          <span class="sd-disc">
            <span class="sd-disc-spin">
              {genLogo ? (
                <img
                  class="sd-disc-logo"
                  src={`/assets/images/logo/${genLogo}.webp`}
                  alt=""
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                />
              ) : null}
            </span>
            <span class="sd-disc-hole" aria-hidden="true"></span>
          </span>
          <div class={`sd-j${song.alt ? ' is-alt' : ''}`}>
            {coverSrc ? (
              <img src={coverSrc} alt={`${song.t} 曲绘`} width="208" height="208" loading="eager" fetchpriority="high" decoding="async" />
            ) : (
              <span class="sd-no">no jacket</span>
            )}
            {/* 长押标识（2026-11-12 起改 CSS 重绘，原 hold.gif 退役）：放在 .sd-j 内，
                overflow:hidden 会把角标裁在封套范围内。判定只认 has_hold === 1（null=未知不画）。
                原来的「[2] 长押谱」文案已按主人要求删除——那句话把 alt=1 说成了长押，
                而 alt=1 只是 [ 2 ] 谱面变体。结构与动画见 HoldMarker.astro + songs.css 的 .hm-*。 */}
            {song.hasHold === 1 ? <HoldMarker class="sd-hold" /> : null}
          </div>
        </div>
      </aside>

      <div class="sd-main">
        {/* 【2026-10-29 主人 4 条版式意见】
            ①songId 用 #10000036 的形式放到曲名**上方**；
            ②世代/分区做成两枚徽章、跟在 songId 右边（世代徽章用主题色，年份不要）；
            ③艺术家从曲名上方挪到**曲名下方**。
            顺序：songId + 世代徽章 + 分区徽章 → 曲名 → 艺术家。 */}
        <p class="sd-idline">
          <button type="button" class="sd-sid" data-copy={song.id} title="点击复制 songId">#{song.id}</button>
          {/* title：窄屏上世代名放不下时会被省略号截断（见 songs.css 的 .sd-badge-gen），
              全文靠它补回来。 */}
          <span class="sd-badge sd-badge-gen" title={song.gen}>{song.gen}</span>
          <span class="sd-badge sd-badge-cat">{song.cat}</span>
        </p>

        {/* 曲名：点一下复制歌名（主人 2026-10-29 要求）。用 button 而不是 h1 是为了
            可聚焦、可键盘触发；语义上仍用 h1 包住，标题层级不断。 */}
        <h1 class="sd-title-wrap">
          {/* 【2026-11-02 主人「移动端视图的歌曲缩到两行」】
              曲名文字包一层 span：行数限制（-webkit-line-clamp）只能作用在
              block / -webkit-box 上，直接写在 <button> 上不生效（实测按钮的
              display 被 UA 固定成 flow-root，clamp 只把高度收到 2.9 行）。
              包裹层只做「最多两行 + 省略号」，桌面端不设限，行为不变。 */}
          <button type="button" class="sd-title" data-copy={song.t} title="点击复制曲名">
            <span class="sd-title-t">{song.t}</span>
          </button>
        </h1>

        <p class="sd-artist">{song.a ?? '—'}</p>

        {/* 【2026-10-29 主人「把播放条弄到难度条上面」】
            顺序改为：曲名 → 艺人 → 试听条 → 定数条。理由（主人给的版面图）：
            播放是"听到这首"的入口，紧挨作品信息；定数条是数据区，压到下面。
            没有音源时试听条整块不渲染，定数条位置照旧。 */}
        {/* 【2026-11-19 主人「无论有无音源都显示播放条」】不再条件渲染：没有音源的曲目
            也走这一块，由组件内部切成禁用态（虚线轨道 + 置灰键 + 「暂无音源」）。 */}
        <SongAudio
          songId={String(song.id)}
          bpm={song.bpm}
          hasAudio={hasAudio}
          source={audioSource}
          sourceLabel={audioUploader}
        />

        {/* 【2026-11-09 别名块】玩家给曲目起的俗称（喇叭口、通称），参与全站搜索。
            主人定的位置：曲绘 / 播放条**下面**，不挤在曲名与艺人之间——
            曲名与艺人是「这首叫什么、谁做的」，别名是附注，压到作品信息之后才不打断阅读。
            未登录也整块渲染：访客看得见别人怎么叫这首，只是加不了。
            【2026-11-16 主人「顺便把歌曲详情页的别名模块先隐藏了」】
            用 hidden 藏起来而不是删：数据与交互都还是死的静态示例（「喇叭口」那三条写死在
            模板里，提交按钮没接接口），先不占版面。恢复时只去掉这里的 hidden 与下面那条
            注释里的 .sd-alias[hidden] 规则即可；grid-template-areas 的 alias 行留着不动，
            它只是多出一个零高的行，不影响别的行。 */}
      </div>

{/* 【2026-11-03 主人「是这两个重叠」】定数区从 .sd-main 里提出来，成为 .sd-body
          的直接子节点。它原本靠负 margin 横向扩到曲绘下方，纵向位置却由右栏内容决定，
          右栏比曲绘矮时左扩的那半截就压在曲绘上（816px 宽实测重叠 17px）。
          现在它是独立网格行 grid-area:gauge（见 songs.css 的 .sd-body），
          纵向由网格决定，结构上不可能再回贴到曲绘。 */}
        {/* 定数条：三条横条按 0-11 刻度填充，颜色沿用难度三色。
            定数是这个站最有信息量的字段，横条让「这首的难度分布」一眼可读
            （比如 BSC 短、EXT 长 = 高难曲）。
            【2026-10-29 主人「没有 bgm 的视图」】无音源时没有播放条占位，
            定数条会上移到曲绘高度；它又向左扩张到曲绘下方，于是被曲绘压住。
            给无音源加 .is-solo：把它推离曲绘底边（见 songs.css）。 */}
        {/* 【2026-11-01 难度卡片】主人「拓展一下难度条样式（做成难度卡片也行），
            我希望能看到某个难度的一些基本信息」。
            原来每档只是一行「标签 + 条 + 数字」，只有定数一个字段；现在每档是一张卡，
            把库里**已有**的谱面数据挂上去，不新增任何列：
              · 定数（原来的数值，变成卡片视觉重心）
              · 键数 notecounts[key]：1248 首 100% 覆盖，且每首键数都不同 → 纯信息增量
              · 长押 holds[key]：只在 >0 时出现。全库 852 首是 0，把「长押 0」印上去
                等于一列几乎没有差异的值（主人判过：多行重复同一值就不占版面），
                所以「没有长押」这件事用「不显示」来表达，卡片上每一项都有信息量。
                未抓到（98 首 holds 为 null）同样不显示，不拿「—」冒充「没有」。
            【被否掉的字段·每键均时】想过显示 键数 ÷ (BPM/60) 的「每秒按键数」，
            但换算出来 = 键数 × 60 / BPM，BPM 恒定的一首里它只是键数的线性缩放，
            读的人拿不到新东西；真正有意义的密度要按谱面时长算，而时长库里没有。
            宁可少一项，也不摆一个看不出所以然的数字。 */}
        <div class={`sd-gauge${hasAudio ? '' : ' is-solo'}`} role="group" aria-label="难度信息">
          {/* 【2026-11-19 主人「在 div.sd-gauge 开左右两个 div，别名、服务器、国服上线等等
              应该放在左侧 div，难度、标签放在右侧 div，标签单独一个 div，给这个 div 的
              左边框上主题色」】
              所以 gauge 内部是两栏：左 .sd-side（附注：别名 + 背签），
              右 .sd-read（读数：三档行 + 标签）。串行顺序（左先右后）只影响
              窄屏堆叠与读屏朗读顺序——两者都该先读到「这是哪首、哪个服」再读到难度。
              桌面上两栏靠 grid 并排，行的上下沿由 --sd-row-gap 之外的对齐规则管。 */}
          {/* 【2026-11-20 主人三条指令合起来的终态】
              ①「别名模块要放到 div.sd-lrow.sd-lrow-bsc 的上面（在 div.sd-read 里）」
              ②「dl.sd-foot 的数据先放到 div.sd-side 里」
              ③「dl.sd-foot 的布局要放到 div.sd-gauge 的下面（与 div.sd-gauge 分离）」
              「先放」= 数据留在左栏，但块本身要离开 gauge 独立成块（已与主人确认）。
              **左栏 .sd-side 仍保留**（主人随后一句「.sd-side 要保留，后续要加信息」）：
              它现在空着，是个占好位的附注槽，将来往里加东西不用再动布局。
              背签 dl 是 .sd-body 的 grid-area:foot 行，排在 gauge 之后、横跨整宽。
              别名进读数区顶部：它是「这首还叫什么」，与难度读数同一栏才读得顺。 */}
          <div class="sd-side">
          {/* 【2026-11-20 主人「把服务器，国服上线这些数据放在 sd-side」】——
              背签数据回到左栏附注槽里，块形态也随之回到竖排清单。
              文件名仍叫「背签」，类名改 .sd-meta：.sd-foot 这个名字让给评论区（见 gauge 之后）。 */}
          {metaFoot.length ? (
            <dl class="sd-meta">
              {metaFoot.map((m) => (
                <div class={m.k === '备注' ? 'is-wide' : undefined}>
                  <dt>{m.k}</dt>
                  <dd class={m.mono ? 'sd-num' : undefined}>{m.v}</dd>
                </div>
              ))}
            </dl>
          ) : null}
          </div>

          <div class="sd-read">
          {/* 【2026-11-20 主人「别名模块要放到 div.sd-lrow.sd-lrow-bsc 的上面（在
              div.sd-read 里）」。复用的是标签那套形态：默认空、登录才出现加号、
              已加的右上角带圈小叉（电脑 hover / 手机长按），未登录两样都没有。
              别名却是**圆角矩形、横排不换行**（主人「别名使用圆角矩形，无需每个别名一行」），
              和标签的竖排词钮不同——所以类名不共用，只共用交互脚本。
              点击别名是复制（主人「点击别名可以复制别名」），不是投票。
              数据：首屏由服务端 aliasRows 给一份，脚本随后用 /api/song-alias 校正。 */}
          <section class="sd-alias" aria-labelledby="sdAliasH" data-login={Astro.locals.user ? '1' : '0'}>
            <div class="sd-alias-head">
              {/* 计数 2026-11-20 按主人要求去掉：别名一栏本来就不长，数字只是重复「有几条」。
                  脚本里 data-alias-n 的赋值留着也不报错，只是没有元素可写。 */}
              <h2 class="sd-alias-h" id="sdAliasH">别名</h2>
            </div>
            <div class="sd-alias-ws" data-alias-ws>
              {/* 【2026-11-20 空态「暂无」】服务端判空直出，脚本拿到真数据后：有别名就把它删掉，
                  一条都没有则留着。原先试过无条件先铺「加载中…」，主人认为多余（本机 D1 命中很快，
                  那句话基本一闪而过），已改回直出结论。 */}
              {aliasRows.length === 0 ? <span class="sd-alias-ph" data-alias-ph>暂无</span> : null}
              {aliasRows.map((r) => (
                <button
                  type="button"
                  class={`sd-aliasw${myAliases.has(r.name) ? ' is-mine' : ''}`}
                  data-alias={r.name}
                  title="点击复制这个别名"
                >
                  {r.name}
                  {myAliases.has(r.name) ? (
                    <span class="sd-aliasw-x" data-alias-del={r.name} aria-label={`删除别名 ${r.name}`} role="button" tabindex="-1">
                      ×
                    </span>
                  ) : null}
                </button>
              ))}
              {/* 【2026-11-21 主人「别名默认最多两行，超出则在「＋」前放一个「v」展开更多」】
                  折叠靠给超出的药丸加 .is-over（display:none），不靠 max-height：
                  行高随字号变，量出来写死的高度换个字号就切到半个词。
                  只有真的超过两行才出现这枚 ∨（.sd-alias[data-more="1"] 时才显示）。 */}
              <button
                type="button"
                class="sd-aliasw sd-aliasw-more"
                data-alias-more
                aria-expanded="false"
                title="展开更多别名"
              >
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 4.5L6 7.5L9 4.5" />
                </svg>
              </button>
              <button type="button" class="sd-aliasw sd-aliasw-add" data-alias-add title="添加别名">
                ＋
              </button>
            </div>
            {/* 输入框弹在词行**下面**一层，不塞进词行（blur 会先把面板收掉） */}
            <form class="sd-alias-form" data-alias-form hidden>
              <label class="sd-sr" for="sdAliasInput">别名</label>
              <input
                id="sdAliasInput"
                class="sd-alias-input"
                data-alias-input
                type="text"
                maxlength="40"
                placeholder="俗称、通称、错记的写法…"
                autocomplete="off"
              />
              <button type="submit" class="sd-alias-ok">提交</button>
              <button type="button" class="sd-alias-cancel" data-alias-cancel>取消</button>
            </form>
          </section>
          {/* 【2026-11-02 主人「标记1的 5、10 可以不用」】顶部那把刻度尺整条删除。
              尺子本体只剩「5」「10」两个数字，去掉数字后它就不再承载信息了——
              0-11 的刻度仍由填充条上的 11 段细线表达（.sd-lrow-track::after），
              横向比例读得出来，数字是多余的注解。 */}
          {LEVELS.map(({ key, label }) => {
            const lv = song.lv[key];
            const notes = song.notecounts?.[key] ?? null;
            const holds = song.holds?.[key] ?? null;
            const st = diffStats?.get(`${song.id}|${key}`) ?? null;
            return (
              <div class={`sd-lrow sd-lrow-${key}${lv == null ? ' is-empty' : ''}`}>
                <span class="sd-lrow-k">{label}</span>
                {/* 【坑·2026-11-01】--fill 必须写在填充元素自己身上。
                    写在 .sd-lrow 上时，填充元素隔着 .sd-lrow-track 一层，
                    自定义属性**会继承**但 clip-path 里的 calc 拿不到有效长度，
                    实测三档全都填满 100%（213/213），定数 5 和 10.7 长得一模一样。
                    直接内联到 .sd-lrow-fill 上就没有这层歧义。 */}
                <span class="sd-lrow-track">
                  <span class="sd-lrow-fill" style={`width:${gauge(lv) ?? 0}%`}></span>
                </span>
                <span class="sd-lrow-v">{dash(lv)}</span>

                {/* 副行：Notes / Holds 两块读数（2026-11-19 重做）。
                    原来是两枚胶囊徽章 + 10 格分位 + 长押率条挤成一行，
                    三项各是一种形状，读起来像三套写法。
                    现在统一成一块「标签在上、数字在下、参照条垫底」的读数格：
                    两块并排、组宽一致，扫一列下来数字与条都对齐。
                    【2026-11-19 主人「没有 Holds 的也要表示出来，Holds 为 0」】
                    长押为 0 现在也照常印出（此前按「重复值不占版面」藏掉了，
                    结果绝大多数曲目整页只有一列 Notes、右边空着）。
                    参照条与分位/长押率是参照系，照旧保留。 */}
                <span class="sd-lrow-sub">
                  <span class="sd-facts">
                    {/* 【2026-11-22 主人「歌曲详情页的 Notes 数据没有也要显示，总数依旧写暂无」】
                        与 Holds 同构：无条件渲染这一格，没抓到就印「暂无」+ is-none，
                        两块读数始终等高；参照条与分位只在真有数据时出现。 */}
                    {(
                      <span class="sd-stat">
                        {/* 【2026-11-20 主人「notes/holds 标题和各自的总数，位置改为标题在上总数在下」】
                            标题单独一层在上，数字与参照条一起落到下一层的 .sd-stat-bd：
                            上下关系按主人点的来，数字与它的刻度仍是同一行，不拆散。 */}
                        <i>Notes</i>
                        <span class="sd-stat-bd">
                          <b class={notes == null ? 'is-none' : undefined}>{notes == null ? '暂无' : fmtInt(notes)}</b>
                        </span>
                        {/* 【2026-11-20 主人「参照条改成由下往上的条，跟分位文字一起放到右边」】
                            条与分位值都在数字右边：数字是主体，条与分位是它的参照，
                            横着排在右侧读起来是「值 → 刻度 → 分位」一条链。 */}
                        {st?.notesPctl != null ? (
                          <span class="sd-stat-side">
                            <span class="sd-stat-ref" aria-hidden="true">
                              {Array.from({ length: 10 }, (_, i) => (
                                <u class={i < Math.round(st.notesPctl! / 10) ? 'is-on' : undefined}></u>
                              ))}
                            </span>
                            <em title={`键数分位：键数超过同档 ${st.notesPctl}% 的谱面`}>
                              <span class="sd-sr">键数分位</span>P{st.notesPctl}
                            </em>
                          </span>
                        ) : null}
                      </span>
                    )}
                    {/* 【2026-11-19 主人「没有 Holds 的也要表示出来，Holds 为 0」】
                        原来 0 与未抓到都不渲染这块，全库 852 首是 0 →
                        整页只剩一列 Notes，右边空着。现在只要抓到过就照常渲染，
                        0 也一样印出来；未抓到（holds 为 null）仍然不印，
                        免得拿 0 冒充"没有"。
                    【2026-11-21 主人「holds 没数据也要显示暂无」】改成无条件占位：
                    未抓到时印「暂无」并打 is-none，两块读数始终等高、不塌一半。 */}
                    {(holds !== undefined) ? (
                      <span class="sd-stat">
                        <i>Holds</i>
                        <span class="sd-stat-bd">
                          <b class={holds == null ? 'is-none' : undefined}>
                            {holds == null ? '暂无' : fmtInt(holds)}
                          </b>
                        </span>
                        {/* 参照条改成与 Notes 同构的 10 格：Holds 为 0 时整条是空的，
                            仍然画出来当刻度（原来的单条填充在 0 时宽度 0%，等于没有）。 */}
                        {st?.holdPct != null ? (
                          <span class="sd-stat-side">
                            <span class="sd-stat-ref" aria-hidden="true">
                              {Array.from({ length: 10 }, (_, i) => (
                                <u
                                  class={
                                    i < Math.round((st.holdPct! / HOLD_PCT_MAX) * 10) ? 'is-on' : undefined
                                  }
                                ></u>
                              ))}
                            </span>
                            <em title={`长押率：长押音符占全谱 ${st.holdPct.toFixed(1)}%`}>
                              <span class="sd-sr">长押率</span>{st.holdPct.toFixed(1)}%
                            </em>
                          </span>
                        ) : null}
                      </span>
                    ) : null}
                  </span>
                </span>

                {/* 【2026-11-19 主人「标签单独一个div」→ 随即又纠正「对应难度的
                    div.sd-tags 要在对应难度的 div.sd-lrow 下」】
                    标签块仍自成一个 div（左侧主题色边框），但挂在**自己那一档的行内**，
                    不再在 .sd-read 末尾另排三段——那样看不出标签属于哪一档。
                    三类三行，词表来自 lib/song-tags.ts；已打的高亮带人数。
                    未登录也渲染，点一下跳登录。data-diff 仍留着，脚本回读不必猜。 */}
                {/* 【2026-11-20 主人「在难度标签（BSC/ADV/EXT）的下面加一个标签展开收缩按钮（默认收起）」】
                    按钮落在第 1 栏、标签的正下方（grid-row 2），与读数块同一行起势；
                    展开的是**这一档整块**标签（图一那三行配置/难度/评价只是一个开关管着的整体）。
                    默认收起：收起后三行标签不再各占一截高度，展开状态由 aria-expanded 承担。 */}
                <button
                  type="button"
                  class="sd-tags-toggle"
                  data-tags-toggle
                  aria-expanded="false"
                  aria-controls={`sdTags-${song.id}-${key}`}
                  title="展开标签"
                >
                  <span class="sd-tags-toggle-l">标签</span>
                  <svg class="sd-tags-chev" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M3 4.5L6 7.5L9 4.5" />
                  </svg>
                </button>
                <div
                  class={`sd-tags is-${key}`}
                  id={`sdTags-${song.id}-${key}`}
                  data-tags
                  data-diff={key}
                  data-login={Astro.locals.user ? '1' : '0'}
                  hidden
                >
                  {KINDS_BY_DIFF[key].map((kind) => {
                    const words = tagsOf(key, kind);
                    /* 【2026-11-19 主人「标签默认为空」】默认只渲染真被打过的词
                       （count>0 或自己打过），词表不再预先铺满——一屏几十个灰词压着，
                       读的人分不清哪些是这首的共识。词表改作「点＋后的候选」。 */
                    const shown = words.filter((w) => w.count > 0 || w.mine);
                    const pool = words.filter((w) => !w.count && !w.mine).map((w) => w.name);
                    return (
                      <div class="sd-tag-k" data-kind={kind} data-pool={JSON.stringify(pool)} data-pool-all={JSON.stringify(words.map((w) => w.name))}>
                        <span class="sd-tag-kl">{TAG_KIND_LABEL[kind]}</span>
                        <span class="sd-tag-ws">
                          {/* 自己打过的词右侧带一个 x（2026-11-19 主人要求），
                              电脑 hover 出现、手机长按出现，未登录两样都不出现。
                              x 用 span 而不是 button：它挂在 button 里，button 套 button 非法。 */}
                          {shown.length === 0 ? <span class="sd-tag-ph">暂无</span> : null}
                          {shown.map((w) => (
                            <button
                              type="button"
                              class={`sd-tagw${w.mine ? ' is-mine' : ''}`}
                              data-kind={kind}
                              data-name={w.name}
                              aria-pressed={w.mine ? 'true' : 'false'}
                            >
                              {w.name}
                              {w.mine ? (
                                <span class="sd-tagw-x" data-del={kind} aria-label={`删除标签 ${w.name}`} role="button" tabindex="-1">
                                  ×
                                </span>
                              ) : null}
                            </button>
                          ))}
                          <button type="button" class="sd-tagw sd-tagw-add" data-add={kind} title="添加标签">
                            ＋
                          </button>
                        </span>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}

          </div>
        </div>

    {/* 【2026-11-20 主人「sd-foot 可以放评论区模块」】——这一行（.sd-body 的
        grid-area:foot）从「背签」改成「评论区」的容器：横跨整宽、在 gauge 之后、与它分离。
        背签数据本身已按主人前一句搬进左栏 .sd-side（类名 .sd-meta）。
        评论区功能尚未实现，先立区块占住版面与锚点，文案与结构等接口就位再接。 */}
    <section class="sd-foot" id="sdFoot" aria-labelledby="sdFootH">
      <h2 class="sd-foot-h" id="sdFootH">评论</h2>
      <p class="sd-foot-ph">还没有评论。</p>
    </section>

    </div>
    </div>
  </section>
  )}

{/* 点击复制（主人 2026-10-29 第 5 条：点一下歌曲名可以复制到剪贴板）。
    songId 与曲名都挂 data-copy，用同一段脚本处理——两处行为一致，不写两套。
    clipboard API 在非 HTTPS / 老浏览器里可能不可用，所以带回退：
    临时 textarea + execCommand('copy')，这是 2026 年仍然最稳的兜底。
    【2026-10-29 改】提示从"贴元素上方的小气泡"改成"从顶部向下弹出的 toast"
    （主人原话「已复制直接换成从顶部向下弹出的toast」）——
    气泡的问题是不管怎么摆都受宿主元素尺寸影响，长曲名会漂、移动端会被挤出屏幕；
    页面级 toast 位置永远可预期。脚本负责创建/复用 #sdToast 节点。 */}
<script is:inline>
  (function () {
    var toastEl = null;
    var toastTimer = null;
    function ensureToast() {
      if (toastEl) return toastEl;
      toastEl = document.createElement('div');
      toastEl.id = 'sdToast';
      toastEl.className = 'sd-toast';
      toastEl.setAttribute('role', 'status');
      toastEl.setAttribute('aria-live', 'polite');
      toastEl.innerHTML =
        '<svg class="sd-toast-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>' +
        '<span>已复制</span>';
      document.body.appendChild(toastEl);
      return toastEl;
    }
    /* 【2026-11-19】文案可传：复制是「已复制」，未登录点＋是「需要登录后才能添加标签」。
       同一个 toast 复用，图标按类型换（勾 / 锁），不另起一套提示。 */
    function showToast(msg, kind) {
      var t = ensureToast();
      t.classList.toggle('is-warn', kind === 'warn');
      t.querySelector('.sd-toast-ico path').setAttribute('d', kind === 'warn' ? 'M12 4v10m0 4v.5' : 'M4 12.5l5 5L20 6.5');
      t.querySelector('span').textContent = msg || '已复制';
      // 先移除再强制回流，连点也能重播滑入动画
      t.classList.remove('is-on');
      void t.offsetWidth;
      t.classList.add('is-on');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { t.classList.remove('is-on'); }, 1600);
    }
    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }
    function copy(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text).then(
          function () { return true; },
          function () { return fallbackCopy(text); }
        );
      }
      return Promise.resolve(fallbackCopy(text));
    }
    /* 实测这个元素现在占了几行（用 Range 的客户端矩形，比拿高度除以行高准——
       行内元素的高度是按字体上下伸出来的，不等于「行数 × 行高」，早先按高度算
       得出了「12px 还占 3.5 行」这种假结论）。 */
    function countLines(el) {
      var rg = document.createRange();
      rg.selectNodeContents(el);
      var rects = rg.getClientRects();
      var tops = {};
      var n = 0;
      for (var i = 0; i < rects.length; i++) {
        if (rects[i].height < 1) continue;
        var t = Math.round(rects[i].top);
        if (!tops[t]) { tops[t] = 1; n++; }
      }
      return n;
    }

    /* 【2026-11-02 歌名排版：桌面一行 / 窄屏两行，都用降字号达成】
       桌面（>700px）：一行 + 不溢出右栏，下限 20px。
       窄屏（≤700px）：最多两行，下限 13px（站内移动端字号下限）。
       超长曲名缩到下限仍超行数时，才给 .sd-title-t 挂 .is-clamp 截断兜底
       （库里最长的一条 60 字符，缩到 13px 一般是 3 行）。
       先清掉内联字号回到 CSS 值再量，缩放窗口时才不会越缩越小。 */
    function fitTitle() {
      var wrap = document.querySelector('.sd-title-wrap');
      if (!wrap) return;
      var btn = wrap.querySelector('.sd-title');
      if (!btn) return;
      var inner = btn.querySelector('.sd-title-t');
      btn.style.fontSize = '';
      if (inner) inner.classList.remove('is-clamp');
      /* 取整：CSS clamp 会给出 19.125 这种带小数的值，逐级减 1 之后就变成
         13.125 这种「比整数小一档」的字号，既不好读也不利于对齐。 */
      var fs = Math.round(parseFloat(getComputedStyle(btn).fontSize));
      if (window.innerWidth <= 700) {
        var guardM = 0;
        /* 【2026-11-12 主人「移动端视图中两行的曲名字体可以小一些」】
           占两行的曲名（如「残響二繋ガレタ追憶ノHIDEAWAY」）在 20px 档压在
           右栏里太肿：曲绘只有 108 宽，两行 20px 的字块比它更抢眼。
           两行的降到基线的 88%（390px 屏 19.9 → 17px 左右），一行不动——
           他只说两行可以小一些，不是全站缩字号。下限 16px 兜住
           （再小就比曲师 12px 只大一档，撑不起 h1 的视觉）。
           缩完若回到一行，就停在一行（更省纵向空间，不算跑偏）。 */
        if (countLines(btn) === 2 && fs > 16) {
          var two = Math.max(16, Math.round(fs * 0.88));
          while (fs > two && guardM < 60) {
            fs -= 1;
            btn.style.fontSize = fs + 'px';
            guardM++;
          }
        }
        /* 【坑·2026-11-02】原来写的是 fs > 13：循环体先减再判断，
           于是最后一档落在 12.125px（比下限还小 1px 的零头）。
           改成「再减 1 之后仍 ≥ 下限」才继续减，最低正好停在 13px。 */
        while (countLines(btn) > 2 && fs - 1 >= 13 && guardM < 60) {
          fs -= 1;
          btn.style.fontSize = fs + 'px';
          guardM++;
        }
        if (inner && countLines(btn) > 2) inner.classList.add('is-clamp');
        /* 【2026-11-19 主人「曲名有两行时应减少 div.sda 的 margin-top」】
           两行的事实交给 CSS 用（.sda 的窄屏 margin-top 据此回落），
           挂在 <html> 上是因为 .sda 在组件 scoped 样式里、无法向父级回溯。 */
        document.documentElement.classList.toggle('is-title-2l', countLines(btn) >= 2);
        return;
      }
      document.documentElement.classList.remove('is-title-2l');
      var avail = wrap.clientWidth;
      var guard = 0;
      while (wrap.scrollWidth > avail + 1 && fs - 1 >= 20 && guard < 80) {
        fs -= 1;
        btn.style.fontSize = fs + 'px';
        guard++;
      }
    }

    /* 【2026-11-02 主人「曲师在移动端字体缩小至一行」】
       艺名在窄屏只排一行：先清掉内联字号，再逐级降字号直到不溢出，
       下限 12px（站内移动端辅助文字下限）。缩到下限仍放不下时保持
       一行 + 省略号（CSS 给的 text-overflow），绝不折成两行。
       桌面不动——桌面本来就允许换行。 */
    function fitArtist() {
      var a = document.querySelector('.sd-artist');
      if (!a) return;
      a.style.fontSize = '';
      if (window.innerWidth > 700) return;
      var fs = Math.round(parseFloat(getComputedStyle(a).fontSize));
      var guard = 0;
      while (a.scrollWidth > a.clientWidth + 1 && fs - 1 >= 12 && guard < 40) {
        fs -= 1;
        a.style.fontSize = fs + 'px';
        guard++;
      }
    }

    function fitText() { fitTitle(); fitArtist(); }
    fitText();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitText);
    var fitTimer = null;
    window.addEventListener('resize', function () {
      if (fitTimer) clearTimeout(fitTimer);
      fitTimer = setTimeout(fitText, 120);
    });


    /* ── 标签栏（2026-11-19）────────────────────────────────────────
       点一下 = 打/撤一票。后端是 /api/song-tags/<id>，POST 里 del 字段表示撤销。
       交互取舍：
       · 只改被点的这一枚按钮（高亮 + 人数 ±1），不重拉整块——重绘会让
         刚点的那枚失焦，连点几枚时手感很碎；
       · 请求期间给按钮加 is-busy 并忽略重复点击，避免连点打出双份票；
       · 未登录（页面没有登录态）直接跳登录页，带上 return 回本页；
       · 失败就把刚才的乐观改动回滚，不弹窗——标签是低风险操作，
         一次失败不值得打断阅读，高亮自己退回去已经说明问题了。
       · 「＋」是自填输入：点了就地变成 input，回车提交、Esc 取消。 */
    /* 【2026-11-19 标签块从难度行里提出来、按档拆成三段（各带 data-diff），
       所以这里从「一个容器」改成「按容器分别挂委托」：每段各自知道自己是哪一档，
       不用再靠 closest('.sd-lrow') 去猜。 */
    var tagWraps = document.querySelectorAll('[data-tags]');
    var songId = location.pathname.split('/').filter(Boolean).pop();
    /* 登录态先信模板写的 data-login，但**不能只信它**：详情页 HTML 会过
       EdgeOne/CDN 缓存，一个游客的请求渲出的版本可能被发给已登录的人（反之亦然），
       于是「登录了却被告知要登录」或「明明登录却没叉」。下面用 /api/auth/me
       校正一次，登录态一翻就按真实身份重画标签块。 */
    var aliasSec0 = document.querySelector('.sd-alias');
    var LOGGED = tagWraps.length
      ? tagWraps[0].getAttribute('data-login') === '1'
      : aliasSec0
        ? aliasSec0.getAttribute('data-login') === '1'
        : false;

    function post(diff, kind, name, del) {
      return fetch('/api/song-tags/' + songId, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ diff: diff, kind: kind, name: name, del: !!del }),
      });
    }

    /* 【2026-11-19 主人「已创建的标签右边不用加数字」】原先每个词后面跟一个人数 <b>，
       现在不显示了。bump() 与各处 b 构造一并删掉，不再留空节点。 */

    /* 【2026-11-20 主人「已添加的标签并不统计点击人数，所以点击已添加的标签应该无反应」】
       词钮原先是 toggle：点一下投自己一票、再点取消。现在人数不显示了，
       点它既看不到数字变化、又会莫名其妙多打一次请求，所以整枚词改**只读**——
       点击只在有叉时走删除，别的什么都不做。toggle() 随之删掉。 */

    /* 点叉删除自己这一条（2026-11-19 主人要求）。
       与 toggle 的删除分支不同：这里是「明确要删」，不判当前状态，直接删一次，
       叉一并去掉（已经不是自己的了）。失败就还原。
       【人数计数已不显示（同日主人「已创建的标签右边不用加数字」），
       所以这里只剩「叉还在不在」一个状态要管；「人数减到 0 就整枚撤掉」照旧。 */
    function removeMyTag(btn, diff, kind, name) {
      btn.classList.add('is-busy');
      var x = btn.querySelector('.sd-tagw-x');
      if (x) x.remove();
      post(diff, kind, name, true)
        .then(function (r) {
          if (!r.ok && r.status !== 204) throw new Error('t');
          btn.classList.remove('is-mine', 'is-x-on');
          btn.setAttribute('aria-pressed', 'false');
          /* 人数已经不显示了，本地算不出「这枚词是不是只剩我」——
             交给接口回读：repaint() 按最新数据重画，别人还打过的词留着、只剩我的自动消失，
             空出来时它自己会补「暂无」。比本地猜准，也不多写一套删词逻辑。 */
          repaint();
        })
        .catch(function () {
          /* 失败：把叉放回去（词钮本来就没被撤，除非它已被移除） */
          if (btn.isConnected && !btn.querySelector('.sd-tagw-x')) {
            var nx = document.createElement('span');
            nx.className = 'sd-tagw-x';
            nx.dataset.del = kind;
            nx.setAttribute('role', 'button');
            nx.tabIndex = -1;
            nx.textContent = '×';
            btn.appendChild(nx);
          }
        })
        .finally(function () {
          setTimeout(function () {
            btn.classList.remove('is-busy');
          }, 260);
        });
    }

    /* 【2026-11-19】点「＋」在词行下方展开一枚候选面板：上面是词表里还没人打的词，
       下面一个输入框可以自填。选候选 / 回车提交都走同一条 POST。
       面板挂在 .sd-tag-k 之后而不是塞进词行——塞进去会和输入框的 blur 打架
       （点候选先触发 blur 把面板收起，候选就点不到了）。 */
    function closeAdd(pop) {
      if (!pop) return;
      pop.remove();
      var k = document.querySelector('.sd-tag-k.is-open');
      if (k) k.classList.remove('is-open');
      var a = document.querySelector('.sd-tagw-add.is-open');
      if (a) a.classList.remove('is-open');
    }
    function inlineAdd(addBtn, diff, kind) {
      if (addBtn.dataset.on === '1') {
        addBtn.dataset.on = '';
        closeAdd(document.querySelector('.sd-tag-pop'));
        return;
      }
      closeAdd(document.querySelector('.sd-tag-pop'));
      addBtn.dataset.on = '1';

      var k = addBtn.closest('.sd-tag-k');
      var ws = addBtn.parentNode;
      if (!k) return;
      k.classList.add('is-open');
      addBtn.classList.add('is-open');

      var pool = [];
      try {
        pool = JSON.parse(k.getAttribute('data-pool') || '[]');
      } catch (err) {
        pool = [];
      }

      var pop = document.createElement('div');
      pop.className = 'sd-tag-pop';
      pop.setAttribute('role', 'group');
      pop.setAttribute('aria-label', '可选标签');

      var line = document.createElement('div');
      line.className = 'sd-tag-pop-l';

      /* 提交一枚词：成功后收面板，并把它补进词行（人数 1、高亮）。 */
      function submit(name, candBtn) {
        name = (name || '').trim().slice(0, 20);
        if (!name) return;
        if (candBtn) candBtn.classList.add('is-busy');
        post(diff, kind, name, false)
          .then(function (r) {
            if (!r.ok && r.status !== 204) throw new Error('t');
            var ph = ws.querySelector('.sd-tag-ph');
            if (ph) ph.remove();
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'sd-tagw is-mine';
            btn.dataset.kind = kind;
            btn.dataset.name = name;
            btn.setAttribute('aria-pressed', 'true');
            btn.textContent = name;
            var nx = document.createElement('span');
            nx.className = 'sd-tagw-x';
            nx.dataset.del = kind;
            nx.setAttribute('role', 'button');
            nx.tabIndex = -1;
            nx.textContent = '×';
            btn.appendChild(nx);
            /* 不挂单独监听：父级委托本来就覆盖这一段，命中 .sd-tagw-x 时按删除走。 */
            ws.insertBefore(btn, addBtn);
            addBtn.dataset.on = '';
            closeAdd(pop);
          })
          .catch(function () {
            if (candBtn) candBtn.classList.remove('is-busy');
          });
      }

      for (var p = 0; p < pool.length; p++) {
        var cb = document.createElement('button');
        cb.type = 'button';
        cb.className = 'sd-tagw sd-tagc';
        cb.dataset.cand = pool[p];
        cb.textContent = pool[p];
        cb.addEventListener('click', function () {
          submit(this.getAttribute('data-cand'), this);
        });
        line.appendChild(cb);
      }

      pop.appendChild(line);

      /* 输入框单独一行：候选会折成两三行，混在词流里的话它会浮在半空、
         位置随候选数量漂。独占一行后位置固定，也自然和上面「选现成词」分开。 */
      var input = document.createElement('input');
      input.type = 'text';
      input.maxLength = 20;
      input.className = 'sd-tagw-in';
      input.placeholder = pool.length ? '或自己填一个' : '输入新标签';
      input.setAttribute('aria-label', '新标签');
      pop.appendChild(input);
      k.parentNode.insertBefore(pop, k.nextSibling);
      input.focus();
      /* 候选很多时滚到候选区顶部，别让输入框把面板撑出屏外 */
      pop.scrollTop = 0;

      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          addBtn.dataset.on = '';
          closeAdd(pop);
          addBtn.focus();
          return;
        }
        if (e.key !== 'Enter') return;
        e.preventDefault();
        submit(input.value);
      });
    }

    /* 【2026-11-19 触屏】手机上点一下是 toggle，长按 450ms 才让叉显形。
       长按结束后浏览器还会补一个 click，必须吞掉，否则刚按出来的叉立刻被 toggle 收走。
       长按只在「自己打过的词」上生效，未登录 / 别人的词按了没反应。 */
    var lpTimer = null;
    var lpFire = false;
    var lpBtn = null;
    function lpClear() {
      if (lpTimer) {
        clearTimeout(lpTimer);
        lpTimer = null;
      }
    }
    for (var w = 0; w < tagWraps.length; w++) {
      (function (wrap) {
        wrap.addEventListener('touchstart', function (e) {
          var btn = e.target.closest('.sd-tagw.is-mine');
          if (!LOGGED || !btn) return;
          lpBtn = btn;
          lpFire = false;
          lpClear();
          lpTimer = setTimeout(function () {
            lpFire = true;
            var old = wrap.querySelector('.sd-tagw.is-x-on');
            if (old && old !== btn) old.classList.remove('is-x-on');
            btn.classList.add('is-x-on');
          }, 450);
        }, { passive: true });
        wrap.addEventListener('touchmove', lpClear, { passive: true });
        wrap.addEventListener('touchend', function () {
          lpClear();
          /* 长按已经亮过叉：这一次的 click 只用来「收」，不做事 */
          if (lpFire) setTimeout(function () { lpFire = false; }, 0);
        });
        wrap.addEventListener('click', function (e) {
          var btn = e.target.closest('.sd-tagw');
          if (!btn || !wrap.contains(btn)) return;
          if (lpFire && !e.target.closest('.sd-tagw-x')) return;
          /* 【2026-11-19 主人「未登录用户标签不出现 +」＋「删除提示」】
             游客看不到加号，所以这里只剩「点已有词去登录」一条路；
             加号分支不再需要 toast，直接由可见性表达「不可加」。
             （is-nudge 与 .sd-tagw-add.is-nudge 样式暂留，供别处复用。） */
          if (!LOGGED) return;
          /* 档位由所在段自己的 data-diff 给出（三段各写死一档）。 */
          var diff = wrap.getAttribute('data-diff');
          if (!diff) return;
          if (btn.classList.contains('sd-tagw-add')) {
            inlineAdd(btn, diff, btn.dataset.add);
            return;
          }
          /* 点叉＝删除自己这一条。叉没有自己的监听器（它是 span 嵌在按钮里），
             靠最外层这一处委托统一判：命中 .sd-tagw-x 就按删除走，
             不再走 toggle——否则点叉会先 toggle 再删，白打两次请求。 */
          if (e.target.closest('.sd-tagw-x')) {
            if (btn.classList.contains('is-busy')) return;
            removeMyTag(btn, diff, btn.dataset.kind, btn.dataset.name);
            return;
          }
          /* 剩下的情况就是「点词本身」：什么都不做（词钮只读）。 */
        });
      })(tagWraps[w]);
    }

    /* ── 标签的展开 / 收起（2026-11-20 主人「在难度标签的下面加一个
       标签展开收缩按钮（默认收起）」）───────────────────────────────
       收起态靠 [hidden] 摘出布局，不在 CSS 里留 max-height 过渡的中间态：
       标签行数不定（有人只打一个词、也有人铺满三行），量不出固定高度。
       按钮自己管 aria-expanded（读屏据此播报开合），文案与 title 也跟着换。 */
    var tagToggles = document.querySelectorAll('[data-tags-toggle]');
    /* 【2026-11-21 主人「详情页【标签】下拉的展开/收起加过渡动画」】
       与列表页下拉同一套（CSS 的 sdTagsIn / sdTagsOut + [data-closing]）：
       收起先播 0.16s 再摘 hidden，播放期间用 _outT 计时、连点能中途反转。
       渲染降动效时不等动画，直接摘。 */
    var reduceMotion = window.matchMedia
      ? window.matchMedia('(prefers-reduced-motion: reduce)')
      : null;
    function tagsCancelOut(box) {
      if (!box) return;
      if (box._outT) {
        clearTimeout(box._outT);
        box._outT = null;
      }
      box.removeAttribute('data-closing');
    }
    function tagsPlayOut(box) {
      if (!box) return;
      if (box._outT) clearTimeout(box._outT);
      if (reduceMotion && reduceMotion.matches) {
        box.hidden = true;
        box.removeAttribute('data-closing');
        box._outT = null;
        return;
      }
      box.setAttribute('data-closing', '');
      box._outT = setTimeout(function () {
        box.hidden = true;
        box.removeAttribute('data-closing');
        box._outT = null;
      }, 170); // 略长于 0.16s 的动画，留一帧余量
    }
    for (var g = 0; g < tagToggles.length; g++) {
      (function (btn) {
        btn.addEventListener('click', function () {
          var box = document.getElementById(btn.getAttribute('aria-controls'));
          if (!box) return;
          var open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', open ? 'false' : 'true');
          btn.title = open ? '展开标签' : '收起标签';
          if (open) {
            tagsPlayOut(box);
          } else {
            /* 收起动画还在播时又点开：先撤掉 data-closing 与旧计时器，
               否则入场动画被收起那条盖住、且旧计时器到点仍会把块摘掉。 */
            tagsCancelOut(box);
            box.hidden = false;
          }
        });
      })(tagToggles[g]);
    }

    /* ── 按真实登录态重画标签块（2026-11-19）──────────────────────────
       起因：详情页 HTML 会过 EdgeOne 缓存，缓存版本里的 data-login 与 is-mine
       可能不属于当前这个人。所以登录态一律以 /api/auth/me 为准，
       一翻就重拉 /api/song-tags 重画，不信任 HTML 里的那份。 */
    function applyLogin(on) {
      /* 登录态一致也要重画一次：缓存里的 is-mine 可能属于上一个登录的人。 */
      if (on === LOGGED) {
        if (on) {
          repaint();
          repaintAlias();
        }
        return;
      }
      LOGGED = on;
      for (var t = 0; t < tagWraps.length; t++) tagWraps[t].setAttribute('data-login', on ? '1' : '0');
      /* 别名块同样按真实登录态翻属性：它的 data-login 管着加号显不显示，
         同样可能被缓存成别人的那一版。 */
      var alS = document.querySelector('.sd-alias');
      if (alS) alS.setAttribute('data-login', on ? '1' : '0');
      repaint();
      repaintAlias();
    }

    /* 用接口数据重画三段：每档三类，先清空词行再按 count / mine 铺回去。
       词表候选池（data-pool）也一并按最新结果重算——否则刚打过的词还会留在候选里。 */
    function repaint() {
      if (!tagWraps.length) return;
      fetch('/api/song-tags/' + songId, { headers: { accept: 'application/json' } })
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (data) {
          if (!data) return;
          for (var t = 0; t < tagWraps.length; t++) {
            var wrap = tagWraps[t];
            var d = wrap.getAttribute('data-diff');
            var byDiff = data[d] || {};
            var rows = wrap.querySelectorAll('.sd-tag-k');
            for (var q = 0; q < rows.length; q++) {
              var row = rows[q];
              var ws = row.querySelector('.sd-tag-ws');
              var addBtn = ws.querySelector('.sd-tagw-add');
              if (!ws || !addBtn) continue;
              var list = byDiff[row.getAttribute('data-kind')] || [];
              var mineNames = [];
              var pool = [];
              var have = {};
              for (var i = 0; i < list.length; i++) have[list[i].name] = true;
              var all = [];
              try {
                all = JSON.parse(row.getAttribute('data-pool-all') || '[]');
              } catch (err2) {
                all = [];
              }
              for (var j = 0; j < all.length; j++) {
                if (all[j] && !have[all[j]]) pool.push(all[j]);
              }
              row.setAttribute('data-pool', JSON.stringify(pool));
              /* 清掉词钮（加号留着），再按最新数据重建 */
              var olds = ws.querySelectorAll('.sd-tagw:not(.sd-tagw-add)');
              for (var k = 0; k < olds.length; k++) olds[k].remove();
              var ph = ws.querySelector('.sd-tag-ph');
              if (list.length && ph) ph.remove();
              if (!list.length && !ph) {
                ph = document.createElement('span');
                ph.className = 'sd-tag-ph';
                ph.textContent = '暂无';
                ws.insertBefore(ph, ws.firstChild);
              }
              for (var m = 0; m < list.length; m++) {
                var it = list[m];
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'sd-tagw' + (it.mine ? ' is-mine' : '');
                btn.dataset.kind = row.getAttribute('data-kind');
                btn.dataset.name = it.name;
                btn.setAttribute('aria-pressed', it.mine ? 'true' : 'false');
                btn.textContent = it.name;
                if (it.mine) {
                  var x = document.createElement('span');
                  x.className = 'sd-tagw-x';
                  x.dataset.del = row.getAttribute('data-kind');
                  x.setAttribute('role', 'button');
                  x.tabIndex = -1;
                  x.textContent = '×';
                  btn.appendChild(x);
                }
                ws.insertBefore(btn, addBtn);
              }
            }
          }
        })
        .catch(function () {});
    }

    /* 一进页面就用权威接口校正登录态。模板那份来自可能被缓存的 HTML，不可信。 */
    if (tagWraps.length || document.querySelector('.sd-alias')) {
      fetch('/api/auth/me', { headers: { accept: 'application/json' } })
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (!d) return;
          applyLogin(!!d.user);
        })
        .catch(function () {});
    }


    /* ── 别名（2026-11-20）──────────────────────────────────────────
       主人「别名复用标签的设计」：登录才能增删、自己加的右上角带圈小叉、
       电脑 hover / 手机长按才显形、未登录两样都没有。区别有三：
       · 别名是自由文本，没有候选词表，所以 ＋ 直接开一个输入框，不弹面板；
       · 无需审核、不印创建者，入库即生效；
       · 点击别名不是投票，是**复制**（主人「点击别名可以复制别名」）。
       与标签同一个理由：HTML 会过边缘缓存，所以登录态与 mine 都用接口校正后重画。 */
    var aliasWrap = document.querySelector('[data-alias-ws]');
    var aliasForm = document.querySelector('[data-alias-form]');
    var aliasInput = document.querySelector('[data-alias-input]');
    var aliasAddBtn = document.querySelector('[data-alias-add]');
    var moreBtn = document.querySelector('[data-alias-more]');

    function aliasPost(name, del) {
      return fetch('/api/song-alias/' + songId, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(del ? { name: name, del: true } : { name: name }),
      });
    }

    /* 【2026-11-21 主人「别名默认最多两行，超出则在「＋」前放一个「v」展开更多」】
       折叠用 .is-over（display:none）而不是 max-height 裁切：行高随字号与缩放变，
       写死一个高度必定在某档字号下切到半个词；按 offsetTop 分行则是量真实排版，
       换字号、换宽度都自洽。
       只有真的排到第三行才让 ∨ 出现（.sd-alias[data-more="1"]），两行以内不留空按钮。 */
    var aliasExpanded = false;
    var aliasSec = document.querySelector('.sd-alias');
    /* ∨ 用 DOM 顺序摆位：收在第二行末而不是钉在 ＋ 前——窄屏 ＋ 独占一行时，
       钉死的 ∨ 会孤零零落到第三行，看上去像“第三条别名”。null = 放回 ＋ 前。 */
    function placeMore(before) {
      if (!moreBtn || !aliasWrap) return;
      aliasWrap.insertBefore(moreBtn, before || aliasAddBtn);
    }
    function aliasClamp() {
      if (!aliasWrap || !aliasSec) return;
      var pills = aliasWrap.querySelectorAll('.sd-aliasw:not(.sd-aliasw-add):not(.sd-aliasw-more)');
      var i;
      for (i = 0; i < pills.length; i++) pills[i].classList.remove('is-over');
      aliasSec.removeAttribute('data-more');
      /* 按 offsetTop 归纳出「行首」：同一行的药丸顶坐标相同 */
      var tops = [];
      for (i = 0; i < pills.length; i++) {
        var t = pills[i].offsetTop;
        var known = false;
        for (var k = 0; k < tops.length; k++) if (Math.abs(tops[k] - t) <= 2) known = true;
        if (!known) tops.push(t);
      }
      if (tops.length <= 2) {
        aliasExpanded = false;
        placeMore(null);
        if (moreBtn) {
          moreBtn.setAttribute('aria-expanded', 'false');
          moreBtn.title = '展开更多别名';
        }
        return;
      }
      /* 有三行以上：∨ 留在场；尚未展开才把第三行起的药丸收起来 */
      aliasSec.setAttribute('data-more', '1');
      if (aliasExpanded || !moreBtn) {
        placeMore(null);
        return;
      }
      var cut = tops[2] - 2;
      var firstHidden = null;
      for (i = 0; i < pills.length; i++) {
        if (pills[i].offsetTop >= cut) {
          pills[i].classList.add('is-over');
          if (!firstHidden) firstHidden = pills[i];
        }
      }
      /* 先把 ∨ 摆到第二行末（插在第一个被收起词的前面），再看它有没有被挤下去。
         行宽紧的时候宁可再多收一个词，也不让 ∨ 掉到第三行。 */
      placeMore(firstHidden);
      /* 判据是「∨ 有没有掉出第二行」，不是「∨ 顶是不是恰好等于第二行顶」：
         ∨ 与药丸的 offsetTop 天然差几像素（不同盒模型），拿等式当门槛会一路把整行收光。
         同一行的药丸 offsetTop 完全相同、跨行差一个行高，6px 容差两边都分得开。 */
      var vis = [];
      for (i = 0; i < pills.length; i++) if (!pills[i].classList.contains('is-over')) vis.push(pills[i]);
      while (vis.length && moreBtn.offsetTop - tops[1] > 6) {
        vis.pop().classList.add('is-over');
      }
    }

    /* 按接口数据重画词行：清掉所有药丸（加号留着），按 mine 补回小叉。
       空时补「暂无」。复制按钮没有单独监听，统一走父级委托。 */
    function repaintAlias() {
      if (!aliasWrap) return;
      fetch('/api/song-alias/' + songId, { headers: { accept: 'application/json' } })
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (list) {
          if (!list) return;
          // ∨ 与 ＋ 两枚按钮不参与重画，只清词
          var olds = aliasWrap.querySelectorAll('.sd-aliasw:not(.sd-aliasw-add):not(.sd-aliasw-more)');
          for (var i = 0; i < olds.length; i++) olds[i].remove();
          /* 空态句「暂无」：服务端只在真的没别名时才铺（见模板里的说明）。
             拿到真数据后有别名 → 删掉；一条都没有 → 补上（本地加完又删掉、或缓存的旧 HTML
             说「暂无」而库里其实已经有人加了，都要靠这里兜正）。 */
          var ph = aliasWrap.querySelector('[data-alias-ph]');
          if (list.length) {
            if (ph) ph.remove();
          } else if (!ph) {
            ph = document.createElement('span');
            ph.className = 'sd-alias-ph';
            ph.setAttribute('data-alias-ph', '');
            aliasWrap.insertBefore(ph, aliasWrap.firstChild);
          }
          for (var m = 0; m < list.length; m++) {
            var it = list[m];
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'sd-aliasw' + (it.mine ? ' is-mine' : '');
            btn.setAttribute('data-alias', it.name);
            btn.title = '点击复制这个别名';
            btn.textContent = it.name;
            if (it.mine) {
              var x = document.createElement('span');
              x.className = 'sd-aliasw-x';
              x.setAttribute('data-alias-del', it.name);
              x.setAttribute('role', 'button');
              x.tabIndex = -1;
              x.textContent = '×';
              btn.appendChild(x);
            }
            // 新词要排在这两枚按钮之前（moreBtn 在 addBtn 前面，插到 addBtn 前会落到 ∨ 与 ＋ 之间）
            aliasWrap.insertBefore(btn, moreBtn || aliasAddBtn);
          }
          aliasClamp();
        })
        .catch(function () {});
    }

    /* 长按出叉：与标签同一套 450ms 规则，操作对象换成别名药丸 */
    var alLpTimer = null;
    var alLpFire = false;
    function alLpClear() {
      if (alLpTimer) {
        clearTimeout(alLpTimer);
        alLpTimer = null;
      }
    }
    if (aliasWrap) {
      aliasWrap.addEventListener('touchstart', function (e) {
        var btn = e.target.closest('.sd-aliasw.is-mine');
        if (!LOGGED || !btn) return;
        alLpFire = false;
        alLpClear();
        alLpTimer = setTimeout(function () {
          alLpFire = true;
          var old = aliasWrap.querySelector('.sd-aliasw.is-x-on');
          if (old && old !== btn) old.classList.remove('is-x-on');
          btn.classList.add('is-x-on');
        }, 450);
      }, { passive: true });
      aliasWrap.addEventListener('touchmove', alLpClear, { passive: true });
      aliasWrap.addEventListener('touchend', function () {
        alLpClear();
        if (alLpFire) setTimeout(function () { alLpFire = false; }, 0);
      });
      aliasWrap.addEventListener('click', function (e) {
        var btn = e.target.closest('.sd-aliasw');
        if (!btn || !aliasWrap.contains(btn)) return;
        if (alLpFire && !e.target.closest('.sd-aliasw-x')) return;
        /* ∨ 展开钮（2026-11-21）：只管折叠状态，不是别名、不复制、也不进登录分支 */
        if (btn.hasAttribute('data-alias-more')) {
          aliasExpanded = !aliasExpanded;
          btn.setAttribute('aria-expanded', aliasExpanded ? 'true' : 'false');
          btn.title = aliasExpanded ? '收起别名' : '展开更多别名';
          aliasClamp();
          return;
        }
        if (btn.classList.contains('sd-aliasw-add')) {
          if (!LOGGED) return;
          if (aliasForm.hidden) {
            aliasForm.hidden = false;
            btn.classList.add('is-open');
            aliasInput.focus();
          } else {
            aliasForm.hidden = true;
            btn.classList.remove('is-open');
          }
          return;
        }
        /* 点叉＝删自己这一条。叉是 span 嵌在按钮里，靠这处委托统一判，
           否则点叉会先走复制再删，白复制一次。 */
        if (e.target.closest('.sd-aliasw-x')) {
          if (!LOGGED || btn.classList.contains('is-busy')) return;
          var delName = btn.getAttribute('data-alias');
          btn.classList.add('is-busy');
          aliasPost(delName, true)
            .then(function (r) {
              if (!r.ok && r.status !== 204) throw new Error('t');
              repaintAlias();
            })
            .catch(function () {
              btn.classList.remove('is-busy');
            });
          return;
        }
        /* 剩下的就是点别名本身：复制 */
        copy(btn.getAttribute('data-alias') || '').then(function (ok) {
          if (ok) showToast('已复制别名');
        });
      });
    }

    /* 首屏判一次折叠：服务端直出的药丸不会走 repaintAlias。
       字体加载完再判一次（rAF 里字体可能还没就位，行宽会变）。 */
    aliasClamp();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(aliasClamp);
    /* 换宽度会重排行，折叠的切点也得跟着重算 */
    var aliasRzT = null;
    window.addEventListener('resize', function () {
      if (aliasRzT) clearTimeout(aliasRzT);
      aliasRzT = setTimeout(aliasClamp, 150);
    });

    if (aliasForm) {
      aliasForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = (aliasInput.value || '').trim();
        if (!name) return;
        aliasPost(name, false)
          .then(function (r) {
            if (!r.ok && r.status !== 204) throw new Error('t');
            aliasInput.value = '';
            aliasForm.hidden = true;
            if (aliasAddBtn) aliasAddBtn.classList.remove('is-open');
            repaintAlias();
          })
          .catch(function () {});
      });
      aliasInput.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        aliasForm.hidden = true;
        if (aliasAddBtn) aliasAddBtn.classList.remove('is-open');
      });
      var alCancel = document.querySelector('[data-alias-cancel]');
      if (alCancel) alCancel.addEventListener('click', function () {
        aliasForm.hidden = true;
        if (aliasAddBtn) aliasAddBtn.classList.remove('is-open');
      });
    }

    var targets = document.querySelectorAll('[data-copy]');
    for (var i = 0; i < targets.length; i++) {
      targets[i].addEventListener('click', function () {
        var el = this;
        var text = el.getAttribute('data-copy') || '';
        if (!text) return;
        copy(text).then(function (ok) {
          if (ok) showToast();
          el.blur();
        });
      });
    }
  })();
</script>
</Layout>
