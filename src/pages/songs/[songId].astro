---
// 曲目详情页：按 song_id 查 D1 单行。
// 和 /songs/ 一样是 SSR（prerender = false）：曲库在 D1，构建期不知道有哪些 id，
// 也不能给上千首曲目逐个预渲染静态页——新增曲目会漏、改一次数据要全量重建。
import Layout from '../../layouts/Base.astro';
import '../../styles/songs.css';
import { pageTitle } from '../../lib/title';
import { GEN_ORDER } from '../../lib/gens';
import NotFound from '../../components/NotFound.astro';
import SongAudio from '../../components/SongAudio.astro';
import HoldMarker from '../../components/HoldMarker.astro';
import { getSongById, type Song } from '../../lib/song-data';
import { LEVELS, gauge, dash as dashLv, HOLD_PCT_MAX } from '../../lib/difficulty';
// 键数分位 / 长押率基准：**构建期预计算**的静态数据，运行时只读。
// 【2026-11-01 线上事故，别改回现算】最初写成每次请求调 buildDifficultyStats()，
// 要对 1248 首 × 3 档做分桶 + 60 万次内层循环（实测 77 ms），
// CF Worker 的 CPU 预算撑不住，详情页直接 500。
// 这组统计只随曲库变、与请求无关，构建期算一次落盘才是对的。
import diffStatsJson from '../../data/difficulty-stats.json';
import { env } from 'cloudflare:workers';
// BGM 试听映射（本站 songId → 上游相对路径），由 scripts/ub/build-ub-audio.cjs 生成。
// 打包期内联进 Worker，运行时不读文件；未命中的曲目说明上游没有音源，不渲染播放器。
import audioMap from '../../data/ub-audio.json';
// 谱面密度数据**不再 import 进 Worker 包**。
// 【2026-11-01 主人「能不能不需要全量获得谱面，进入到歌曲详情页才加载」】
// 原先把整张表（1.07MB）import 进来，实测详情页 chunk 3.3MB，
// 而每次请求只用到其中一首（中位 961 字节），1200 首被批量访问时纯属浪费。
//
// 三种做法的实测对比：
//   ① 打进 Worker 包：用户 0 下载、无延迟，但 Worker 每次载入整表（原方案）。
//   ② 进页面再找 ub 拉：用户 +3KB、+3 次跨站（各 ~300ms），且 ub 挂了图就没了。
//   ③ **每首一个同源静态 JSON**（现方案）：用户 0 下载（同源、边缘缓存）、
//      单次约 20ms，Worker 只读这 1KB。取不到就整块不渲染。
// 产物：public/assets/diff/<songId>.json，由 scripts/ub/split-ub-charts.cjs 生成。

export const prerender = false;

const { songId } = Astro.params;
const db = (env as { beyond_jubeat?: D1Database })?.beyond_jubeat;
const song: Song | null = songId
  ? await getSongById((env as { ASSETS: Fetcher }).ASSETS, Astro.url.origin, songId, db, Astro.locals.cfContext)
  : null;

// 【2026-11-01 键数 / 长押的参照系】分位拿**全站同档谱面**当分母，
// 由 scripts/build-difficulty-stats.cjs 在构建期算好，这里只做查表。
// 存储形状是 [分位|null, 长押率|null] 的数组（压体积用），这里还原成具名对象。
const DIFF_BASELINE = (diffStatsJson as { baseline: { medianPct: number; sample: number } | null }).baseline;
const DIFF_RAW = (diffStatsJson as { stats: Record<string, [number | null, number | null]> }).stats;
const diffStats = {
  get: (k: string) => {
    const v = DIFF_RAW[k];
    if (!v) return null;
    return { notesPctl: v[0], holdPct: v[1], holdBaseline: DIFF_BASELINE };
  },
};

// 找不到就渲染 404 内容并回 404 状态码：原 URL 不变，符合 HTTP 语义，
// 也不会被搜索引擎当成「内容存在但跳走了」。不用 Astro.redirect——那会 302 到 /404，
// URL 变了之后浏览器地址栏显示的是 /404，用户复制出来的链接就丢了 songId。
if (!song) {
  Astro.response.status = 404;
}
// 404 结果不缓存（避免把「这首不存在」缓存到边缘，之后补数据也还能查到）
Astro.response.headers.set(
  'cache-control',
  song
    ? 'public, max-age=30, s-maxage=300, stale-while-revalidate=60'
    : 'public, max-age=0, s-maxage=0'
);

// 注意：以下派生值只在 song 存在时计算。之前漏了这层保护——song 为 null 时
// 直接读 song.gen 会抛 TypeError，线上表现为 500 而不是 404（真实踩坑）。
const genMeta = song ? GEN_ORDER.find((g) => g.k === song.gen) : undefined;

// 【2026-10-29 主人「唱片换成对应世代的颜色 + 加世代 logo」，
//   并明确「即使正在看 jubeat 的歌，只要切到 ripples 主题，也应当显示 jubeat 的颜色」】
//
// 所以这里**不能用 var(--acc)**——那是"当前主题色"，会随顶栏切主题而变。
// 要的是「这首歌所属世代」的固定色：曲子属于 jubeat，就永远是 jubeat 的蓝，
// 无论用户此刻套着哪套皮肤。所以把这些色值抄成本表常量。
//
// 色值来源：src/styles/theme.css 每个 html[data-g="x"] 块的 --acc
// （scripts/ci 里若有主题色改动，这里是唯一需要同步的手抄点；改色请两边一起改）。
// clan 在数据层只有一个世代，但主题层拆成 4 套；clan 系列的曲子改用 EXT 等级分段取色，
// 见下面的 clanColor()。
const GEN_COLOR: Record<string, string> = {
  jubeat: '#2f86e6',
  ripples: '#4fae9e',
  knit: '#e0a92e',
  copious: '#8fa6ff',
  saucer: '#37474F',
  'saucer fulfill': '#c9d2d6',
  prop: '#e0338f',
  Qubell: '#3E8FBF',
  festo: '#ffd166',
  'Ave.': '#2ee8e8',
  'beyond the Ave.': '#ffa23c',
  音乐魔方: '#3f6fd8',
};

// 【2026-10-29 主人「clan 代的唱片和世代徽章颜色根据 EXT 等级来定：
//   7 级及以下绿、8 级蓝、9 级红、10 级紫」】
// clan 恰好自带四套主题色，这里按 EXT 分段取对应的那套，观感上是同一套视觉语言。
// 色值取自 theme.css：clan_green #57d98a / clan_blue #5c8dff /
// clan_red #ff6b6b / clan_purple #b07dff。
// 边界：EXT 为空（无谱面）时退回 7 级及以下的绿色——不留空色。
// 分段用「>= 10 → 紫，>= 9 → 红，>= 8 → 蓝，其余 → 绿」，
// 这样 10.5 这类超 10 的定数也落在紫段，不会漏进红段。
const CLAN_BY_EXT = [
  { min: 10, color: '#b07dff' }, // 紫
  { min: 9, color: '#ff6b6b' },  // 红
  { min: 8, color: '#5c8dff' },  // 蓝
  { min: -Infinity, color: '#57d98a' }, // 绿（7 级及以下）
];
const clanColor = (ext: number | null) => {
  const v = ext == null ? 0 : ext;
  for (const seg of CLAN_BY_EXT) if (v >= seg.min) return seg.color;
  return CLAN_BY_EXT[CLAN_BY_EXT.length - 1].color;
};

// 世代名（数据层）与 logo 文件名（主题层）是两套标识，不能直接拼：
//   Qubell→qubell、Ave.→ave、beyond the Ave.→bta、音乐魔方→yymf、saucer fulfill→saucerfulfill。
const GEN_LOGO: Record<string, string> = {
  jubeat: 'jubeat',
  ripples: 'ripples',
  knit: 'knit',
  copious: 'copious',
  saucer: 'saucer',
  'saucer fulfill': 'saucerfulfill',
  prop: 'prop',
  Qubell: 'qubell',
  clan: 'clan',
  festo: 'festo',
  'Ave.': 'ave',
  'beyond the Ave.': 'bta',
  音乐魔方: 'yymf',
};
const genLogo = song ? GEN_LOGO[song.gen] : undefined;
// clan 走 EXT 分段取色，其余世代用固定色（见上面两处注释）
const genColor = song
  ? song.gen === 'clan'
    ? clanColor(song.lv.ext)
    : GEN_COLOR[song.gen]
  : undefined;

const dash = dashLv;
// 键数四位数（最高 1606）在窄卡里要读得快，加千分位
const fmtInt = (v: number) => v.toLocaleString('en-US');
const servers = song ? [song.jp ? '日服' : null, song.cn ? '国服' : null].filter(Boolean).join(' / ') : '';
const coverSrc = song?.cover ? `/assets/images/jackets/${song.cover}` : null;

// 定数刻度、难度顺序与空值显示已统一抽到 src/lib/difficulty.ts——
// 加一档难度或改上限只需改那一处，模板与样式不再各持一份。
// 【2026-11-01 难度卡片】主人要求「拓展难度条样式，希望能看到某个难度的一些基本信息」。
// 现在每个难度是一张卡：等级 + 定数 + 填充条 + 键数 / 每键均时 / 长押。
// 这三项全部来自库里已有字段（notecounts / holds / bpm），1248 首 100% 有键数，
// 不再新增任何数据列，也就不存在"线上 D1 忘灌导致静默失效"的风险。

// 有没有音源：映射表命中才渲染试听条。1248 首里 1185 首有（上游是日服谱面站，
// 国服原创曲、拿不到官方 id 的 BTA- 占位曲、以及 2026-10-29 刚上架那 7 首——
// 上游还没收录——本就没有），未命中的不摆空控件。
const hasAudio = !!(song && (audioMap as Record<string, string>)[String(song.id)]);

// ---------------------------------------------------------------------------
// 谱面密度数据（2026-11-01 主人「要不去 ub 拉取谱面文件吧，做个如图所示的 bar 条」）
//
// 每档给：逐小节键数 bars[]、时长 dur、bpm、上游 level。
// 【为什么先校验 level】ub 上有个别曲目还挂着旧版谱面（实测 paranoia 的 EXT 是 Lv8 老谱，
// 库里已是 Lv9.5，键数 563 vs 965 差 40%）。拿旧谱的节奏形态当当前谱面展示是错的，
// 所以上游 level 与库里定数不符时**整档不画密度条**，只留数字。
// 宁可少一张图，也不能给一张谎图。
// ---------------------------------------------------------------------------
/** 官方口径的谱面密度数据（见 scripts/ub/build-ub-charts.cjs 头注释）。 */
type ChartCols = {
  cols: number[];   // 115 列，每列的颗数
  dur: number;      // 时间轴秒数 = 最后一颗判定时刻 + 1s
  keys: number;     // 物量 = 单点×1 + 长押×2
  notes: number;    // 单点数
  holds: number;    // 长押数
  bpm: number;
  level?: string | null;
};
/** 柱高封顶层数（官方 8 层）。超过 8 颗的列按 8 层画，不压峰归一化。 */
const MAX_LAYERS = 8;



/**
 * 按 songId 取这一首的谱面密度（三档一起，约 1KB）。
 *
 * 【为什么用 ASSETS 绑定而不是 fetch】
 * 直觉写法是 fetch 自己的同源 URL，但那是**一次真实的 HTTP 请求**：
 * 在 Worker 里对同 zone 的 URL 发 fetch，可能走成外网回环、
 * 也可能因 zone 的缓存规则命中或不命中，行为不确定，还会额外算一次子请求。
 * ASSETS 绑定（wrangler.jsonc 里 assets.binding 已配）直接读静态资源层，
 * 不发网络、不占子请求配额，天然就是「边缘最近的副本」。
 *
 * 关于流量分摊（主人要求）：/assets/* **不在 run_worker_first 里**，
 * 所以浏览器直接请求这些文件时由 CF 静态资源层返回，根本不进 Worker；
 * 加上 public/_headers 里 /assets/diff/* 配了 1 年 immutable，
 * 边缘与浏览器都长缓存。而这份数据是**构建期快照**，
 * 运行时完全不碰 ub.thregren.world —— 上游不承担本站的读取流量。
 *
 * 拿不到就返回 null，与版本校验共用同一个兜底：整块不画，不摆假图。
 */
const loadCharts = async (id: string): Promise<Record<string, ChartCols> | null> => {
  try {
    const assets = (env as { ASSETS?: { fetch: (r: Request) => Promise<Response> } })?.ASSETS;
    const url = new URL(`/assets/diff/${id}.json`, Astro.url);
    // 开发期没有 ASSETS 绑定（astro dev 不起 workerd），退回直接读文件系统
    const res = assets
      ? await assets.fetch(new Request(url))
      : await fetch(url, { headers: { accept: 'application/json' } });
    if (!res.ok) return null;
    return (await res.json()) as Record<string, ChartCols>;
  } catch {
    return null;
  }
};
const charts = song ? await loadCharts(String(song.id)) : null;

/**
 * 取某一档的谱面密度；**版本对不上就返回 null**（整档不画）。
 *
 * 两道校验，缺一不可（实测数据：只靠 level 会漏 89/93 个）：
 *   ① level 不符：上游还挂着旧版谱面。实测 paranoia 的 EXT 在 ub 是 Lv8 老谱，
 *      库里已是 Lv9.5，键数 563 vs 965。
 *   ② **键数不符**：这一条更要紧——页面上「键数」显示的是库里的值，
 *      如果谱面文件算出来的键数与之不符，那么密度条画的就不是这一份谱面。
 *      实测 3493 个谱面里有 93 个键数对不上、但其中只有 4 个 level 也不符，
 *      所以光查 level 挡不住 89 个「定了同一定数但谱面被改过」的情况。
 *
 * 判据很简单：密度条必须和它旁边那个「N 键」说的是同一份谱面，否则宁可不画。
 */
const chartOf = (key: 'bsc' | 'adv' | 'ext') => {
  const c = charts?.[key];
  if (!c || !c.cols?.length) return null;
  const libNotes = song?.notecounts?.[key];
  // 【判据只有一条：键数必须一致】算出来的 ub 键数要等于库里那个官方物量。
  // 键数一致就说明「这确实是同一张谱面」，图形有效。
  //
  // 【2026-11-01 22:55 为什么去掉定数比对】主人原话「等级差异不按 ub 的来（等级都是官方的）」。
  // 库里的定数是官方值，ub 页上那一栏的 level 标签会滞后（实测 4 例：50000228 EXT 库 9.3 / ub 9，
  // 990000003 EXT 9.8/9.6，991000003 EXT 9.5/9.3，991000001 ADV 6/7——这四例的**键数全部相等**，
  // 谱面本身没问题）。用定数当判据会把「谱面对、只是标签旧」的四档误判成不可画。
  // 反过来，定数比对原先要防的「取错页」（如 paranoia 把 Lv8 老谱当现行谱）也由键数这一条
  // 完整抓住：老谱 563 键≠965 键，照样不画。所以定数判据是多余且有害的。
  if (libNotes != null && c.keys !== libNotes) return null;
  return c;
};

// 【2026-10-28 重设计·第三版】主人「这歌曲详情太小了」。
// 上一版（10-22）是「左栏 = 封面 + 4 项硬数据，右栏 = 曲名 + 定数条，底部条 = 其余」。
// 实测问题：左栏 4 项把 aside 撑到 ~450px，而右栏只有 ~250px，靠 align-self:center
// 硬居中 → 定数条下方空出一大块（140px+），面板显得又高又空。
// 这一版改成**唱片内页**的标准结构：
//   左栏只有封面（208px，视觉锤）；
//   右栏艺术主体：艺人 → 曲名 → 定数条（信息重心）；
//   全部元数据（songId / 世代 / 分区 / 服务器 / 上线 / 解禁 / 备注；BPM 在播放条徽章上）
//   统一收进底部横条——它本来就该是「唱片背签」式的密集小字区，铺满宽度。
// 好处：两栏高度接近，版面不用硬居中；元数据集中成一区比散落两处更好扫读。
// 仍然只渲染有值的项，不摆「—」占位。
// 【2026-10-29】songId / 世代 / 分区 三项已挪到曲名上方的徽章行，
// 这里不再重复——同一份信息出现两处，读起来像两个不同字段。
type Meta = { k: string; v: string; mono?: boolean };
const metaFoot: Meta[] = song
  ? [
      { k: '服务器', v: servers },
      // 【2026-10-31 主人「把如图的 BPM 给去掉」】BPM 已由播放条左上角的徽章承担，
      // 底部背签不再重复同一个字段（他此前也有「同一份信息别出现两处」的口径）。
      ...(song.d ? [{ k: '上线', v: song.d, mono: true }] : []),
      ...(song.unlock ? [{ k: '解禁', v: song.unlock }] : []),
      ...(song.kind === 'synthetic' ? [{ k: '备注', v: '官方 songId 暂缺，此处为占位 id' }] : []),
    ].filter((m) => m.v)
  : [];
---

<Layout
  title={pageTitle(song ? song.t : '页面不存在')}
  canonicalPath={song ? `/songs/${song.id}/` : ''}
  noindex={!song}
  description={song ? `${song.t}${song.a ? ' - ' + song.a : ''}｜jubeat ${song.gen} 世代，BSC ${dash(song.lv.bsc)} / ADV ${dash(song.lv.adv)} / EXT ${dash(song.lv.ext)}。` : undefined}
>
  {!song ? <NotFound /> : (
  // --gen-c = 本曲所属世代的固定色（与当前主题无关），由父级下发一次，
  // 后代 .sd-disc / .sd-badge-gen 都读它——"唱片颜色 = 世代徽章颜色"天然一致。
  <section class="band sd" id="songRoot" style={genColor ? `--gen-c: ${genColor}` : undefined}>
    {/* 顶部不再是「大圆角玻璃面板里塞一堆小方盒」，而是两栏唱片页式布局：
        左窄栏放曲绘与硬数据（像唱片封套背签），右栏让曲名与定数占据版面。
        曲绘原图只有 144px，放大必糊——所以不追求大图，做成贴合尺寸的实物感封面。 */}
    {/* 【2026-11-03 主人「给标记一套上一层容器限制」】面板外面再套一层容器 .sd-shell：
        唱片是以 left:-100px 挂在 .sd-cover 上的，cover 又坐在面板内边距里，
        所以唱片必然探出面板左缘 40+px；面板原本 overflow:visible，探出的部分直接跑到板外。
        交外层容器掌住：左侧预留 --sd-gutter 把悬出量吃进来，再 overflow:clip 兜底。
        head 与 body 一起放进来，返回/面包屑才对得上面板左缘。 */}
    <div class="sd-shell">
    <div class="sd-head">
      <a class="sd-back" href="/songs/">曲目库</a>
      <span class="sd-sep" aria-hidden="true"></span>
      <span class="sd-crumb">{song.gen}</span>
    </div>

    <div class="sd-body">
      <aside class="sd-aside">
        {/* 【2026-10-29 主人第 1 条】曲绘下面垫一张唱片，向左露出小半个；
            BGM 播放时唱片旋转（状态由 SongAudio 写在 html[data-bgm] 上）。
            唱片必须在曲绘之下（z-index 更低），露出的那一弯才像"从封套里抽出来"。
            结构：.sd-disc 是唱片本体（黑胶同心圆环），.sd-disc-spin 只是承载旋转的层，
            两者拆开是因为旋转要独立于居中定位，混在一起会让 transform 互相覆盖。 */}
        <div class="sd-cover" aria-hidden={coverSrc ? undefined : 'true'}>
          {/* 唱片（主人 2026-10-29 两次修正）：
              ① 盘面颜色 = 当前世代主题色（与世代徽章同源，都取 --acc）；
              ② 世代 logo **印在盘面上、随唱片一起转**，不是钉在圆心。
                 所以 logo 放进 .sd-disc-spin 里——那个层才是承载旋转的。
                 圆心只留一个装轴孔。 */}
          <span class="sd-disc">
            <span class="sd-disc-spin">
              {genLogo ? (
                <img
                  class="sd-disc-logo"
                  src={`/assets/images/logo/${genLogo}.webp`}
                  alt=""
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                />
              ) : null}
            </span>
            <span class="sd-disc-hole" aria-hidden="true"></span>
          </span>
          <div class={`sd-j${song.alt ? ' is-alt' : ''}`}>
            {coverSrc ? (
              <img src={coverSrc} alt={`${song.t} 曲绘`} width="208" height="208" loading="eager" fetchpriority="high" decoding="async" />
            ) : (
              <span class="sd-no">no jacket</span>
            )}
            {/* 长押标识（2026-11-12 起改 CSS 重绘，原 hold.gif 退役）：放在 .sd-j 内，
                overflow:hidden 会把角标裁在封套范围内。判定只认 has_hold === 1（null=未知不画）。
                原来的「[2] 长押谱」文案已按主人要求删除——那句话把 alt=1 说成了长押，
                而 alt=1 只是 [ 2 ] 谱面变体。结构与动画见 HoldMarker.astro + songs.css 的 .hm-*。 */}
            {song.hasHold === 1 ? <HoldMarker class="sd-hold" /> : null}
          </div>
        </div>
      </aside>

      <div class="sd-main">
        {/* 【2026-10-29 主人 4 条版式意见】
            ①songId 用 #10000036 的形式放到曲名**上方**；
            ②世代/分区做成两枚徽章、跟在 songId 右边（世代徽章用主题色，年份不要）；
            ③艺术家从曲名上方挪到**曲名下方**。
            顺序：songId + 世代徽章 + 分区徽章 → 曲名 → 艺术家。 */}
        <p class="sd-idline">
          <button type="button" class="sd-sid" data-copy={song.id} title="点击复制 songId">#{song.id}</button>
          {/* title：窄屏上世代名放不下时会被省略号截断（见 songs.css 的 .sd-badge-gen），
              全文靠它补回来。 */}
          <span class="sd-badge sd-badge-gen" title={song.gen}>{song.gen}</span>
          <span class="sd-badge sd-badge-cat">{song.cat}</span>
        </p>

        {/* 曲名：点一下复制歌名（主人 2026-10-29 要求）。用 button 而不是 h1 是为了
            可聚焦、可键盘触发；语义上仍用 h1 包住，标题层级不断。 */}
        <h1 class="sd-title-wrap">
          {/* 【2026-11-02 主人「移动端视图的歌曲缩到两行」】
              曲名文字包一层 span：行数限制（-webkit-line-clamp）只能作用在
              block / -webkit-box 上，直接写在 <button> 上不生效（实测按钮的
              display 被 UA 固定成 flow-root，clamp 只把高度收到 2.9 行）。
              包裹层只做「最多两行 + 省略号」，桌面端不设限，行为不变。 */}
          <button type="button" class="sd-title" data-copy={song.t} title="点击复制曲名">
            <span class="sd-title-t">{song.t}</span>
          </button>
        </h1>

        <p class="sd-artist">{song.a ?? '—'}</p>

        {/* 【2026-10-29 主人「把播放条弄到难度条上面」】
            顺序改为：曲名 → 艺人 → 试听条 → 定数条。理由（主人给的版面图）：
            播放是"听到这首"的入口，紧挨作品信息；定数条是数据区，压到下面。
            没有音源时试听条整块不渲染，定数条位置照旧。 */}
        {hasAudio ? <SongAudio songId={String(song.id)} bpm={song.bpm} /> : null}
      </div>

      {/* 【2026-11-03 主人「是这两个重叠」】定数区从 .sd-main 里提出来，成为 .sd-body
          的直接子节点。它原本靠负 margin 横向扩到曲绘下方，纵向位置却由右栏内容决定，
          右栏比曲绘矮时左扩的那半截就压在曲绘上（816px 宽实测重叠 17px）。
          现在它是独立网格行 grid-area:gauge（见 songs.css 的 .sd-body），
          纵向由网格决定，结构上不可能再回贴到曲绘。 */}
        {/* 定数条：三条横条按 0-11 刻度填充，颜色沿用难度三色。
            定数是这个站最有信息量的字段，横条让「这首的难度分布」一眼可读
            （比如 BSC 短、EXT 长 = 高难曲）。
            【2026-10-29 主人「没有 bgm 的视图」】无音源时没有播放条占位，
            定数条会上移到曲绘高度；它又向左扩张到曲绘下方，于是被曲绘压住。
            给无音源加 .is-solo：把它推离曲绘底边（见 songs.css）。 */}
        {/* 【2026-11-01 难度卡片】主人「拓展一下难度条样式（做成难度卡片也行），
            我希望能看到某个难度的一些基本信息」。
            原来每档只是一行「标签 + 条 + 数字」，只有定数一个字段；现在每档是一张卡，
            把库里**已有**的谱面数据挂上去，不新增任何列：
              · 定数（原来的数值，变成卡片视觉重心）
              · 键数 notecounts[key]：1248 首 100% 覆盖，且每首键数都不同 → 纯信息增量
              · 长押 holds[key]：只在 >0 时出现。全库 852 首是 0，把「长押 0」印上去
                等于一列几乎没有差异的值（主人判过：多行重复同一值就不占版面），
                所以「没有长押」这件事用「不显示」来表达，卡片上每一项都有信息量。
                未抓到（98 首 holds 为 null）同样不显示，不拿「—」冒充「没有」。
            【被否掉的字段·每键均时】想过显示 键数 ÷ (BPM/60) 的「每秒按键数」，
            但换算出来 = 键数 × 60 / BPM，BPM 恒定的一首里它只是键数的线性缩放，
            读的人拿不到新东西；真正有意义的密度要按谱面时长算，而时长库里没有。
            宁可少一项，也不摆一个看不出所以然的数字。 */}
        <div class={`sd-gauge${hasAudio ? '' : ' is-solo'}`} role="group" aria-label="难度信息">
          {/* 【2026-11-02 主人「标记1的 5、10 可以不用」】顶部那把刻度尺整条删除。
              尺子本体只剩「5」「10」两个数字，去掉数字后它就不再承载信息了——
              0-11 的刻度仍由填充条上的 11 段细线表达（.sd-lrow-track::after），
              横向比例读得出来，数字是多余的注解。 */}
          {LEVELS.map(({ key, label }) => {
            const lv = song.lv[key];
            const notes = song.notecounts?.[key] ?? null;
            const holds = song.holds?.[key] ?? null;
            const st = diffStats?.get(`${song.id}|${key}`) ?? null;
            return (
              <div class={`sd-lrow sd-lrow-${key}${lv == null ? ' is-empty' : ''}`}>
                <span class="sd-lrow-k">{label}</span>
                {/* 【坑·2026-11-01】--fill 必须写在填充元素自己身上。
                    写在 .sd-lrow 上时，填充元素隔着 .sd-lrow-track 一层，
                    自定义属性**会继承**但 clip-path 里的 calc 拿不到有效长度，
                    实测三档全都填满 100%（213/213），定数 5 和 10.7 长得一模一样。
                    直接内联到 .sd-lrow-fill 上就没有这层歧义。 */}
                <span class="sd-lrow-track">
                  <span class="sd-lrow-fill" style={`width:${gauge(lv) ?? 0}%`}></span>
                </span>
                <span class="sd-lrow-v">{dash(lv)}</span>

                {/* 副行：Notes / Holds 两枚数据徽章。
                    【2026-11-02 主人三条】①「Notes XXX」「Holds XXX」并用徽章——
                    原来是「282键 / 34长押 / 无长押」三种句式混排，读起来像三套写法；
                    统一成「标签 + 数字」的徽章后，扫一列下来是对齐的。
                    长押为 0 时不再写「无长押」，直接 Holds 0，仍是同一句式（数字压成灰）。
                    分位小格与长押率条保留：它们给的是参照系，不是重复值。
                    【2026-11-02 第二次纠正】定数**留在右栏**、尺寸不变——
                    主人「我说让你把 bar 行缩小，没让你改变 bar」，这里的 bar 指的是
                    下面那条**谱面密度条**，不是定数字。定数原样退回第 3 栏。 */}
                <span class="sd-lrow-sub">
                  <span class="sd-facts">
                    {notes == null ? null : (
                      <span class="sd-tag" title="总键数"><i>Notes</i><b>{fmtInt(notes)}</b></span>
                    )}
                    {st?.notesPctl != null ? (
                      <>
                        <span class="sd-pctl" aria-hidden="true">
                          {Array.from({ length: 10 }, (_, i) => (
                            <b class={i < Math.round(st.notesPctl! / 10) ? 'is-on' : undefined}></b>
                          ))}
                        </span>
                        {/* 【2026-11-02 审计】裸「P13」没人能解：给 title 讲清口径，
                            并补一段只给读屏的「键数分位」——视觉上仍是两个字符，
                            不新增标签、不占版面。 */}
                        <span class="sd-pctl-v" title={`键数分位：键数超过同档 ${st.notesPctl}% 的谱面`}>
                          <span class="sd-sr">键数分位</span>P{st.notesPctl}
                        </span>
                      </>
                    ) : null}
                    {/* 【2026-11-02 审计】长押为 0 不再印徽章。
                        ①「Holds 0」在全库 852 首里是同一个值，三档 × 每首重复三次，
                          正是主人早前判过的「多行重复同一值就别占版面」；
                        ②「这一档没有长押」这件事，用「没有那枚徽章」表达最省，
                          与长押率百分比（holds > 0 才画）的规则也一致。
                        未抓到（holds 为 null）同样不显示。 */}
                    {holds != null && holds > 0 ? (
                      <span class="sd-tag" title="长押数">
                        <i>Holds</i><b>{fmtInt(holds)}</b>
                      </span>
                    ) : null}
                    {holds != null && holds > 0 && st?.holdPct != null ? (
                      /* 条与百分比包成一组：窄屏放不下时两者一起换行，
                         不会出现「条留在上行、百分比被挤到下一行」的断体。 */
                      <span class="sd-holdbarwrap">
                        <span class="sd-holdbar" aria-hidden="true"
                              style={`--w:${Math.min(100, (st.holdPct / HOLD_PCT_MAX) * 100)}%;--med:${
                                st.holdBaseline ? (st.holdBaseline.medianPct / HOLD_PCT_MAX) * 100 : 0
                              }%`}>
                          {st.holdBaseline ? <u></u> : null}<i></i>
                        </span>
                        <span class="sd-pctl-v" title={`长押率：长押音符占全谱 ${st.holdPct.toFixed(1)}%`}>
                          <span class="sd-sr">长押率</span>{st.holdPct.toFixed(1)}%
                        </span>
                      </span>
                    ) : null}
                  </span>
                </span>

                {/* 谱面密度条（2026-11-01，按 jubeat 官方口径）：
                    · 固定 115 列等分时间轴，柱高封顶 8 层，画**绝对颗数**、不按本曲峰值归一化
                    · 物量 = 单点×1 + 长押×2，长押的头判与尾判各落一列
                      （所以列合计 == 物量，两个独立算法互验）
                    · 格子是正方形，整张图等比缩放后居中（见 songs.css 的 --cell）
                    0 颗的列不画任何东西——曲中间的静音段本身就是信息。
                    版本对不上（chartOf 返回 null）就整块不渲染，不给假图。 */}
                {(() => {
                  const c = chartOf(key);
                  if (!c) return null;
                  return (
                    // 【空列必须占位】115 列是等分时间轴，空列（这一小段没有音符）
                    // 也要占住自己的宽度，否则柱子挤在一起、时间轴就失真了——
                    // 实测症状是「柱子之间没有间隔、节奏形态读不出来」。
                    // is-rest 只负责保持列宽，不画任何方块。
                    // 【柱高要按颗数】给每列传一个 --n（这一列有几颗，封顶 8）。
                    // 不传的话方块各自 flex:1 会撑满整列，结果每根柱都顶到天花板、
                    // 全都一样高 —— 主人原话「全部撑满很难看的，而且也不直观」。
                    <span class="sd-chart" aria-hidden="true">
                      {c.cols.map((v) => {
                        const n = Math.min(MAX_LAYERS, v);
                        return (
                          <span class="sd-col" style={`--n:${n}`}>
                            {Array.from({ length: n }, () => <b></b>)}
                          </span>
                        );
                      })}
                    </span>
                  );
                })()}
              </div>
            );
          })}
        </div>

      {/* 底部横向信息条：BPM / 上线 / 解禁 / 备注。
          放在底板下缘横铺，既填满右半宽度、又把左栏过长的纵向清单压回去，
          让整体从「左重右空」变成两栏均衡。只渲染有值的项。 */}
      {metaFoot.length ? (
        <dl class="sd-foot">
          {metaFoot.map((m) => (
            <div class={m.k === '备注' ? 'is-wide' : undefined}>
              <dt>{m.k}</dt>
              <dd class={m.mono ? 'sd-num' : undefined}>{m.v}</dd>
            </div>
          ))}
        </dl>
      ) : null}
    </div>
    </div>
  </section>
  )}

{/* 点击复制（主人 2026-10-29 第 5 条：点一下歌曲名可以复制到剪贴板）。
    songId 与曲名都挂 data-copy，用同一段脚本处理——两处行为一致，不写两套。
    clipboard API 在非 HTTPS / 老浏览器里可能不可用，所以带回退：
    临时 textarea + execCommand('copy')，这是 2026 年仍然最稳的兜底。
    【2026-10-29 改】提示从"贴元素上方的小气泡"改成"从顶部向下弹出的 toast"
    （主人原话「已复制直接换成从顶部向下弹出的toast」）——
    气泡的问题是不管怎么摆都受宿主元素尺寸影响，长曲名会漂、移动端会被挤出屏幕；
    页面级 toast 位置永远可预期。脚本负责创建/复用 #sdToast 节点。 */}
<script is:inline>
  (function () {
    var toastEl = null;
    var toastTimer = null;
    function ensureToast() {
      if (toastEl) return toastEl;
      toastEl = document.createElement('div');
      toastEl.id = 'sdToast';
      toastEl.className = 'sd-toast';
      toastEl.setAttribute('role', 'status');
      toastEl.setAttribute('aria-live', 'polite');
      toastEl.innerHTML =
        '<svg class="sd-toast-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>' +
        '<span>已复制</span>';
      document.body.appendChild(toastEl);
      return toastEl;
    }
    function showToast() {
      var t = ensureToast();
      // 先移除再强制回流，连点也能重播滑入动画
      t.classList.remove('is-on');
      void t.offsetWidth;
      t.classList.add('is-on');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { t.classList.remove('is-on'); }, 1600);
    }
    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }
    function copy(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text).then(
          function () { return true; },
          function () { return fallbackCopy(text); }
        );
      }
      return Promise.resolve(fallbackCopy(text));
    }
    /* 实测这个元素现在占了几行（用 Range 的客户端矩形，比拿高度除以行高准——
       行内元素的高度是按字体上下伸出来的，不等于「行数 × 行高」，早先按高度算
       得出了「12px 还占 3.5 行」这种假结论）。 */
    function countLines(el) {
      var rg = document.createRange();
      rg.selectNodeContents(el);
      var rects = rg.getClientRects();
      var tops = {};
      var n = 0;
      for (var i = 0; i < rects.length; i++) {
        if (rects[i].height < 1) continue;
        var t = Math.round(rects[i].top);
        if (!tops[t]) { tops[t] = 1; n++; }
      }
      return n;
    }

    /* 【2026-11-02 歌名排版：桌面一行 / 窄屏两行，都用降字号达成】
       桌面（>700px）：一行 + 不溢出右栏，下限 20px。
       窄屏（≤700px）：最多两行，下限 13px（站内移动端字号下限）。
       超长曲名缩到下限仍超行数时，才给 .sd-title-t 挂 .is-clamp 截断兜底
       （库里最长的一条 60 字符，缩到 13px 一般是 3 行）。
       先清掉内联字号回到 CSS 值再量，缩放窗口时才不会越缩越小。 */
    function fitTitle() {
      var wrap = document.querySelector('.sd-title-wrap');
      if (!wrap) return;
      var btn = wrap.querySelector('.sd-title');
      if (!btn) return;
      var inner = btn.querySelector('.sd-title-t');
      btn.style.fontSize = '';
      if (inner) inner.classList.remove('is-clamp');
      /* 取整：CSS clamp 会给出 19.125 这种带小数的值，逐级减 1 之后就变成
         13.125 这种「比整数小一档」的字号，既不好读也不利于对齐。 */
      var fs = Math.round(parseFloat(getComputedStyle(btn).fontSize));
      if (window.innerWidth <= 700) {
        var guardM = 0;
        /* 【2026-11-12 主人「移动端视图中两行的曲名字体可以小一些」】
           占两行的曲名（如「残響二繋ガレタ追憶ノHIDEAWAY」）在 20px 档压在
           右栏里太肿：曲绘只有 108 宽，两行 20px 的字块比它更抢眼。
           两行的降到基线的 88%（390px 屏 19.9 → 17px 左右），一行不动——
           他只说两行可以小一些，不是全站缩字号。下限 16px 兜住
           （再小就比曲师 12px 只大一档，撑不起 h1 的视觉）。
           缩完若回到一行，就停在一行（更省纵向空间，不算跑偏）。 */
        if (countLines(btn) === 2 && fs > 16) {
          var two = Math.max(16, Math.round(fs * 0.88));
          while (fs > two && guardM < 60) {
            fs -= 1;
            btn.style.fontSize = fs + 'px';
            guardM++;
          }
        }
        /* 【坑·2026-11-02】原来写的是 fs > 13：循环体先减再判断，
           于是最后一档落在 12.125px（比下限还小 1px 的零头）。
           改成「再减 1 之后仍 ≥ 下限」才继续减，最低正好停在 13px。 */
        while (countLines(btn) > 2 && fs - 1 >= 13 && guardM < 60) {
          fs -= 1;
          btn.style.fontSize = fs + 'px';
          guardM++;
        }
        if (inner && countLines(btn) > 2) inner.classList.add('is-clamp');
        return;
      }
      var avail = wrap.clientWidth;
      var guard = 0;
      while (wrap.scrollWidth > avail + 1 && fs - 1 >= 20 && guard < 80) {
        fs -= 1;
        btn.style.fontSize = fs + 'px';
        guard++;
      }
    }

    /* 【2026-11-02 主人「曲师在移动端字体缩小至一行」】
       艺名在窄屏只排一行：先清掉内联字号，再逐级降字号直到不溢出，
       下限 12px（站内移动端辅助文字下限）。缩到下限仍放不下时保持
       一行 + 省略号（CSS 给的 text-overflow），绝不折成两行。
       桌面不动——桌面本来就允许换行。 */
    function fitArtist() {
      var a = document.querySelector('.sd-artist');
      if (!a) return;
      a.style.fontSize = '';
      if (window.innerWidth > 700) return;
      var fs = Math.round(parseFloat(getComputedStyle(a).fontSize));
      var guard = 0;
      while (a.scrollWidth > a.clientWidth + 1 && fs - 1 >= 12 && guard < 40) {
        fs -= 1;
        a.style.fontSize = fs + 'px';
        guard++;
      }
    }

    function fitText() { fitTitle(); fitArtist(); }
    fitText();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitText);
    var fitTimer = null;
    window.addEventListener('resize', function () {
      if (fitTimer) clearTimeout(fitTimer);
      fitTimer = setTimeout(fitText, 120);
    });

    var targets = document.querySelectorAll('[data-copy]');
    for (var i = 0; i < targets.length; i++) {
      targets[i].addEventListener('click', function () {
        var el = this;
        var text = el.getAttribute('data-copy') || '';
        if (!text) return;
        copy(text).then(function (ok) {
          if (ok) showToast();
          el.blur();
        });
      });
    }
  })();
</script>
</Layout>
