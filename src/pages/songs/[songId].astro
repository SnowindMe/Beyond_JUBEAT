---
// 曲目详情页：按 song_id 查 D1 单行。
// 和 /songs/ 一样是 SSR（prerender = false）：曲库在 D1，构建期不知道有哪些 id，
// 也不能给上千首曲目逐个预渲染静态页——新增曲目会漏、改一次数据要全量重建。
import Layout from '../../layouts/Base.astro';
import '../../styles/songs.css';
import { pageTitle } from '../../lib/title';
import { GEN_ORDER } from '../../lib/gens';
import NotFound from '../../components/NotFound.astro';
import SongAudio from '../../components/SongAudio.astro';
import { getSongById, type Song } from '../../lib/db';
import { env } from 'cloudflare:workers';
// BGM 试听映射（本站 songId → 上游相对路径），由 scripts/ub/build-ub-audio.cjs 生成。
// 打包期内联进 Worker，运行时不读文件；未命中的曲目说明上游没有音源，不渲染播放器。
import audioMap from '../../data/ub-audio.json';

export const prerender = false;

const { songId } = Astro.params;
const db = (env as { beyond_jubeat?: D1Database })?.beyond_jubeat;
const song: Song | null = songId ? await getSongById(db, songId) : null;

// 找不到就渲染 404 内容并回 404 状态码：原 URL 不变，符合 HTTP 语义，
// 也不会被搜索引擎当成「内容存在但跳走了」。不用 Astro.redirect——那会 302 到 /404，
// URL 变了之后浏览器地址栏显示的是 /404，用户复制出来的链接就丢了 songId。
if (!song) {
  Astro.response.status = 404;
}
// 404 结果不缓存（避免把「这首不存在」缓存到边缘，之后补数据也还能查到）
Astro.response.headers.set(
  'cache-control',
  song
    ? 'public, max-age=30, s-maxage=300, stale-while-revalidate=60'
    : 'public, max-age=0, s-maxage=0'
);

// 注意：以下派生值只在 song 存在时计算。之前漏了这层保护——song 为 null 时
// 直接读 song.gen 会抛 TypeError，线上表现为 500 而不是 404（真实踩坑）。
const genMeta = song ? GEN_ORDER.find((g) => g.k === song.gen) : undefined;

// 【2026-10-29 主人「唱片换成对应世代的颜色 + 加世代 logo」，
//   并明确「即使正在看 jubeat 的歌，只要切到 ripples 主题，也应当显示 jubeat 的颜色」】
//
// 所以这里**不能用 var(--acc)**——那是"当前主题色"，会随顶栏切主题而变。
// 要的是「这首歌所属世代」的固定色：曲子属于 jubeat，就永远是 jubeat 的蓝，
// 无论用户此刻套着哪套皮肤。所以把这些色值抄成本表常量。
//
// 色值来源：src/styles/theme.css 每个 html[data-g="x"] 块的 --acc
// （scripts/ci 里若有主题色改动，这里是唯一需要同步的手抄点；改色请两边一起改）。
// clan 在数据层只有一个世代，但主题层拆成 4 套；clan 系列的曲子改用 EXT 等级分段取色，
// 见下面的 clanColor()。
const GEN_COLOR: Record<string, string> = {
  jubeat: '#2f86e6',
  ripples: '#4fae9e',
  knit: '#e0a92e',
  copious: '#8fa6ff',
  saucer: '#37474F',
  'saucer fulfill': '#c9d2d6',
  prop: '#e0338f',
  Qubell: '#3E8FBF',
  festo: '#ffd166',
  'Ave.': '#2ee8e8',
  'beyond the Ave.': '#ffa23c',
  音乐魔方: '#3f6fd8',
};

// 【2026-10-29 主人「clan 代的唱片和世代徽章颜色根据 EXT 等级来定：
//   7 级及以下绿、8 级蓝、9 级红、10 级紫」】
// clan 恰好自带四套主题色，这里按 EXT 分段取对应的那套，观感上是同一套视觉语言。
// 色值取自 theme.css：clan_green #57d98a / clan_blue #5c8dff /
// clan_red #ff6b6b / clan_purple #b07dff。
// 边界：EXT 为空（无谱面）时退回 7 级及以下的绿色——不留空色。
// 分段用「>= 10 → 紫，>= 9 → 红，>= 8 → 蓝，其余 → 绿」，
// 这样 10.5 这类超 10 的定数也落在紫段，不会漏进红段。
const CLAN_BY_EXT = [
  { min: 10, color: '#b07dff' }, // 紫
  { min: 9, color: '#ff6b6b' },  // 红
  { min: 8, color: '#5c8dff' },  // 蓝
  { min: -Infinity, color: '#57d98a' }, // 绿（7 级及以下）
];
const clanColor = (ext: number | null) => {
  const v = ext == null ? 0 : ext;
  for (const seg of CLAN_BY_EXT) if (v >= seg.min) return seg.color;
  return CLAN_BY_EXT[CLAN_BY_EXT.length - 1].color;
};

// 世代名（数据层）与 logo 文件名（主题层）是两套标识，不能直接拼：
//   Qubell→qubell、Ave.→ave、beyond the Ave.→bta、音乐魔方→yymf、saucer fulfill→saucerfulfill。
const GEN_LOGO: Record<string, string> = {
  jubeat: 'jubeat',
  ripples: 'ripples',
  knit: 'knit',
  copious: 'copious',
  saucer: 'saucer',
  'saucer fulfill': 'saucerfulfill',
  prop: 'prop',
  Qubell: 'qubell',
  clan: 'clan',
  festo: 'festo',
  'Ave.': 'ave',
  'beyond the Ave.': 'bta',
  音乐魔方: 'yymf',
};
const genLogo = song ? GEN_LOGO[song.gen] : undefined;
// clan 走 EXT 分段取色，其余世代用固定色（见上面两处注释）
const genColor = song
  ? song.gen === 'clan'
    ? clanColor(song.lv.ext)
    : GEN_COLOR[song.gen]
  : undefined;

const dash = (v: number | null) => (v == null ? '—' : String(v));
const servers = song ? [song.jp ? '日服' : null, song.cn ? '国服' : null].filter(Boolean).join(' / ') : '';
const coverSrc = song?.cover ? `/assets/images/jackets/${song.cover}` : null;

// 定数刻度：jubeat 定数上限约 11，按比例画条。低于 1 的给个最小可见宽度，
// 但用 .is-thin 提示「几乎为空」，避免短到看不见又被误读成没加载。
const SCALE_MAX = 11;
const gauge = (v: number | null) => (v == null ? null : Math.max(4, Math.round((v / SCALE_MAX) * 100)));

// 有没有音源：映射表命中才渲染试听条。1248 首里 1185 首有（上游是日服谱面站，
// 国服原创曲、拿不到官方 id 的 BTA- 占位曲、以及 2026-10-29 刚上架那 7 首——
// 上游还没收录——本就没有），未命中的不摆空控件。
const hasAudio = !!(song && (audioMap as Record<string, string>)[String(song.id)]);

// 【2026-10-28 重设计·第三版】主人「这歌曲详情太小了」。
// 上一版（10-22）是「左栏 = 封面 + 4 项硬数据，右栏 = 曲名 + 定数条，底部条 = 其余」。
// 实测问题：左栏 4 项把 aside 撑到 ~450px，而右栏只有 ~250px，靠 align-self:center
// 硬居中 → 定数条下方空出一大块（140px+），面板显得又高又空。
// 这一版改成**唱片内页**的标准结构：
//   左栏只有封面（208px，视觉锤）；
//   右栏艺术主体：艺人 → 曲名 → 定数条（信息重心）；
//   全部元数据（songId / 世代 / 分区 / 服务器 / BPM / 上线 / 解禁 / 备注）
//   统一收进底部横条——它本来就该是「唱片背签」式的密集小字区，铺满宽度。
// 好处：两栏高度接近，版面不用硬居中；元数据集中成一区比散落两处更好扫读。
// 仍然只渲染有值的项，不摆「—」占位。
// 【2026-10-29】songId / 世代 / 分区 三项已挪到曲名上方的徽章行，
// 这里不再重复——同一份信息出现两处，读起来像两个不同字段。
type Meta = { k: string; v: string; mono?: boolean };
const metaFoot: Meta[] = song
  ? [
      { k: '服务器', v: servers },
      ...(song.bpm ? [{ k: 'BPM', v: song.bpm, mono: true }] : []),
      ...(song.d ? [{ k: '上线', v: song.d, mono: true }] : []),
      ...(song.unlock ? [{ k: '解禁', v: song.unlock }] : []),
      ...(song.kind === 'synthetic' ? [{ k: '备注', v: '官方 songId 暂缺，此处为占位 id' }] : []),
    ].filter((m) => m.v)
  : [];
---

<Layout
  title={pageTitle(song ? song.t : '页面不存在')}
  canonicalPath={song ? `/songs/${song.id}/` : ''}
  noindex={!song}
  description={song ? `${song.t}${song.a ? ' - ' + song.a : ''}｜jubeat ${song.gen} 世代，BSC ${dash(song.lv.bsc)} / ADV ${dash(song.lv.adv)} / EXT ${dash(song.lv.ext)}。` : undefined}
>
  {!song ? <NotFound /> : (
  // --gen-c = 本曲所属世代的固定色（与当前主题无关），由父级下发一次，
  // 后代 .sd-disc / .sd-badge-gen 都读它——"唱片颜色 = 世代徽章颜色"天然一致。
  <section class="band sd" id="songRoot" style={genColor ? `--gen-c: ${genColor}` : undefined}>
    {/* 顶部不再是「大圆角玻璃面板里塞一堆小方盒」，而是两栏唱片页式布局：
        左窄栏放曲绘与硬数据（像唱片封套背签），右栏让曲名与定数占据版面。
        曲绘原图只有 144px，放大必糊——所以不追求大图，做成贴合尺寸的实物感封面。 */}
    <div class="sd-head">
      <a class="sd-back" href="/songs/">曲目库</a>
      <span class="sd-sep" aria-hidden="true"></span>
      <span class="sd-crumb">{song.gen}</span>
    </div>

    <div class="sd-body">
      <aside class="sd-aside">
        {/* 【2026-10-29 主人第 1 条】曲绘下面垫一张唱片，向左露出小半个；
            BGM 播放时唱片旋转（状态由 SongAudio 写在 html[data-bgm] 上）。
            唱片必须在曲绘之下（z-index 更低），露出的那一弯才像"从封套里抽出来"。
            结构：.sd-disc 是唱片本体（黑胶同心圆环），.sd-disc-spin 只是承载旋转的层，
            两者拆开是因为旋转要独立于居中定位，混在一起会让 transform 互相覆盖。 */}
        <div class="sd-cover" aria-hidden={coverSrc ? undefined : 'true'}>
          {/* 唱片（主人 2026-10-29 两次修正）：
              ① 盘面颜色 = 当前世代主题色（与世代徽章同源，都取 --acc）；
              ② 世代 logo **印在盘面上、随唱片一起转**，不是钉在圆心。
                 所以 logo 放进 .sd-disc-spin 里——那个层才是承载旋转的。
                 圆心只留一个装轴孔。 */}
          <span class="sd-disc">
            <span class="sd-disc-spin">
              {genLogo ? (
                <img
                  class="sd-disc-logo"
                  src={`/assets/images/logo/${genLogo}.webp`}
                  alt=""
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                />
              ) : null}
            </span>
            <span class="sd-disc-hole" aria-hidden="true"></span>
          </span>
          <div class={`sd-j${song.alt ? ' is-alt' : ''}`}>
            {coverSrc ? (
              <img src={coverSrc} alt={`${song.t} 曲绘`} width="208" height="208" loading="eager" fetchpriority="high" decoding="async" />
            ) : (
              <span class="sd-no">no jacket</span>
            )}
            {/* 长押标识（2026-10-31 主人 hold.gif）：放在 .sd-j 内，overflow:hidden 会把
                角标裁在封套范围内。判定只认 has_hold === 1（null=未知不画）。
                原来的「[2] 长押谱」文案已按主人要求删除——那句话把 alt=1 说成了长押，
                而 alt=1 只是 [ 2 ] 谱面变体。 */}
            {song.hasHold === 1 ? (
              <picture class="sd-hold">
                <source srcset="/assets/images/badge/hold-static.png" media="(prefers-reduced-motion: reduce)" />
                <img
                  src="/assets/images/badge/hold.webp"
                  alt="长押谱"
                  title="长押谱"
                  width="128"
                  height="128"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            ) : null}
          </div>
        </div>
      </aside>

      <div class="sd-main">
        {/* 【2026-10-29 主人 4 条版式意见】
            ①songId 用 #10000036 的形式放到曲名**上方**；
            ②世代/分区做成两枚徽章、跟在 songId 右边（世代徽章用主题色，年份不要）；
            ③艺术家从曲名上方挪到**曲名下方**。
            顺序：songId + 世代徽章 + 分区徽章 → 曲名 → 艺术家。 */}
        <p class="sd-idline">
          <button type="button" class="sd-sid" data-copy={song.id} title="点击复制 songId">#{song.id}</button>
          <span class="sd-badge sd-badge-gen">{song.gen}</span>
          <span class="sd-badge sd-badge-cat">{song.cat}</span>
        </p>

        {/* 曲名：点一下复制歌名（主人 2026-10-29 要求）。用 button 而不是 h1 是为了
            可聚焦、可键盘触发；语义上仍用 h1 包住，标题层级不断。 */}
        <h1 class="sd-title-wrap">
          <button type="button" class="sd-title" data-copy={song.t} title="点击复制曲名">
            {song.t}
          </button>
        </h1>

        <p class="sd-artist">{song.a ?? '—'}</p>

        {/* 【2026-10-29 主人「把播放条弄到难度条上面」】
            顺序改为：曲名 → 艺人 → 试听条 → 定数条。理由（主人给的版面图）：
            播放是"听到这首"的入口，紧挨作品信息；定数条是数据区，压到下面。
            没有音源时试听条整块不渲染，定数条位置照旧。 */}
        {hasAudio ? <SongAudio songId={String(song.id)} /> : null}

        {/* 定数条：三条横条按 0-11 刻度填充，颜色沿用难度三色。
            定数是这个站最有信息量的字段，横条让「这首的难度分布」一眼可读
            （比如 BSC 短、EXT 长 = 高难曲）。
            【2026-10-29 主人「没有 bgm 的视图」】无音源时没有播放条占位，
            定数条会上移到曲绘高度；它又向左扩张到曲绘下方，于是被曲绘压住。
            给无音源加 .is-solo：把它推离曲绘底边（见 songs.css）。 */}
        <div class={`sd-gauge${hasAudio ? '' : ' is-solo'}`}>
          {([
            ['bsc', 'BSC', song.lv.bsc],
            ['adv', 'ADV', song.lv.adv],
            ['ext', 'EXT', song.lv.ext],
          ] as const).map(([key, label, val]) => (
            <div class={`sd-row sd-row-${key}${val == null ? ' is-empty' : ''}`}>
              <span class="sd-row-k">{label}</span>
              <span class="sd-bar"><i style={`width:${gauge(val) ?? 0}%`}></i></span>
              <span class="sd-row-v">{dash(val)}</span>
            </div>
          ))}
        </div>
      </div>

      {/* 底部横向信息条：BPM / 上线 / 解禁 / 备注。
          放在底板下缘横铺，既填满右半宽度、又把左栏过长的纵向清单压回去，
          让整体从「左重右空」变成两栏均衡。只渲染有值的项。 */}
      {metaFoot.length ? (
        <dl class="sd-foot">
          {metaFoot.map((m) => (
            <div class={m.k === '备注' ? 'is-wide' : undefined}>
              <dt>{m.k}</dt>
              <dd class={m.mono ? 'sd-num' : undefined}>{m.v}</dd>
            </div>
          ))}
        </dl>
      ) : null}
    </div>
  </section>
  )}

{/* 点击复制（主人 2026-10-29 第 5 条：点一下歌曲名可以复制到剪贴板）。
    songId 与曲名都挂 data-copy，用同一段脚本处理——两处行为一致，不写两套。
    clipboard API 在非 HTTPS / 老浏览器里可能不可用，所以带回退：
    临时 textarea + execCommand('copy')，这是 2026 年仍然最稳的兜底。
    【2026-10-29 改】提示从"贴元素上方的小气泡"改成"从顶部向下弹出的 toast"
    （主人原话「已复制直接换成从顶部向下弹出的toast」）——
    气泡的问题是不管怎么摆都受宿主元素尺寸影响，长曲名会漂、移动端会被挤出屏幕；
    页面级 toast 位置永远可预期。脚本负责创建/复用 #sdToast 节点。 */}
<script is:inline>
  (function () {
    var toastEl = null;
    var toastTimer = null;
    function ensureToast() {
      if (toastEl) return toastEl;
      toastEl = document.createElement('div');
      toastEl.id = 'sdToast';
      toastEl.className = 'sd-toast';
      toastEl.setAttribute('role', 'status');
      toastEl.setAttribute('aria-live', 'polite');
      toastEl.innerHTML =
        '<svg class="sd-toast-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>' +
        '<span>已复制</span>';
      document.body.appendChild(toastEl);
      return toastEl;
    }
    function showToast() {
      var t = ensureToast();
      // 先移除再强制回流，连点也能重播滑入动画
      t.classList.remove('is-on');
      void t.offsetWidth;
      t.classList.add('is-on');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { t.classList.remove('is-on'); }, 1600);
    }
    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }
    function copy(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text).then(
          function () { return true; },
          function () { return fallbackCopy(text); }
        );
      }
      return Promise.resolve(fallbackCopy(text));
    }
    var targets = document.querySelectorAll('[data-copy]');
    for (var i = 0; i < targets.length; i++) {
      targets[i].addEventListener('click', function () {
        var el = this;
        var text = el.getAttribute('data-copy') || '';
        if (!text) return;
        copy(text).then(function (ok) {
          if (ok) showToast();
          el.blur();
        });
      });
    }
  })();
</script>
</Layout>
