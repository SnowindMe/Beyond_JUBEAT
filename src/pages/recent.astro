---
// 最近更改 /recent/：从 D1 读 recent_changes，按时间倒序展示谁在什么时候改了什么。
//
// 为什么改成 SSR（prerender = false）：
//   编辑记录是运行时数据，构建期不可能知道。之前读的是 src/data/recent-changes.json
//   这份构建期快照，所以列表永远是空的——那个文件现在只留作 dev 退路（见 lib/db.ts）。
//
// 无 JS 也要能读：前后差异用原生 <details>/<summary>，折叠展开完全由浏览器负责，
// 这一页没有任何脚本。定数/曲名这类长文本靠 CSS 的 overflow-wrap:anywhere 兜底。
import Layout from '../layouts/Base.astro';
import { pageTitle } from '../lib/title';
import { getRecentChanges, type RecentChange } from '../lib/db';
import { env } from 'cloudflare:workers';

export const prerender = false;

const db = (env as { beyond_jubeat?: D1Database })?.beyond_jubeat;
const changes: RecentChange[] = await getRecentChanges(db);

// 缓存口径与 /songs/ 一致：内容变化慢，允许浏览器短缓存、边缘稍久，
// stale-while-revalidate 兜住边缘回源。后台编辑后要立刻看到新记录的话，
// 由 /api/admin/song-update 侧不涉及——它的 303 跳回编辑页，用户自己刷新即可。
Astro.response.headers.set(
  'cache-control',
  'public, max-age=30, s-maxage=300, stale-while-revalidate=60'
);

const count = changes.length;

// 时间显示：库里存的是 ISO（UTC，带毫秒）。直接甩 ISO 给读者不好读，
// 这里统一换成北京时间「YYYY-MM-DD HH:MM」，<time datetime> 仍保留原始 ISO
// （机器可读的那一份必须是标准格式，不能是给人看的那份）。
// 不用 toLocaleString：Workers 的 ICU 数据不全，且不同 isolate 上结果可能不一致。
// 这里就是单纯的 +8 小时算术，跨平台确定。
const beijing = (iso: string): string => {
  const ms = Date.parse(iso);
  if (!Number.isFinite(ms)) return iso;
  const d = new Date(ms + 8 * 3600 * 1000);
  const p = (n: number) => String(n).padStart(2, '0');
  return `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())} ${p(d.getUTCHours())}:${p(d.getUTCMinutes())}`;
};
---

<Layout
  title={pageTitle('最近更改')}
  canonicalPath="/recent/"
  description="jubeat 音乐魔方中文资料站的最近更改：记录维护者对站点内容的每一次编辑。"
  noindex
>
  <section class="band">
    <div class="band-h">
      <h1>最近更改</h1>
      <em>{count} changes</em>
    </div>

    <div class="panel rc">
      {count === 0 ? (
        <div class="rc-empty">
          <div class="wip-ico" aria-hidden="true"><i></i><i></i><i></i></div>
          <p class="wip-t">还没有任何更改记录</p>
          <span class="wip-s">awaiting first edit</span>
          <p class="rc-note">
            这里按时间倒序列出维护者对站点内容的编辑：谁、什么时候改了哪个页面、改了什么、前后差异。
            维护者改过曲目之后，记录会出现在这里。
          </p>
        </div>
      ) : (
        <ol class="rc-list">
          {changes.map((c) => (
            <li class="rc-item">
              <div class="rc-top">
                {/* datetime 放原始 ISO（机器可读），页面上显示北京时间 */}
                <time class="rc-time" datetime={c.time}>{beijing(c.time)}</time>
                <span class="rc-user">{c.user}</span>
              </div>
              <a class="rc-target" href={c.target.href}>{c.target.label}</a>
              {c.summary && <p class="rc-sum">{c.summary}</p>}
              {/* 原生 details：不写一行 JS 也能展开。before/after 只在有值时才出，
                  编辑记录里两者一般成对出现，但 schema 允许单独为 NULL。 */}
              {c.before || c.after ? (
                <details class="rc-diff">
                  <summary>前后差异</summary>
                  <div class="rc-diff-body">
                    {c.before && (
                      <div class="rc-before">
                        <span class="rc-tag">改前</span>
                        {/* 文本单独一层：换行要保留（一条记录里可能改了好几个字段，
                            每个字段一行），而 .rc-tag 是 flex 兄弟、不该被 pre-line 影响 */}
                        <span class="rc-text">{c.before}</span>
                      </div>
                    )}
                    {c.after && (
                      <div class="rc-after">
                        <span class="rc-tag">改后</span>
                        <span class="rc-text">{c.after}</span>
                      </div>
                    )}
                  </div>
                </details>
              ) : null}
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</Layout>
