---
// 曲目库：日服 / 国服 同页切换（不换网址），分区按服务器各自的分类，区内再按世代分组。
// 数据在运行时从 Cloudflare D1 读取（prerender = false）；切换与筛选仍是纯前端显隐，
// 不请求接口、不动 URL。D1 查询在 lib/db.ts 里做 isolate 级缓存（60s）。
import Layout from '../layouts/Base.astro';
import '../styles/songs.css';
import { pageTitle } from '../lib/title';
import { GEN_JP, GEN_CN } from '../lib/gens';
import { getAllSongs, type Song } from '../lib/db';
import { env } from 'cloudflare:workers';

// 这一页是唯一需要运行时数据的页面，其余页面仍是构建期静态页。
export const prerender = false;

const ALL: Song[] = await getAllSongs((env as { beyond_jubeat?: D1Database })?.beyond_jubeat);

// 数据变化很慢：允许浏览器短缓存，边缘可缓存更久（stale-while-revalidate 兜底）
Astro.response.headers.set(
  'cache-control',
  'public, max-age=30, s-maxage=300, stale-while-revalidate=60'
);

const yearOf = (gen: string, _srv?: string) => [...GEN_JP, ...GEN_CN].find((g) => g.k === gen)?.y ?? '';

// 分区顺序：日服 版权 → 原创；国服 KONAMI原创 → 音乐魔方原创 → 音乐魔方流行。
const CATS: Record<string, string[]> = {
  jp: ['版权', '原创'],
  cn: ['KONAMI原创', '音乐魔方原创', '音乐魔方流行'],
};
// 分区归属（主人 2026-10-22 口径）：音乐魔方里「两者都有」的曲目显示在 KONAMI原创 分区，
// 其余按库里的 category。日服视图只走自己的两个分区。
const catOf = (s: Song, srv: string) => (srv === 'cn' && s.jp && s.cn ? 'KONAMI原创' : s.cat);
// 每个分区实际会出现的世代
const CAT_GENS: Record<string, Record<string, string[]>> = {
  jp: { '版权': GEN_JP.map((g) => g.k), '原创': GEN_JP.map((g) => g.k) },
  cn: { 'KONAMI原创': GEN_CN.map((g) => g.k), '音乐魔方原创': GEN_CN.map((g) => g.k), '音乐魔方流行': GEN_CN.map((g) => g.k) },
};
// 服务器卡：卡片内 logo 在上、服务器名在下（主人 2026-10-21 指定）。
// 国际服已移除（主人 2026-10-22）：曲库没有独立国际服数据，入口留着只会误导。
const SRV_CARDS = [
  { id: 'jp', name: '日服', gen: 'Beyond the Ave.', logo: 'bta', line: true },
  { id: 'cn', name: '国服', gen: '音乐魔方', logo: 'yymf', line: false },
] as const;

// 按 视图服务器 → 分区 → 世代 建桶，桶内按 EXT 定数降序（同一曲的长押谱排在原谱后面）。
// 行有 jp/cn 两个标志：两服都有的行（KONAMI原创）同时进 jp 和 cn 两个视图。
const extOf = (s: Song) => s.lv.ext ?? -1;
// 视图归属：行 = 一份谱面记录，各归各的世代。双服曲（如 Big Daddy）两服各有一行，
// 国服视图只收「音乐魔方」世代的行，日服视图只收日服世代的行，避免同一首的两行串视图。
const inView = (s: Song, srv: string) =>
  srv === 'cn' ? s.cn && s.gen === '音乐魔方' : s.jp && s.gen !== '音乐魔方';
const bucket: Record<string, Record<string, Record<string, Song[]>>> = { jp: {}, cn: {} };
for (const srv of ['jp', 'cn']) {
  for (const cat of CATS[srv]) {
    bucket[srv][cat] = {};
    for (const gen of CAT_GENS[srv][cat]) bucket[srv][cat][gen] = [];
  }
}
for (const srv of ['jp', 'cn']) {
  for (const s of ALL) {
    if (!inView(s, srv)) continue;
    const g = bucket[srv]?.[catOf(s, srv)]?.[s.gen];
    if (g) g.push(s);
  }
}
for (const srv of ['jp', 'cn']) {
  for (const cat of CATS[srv]) {
    for (const gen of CAT_GENS[srv][cat]) {
      bucket[srv][cat][gen].sort((a, b) => extOf(b) - extOf(a) || a.t.localeCompare(b.t));
    }
  }
}

const countOf = (srv: string, cat?: string) =>
  ALL.filter((s) => inView(s, srv) && (!cat || catOf(s, srv) === cat)).length;
const srvTotal = (srv: string) => ALL.filter((s) => inView(s, srv)).length;

// 徽章颜色按难度固定（主人 2026-10-22）：BSC 绿 / ADV 黄 / EXT 红；空值灰
const dash = (v: number | null) => (v == null ? '—' : String(v));

const DEFAULT_SRV = 'jp';

// 首屏曲绘：默认视图（日服 · 版权 · 前两个世代）里的前 18 张优先加载，
// 其余一律 lazy + low，避免一次开 1200+ 请求。
const EAGER = new Set(
  GEN_JP.map((g) => bucket.jp['版权'][g.k] ?? [])
    .reduce((acc, arr) => acc.concat(arr), [])
    .slice(0, 18)
    .map((s) => s.id),
);
---


<Layout
  title={pageTitle('曲目')}
  canonicalPath="/songs/"
  description={`jubeat 音乐魔方曲目库：日服 ${srvTotal('jp')} 首（版权 ${countOf('jp', '版权')} 首、原创 ${countOf('jp', '原创')} 首）、国服 ${srvTotal('cn')} 首（KONAMI原创 ${countOf('cn', 'KONAMI原创')} 首、音乐魔方原创 ${countOf('cn', '音乐魔方原创')} 首、音乐魔方流行 ${countOf('cn', '音乐魔方流行')} 首），按世代分组，同页切换服务器。`}
>
  <section class="band songs" id="songsRoot" data-srv={DEFAULT_SRV}>
    {/* 主人 2026-10-22 要求：去掉「曲目 + songs 计数」那行标题，也去掉外面那层暗色 panel，
        服务器卡直接站到页面上并放大，总曲数收进卡里（分区 chips 各自还带自己的计数）。
        标题行去掉后页面只剩 h3（分区名），补一个视觉隐藏的 h2 保住标题层级，供读屏与 SEO。 */}
    <h2 class="sc-hide">曲目库</h2>
    <div class="sc-tools">
      <div class="sc-srv" role="group" aria-label="切换服务器">
        {SRV_CARDS.map((s) => (
          <button type="button" class={`sc-srv-b${s.id === DEFAULT_SRV ? ' is-on' : ''}`} data-srv={s.id} aria-pressed={s.id === DEFAULT_SRV ? 'true' : 'false'}>
            <img class={`sc-srv-logo${s.line ? ' sc-line' : ''}`} src={`/assets/images/logo/${s.logo}.webp`} alt="" width="160" height="54" loading="eager" decoding="async" />
            <span class="sc-srv-n">{s.name}</span>
            <span class="sc-srv-c">{srvTotal(s.id)} 首</span>
          </button>
        ))}
      </div>

      <div class="sc-cats" role="group" aria-label="按分区筛选">
        {(['jp', 'cn'] as const).map((srv) => (
          <div class="sc-cat-set" data-srv={srv} hidden={srv !== DEFAULT_SRV}>
            <button type="button" class="sc-chip is-on" data-cat="all" aria-pressed="true">全部分区<b>{srvTotal(srv)}</b></button>
            {CATS[srv].map((c) => (
              <button type="button" class="sc-chip" data-cat={c} aria-pressed="false">{c}<b>{countOf(srv, c)}</b></button>
            ))}
          </div>
        ))}
      </div>
    </div>

    {(['jp', 'cn'] as const).map((srv) => (
      <div class="sc-body" data-srv={srv} hidden={srv !== DEFAULT_SRV}>
        {CATS[srv].map((cat) => (
          <section class="sc-sec" data-cat={cat}>
            <header class="sc-sec-h">
              <h3>{cat}</h3>
              <em>{countOf(srv, cat)} 首</em>
            </header>
            {CAT_GENS[srv][cat].map((gen) => {
              const list = bucket[srv][cat][gen];
              if (!list.length) return null;
              return (
                <div class="sc-gen">
                  <div class="sc-gen-h">
                    <b>{gen}</b>
                    {yearOf(gen, srv) && <span>{yearOf(gen, srv)}</span>}
                    <i>{list.length}</i>
                  </div>
                  <div class="sc-grid">
                    {list.map((s) => (
                      <article class="sc-card">
                        <div class="sc-j">
                          {s.cover ? (
                            <img
                              src={`/assets/images/jackets/${s.cover}`}
                              alt=""
                              width="144"
                              height="144"
                              loading={EAGER.has(s.id) ? 'eager' : 'lazy'}
                              fetchpriority={EAGER.has(s.id) ? 'high' : 'low'}
                              decoding="async"
                            />
                          ) : (
                            <span class="sc-no">no jacket</span>
                          )}
                          {s.alt ? <span class="sc-alt">[2]</span> : null}
                        </div>
                        <b class="sc-t" title={s.t}>{s.t}{s.jp && s.cn ? <span class="sc-dual" title="日服/国服均有">双</span> : null}</b>
                        <span class="sc-a" title={s.a ?? ''}>{s.a ?? '—'}</span>
                        <div class="sc-lv">
                          <i class={`lv lv-bsc${s.lv.bsc == null ? ' lv-0' : ''}`}><u>BSC</u>{dash(s.lv.bsc)}</i>
                          <i class={`lv lv-adv${s.lv.adv == null ? ' lv-0' : ''}`}><u>ADV</u>{dash(s.lv.adv)}</i>
                          <i class={`lv lv-ext${s.lv.ext == null ? ' lv-0' : ''}`}><u>EXT</u>{dash(s.lv.ext)}</i>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              );
            })}
          </section>
        ))}
      </div>
    ))}
  </section>

  <script is:inline>
    // 服务器切换 + 分区筛选：只改 data-srv / hidden，不写 localStorage、不动 URL。
    (function () {
      var root = document.getElementById('songsRoot');
      if (!root) return;
      var srvBtns = root.querySelectorAll('.sc-srv-b');
      var sets = root.querySelectorAll('.sc-cat-set');
      var bodies = root.querySelectorAll('.sc-body');

      var state = { srv: root.getAttribute('data-srv') || 'jp', cat: 'all' };

      function apply() {
        root.setAttribute('data-srv', state.srv);
        var bs = state.srv;
        for (var i = 0; i < srvBtns.length; i++) {
          var on = srvBtns[i].getAttribute('data-srv') === state.srv;
          srvBtns[i].classList.toggle('is-on', on);
          srvBtns[i].setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        for (var j = 0; j < sets.length; j++) {
          sets[j].hidden = sets[j].getAttribute('data-srv') !== bs;
        }
        // 总曲数已移进服务器卡（静态渲染），这里只负责显隐，不再统计
        for (var k = 0; k < bodies.length; k++) {
          var body = bodies[k];
          var isMine = body.getAttribute('data-srv') === bs;
          body.hidden = !isMine;
          var secs = body.querySelectorAll('.sc-sec');
          for (var m = 0; m < secs.length; m++) {
            var show = isMine && (state.cat === 'all' || secs[m].getAttribute('data-cat') === state.cat);
            secs[m].hidden = !show;
          }
        }
      }

      root.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var srvB = t.closest('.sc-srv-b');
        if (srvB) { state.srv = srvB.getAttribute('data-srv'); state.cat = 'all';
          var chips = document.querySelectorAll('.sc-cat-set .sc-chip');
          for (var i = 0; i < chips.length; i++) {
            var on = chips[i].getAttribute('data-cat') === 'all';
            chips[i].classList.toggle('is-on', on);
            chips[i].setAttribute('aria-pressed', on ? 'true' : 'false');
          }
          apply(); return; }
        var chip = t.closest('.sc-chip');
        if (chip) {
          var set = chip.closest('.sc-cat-set');
          if (!set || set.getAttribute('data-srv') !== state.srv) return;
          state.cat = chip.getAttribute('data-cat');
          var all = set.querySelectorAll('.sc-chip');
          for (var n = 0; n < all.length; n++) {
            var sel = all[n] === chip;
            all[n].classList.toggle('is-on', sel);
            all[n].setAttribute('aria-pressed', sel ? 'true' : 'false');
          }
          apply();
        }
      });

      apply();
    })();
  </script>
</Layout>