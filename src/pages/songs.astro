---
// 曲目库：日服 / 国服 同页切换（不换网址），分区按服务器各自的分类，区内再按世代分组。
// 数据在运行时从 Cloudflare D1 读取（prerender = false）；切换、搜索、筛选、排序全是纯前端显隐，
// 不请求接口、不动 URL。D1 查询在 lib/db.ts 里做 isolate 级缓存（60s）。
//
// 世代分组标题是纯文字（2026-10-28 主人「/songs/gen/jubeat/ 这个页面不要」，
// 单独的世代筛选页已删除；本页本身已按世代分组，不需要再多一层）。
// 卡片结构在 components/SongCard.astro，别在这里再写一遍。
//
// 搜索 / 四维筛选 / 五种排序（2026-10-23，t9）：
//   匹配字段全部读卡片上的 data-*，不在输入时解析文本；
//   排序只改 CSS order，不重排 DOM（1248 张卡重排会掉帧、滚动位置也会跳）。
// 【无 JS 时】页面默认就渲染成「日服 → 分区 → 世代分组」的完整列表，
//   工具条只是叠加能力：脚本不跑，内容照样从头读到尾，不会白屏。
import Layout from '../layouts/Base.astro';
import '../styles/server-card.css';
import '../styles/songs.css';
import SongCard from '../components/SongCard.astro';
import { jacketUrl } from '../lib/covers';
import GenBlock from '../components/GenBlock.astro';
import GenSkeleton from '../components/GenSkeleton.astro';
import { pageTitle } from '../lib/title';
import site from '../data/site.json';
import { GEN_ORDER, GEN_JP, GEN_CN } from '../lib/gens';
import { getAllSongs, type Song } from '../lib/song-data';
import { CATS, catOf, countedIn, isLimitedEnded, isPickUp, todayISO, viewRows, type Srv } from '../lib/song-view';
import { env } from 'cloudflare:workers';

// 这一页是唯一需要运行时数据的页面，其余页面仍是构建期静态页。
export const prerender = false;

// 曲目走静态资产（不再每请求扫 D1 的 1248 行），曲绘/片段同理见 song-data.ts 的说明。
const ALL: Song[] = await getAllSongs(
  (env as { ASSETS: Fetcher }).ASSETS,
  Astro.url.origin,
  (env as { beyond_jubeat?: D1Database })?.beyond_jubeat,
  Astro.locals.cfContext
);

// 数据变化很慢：允许浏览器短缓存，边缘可缓存更久（stale-while-revalidate 兜底）
Astro.response.headers.set(
  'cache-control',
  'public, max-age=30, s-maxage=300, stale-while-revalidate=60'
);

// 世代 → 元信息（取上线日；slug 字段随世代页一起作废了，这里用不到）。
const genMetaOf = (gen: string) => GEN_ORDER.find((g) => g.k === gen);
const dateOf = (gen: string) => genMetaOf(gen)?.date ?? '';

// 每个分区实际会出现的世代（2026-10-24 分区改名后重算）。
//
// KONAMI 分区要列**日服 12 个世代 + 音乐魔方**：
// 它装的是「国服已上线的日服曲」（sheet1 打√的 432 首，首登于 jubeat…beyond the Ave.）
// 加上国服独有的机种移植曲与 Big Daddy。只映射 GEN_CN 的话，那 432 首会因为没有对应桶被丢掉——
// 这正是「数据标了 cn=1、页面却仍只有 91 卡」的真因（视图放行了，桶没建）。
//
// 「独占」也要列日服的 12 个世代：华立独占的 17 首里有相当一部分是 gitadora / DDR / popn
// 等机种的移植曲（源表 I 列写着「移植机种」），它们在库里带着日服世代的 gen_name，
// 只给它 GEN_CN 会导致命中卡片被静默丢掉（数据对、页面少卡，就是上一轮踩过的坑）。
// 多给世代不会让别的曲混进来 —— 分区归属由 catOf() 决定，世代只是分块轴。
const CN_ALL_GENS = [...GEN_JP.map((g) => g.k), ...GEN_CN.map((g) => g.k)];
const CAT_GENS: Record<string, Record<string, string[]>> = {
  jp: { '授权': GEN_JP.map((g) => g.k), '原创': GEN_JP.map((g) => g.k) },
  cn: {
    '独占': CN_ALL_GENS,
    'KONAMI': CN_ALL_GENS,
    '原创': GEN_CN.map((g) => g.k),
    '流行': GEN_CN.map((g) => g.k),
  },
};
// 服务器卡：卡片内 logo 在上、服务器名在下（主人 2026-10-21 指定）。
// 国际服已移除（主人 2026-10-22）：曲库没有独立国际服数据，入口留着只会误导。
// latest = 该服最近一次收录新曲的日期（主人 2026-11-14 给出：日服 2026-09-20、国服 2026-10-29；
// 国服 2026-11-16 上新后由本人改为同日，与 jubility.astro 同值同源）。
// 曲库数据里没有「收录日」这一列，也推不出来，所以是常量；某一服上新后要手动改这里。
// 文案主人定的是「Latest：」（首版写成 Lastest，2026-11-14 当场纠正）。
const SRV_CARDS = [
  { id: 'jp', name: '日服', gen: 'Beyond the Ave.', logo: 'bta', line: true, latest: '2026-09-20' },
  { id: 'cn', name: '国服', gen: '音乐魔方', logo: 'yymf', line: false, latest: '2026-11-16' },
] as const;

// 按 视图服务器 → 分区 → 世代 建桶。
//
// 【桶内顺序必须与前端默认排序一致（2026-10-25 修「刷新先看到难度降序再跳到 songId 升序」）】
// 前端排序只写 CSS order、不重排 DOM，而默认排序已改成 songId 升序（DEFAULT_SORT = 'id-asc'）。
// 原来服务端按 EXT 降序输出 DOM，于是首屏绘制的是「定数高→低」，脚本跑完才被 order 改写成
// songId 升序 —— 两者之间的时间差就是用户看到的「先难度降序、再跳一下」。
// 现在服务端直接按 songId 升序输出，首帧即最终顺序，没有可闪的空档。
// 「哪些行进哪个视图、算哪个分区」的口径在 lib/song-view.ts，与世代页共用，别在这里重写。
/** 与前端 sortCards('id-asc') 完全同构的比较器：
 *  songId 是「8 位日服 / 9 位国服」两种长度，必须按数值比，字符串比会把 991000007 排到
 *  11000228 前面；非纯数字 id（日服占位 BTA-xxxxxx）排在数字之后，同 id 才比曲名。
 *  改这里必须同步改前端那段，否则又会出现「首帧一个顺序、脚本跑完另一个顺序」。 */
const byIdAsc = (a: Song, b: Song) => {
  const na = /^\d+$/.test(a.id) ? Number(a.id) : null;
  const nb = /^\d+$/.test(b.id) ? Number(b.id) : null;
  if (na === null && nb !== null) return 1;
  if (nb === null && na !== null) return -1;
  const c = na === null || nb === null ? a.id.localeCompare(b.id) : na - nb;
  return c !== 0 ? c : a.t.localeCompare(b.t);
};
const bucket: Record<string, Record<string, Record<string, Song[]>>> = { jp: {}, cn: {} };
for (const srv of ['jp', 'cn'] as const) {
  for (const cat of CATS[srv]) {
    bucket[srv][cat] = {};
    for (const gen of CAT_GENS[srv][cat]) bucket[srv][cat][gen] = [];
  }
}
// 国服视图内去重（2026-10-24 实测发现）：国服视图现在收 cn=1 的所有行，
// 而「双服曲」在库里是**两行**（日服行 + 国服行，如 Big Daddy 11000228 / 991000007）。
// 不去重的话同一首会在国服视图里出现两次，违反「同一视图内不重复」这条一直有效的约束
// （之前 cn 只收 gen==='音乐魔方' 的行，那两行不会同时进视图，所以没暴露）。
// 保留哪一行：优先保留国服行（gen==='音乐魔方'，它的定数/分类是国服口径），
// 日服行只在这一首没有国服行时才留（即 432 首旧框曲，它们本来就只有日服行）。
// 【2026-10-28 抽走】原先这里自建 cnSeen、并在 bucket / byGen / rowsIn 三处各写一遍
// 「inView + 国服去重」的 filter；jubility 那边自己又写第四遍，且漏了限时曲。
// 现在全部走 song-view.ts 的 viewRows() / countedIn()，单一来源。
// cnSeen 已随之上移进 viewRows，本页不再需要持有它。
for (const srv of ['jp', 'cn'] as const) {
  // viewRows 已内含「国服视图里双服曲只留国服行」的去重，这里不再手写一遍。
  for (const s of viewRows(ALL, srv)) {
    const g = bucket[srv]?.[catOf(s, srv)]?.[s.gen];
    if (g) g.push(s);
  }
}
for (const srv of ['jp', 'cn'] as const) {
  for (const cat of CATS[srv]) {
    for (const gen of CAT_GENS[srv][cat]) {
      bucket[srv][cat][gen].sort(byIdAsc);
    }
  }
}

// 「全部分区」视图（主人 2026-10-24）：选「全部」时不按分区分块，改成跨该服务器
// 所有分区按世代整合——一个世代只出现一次，同一世代的授权/原创/国服各类曲目混在一起按定数排。
// 不这么做的话，选「全部」只是把三个分区各自展开，同一个世代会出现 3 次，看着不像"全部"。
// 键用世代名，值是该世代在这个服务器视图下的全部行（跨分区去重后合并）。
const byGen: Record<string, Record<string, Song[]>> = { jp: {}, cn: {} };
for (const srv of ['jp', 'cn'] as const) {
  for (const gen of GEN_JP.concat(GEN_CN).map((g) => g.k)) byGen[srv][gen] = [];
}
for (const srv of ['jp', 'cn'] as const) {
  for (const s of viewRows(ALL, srv)) {
    const g = byGen[srv][s.gen];
    if (g) g.push(s);
  }
  for (const gen of Object.keys(byGen[srv])) {
    byGen[srv][gen].sort(byIdAsc);
  }
}
// 该服务器视图下按 **GEN_ORDER 的自然顺序（旧→新：jubeat 2008 → beyond the Ave. 2024）**
// 排列的世代清单，只保留非空世代。
// 顺序固定为「旧→新」（与 GEN_ORDER 一致）。原「世代 新→旧」排序项已按主人要求删除，
// 所以这里不需要再考虑「块顺序被前端改写」的情况，直接按 GEN_ORDER 排即可。
//
// 【2026-10-24 修正】不再按「世代自带服务器」过滤（g.s === srv）——那是「国服只有音乐魔方
// 一个世代」的旧口径。国服视图现在还要装「旧框已有曲」（sheet1 打√的 432 首，首登于日服
// 各世代），它们必须有自己的世代块，否则数据标了 cn=1、byGen 桶也装好了，渲染时却一个块
// 都不列 —— 结果就是标题写「524 首」、页面只有 91 张卡（本轮实测到的真因）。
// 判据改成「该视图下这个世代桶非空」，与是谁的世代无关；空世代仍然不出现。
const srvGenOrder = (srv: Srv) =>
  GEN_ORDER.map((g) => g.k).filter((k) => (byGen[srv][k] || []).length > 0);

/* 骨架块头那个「N 首」要与真卡片的可见数一致（2026-11-16 主人指出）：
   默认藏掉的已结束限时曲不能算进去，否则骨架写「105 首」、换成真卡片后变「103 首」。
   data-count 同时是占位高度的估算输入，用可见数也只会让估算更准。 */
const visibleCountOf = (srv: Srv, gen: string) =>
  (byGen[srv][gen] || []).filter((s) => !isLimitedEnded(s)).length;

// 计数必须与实际渲染同一套口径，否则就会出现「标题 524、页面 523」这种自相矛盾
// （本轮实测：去重过滤器只加在渲染循环里，countOf/srvTotal 还在裸数 ALL）。
// 所以先把「这个视图里到底有哪些行」抽成一个函数，桶、计数、世代清单三处共用它。
// 【2026-10-28 限时曲】服务端就判一次，别只在前端隐藏：
// 主人明确「服务器选项卡的歌曲总数也不要加上限时曲的数量」——若只在 JS 里藏卡片，
// 右上角那个「1150 首」仍会把它们算进去，数字与肉眼可见对不上。
// 口径与前端 isEndedLimited() 严格一致：结束日 < 今天 才算已结束。
// 日期与限时曲判据、视图行都改由 song-view.ts 提供（todayISO / isLimitedEnded / countedIn）。
// 原先这里是第 3 份手写 filter，jubility.ts 还有第 4 份且漏了限时曲——已全部收敛。
const TODAY = todayISO();

/** 计入统计的行（排除已结束限时曲）：计数、分桶、世代清单、谱面池由此一并对齐 */
const rowsIn = (srv: Srv) => countedIn(ALL, srv, TODAY);

const countOf = (srv: Srv, cat?: string) =>
  rowsIn(srv).filter((s) => !cat || catOf(s, srv) === cat).length;
const srvTotal = (srv: Srv) => rowsIn(srv).length;

// PICK UP / COMMON 的计数（2026-10-25）。与卡片上的 data-scope 同一个判据 isPickUp()，
// 与 rowsIn 同一套视图去重——三处必须是同一个数，否则会出现「chip 写 142、页面数出 141」。
// 实测（2026-10-25 按本页口径）：日服 142 / 1008；国服 158 / 365（合计 523）。
const pickUpIn = (srv: Srv) => rowsIn(srv).filter((s) => isPickUp(s, srv));
const countScope = (srv: Srv, scope: 'pick' | 'common') => {
  const pick = pickUpIn(srv).length;
  const total = srvTotal(srv);
  return scope === 'pick' ? pick : total - pick;
};

const DEFAULT_SRV: Srv = 'jp';

// 首屏曲绘：只给「默认视图真正排在最前面那一个世代块」的头部若干张，其余一律 lazy。
//
// 【2026-11-15 P0 修正 · 取图口径必须与渲染循环同源】
// 原写法从 bucket.jp['授权']（授权分区、按世代键升序）取 18 张，而默认视图是
// 「全部曲目」+ srvGenOrder 顺序 + 块内 songId 升序，两者根本不是一个列表：
// 授权分区从 copious 起才有曲，于是 18 张全落在 copious 之后（DOM 里第 45~76 张），
// 首屏第一张卡反倒没人管 —— 线上实测最早图片请求 550ms、48 张图全部 ≥791ms。
// 现在直接摊平 srvGenOrder 的真实渲染顺序取，判据与下面的 map 渲染完全一致。
// bta（PICK UP 世代）本来就在 GEN_ORDER 末尾，摊平后自然落不进头部，
// 原来那个 EAGER_PICKUP_GENS 排除集因此可以省掉。
//
// 两台服务器各取一份：另一台的 body 是 hidden，而 display:none 容器里的 lazy 图
// 不会下载，不预先 eager 的话切过去就是一片空白。
// 量不同：默认服给 12 张（≈ 视口里两行多，视口 790 宽、每行 4~5 张），
// 另一服只给 6 张 —— 它要等用户真去点服务器切换才露脸，给满 12 张等于把
// fetchpriority=high 摊到十几张上、首屏那几张反而没优势。
// 两服的头部世代往往大面积重曲（jubeat 世代两服都有），Set 去重后实测 29 张 high。
const EAGER_LEAD: Record<Srv, number> = { jp: 12, cn: 6 };
const eagerOf = (srv: Srv): Song[] => {
  const first = srvGenOrder(srv)[0];
  return first ? (byGen[srv][first] ?? []).slice(0, EAGER_LEAD[srv]) : [];
};
const EAGER = new Set(['jp', 'cn'].flatMap((srv) => eagerOf(srv as Srv)).map((s) => s.id));

/* 首屏曲绘 preload（2026-11-13 主人「曲绘有时加载缓慢、甚至加载不出来」）。
   为什么需要：EAGER 只给了 loading=eager + fetchpriority=high，那是「解析到这行才开始下载」，
   而卡片的 <img> 在 HTML 里排到几十 KB 之后；在跨境链路（RTT ~1s）上，晚 100ms 解析就晚一个往返。
   用 <link rel=preload> 让浏览器在解析 <head> 时就发起。
   取前 2 张而不是 8（2026-11-15 P0）：modern-web-guidance 的 optimize-preload-priority 是
   MANDATORY —— fetchpriority=high 的图片 preload 最多 1~2 条，全页图片 preload 上限 2 张，
   超过就互相抢带宽、每张的优先级提升被摊薄。原版 8 条已经超了 4 倍。
   其余首屏图由 loading=eager + fetchpriority=high 的 <img> 承担，它们本来就排在 HTML 前部。
   地址必须与 SongCard 里那个 src 逐字一致，否则浏览器当成两个 URL、图会被下载两次。 */
const PRELOAD_SONGS = eagerOf(DEFAULT_SRV).slice(0, 2).filter((s) => !!s.cover);

// 【2026-11-02 分段加载】首屏只 SSR 渲染前若干世代，其余世代先出骨架。
//
// 为什么：每请求渲染 1683 张卡要 1.7MB HTML、2.5 万 DOM 节点，缓存只能兜住并发，
// 兜不住单次渲染成本（详见 docs/audit-2026-11-02.md）。主人选了 B 方案：
// 首屏 SSR + 其余世代骨架 + 滚到附近再拉该段 SSR 片段（/songs/frag）。
//
// 分界按「累计卡数」而不是「固定几个世代」：世代大小差很多（jubeat 20 首、
// festo 226 首），按个数切会在某些世代切出 1000 张、另一些只切出 30 张。
// 120 首 ≈ 390px 屏两屏多，足够覆盖首屏与第一次滚动。
// 阈值取「下限 100 / 上限 220」两个数，而不是一个：
//   世代大小差得离谱（jubeat 20 首、festo 226 首、saucer 201 首），
//   只写下限会在边界上撞进一个 200 首的大世代，首屏直接翻倍。
//   实测日服前四代累计 20+25+28+40=113 → 首屏约 113 张/服（含国服共约 230 张），
//   HTML 从 1.74MB 降到约 250KB；saucer(201) 起全部走骨架。
const FIRST_LOAD_MIN = 100;
const FIRST_LOAD_MAX = 220;
const firstLoadGens = (srv: Srv): Set<string> => {
  const out = new Set<string>();
  let n = 0;
  for (const g of srvGenOrder(srv)) {
    const size = (byGen[srv][g] || []).length;
    if (n >= FIRST_LOAD_MIN) break;            // 已经够一屏多了
    if (n > 0 && n + size > FIRST_LOAD_MAX) break; // 这一代太大，宁可整代留给骨架
    out.add(g);
    n += size;
  }
  return out;
};
const FIRST_LOAD: Record<Srv, Set<string>> = { jp: firstLoadGens('jp'), cn: firstLoadGens('cn') };

// 【2026-10-30 主人要求删掉「曲师」筛选】
// 这里原本会为 ALL 全表扫一遍统计每位曲师的曲数、再筛出 5 首以上的 38 位塞进下拉。
// UI 删掉后这段统计没有任何消费者，一并删除——它每次请求都要遍历 1248 行，
// 留着只是白烧 CPU。曲师仍可用搜索框直接打名字（matchCard 的 hay 里包含 data-a）。

// 世代下拉：全库 13 个世代、跨分区（任务书写「15 个」是主题套数口径，见 CONTEXT.md）
const GEN_OPTS = GEN_ORDER;

// 定数区间 / 难度档 / 排序选项。区间值与脚本里的 BAND_KEYS / BANDS 一一对应，改一处必须改两处。
//
// 【2026-11-17 难度与区间换控件】难度改成下拉（全部 / BSC / ADV / EXT），区间改成滑块
// （7- 7 8 9 9+ 10 10+）。滑块只是换了形态，每格仍是**互斥的档**（10 = 10.0~10.4），
// 主人原话：「这个滑块选择类似于挡位，比如说你选择【10】，并不是 10.0 及其以下，
// 而是 10.0 - 10.4 这个区间」。模板里刻度用 BANDS.slice(1)——滑块轴上不需要「全部」那一格。
//
// 【2026-10-28 主人改档位】原五档（7.0 以下 / 7.x / 8.x / 9.x / 10.0 以上）
// 改成八档：全部、7-、7、8、9、9+、10、10+。
//
// 主人原话：「X 指的是 X.0-X.4 这个区间，X+ 指的是 X.5-X.9 这个区间」。
// 按字面，7 与 8 也该各有 7+ / 8+，但主人给的清单里没有——查过实际数据：
// 全库 7.0 有 450 个谱面、8.0 有 510 个，**没有任何 7.1~7.9 或 8.1~8.9**，
// 细分只从 9 开始（9.0~10.9）。所以 7 与 8 按整段处理即可完整覆盖：
//   7-  = v < 7
//   7   = 7.0 ≤ v < 8.0     （实际只有 7.0）
//   8   = 8.0 ≤ v < 9.0     （实际只有 8.0）
//   9   = 9.0 ≤ v < 9.5     （X.0–X.4）
//   9+  = 9.5 ≤ v < 10      （X.5–X.9）
//   10  = 10.0 ≤ v < 10.5
//   10+ = v ≥ 10.5
// 每档互不重叠、合起来 100% 覆盖。将来若出现 7.5 这类值，会落进「7」这一档
// （不会漏），届时要拆 7+ 再说。
const BANDS = [
  { v: 'all', label: '全部' },
  { v: 'lt7', label: '7-' },
  { v: '7', label: '7' },
  { v: '8', label: '8' },
  { v: '9', label: '9' },
  { v: '9p', label: '9+' },
  { v: '10', label: '10' },
  { v: '10p', label: '10+' },
] as const;
// 【2026-10-30 主人：「难度档的『全部档』可以去掉了，默认不选」】
// 去掉后 state.diff 的合法值只剩 bsc/adv/ext 三档，默认值为 ''（= 不选）。
// 这一删顺带修好了一个老 bug：原来 'all' 会让 matchCard 直接 return true，
// 把后面的「定数区间」判断整段短路掉 —— 表现为「只选定数 10+ 完全不生效」。
// 现在「不做难度筛选」用空串表示，走的是「逐档判断、任一档命中即可」的逻辑，
// 区间筛选因此能独立生效。详见 matchCard 里 diff 那段的注释。
const DIFFS = [
  { v: 'bsc', label: 'BSC' },
  { v: 'adv', label: 'ADV' },
  { v: 'ext', label: 'EXT' },
] as const;
// 注意：这里**不要**再定义 DIFF_NONE 之类的常量给前端用 ——
// 页面底部那个 <script is:inline> 不经过 Astro 编译，读不到服务端变量。
// 需要共享的常量请在 inline 脚本里自己再声明一份（见 DIFF_NONE_INLINE）。
// 排序选项（2026-10-25 主人：加 songId 排序，且**默认改为 songId 升序**）。
// DEFAULT_SORT 单独抽出来，因为「默认值」还散落在三处判据里（state 初值、
// resetAll、以及「是否在筛选」的提示条判断），必须都引用这一个常量，
// 否则改默认值时会漏改一处，出现「默认排序却显示命中提示条」这种怪现象。
const DEFAULT_SORT = 'id-asc';
const SORTS = [
  { v: 'id-asc', label: 'songId 升序' },
  { v: 'id-desc', label: 'songId 降序' },
  { v: 'ext-desc', label: '定数 高→低' },
  { v: 'ext-asc', label: '定数 低→高' },
  { v: 't-asc', label: '曲名 A→Z' },
  { v: 't-desc', label: '曲名 Z→A' },
  // 【2026-10-30 主人要求删掉「世代 新→旧」】
  // 它和其他六种排序不是一类东西：其余都是「同一个世代块内部怎么排」，
  // 而它是「把世代块本身换个顺序」——选中它会把块内 order 清空（历史 bug），
  // 反而丢掉刚设好的排序。既然块本身已按世代自然顺序分组、还支持点标题逐块跳转，
  // 这个选项没有独立价值，删掉更干净。
] as const;

// 谱面类型筛选（2026-10-31 主人要求「增加筛选条件【谱面类型】（下拉菜单式）」）：
// 「全部 / STD谱 / HOLD谱 / [2]谱」。STD 与 HOLD 是「有没有长按」这条轴的两端，
// [ 2 ] 谱是另一条轴（谱面变体），三项互斥只是因为这个下拉是单选。
// ⚠ [ 2 ] ≠ 长押谱（主人 2026-10-30 原话），判据分别落在卡片的 data-alt 与 data-hh 上。
// 【上线日期筛选的可选值（2026-11-16）】只收真正用过的国服上架日，去重后升序。
// 主人要求「只能选择固定日期（非上线日期不可选）」——日历里的可点格子就由这份清单决定，
// 没有曲目落在的日子显示成不可点的灰格。
// 【2026-11-16 主人定口径：按服各读各的列，互不借用】
// 「日服的【上线日期】应只读 added_at_jp，国服的只读 added_at_cn」——
// 所以两边各自从自己的列取，不去 fallback 到另一服（早前日服借国服列的写法已废）。
// 日服那一列当前整列为空（拆列时旧日期全进了国服列），于是日服的日历暂时只有禁用格；
// 等日服真有 added_at_jp 数据，这里自动就有可选日期，不需要再改代码。
const datesIn = (srv: 'jp' | 'cn') =>
  [...new Set(ALL.map((s) => (srv === 'jp' ? s.dJp : s.dCn)).filter((d): d is string => !!d))].sort();
const DATA_DATES_JP = datesIn('jp');
const DATA_DATES_CN = datesIn('cn');

const TYPES = [
  { v: 'all', label: '全部' },
  { v: 'std', label: 'STD谱' },
  { v: 'hold', label: 'HOLD谱' },
  { v: 'alt2', label: '[2]谱' },
] as const;
---

<Layout
  title={pageTitle('曲目')}
  canonicalPath="/songs/"
  description={`jubeat 音乐魔方曲目库：日服 ${srvTotal('jp')} 首（授权 ${countOf('jp', '授权')} 首、原创 ${countOf('jp', '原创')} 首）、国服 ${srvTotal('cn')} 首（独占 ${countOf('cn', '独占')} 首、KONAMI ${countOf('cn', 'KONAMI')} 首、原创 ${countOf('cn', '原创')} 首、流行 ${countOf('cn', '流行')} 首），按世代分组，可搜索、筛选与排序。`}
>
  {/* 首屏曲绘 preload：2 张（2026-11-15 由 8 张压下来，理由见 PRELOAD_JACKETS 上方注释），
      必须与 SongCard 的 src 完全一致。 */}
  <Fragment slot="head">
    {PRELOAD_SONGS.map((s) => (
      <link rel="preload" as="image" href={jacketUrl(s.id, s.cover)} fetchpriority="high" />
    ))}
    {/* 预渲染首卡详情页（2026-11-15 P3）：列表站最常见的下一步就是点开第一首。
        只给 1 条、eagerness 用 moderate —— 要指针悬停/按下才真的开始，不与首屏图片抢带宽；
        用 immediate 会在刚进页面时就把带宽吃掉，实测首屏更慢。
        详情页是 SSR（[songId].astro 的 prerender=false），预渲染会把整页渲染好，
        点击时直接换上，省掉一次完整的服务端往返。
        不支持的浏览器（Firefox/Safari）忽略整段规则，无副作用。
        本机 Chrome 156 带 DevTools 时命中不了（CDP 明确报 PrerenderingDisabledByDevTools），
        所以本地只能验规则内容与请求头，activationStart 要在无 DevTools 的普通窗口里看。 */}
    <script type="speculationrules" set:html={JSON.stringify({
      prerender: [{
        source: 'list',
        urls: PRELOAD_SONGS.slice(0, 1).map((s) => `/songs/${s.id}/`),
        eagerness: 'moderate',
      }],
    })} />
  </Fragment>
  {/*
    【本页第 1 个可聚焦元素】键盘逃生口（2026-10-23，t9；位置按稽核实测调整）

    工具条从 3 个控件长到 10+，Tab 到第一张卡要按十几次。原先这条 skip 放在工具条前面，
    实测 Tab 序是：1 skip(全站) → 2~8 mark/曲目/最近更改/登录/图标×2/主题切换
    → 9 sc-skip → 10 服务器 → 11 国服 → 12 搜索 → … → 19 第一张卡。
    也就是说它被 7 个顶栏导航项挡在后面，"快捷键"反而要先绕过整个导航才够得着。

    挪到版面最顶端（<Layout> 之后、第一个 section 之前）之后：
      1「跳到主内容」(全站) → 2「跳到曲目列表」(本页)
    两条 escape hatch 都在最前，Tab 两下进内容。

    必须放在这里而不是 <section> 里：section 有 .band 的定位上下文，
    绝对定位的 skip 会被限制在 section 内，浮不出到版面顶部。
    平时视觉隐藏、键盘聚焦时浮现——与全站 <a class="skip"> 同一套做法。 */}
  <a class="sc-skip" href="#scList">跳到曲目列表</a>

  {/* 工具条可见性交给主脚本（2026-11-15 改）：原先这里有一条内联脚本，
      在解析到它那一刻就给 <html> 挂 .sc-js、让工具条显形。主脚本改成 defer 外链之后
      这个做法反而露了怯——defer 要等 HTML 解析完才跑，中间那段时间工具条已经亮着、
      却一个都点不动，正是 CSS 注释里说的"可见的死控件"。
      所以把挂类那一行搬进 songs-list.js 的第一行：脚本跑到它才亮工具条，
      慢网下宁可晚几百毫秒出现，也不给一排点了没反应的按钮。
      CSS 侧默认值仍是隐藏（.sc-find/.sc-panel/.sc-active 都 display:none），
      只在 html.sc-js 存在时显示——无 JS 就没有死控件。 */}

  <section class="band songs" id="songsRoot" data-srv={DEFAULT_SRV}>
    {/*
      主人 2026-10-22 要求：去掉「曲目 + songs 计数」那行标题，也去掉外面那层暗色 panel，
      服务器卡直接站到页面上并放大，总曲数收进卡里（分区 chips 各自还带自己的计数）。
      标题行去掉后页面只剩 h3（分区名），补一个视觉隐藏的 h1 保住标题层级，供读屏与 SEO。
      h1 是页面唯一的主标题（2026-10-23 无障碍收口：原先这里只有 h2，整页没有 h1）。
    */}
    <h1 class="sc-hide">曲目库</h1>
    {/* 无 JS 兜底：工具条是纯 JS 控件，脚本不跑就是一排死按钮，干脆不显示。
        正文的服务器/分区/世代分组本来就完整可读，不让"假控件"误导人。
        实现见页面末尾那段脚本的第一行（给 <html> 加 .sc-js）+ CSS 的 html:not(.sc-js) 规则。 */}

    <div class="sc-tools">
      <div class="sc-srv" role="group" aria-label="切换服务器">
        {SRV_CARDS.map((s) => (
          <button type="button" class={`sc-srv-b${s.id === DEFAULT_SRV ? ' is-on' : ''}`} data-srv={s.id} aria-pressed={s.id === DEFAULT_SRV ? 'true' : 'false'}>
            {/* 最近收录日（主人 2026-11-14）：先说「这块多久没上新」，再让 logo 与名称说明是哪一服。
                位置按主人同日改口放在 logo **上面**（原先在两枚徽章下面）。中性胶囊、不染主题色——
                它是纯信息，不靠颜色强调；日期用数据字体。 */}
            <b class="sc-tag sc-tag-l"><i class="sc-tag-l-k">Latest：</i><i class="sc-tag-l-d">{s.latest}</i></b>
            <img class={`sc-srv-logo${s.line ? ' sc-line' : ''}`} src={`/assets/images/logo/${s.logo}.webp`} alt="" width="176" height="60" loading="eager" decoding="async" />
            {/* 名称与总曲数并排两枚小徽章（主人 2026-10-22：总曲数放到名称右边，两个都做成徽章）。 */}
            <span class="sc-srv-meta">
              <b class="sc-tag sc-tag-n">{s.name}</b>
              <b class="sc-tag sc-tag-c">{srvTotal(s.id)}<i>首</i></b>
            </span>
          </button>
        ))}
      </div>

      {/*
        搜索行（2026-10-23 t9）：输入即筛，没有提交按钮。
        窄屏（≤768px）这一行独占：搜索框吃掉剩余宽度，按钮固定宽度，绝不把输入框挤没。
        清空按钮初始 hidden，有内容才出现；它是真按钮（可 Tab 聚焦），不是贴在图上的叉。
      */}
      <div class="sc-find">
        {/* 筛选按钮在搜索框**左边**（2026-10-25 主人要求）。
            DOM 顺序就是视觉顺序，不用 order 倒装：键盘 Tab 时也是先到筛选，
            与眼睛看到的左右关系一致，不会出现「视觉在左、Tab 却后到」的错位。 */}
        <button
          type="button"
          id="scFilterBtn"
          class="sc-btn sc-btn-f"
          aria-expanded="false"
          aria-controls="scPanel"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16M7 12h10M10 17.5h4"/></svg>
          <span id="scFilterTxt">筛选</span>
        </button>

        <div class="sc-q">
          <span class="sc-q-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.6" cy="10.6" r="6.4"/><path d="M15.4 15.4 20 20"/></svg>
          </span>
          <input
            id="scSearch"
            class="sc-q-in"
            type="search"
            inputmode="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="搜索曲名 / 曲师 / songId / 定数（可用假名·罗马字）"
            aria-label="搜索曲目：匹配曲名、曲师、songId、定数，也支持假名与罗马字读音"
          />
          <button type="button" id="scClear" class="sc-q-x" aria-label="清空搜索" title="清空搜索（Esc）" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
          </button>
        </div>
      </div>

      {/* 分区 chips 与排序已全部移入下面这个面板（2026-10-25 主人要求「筛选、排序、分区选择
          全整合进一个按钮里」）。工具条上只留：服务器卡（主切换器，不该藏）、搜索框、筛选按钮。
          这样第一张卡的位置从「Tab 19 次」变成「Tab 6 次」，页面顶部也不再被三排控件占掉。 */}

      {/*
        四维筛选面板：默认收起（hidden），由「筛选」按钮展开，aria-expanded 同步。
        面板里全是原生控件（select / button），键盘天然可达，不需要额外的方向键处理。
      */}
      <div class="sc-panel" id="scPanel" data-open="false" hidden>
        <div class="sc-panel-in">
        {/* 范围：PICK UP / COMMON（2026-10-25 主人要求）。
            与「分区」正交的第二个维度——一首歌可以既是原创又是 PICK UP，
            所以它是独立的一组 chip，判定走 lib/song-view.ts 的 isPickUp()，
            不并进 CATS、也不参与 catOf。计数与卡片上的 data-scope 同一判据。 */}
        <div class="sc-pf sc-pf-wide">
          <span class="sc-pf-k">范围</span>
          <div class="sc-scope" role="group" aria-label="按 PICK UP / COMMON 筛选">
            {(['jp', 'cn'] as const).map((srv) => (
              <div class="sc-scope-set" data-srv={srv} hidden={srv !== DEFAULT_SRV}>
                <button type="button" class="sc-chip sc-chip-sm is-on" data-scope="all" aria-pressed="true">全部<b>{srvTotal(srv)}</b></button>
                <button type="button" class="sc-chip sc-chip-sm" data-scope="pick" aria-pressed="false">PICK UP<b>{countScope(srv, 'pick')}</b></button>
                <button type="button" class="sc-chip sc-chip-sm" data-scope="common" aria-pressed="false">COMMON<b>{countScope(srv, 'common')}</b></button>
              </div>
            ))}
          </div>
        </div>

        {/* 分区选择：按服务器各一套 chips，切服时由 apply() 显隐（sets 变量仍指向它们）。 */}
        <div class="sc-pf sc-pf-wide">
          <span class="sc-pf-k">分区</span>
          <div class="sc-cats" role="group" aria-label="按分区筛选">
            {(['jp', 'cn'] as const).map((srv) => (
              <div class="sc-cat-set" data-srv={srv} hidden={srv !== DEFAULT_SRV}>
                {/* 「全部」= 跨分区按世代整合（主人 2026-10-24），不是"所有分区各自展开"。 */}
                <button type="button" class="sc-chip is-on" data-cat="all" aria-pressed="true">全部<b>{srvTotal(srv)}</b></button>
                {CATS[srv].map((c) => (
                  <button type="button" class="sc-chip" data-cat={c} aria-pressed="false">{c}<b>{countOf(srv, c)}</b></button>
                ))}
              </div>
            ))}
          </div>
        </div>

        {/* 【难度档 + 定数区间 合成一组（2026-10-30 主人要求「给难度档、定数区间套一个框在一起，
            边框显示颜色」）】
            为什么把它们俩放一个框：这两个是**同一条筛选轴的两段**——难度档选「哪一档」，
            定数区间选「那一档里的哪个数值段」，本质是「谱面难度」的两级细化，
            分成两个平铺区块读者要自己建立联系。套框把「这两项是一件事」这个关系画出来。

            顺序也按主人要求改成 **难度档 → 定数区间 → 限时曲**（原来是限时曲在最前）。
            理由同样：先定"哪一档"，再定"哪个数值段"，最后才是"要不要把已过期的也算进来"
            —— 限时曲是全局开关，不是这条轴的一部分，所以留在框外面。 */}
        {/* 【2026-11-17 难度 / 定数区间重做（主人指定形态）】
            原样：外面套一个 .sc-pf-box 框、框内两半各自占一整行、难度是 3 个 chip、区间是 8 个 chip。
            现在：①去掉那个框（它是"隔开上下"的壳，主人要求「去除难度和定数区间下面的div」）；
                  ②两项并成一行——难度是主控、区间是它的下钻，主控在左、下钻在右；
                  ③难度改成下拉菜单（全部 / BSC / ADV / EXT，默认「全部」），与排序、世代同一套 .sc-dd
                    （原来是 chip，靠"再点一次取消"回到不筛；下拉里「全部」就是那个出口，更直白）；
                  ④区间改成滑块（7- 7 8 9 9+ 10 10+，默认 7-）——八档 chip 在窄屏要折两行，
                    而它本来就是一根单调轴（"从某一档往上"），滑块正好是这个语义。
                  ⑤难度为「全部」时区间整块不出现（主控没选，下钻没有对象），
                    同时 state.band 复位成 'all'，避免"看不见的条件还在生效"。 */}
        <div class="sc-pf sc-pf-wide sc-diffrow">
          <div class="sc-pf sc-diffrow-main">
            <span class="sc-pf-k" id="scDiffK">难度</span>
            <div class="sc-dd" data-dd="scDiff">
              <button type="button" class="sc-dd-b" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="scDiffK">
                <span class="sc-dd-v">全部</span>
                <svg class="sc-dd-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5"/></svg>
              </button>
              <select id="scDiff" class="sc-dd-sel" aria-label="按难度筛选" tabindex="-1" aria-hidden="true">
