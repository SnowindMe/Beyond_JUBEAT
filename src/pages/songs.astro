---
// 曲目库：日服 / 国服 同页切换（不换网址），分区按服务器各自的分类，区内再按世代分组。
// 数据在运行时从 Cloudflare D1 读取（prerender = false）；切换、搜索、筛选、排序全是纯前端显隐，
// 不请求接口、不动 URL。D1 查询在 lib/db.ts 里做 isolate 级缓存（60s）。
//
// 世代分组标题是纯文字（2026-10-28 主人「/songs/gen/jubeat/ 这个页面不要」，
// 单独的世代筛选页已删除；本页本身已按世代分组，不需要再多一层）。
// 卡片结构在 components/SongCard.astro，别在这里再写一遍。
//
// 搜索 / 四维筛选 / 五种排序（2026-10-23，t9）：
//   匹配字段全部读卡片上的 data-*，不在输入时解析文本；
//   排序只改 CSS order，不重排 DOM（1248 张卡重排会掉帧、滚动位置也会跳）。
// 【无 JS 时】页面默认就渲染成「日服 → 分区 → 世代分组」的完整列表，
//   工具条只是叠加能力：脚本不跑，内容照样从头读到尾，不会白屏。
import Layout from '../layouts/Base.astro';
import '../styles/server-card.css';
import '../styles/songs.css';
import SongCard from '../components/SongCard.astro';
import GenBlock from '../components/GenBlock.astro';
import { pageTitle } from '../lib/title';
import { GEN_ORDER, GEN_JP, GEN_CN } from '../lib/gens';
import { getAllSongs, type Song } from '../lib/db';
import { CATS, catOf, countedIn, isPickUp, pickGen, todayISO, viewRows, type Srv } from '../lib/song-view';
import { env } from 'cloudflare:workers';

// 这一页是唯一需要运行时数据的页面，其余页面仍是构建期静态页。
export const prerender = false;

const ALL: Song[] = await getAllSongs((env as { beyond_jubeat?: D1Database })?.beyond_jubeat);

// 数据变化很慢：允许浏览器短缓存，边缘可缓存更久（stale-while-revalidate 兜底）
Astro.response.headers.set(
  'cache-control',
  'public, max-age=30, s-maxage=300, stale-while-revalidate=60'
);

// 世代 → 元信息（年份 + 稳定 slug）。
const genMetaOf = (gen: string) => GEN_ORDER.find((g) => g.k === gen);
const yearOf = (gen: string) => genMetaOf(gen)?.y ?? '';

// 每个分区实际会出现的世代（2026-10-24 分区改名后重算）。
//
// KONAMI 分区要列**日服 12 个世代 + 音乐魔方**：
// 它装的是「国服已上线的日服曲」（sheet1 打√的 432 首，首登于 jubeat…beyond the Ave.）
// 加上国服独有的机种移植曲与 Big Daddy。只映射 GEN_CN 的话，那 432 首会因为没有对应桶被丢掉——
// 这正是「数据标了 cn=1、页面却仍只有 91 卡」的真因（视图放行了，桶没建）。
//
// 「独占」也要列日服的 12 个世代：华立独占的 17 首里有相当一部分是 gitadora / DDR / popn
// 等机种的移植曲（源表 I 列写着「移植机种」），它们在库里带着日服世代的 gen_name，
// 只给它 GEN_CN 会导致命中卡片被静默丢掉（数据对、页面少卡，就是上一轮踩过的坑）。
// 多给世代不会让别的曲混进来 —— 分区归属由 catOf() 决定，世代只是分块轴。
const CN_ALL_GENS = [...GEN_JP.map((g) => g.k), ...GEN_CN.map((g) => g.k)];
const CAT_GENS: Record<string, Record<string, string[]>> = {
  jp: { '授权': GEN_JP.map((g) => g.k), '原创': GEN_JP.map((g) => g.k) },
  cn: {
    '独占': CN_ALL_GENS,
    'KONAMI': CN_ALL_GENS,
    '原创': GEN_CN.map((g) => g.k),
    '流行': GEN_CN.map((g) => g.k),
  },
};
// 服务器卡：卡片内 logo 在上、服务器名在下（主人 2026-10-21 指定）。
// 国际服已移除（主人 2026-10-22）：曲库没有独立国际服数据，入口留着只会误导。
const SRV_CARDS = [
  { id: 'jp', name: '日服', gen: 'Beyond the Ave.', logo: 'bta', line: true },
  { id: 'cn', name: '国服', gen: '音乐魔方', logo: 'yymf', line: false },
] as const;

// 按 视图服务器 → 分区 → 世代 建桶。
//
// 【桶内顺序必须与前端默认排序一致（2026-10-25 修「刷新先看到难度降序再跳到 songId 升序」）】
// 前端排序只写 CSS order、不重排 DOM，而默认排序已改成 songId 升序（DEFAULT_SORT = 'id-asc'）。
// 原来服务端按 EXT 降序输出 DOM，于是首屏绘制的是「定数高→低」，脚本跑完才被 order 改写成
// songId 升序 —— 两者之间的时间差就是用户看到的「先难度降序、再跳一下」。
// 现在服务端直接按 songId 升序输出，首帧即最终顺序，没有可闪的空档。
// 「哪些行进哪个视图、算哪个分区」的口径在 lib/song-view.ts，与世代页共用，别在这里重写。
/** 与前端 sortCards('id-asc') 完全同构的比较器：
 *  songId 是「8 位日服 / 9 位国服」两种长度，必须按数值比，字符串比会把 991000007 排到
 *  11000228 前面；非纯数字 id（日服占位 BTA-xxxxxx）排在数字之后，同 id 才比曲名。
 *  改这里必须同步改前端那段，否则又会出现「首帧一个顺序、脚本跑完另一个顺序」。 */
const byIdAsc = (a: Song, b: Song) => {
  const na = /^\d+$/.test(a.id) ? Number(a.id) : null;
  const nb = /^\d+$/.test(b.id) ? Number(b.id) : null;
  if (na === null && nb !== null) return 1;
  if (nb === null && na !== null) return -1;
  const c = na === null || nb === null ? a.id.localeCompare(b.id) : na - nb;
  return c !== 0 ? c : a.t.localeCompare(b.t);
};
const bucket: Record<string, Record<string, Record<string, Song[]>>> = { jp: {}, cn: {} };
for (const srv of ['jp', 'cn'] as const) {
  for (const cat of CATS[srv]) {
    bucket[srv][cat] = {};
    for (const gen of CAT_GENS[srv][cat]) bucket[srv][cat][gen] = [];
  }
}
// 国服视图内去重（2026-10-24 实测发现）：国服视图现在收 cn=1 的所有行，
// 而「双服曲」在库里是**两行**（日服行 + 国服行，如 Big Daddy 11000228 / 991000007）。
// 不去重的话同一首会在国服视图里出现两次，违反「同一视图内不重复」这条一直有效的约束
// （之前 cn 只收 gen==='音乐魔方' 的行，那两行不会同时进视图，所以没暴露）。
// 保留哪一行：优先保留国服行（gen==='音乐魔方'，它的定数/分类是国服口径），
// 日服行只在这一首没有国服行时才留（即 432 首旧框曲，它们本来就只有日服行）。
// 【2026-10-28 抽走】原先这里自建 cnSeen、并在 bucket / byGen / rowsIn 三处各写一遍
// 「inView + 国服去重」的 filter；jubility 那边自己又写第四遍，且漏了限时曲。
// 现在全部走 song-view.ts 的 viewRows() / countedIn()，单一来源。
// cnSeen 已随之上移进 viewRows，本页不再需要持有它。
for (const srv of ['jp', 'cn'] as const) {
  // viewRows 已内含「国服视图里双服曲只留国服行」的去重，这里不再手写一遍。
  for (const s of viewRows(ALL, srv)) {
    const g = bucket[srv]?.[catOf(s, srv)]?.[s.gen];
    if (g) g.push(s);
  }
}
for (const srv of ['jp', 'cn'] as const) {
  for (const cat of CATS[srv]) {
    for (const gen of CAT_GENS[srv][cat]) {
      bucket[srv][cat][gen].sort(byIdAsc);
    }
  }
}

// 「全部分区」视图（主人 2026-10-24）：选「全部」时不按分区分块，改成跨该服务器
// 所有分区按世代整合——一个世代只出现一次，同一世代的授权/原创/国服各类曲目混在一起按定数排。
// 不这么做的话，选「全部」只是把三个分区各自展开，同一个世代会出现 3 次，看着不像"全部"。
// 键用世代名，值是该世代在这个服务器视图下的全部行（跨分区去重后合并）。
const byGen: Record<string, Record<string, Song[]>> = { jp: {}, cn: {} };
for (const srv of ['jp', 'cn'] as const) {
  for (const gen of GEN_JP.concat(GEN_CN).map((g) => g.k)) byGen[srv][gen] = [];
}
for (const srv of ['jp', 'cn'] as const) {
  for (const s of viewRows(ALL, srv)) {
    const g = byGen[srv][s.gen];
    if (g) g.push(s);
  }
  for (const gen of Object.keys(byGen[srv])) {
    byGen[srv][gen].sort(byIdAsc);
  }
}
// 该服务器视图下按 **GEN_ORDER 的自然顺序（旧→新：jubeat 2008 → beyond the Ave. 2024）**
// 排列的世代清单，只保留非空世代。
// 注意：默认顺序是「旧→新」（与 GEN_ORDER 一致）；「世代 新→旧」是排序选项 gen-new 的活，
// 由前端按 data-y 给 .sc-gen 写 style.order 实现——两者不冲突，别把这里改成倒序。
//
// 【2026-10-24 修正】不再按「世代自带服务器」过滤（g.s === srv）——那是「国服只有音乐魔方
// 一个世代」的旧口径。国服视图现在还要装「旧框已有曲」（sheet1 打√的 432 首，首登于日服
// 各世代），它们必须有自己的世代块，否则数据标了 cn=1、byGen 桶也装好了，渲染时却一个块
// 都不列 —— 结果就是标题写「524 首」、页面只有 91 张卡（本轮实测到的真因）。
// 判据改成「该视图下这个世代桶非空」，与是谁的世代无关；空世代仍然不出现。
const srvGenOrder = (srv: Srv) =>
  GEN_ORDER.map((g) => g.k).filter((k) => (byGen[srv][k] || []).length > 0);

// 计数必须与实际渲染同一套口径，否则就会出现「标题 524、页面 523」这种自相矛盾
// （本轮实测：去重过滤器只加在渲染循环里，countOf/srvTotal 还在裸数 ALL）。
// 所以先把「这个视图里到底有哪些行」抽成一个函数，桶、计数、世代清单三处共用它。
// 【2026-10-28 限时曲】服务端就判一次，别只在前端隐藏：
// 主人明确「服务器选项卡的歌曲总数也不要加上限时曲的数量」——若只在 JS 里藏卡片，
// 右上角那个「1150 首」仍会把它们算进去，数字与肉眼可见对不上。
// 口径与前端 isEndedLimited() 严格一致：结束日 < 今天 才算已结束。
// 日期与限时曲判据、视图行都改由 song-view.ts 提供（todayISO / isLimitedEnded / countedIn）。
// 原先这里是第 3 份手写 filter，jubility.ts 还有第 4 份且漏了限时曲——已全部收敛。
const TODAY = todayISO();

/** 计入统计的行（排除已结束限时曲）：计数、分桶、世代清单、谱面池由此一并对齐 */
const rowsIn = (srv: Srv) => countedIn(ALL, srv, TODAY);

const countOf = (srv: Srv, cat?: string) =>
  rowsIn(srv).filter((s) => !cat || catOf(s, srv) === cat).length;
const srvTotal = (srv: Srv) => rowsIn(srv).length;

// PICK UP / COMMON 的计数（2026-10-25）。与卡片上的 data-scope 同一个判据 isPickUp()，
// 与 rowsIn 同一套视图去重——三处必须是同一个数，否则会出现「chip 写 142、页面数出 141」。
// 实测（2026-10-25 按本页口径）：日服 142 / 1008；国服 158 / 365（合计 523）。
const pickUpIn = (srv: Srv) => rowsIn(srv).filter((s) => isPickUp(s, srv));
const countScope = (srv: Srv, scope: 'pick' | 'common') => {
  const pick = pickUpIn(srv).length;
  const total = srvTotal(srv);
  return scope === 'pick' ? pick : total - pick;
};

const DEFAULT_SRV: Srv = 'jp';

// 首屏曲绘：默认视图（日服 · 授权 · 从前几个世代取够 18 张）优先加载，
// 其余一律 lazy + low，避免一次开 1200+ 请求。
//
// 【2026-10-25 修正】把 PICK UP 世代（bta）从取图范围里排除。
// 原因：bta 的 songId 是 11000xxx / 11001xxx（8 位、最大），在「songId 升序」下
// 整块排在日服列表最末尾，屏幕外。按原来「按世代顺序累加到 18 张」的写法，
// 头 18 张会全部落在 bta（实测 GEN_ORDER 最后一个世代正好是 bta，前面各世代的授权曲
// 一凑就超 18），于是真正的首屏一张都没预加载、末尾反而预加载了一堆看不见的图 ——
// 首屏 LCP 白等。排除后取的 18 张落在 Ave. 的授权曲（实测为默认视图可见区）。
// 判据必须与前端 isPickUp() 同一口径，所以这里用同一个函数，别另写一份。
const EAGER_PICKUP_GENS = new Set(GEN_JP.filter((g) => pickGen(g.k, 'jp')).map((g) => g.k));
const EAGER = new Set(
  bucket.jp['授权']
    ? Object.keys(bucket.jp['授权'])
        .filter((k) => !EAGER_PICKUP_GENS.has(k))
        .map((k) => bucket.jp['授权'][k])
        .reduce((acc, arr) => acc.concat(arr), [])
        .slice(0, 18)
        .map((s) => s.id)
    : [],
);

// 曲师筛选面板只放「常用曲师」：库里 710 位，全塞进下拉会变成一条没人翻得完的列表。
// 门槛 5 首（实测 38 位），其余靠搜索框直接打曲师名（搜索同时匹配曲师字段）。
const ARTIST_MIN = 5;
const ARTIST_TALLY = new Map<string, number>();
for (const s of ALL) {
  if (!s.a) continue;
  ARTIST_TALLY.set(s.a, (ARTIST_TALLY.get(s.a) ?? 0) + 1);
}
const TOP_ARTISTS = [...ARTIST_TALLY.entries()]
  .filter(([, n]) => n >= ARTIST_MIN)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// 世代下拉：全库 13 个世代、跨分区（任务书写「15 个」是主题套数口径，见 CONTEXT.md）
const GEN_OPTS = GEN_ORDER;

// 定数区间 / 难度档 / 排序选项。区间值与脚本里的 BANDS 一一对应，改一处必须改两处。
//
// 【2026-10-28 主人改档位】原五档（7.0 以下 / 7.x / 8.x / 9.x / 10.0 以上）
// 改成八档：全部、7-、7、8、9、9+、10、10+。
//
// 主人原话：「X 指的是 X.0-X.4 这个区间，X+ 指的是 X.5-X.9 这个区间」。
// 按字面，7 与 8 也该各有 7+ / 8+，但主人给的清单里没有——查过实际数据：
// 全库 7.0 有 450 个谱面、8.0 有 510 个，**没有任何 7.1~7.9 或 8.1~8.9**，
// 细分只从 9 开始（9.0~10.9）。所以 7 与 8 按整段处理即可完整覆盖：
//   7-  = v < 7
//   7   = 7.0 ≤ v < 8.0     （实际只有 7.0）
//   8   = 8.0 ≤ v < 9.0     （实际只有 8.0）
//   9   = 9.0 ≤ v < 9.5     （X.0–X.4）
//   9+  = 9.5 ≤ v < 10      （X.5–X.9）
//   10  = 10.0 ≤ v < 10.5
//   10+ = v ≥ 10.5
// 每档互不重叠、合起来 100% 覆盖。将来若出现 7.5 这类值，会落进「7」这一档
// （不会漏），届时要拆 7+ 再说。
const BANDS = [
  { v: 'all', label: '全部' },
  { v: 'lt7', label: '7-' },
  { v: '7', label: '7' },
  { v: '8', label: '8' },
  { v: '9', label: '9' },
  { v: '9p', label: '9+' },
  { v: '10', label: '10' },
  { v: '10p', label: '10+' },
] as const;
const DIFFS = [
  { v: 'all', label: '全部档' },
  { v: 'bsc', label: 'BSC' },
  { v: 'adv', label: 'ADV' },
  { v: 'ext', label: 'EXT' },
] as const;
// 排序选项（2026-10-25 主人：加 songId 排序，且**默认改为 songId 升序**）。
// DEFAULT_SORT 单独抽出来，因为「默认值」还散落在三处判据里（state 初值、
// resetAll、以及「是否在筛选」的提示条判断），必须都引用这一个常量，
// 否则改默认值时会漏改一处，出现「默认排序却显示命中提示条」这种怪现象。
const DEFAULT_SORT = 'id-asc';
const SORTS = [
  { v: 'id-asc', label: 'songId 升序' },
  { v: 'id-desc', label: 'songId 降序' },
  { v: 'ext-desc', label: '定数 高→低' },
  { v: 'ext-asc', label: '定数 低→高' },
  { v: 't-asc', label: '曲名 A→Z' },
  { v: 't-desc', label: '曲名 Z→A' },
  { v: 'gen-new', label: '世代 新→旧' },
] as const;
---

<Layout
  title={pageTitle('曲目')}
  canonicalPath="/songs/"
  description={`jubeat 音乐魔方曲目库：日服 ${srvTotal('jp')} 首（授权 ${countOf('jp', '授权')} 首、原创 ${countOf('jp', '原创')} 首）、国服 ${srvTotal('cn')} 首（独占 ${countOf('cn', '独占')} 首、KONAMI ${countOf('cn', 'KONAMI')} 首、原创 ${countOf('cn', '原创')} 首、流行 ${countOf('cn', '流行')} 首），按世代分组，可搜索、筛选与排序。`}
>
  {/*
    【本页第 1 个可聚焦元素】键盘逃生口（2026-10-23，t9；位置按稽核实测调整）

    工具条从 3 个控件长到 10+，Tab 到第一张卡要按十几次。原先这条 skip 放在工具条前面，
    实测 Tab 序是：1 skip(全站) → 2~8 mark/曲目/最近更改/登录/图标×2/主题切换
    → 9 sc-skip → 10 服务器 → 11 国服 → 12 搜索 → … → 19 第一张卡。
    也就是说它被 7 个顶栏导航项挡在后面，"快捷键"反而要先绕过整个导航才够得着。

    挪到版面最顶端（<Layout> 之后、第一个 section 之前）之后：
      1「跳到主内容」(全站) → 2「跳到曲目列表」(本页)
    两条 escape hatch 都在最前，Tab 两下进内容。

    必须放在这里而不是 <section> 里：section 有 .band 的定位上下文，
    绝对定位的 skip 会被限制在 section 内，浮不出到版面顶部。
    平时视觉隐藏、键盘聚焦时浮现——与全站 <a class="skip"> 同一套做法。 */}
  <a class="sc-skip" href="#scList">跳到曲目列表</a>

  {/*
    工具条可见性的第一笔（防 FOUC）：这段脚本紧贴 <section> 开头，
    在浏览器解析到它时立刻执行，比版面绘制早，所以不会出现"工具条先亮一下"。
    CSS 侧对应的默认值是隐藏（.sc-find/.sc-cats/.sc-panel 都 display:none），
    只有 html.sc-js 存在时它们才显示——两边配合起来，无 JS 就没有死控件，有 JS 也不闪。
  */}
  <script is:inline>document.documentElement.classList.add('sc-js');</script>

  <section class="band songs" id="songsRoot" data-srv={DEFAULT_SRV}>
    {/*
      主人 2026-10-22 要求：去掉「曲目 + songs 计数」那行标题，也去掉外面那层暗色 panel，
      服务器卡直接站到页面上并放大，总曲数收进卡里（分区 chips 各自还带自己的计数）。
      标题行去掉后页面只剩 h3（分区名），补一个视觉隐藏的 h1 保住标题层级，供读屏与 SEO。
      h1 是页面唯一的主标题（2026-10-23 无障碍收口：原先这里只有 h2，整页没有 h1）。
    */}
    <h1 class="sc-hide">曲目库</h1>
    {/* 无 JS 兜底：工具条是纯 JS 控件，脚本不跑就是一排死按钮，干脆不显示。
        正文的服务器/分区/世代分组本来就完整可读，不让"假控件"误导人。
        实现见页面末尾那段脚本的第一行（给 <html> 加 .sc-js）+ CSS 的 html:not(.sc-js) 规则。 */}

    <div class="sc-tools">
      <div class="sc-srv" role="group" aria-label="切换服务器">
        {SRV_CARDS.map((s) => (
          <button type="button" class={`sc-srv-b${s.id === DEFAULT_SRV ? ' is-on' : ''}`} data-srv={s.id} aria-pressed={s.id === DEFAULT_SRV ? 'true' : 'false'}>
            <img class={`sc-srv-logo${s.line ? ' sc-line' : ''}`} src={`/assets/images/logo/${s.logo}.webp`} alt="" width="176" height="60" loading="eager" decoding="async" />
            {/* 名称与总曲数并排两枚小徽章（主人 2026-10-22：总曲数放到名称右边，两个都做成徽章）。 */}
            <span class="sc-srv-meta">
              <b class="sc-tag sc-tag-n">{s.name}</b>
              <b class="sc-tag sc-tag-c">{srvTotal(s.id)}<i>首</i></b>
            </span>
          </button>
        ))}
      </div>

      {/*
        搜索行（2026-10-23 t9）：输入即筛，没有提交按钮。
        窄屏（≤768px）这一行独占：搜索框吃掉剩余宽度，按钮固定宽度，绝不把输入框挤没。
        清空按钮初始 hidden，有内容才出现；它是真按钮（可 Tab 聚焦），不是贴在图上的叉。
      */}
      <div class="sc-find">
        {/* 筛选按钮在搜索框**左边**（2026-10-25 主人要求）。
            DOM 顺序就是视觉顺序，不用 order 倒装：键盘 Tab 时也是先到筛选，
            与眼睛看到的左右关系一致，不会出现「视觉在左、Tab 却后到」的错位。 */}
        <button
