      */}
      <div class="sc-panel" id="scPanel" data-open="false" hidden>
        <div class="sc-panel-in">
        {/* 范围：PICK UP / COMMON（2026-10-25 主人要求）。
            与「分区」正交的第二个维度——一首歌可以既是原创又是 PICK UP，
            所以它是独立的一组 chip，判定走 lib/song-view.ts 的 isPickUp()，
            不并进 CATS、也不参与 catOf。计数与卡片上的 data-scope 同一判据。 */}
        <div class="sc-pf sc-pf-wide">
          <span class="sc-pf-k">范围</span>
          <div class="sc-scope" role="group" aria-label="按 PICK UP / COMMON 筛选">
            {(['jp', 'cn'] as const).map((srv) => (
              <div class="sc-scope-set" data-srv={srv} hidden={srv !== DEFAULT_SRV}>
                <button type="button" class="sc-chip sc-chip-sm is-on" data-scope="all" aria-pressed="true">全部<b>{srvTotal(srv)}</b></button>
                <button type="button" class="sc-chip sc-chip-sm" data-scope="pick" aria-pressed="false">PICK UP<b>{countScope(srv, 'pick')}</b></button>
                <button type="button" class="sc-chip sc-chip-sm" data-scope="common" aria-pressed="false">COMMON<b>{countScope(srv, 'common')}</b></button>
              </div>
            ))}
          </div>
        </div>

        {/* 分区选择：按服务器各一套 chips，切服时由 apply() 显隐（sets 变量仍指向它们）。 */}
        <div class="sc-pf sc-pf-wide">
          <span class="sc-pf-k">分区</span>
          <div class="sc-cats" role="group" aria-label="按分区筛选">
            {(['jp', 'cn'] as const).map((srv) => (
              <div class="sc-cat-set" data-srv={srv} hidden={srv !== DEFAULT_SRV}>
                {/* 「全部」= 跨分区按世代整合（主人 2026-10-24），不是"所有分区各自展开"。 */}
                <button type="button" class="sc-chip is-on" data-cat="all" aria-pressed="true">全部<b>{srvTotal(srv)}</b></button>
                {CATS[srv].map((c) => (
                  <button type="button" class="sc-chip" data-cat={c} aria-pressed="false">{c}<b>{countOf(srv, c)}</b></button>
