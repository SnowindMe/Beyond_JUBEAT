{
  "name": "beyond-jubeat",
  "version": "4.0.0",
  "private": true,
  "description": "jubeat 音乐魔方中文资料站",
  "scripts": {
    "data": "node scripts/build-data.cjs",
    "dev": "astro dev",
    "build": "node scripts/gen-seo.cjs && astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "node scripts/ci/check-refs.cjs && node scripts/ci/check-refs.cjs dist",
    "opt": "node scripts/optimize-images.cjs",
    "fonts": "python scripts/subset-fonts.py"
  },
  "devDependencies": {
    "astro": "^7.4.0",
    "sharp": "^0.35.5",
    "wrangler": "^4.42.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1"
  }
}
